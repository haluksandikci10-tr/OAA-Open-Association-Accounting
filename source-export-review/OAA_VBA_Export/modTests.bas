'==============================================================================
' TEST-142
' Gelir Guncelleme ve Defter Tutarliligi
'
' Amac:
' Gelir kaydi guncellendiginde baglantili defter hareketinin
' ve isletme defteri bakiyesinin dogru guncellendigini dogrulamak.
'==============================================================================

Public Sub TEST_142_IncomeUpdateLedgerConsistency()

    Dim IncomeService As clsIncomeService
    Dim LedgerService As clsLedgerService

    Dim Income As clsIncome
    Dim LoadedIncome As clsIncome

    Dim Entries As Collection
    Dim Entry As clsLedgerEntry
    Dim CurrentEntry As clsLedgerEntry

    Dim TestIncomeID As Long
    Dim TestDocumentNo As String

    Dim InitialAmount As Currency
    Dim InitialCash As Currency
    Dim InitialBank As Currency

    Dim UpdatedAmount As Currency
    Dim UpdatedCash As Currency
    Dim UpdatedBank As Currency

    Dim BalanceBefore As Currency
    Dim BalanceAfterAdd As Currency
    Dim BalanceAfterUpdate As Currency
    Dim BalanceAfterCleanup As Currency

    Dim MatchCount As Long
    Dim I As Long

    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    On Error GoTo TestError

    '==========================================================================
    ' TEST VERILERI
    '==========================================================================

    TestDocumentNo = _
        "TEST-142-" & Format$(Now, "yyyymmddhhnnss")

    InitialAmount = CCur(100)
    InitialCash = CCur(60)
    InitialBank = CCur(40)

    UpdatedAmount = CCur(120)
    UpdatedCash = CCur(70)
    UpdatedBank = CCur(50)

    '==========================================================================
    ' SERVICES
    '==========================================================================

    Set IncomeService = New clsIncomeService
    Set LedgerService = New clsLedgerService

    BalanceBefore = LedgerService.GetCurrentBalance

    '==========================================================================
    ' ILK GELIR KAYDINI OLUSTUR
    '==========================================================================

    Set Income = New clsIncome

    With Income
        .IncomeID = 0
        .EntryDate = Date
        .DocumentNo = TestDocumentNo
        .IncomeType = "TEST-142"
        .Description = "TEST-142 Gelir guncelleme testi"
        .IncomeAmount = InitialAmount
        .CashAmount = InitialCash
        .BankAmount = InitialBank
    End With

    If Not IncomeService.AddIncomeWithLedger(Income) Then

        Err.Raise _
            vbObjectError + 14201, _
            "TEST-142", _
            "Ilk gelir kaydi olusturulamadi."

    End If

    TestIncomeID = Income.IncomeID

    If TestIncomeID <= 0 Then

        Err.Raise _
            vbObjectError + 14202, _
            "TEST-142", _
            "Gecerli IncomeID olusturulmadi."

    End If

    BalanceAfterAdd = LedgerService.GetCurrentBalance

    If BalanceAfterAdd <> BalanceBefore + InitialAmount Then

        Err.Raise _
            vbObjectError + 14203, _
            "TEST-142", _
            "Ilk gelir kaydindan sonra bakiye hatali."

    End If

    '==========================================================================
    ' GELIR NESNESINI GUNCELLE
    '==========================================================================

    Income.IncomeAmount = UpdatedAmount
    Income.CashAmount = UpdatedCash
    Income.BankAmount = UpdatedBank

    Income.Description = _
        "TEST-142 Guncellenmis gelir kaydi"

    '==========================================================================
    ' UPDATE INCOME
    '==========================================================================

    If Not IncomeService.UpdateIncome(Income) Then

        Err.Raise _
            vbObjectError + 14204, _
            "TEST-142", _
            "UpdateIncome islemi basarisiz."

    End If

    '==========================================================================
    ' GELIR KAYDI KONTROLU
    '==========================================================================

    Set LoadedIncome = _
        IncomeService.GetIncome(TestIncomeID)

    If LoadedIncome Is Nothing Then

        Err.Raise _
            vbObjectError + 14205, _
            "TEST-142", _
            "Guncellenen gelir kaydi okunamadi."

    End If

    If LoadedIncome.IncomeID <> TestIncomeID Then GoTo IncomeDataError

    If LoadedIncome.IncomeAmount <> UpdatedAmount Then GoTo IncomeDataError

    If LoadedIncome.CashAmount <> UpdatedCash Then GoTo IncomeDataError

    If LoadedIncome.BankAmount <> UpdatedBank Then GoTo IncomeDataError

    If LoadedIncome.Description <> Income.Description Then GoTo IncomeDataError

    '==========================================================================
    ' DEFTER ILISKISI KONTROLU
    '==========================================================================

    Set Entries = LedgerService.GetAllEntries

    If Entries Is Nothing Then

        Err.Raise _
            vbObjectError + 14206, _
            "TEST-142", _
            "Defter kayitlari okunamadi."

    End If

    MatchCount = 0

    For I = 1 To Entries.Count

        Set CurrentEntry = Entries(I)

        If Not CurrentEntry Is Nothing Then

            If CurrentEntry.IncomeID = TestIncomeID Then

                MatchCount = MatchCount + 1

                Set Entry = CurrentEntry

            End If

        End If

    Next I

    If MatchCount <> 1 Then

        Err.Raise _
            vbObjectError + 14207, _
            "TEST-142", _
            "IncomeID ile tam olarak bir defter hareketi bulunamadi."

    End If

    '==========================================================================
    ' DEFTER ALANLARI KONTROLU
    '==========================================================================

    If Entry.IncomeID <> TestIncomeID Then GoTo LedgerDataError

    If Entry.IncomeAmount <> UpdatedAmount Then GoTo LedgerDataError

    If Entry.ExpenseAmount <> CCur(0) Then GoTo LedgerDataError

    If Entry.CashAmount <> UpdatedCash Then GoTo LedgerDataError

    If Entry.BankAmount <> UpdatedBank Then GoTo LedgerDataError

    If Entry.Description <> Income.Description Then GoTo LedgerDataError

    '==========================================================================
    ' BAKIYE KONTROLU
    '==========================================================================

    BalanceAfterUpdate = LedgerService.GetCurrentBalance

    If BalanceAfterUpdate <> BalanceBefore + UpdatedAmount Then

        Err.Raise _
            vbObjectError + 14208, _
            "TEST-142", _
            "Guncelleme sonrasi isletme defteri bakiyesi hatali."

    End If

    '==========================================================================
    ' TEST KAYITLARINI TEMIZLE
    '==========================================================================

    If Not IncomeService.DeleteIncome(TestIncomeID) Then

        Err.Raise _
            vbObjectError + 14209, _
            "TEST-142", _
            "Test gelir kaydi silinemedi."

    End If

    TestIncomeID = 0

    '==========================================================================
    ' TEMIZLIK KONTROLU
    '==========================================================================

    BalanceAfterCleanup = LedgerService.GetCurrentBalance

    If BalanceAfterCleanup <> BalanceBefore Then

        Err.Raise _
            vbObjectError + 14210, _
            "TEST-142", _
            "Temizlik sonrasi bakiye eski degerine donmedi."

    End If

    '==========================================================================
    ' BASARILI
    '==========================================================================

    Debug.Print String(70, "=")
    Debug.Print "TEST-142 BASARILI"
    Debug.Print "Gelir guncelleme       : BASARILI"
    Debug.Print "Gelir kaydi kontrolu   : BASARILI"
    Debug.Print "Defter iliskisi        : BASARILI"
    Debug.Print "Kasa/banka kontrolu    : BASARILI"
    Debug.Print "Bakiye kontrolu        : BASARILI"
    Debug.Print "Test temizligi         : BASARILI"
    Debug.Print String(70, "=")

    MsgBox _
        "TEST-142 BASARILI" & vbCrLf & vbCrLf & _
        "Gelir guncelleme       : BASARILI" & vbCrLf & _
        "Gelir kaydi kontrolu   : BASARILI" & vbCrLf & _
        "Defter iliskisi        : BASARILI" & vbCrLf & _
        "Kasa/banka kontrolu    : BASARILI" & vbCrLf & _
        "Bakiye kontrolu        : BASARILI" & vbCrLf & _
        "Test temizligi         : BASARILI", _
        vbInformation, _
        "OAA - TEST-142"

    GoTo CleanExit

'==============================================================================
' GELIR VERI HATASI
'==============================================================================

IncomeDataError:

    Err.Raise _
        vbObjectError + 14211, _
        "TEST-142", _
        "Gelir kaydi beklenen degerlerle eslesmiyor."

'==============================================================================
' DEFTER VERI HATASI
'==============================================================================

LedgerDataError:

    Err.Raise _
        vbObjectError + 14212, _
        "TEST-142", _
        "Defter hareketi beklenen degerlerle eslesmiyor."

'==============================================================================
' HATA YONETIMI
'==============================================================================

TestError:

    ErrorNumber = Err.Number
    ErrorDescription = Err.Description

    On Error Resume Next

    If TestIncomeID > 0 Then
        Call IncomeService.DeleteIncome(TestIncomeID)
    End If

    On Error GoTo 0

    Debug.Print String(70, "=")
    Debug.Print "TEST-142 BASARISIZ"
    Debug.Print "Hata numarasi : " & ErrorNumber
    Debug.Print "Hata aciklamasi: " & ErrorDescription
    Debug.Print String(70, "=")

    MsgBox _
        "TEST-142 BASARISIZ" & vbCrLf & vbCrLf & _
        "Hata numarasi : " & ErrorNumber & vbCrLf & _
        "Hata aciklamasi: " & ErrorDescription, _
        vbCritical, _
        "OAA - TEST-142"

'==============================================================================
' TEMIZ CIKIS
'==============================================================================

CleanExit:

    Set CurrentEntry = Nothing
    Set Entry = Nothing
    Set Entries = Nothing
    Set LoadedIncome = Nothing
    Set Income = Nothing
    Set LedgerService = Nothing
    Set IncomeService = Nothing

End Sub

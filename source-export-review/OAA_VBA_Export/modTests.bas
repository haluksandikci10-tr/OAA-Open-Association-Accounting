        End If

    Next Member

    If TestMemberID <= 0 Then

        Err.Raise vbObjectError + 9203, _
                  "TEST_042", _
                  "Test için aktif üye bulunamadý."

    End If

    '==========================================================================
    ' 4 - KULLANILMAMIÞ RESMI DÖNEM BUL
    '==========================================================================

    PeriodFound = False

    For DueMonth = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                DueMonth, _
                "RESMI") Then

            PeriodFound = True
            Exit For

        End If

    Next DueMonth

    If Not PeriodFound Then

        Err.Raise vbObjectError + 9204, _
                  "TEST_042", _
                  "TEST için kullanýlmamýþ RESMI dönem bulunamadý."

    End If

    ChargeDate = DateSerial(FiscalYear, DueMonth, 1)

    '==========================================================================
    ' 5 - GEÇÝCÝ NORMAL RESMI KAYNAK OLUÞTUR
    '==========================================================================

    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    SourceChargeID = _
        Service.AddOfficialCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            SourceAmount, _
            PeriodEndDate, _
            "TEST-042", _
            ChargeDate, _
            "TEST-042 - Geçici NORMAL RESMI kaynak")

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    If Len(ErrorDescription) > 0 Then

        Err.Raise vbObjectError + 9205, _
                  "TEST_042", _
                  "Geçici NORMAL RESMI tahakkuk oluþturulamadý." & _
                  vbCrLf & ErrorDescription

    End If

    If SourceChargeID <= 0 Then

        Err.Raise vbObjectError + 9206, _
                  "TEST_042", _
                  "Geçici NORMAL RESMI tahakkuk için ChargeID oluþmadý."

    End If

    '==========================================================================
    ' 6 - NORMAL KAYNAÐI DOÐRULA
    '==========================================================================

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 9207, _
                  "TEST_042", _
                  "NORMAL kaynak Repository'den okunamadý."

    End If

    If StrComp( _
            Trim$(SourceCharge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9208, _
                  "TEST_042", _
                  "Kaynak ChargeType RESMI deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9209, _
                  "TEST_042", _
                  "Kaynak AdjustmentType NORMAL deðil."

    End If

    '==========================================================================
    ' 7 - NORMAL KAYNAKTAN ÝLK ARTIS KAYDINI OLUÞTUR
    '
    ' Bu kayýt TEST-042'nin ikinci aþamasýnda kaynak olarak kullanýlacaktýr.
    '==============================================================================

    FirstAdjustmentID = 0
    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    FirstAdjustmentID = _
        Service.AddOfficialChargeAdjustment( _
            SourceChargeID, _
            AdjustmentDate, _
            FirstAdjustmentAmount, _
            "TEST-042-ARTIS-1", _
            AdjustmentDate, _
            "TEST-042 - Ýlk ARTIS")

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    If Len(ErrorDescription) > 0 Then

        Err.Raise vbObjectError + 9210, _
                  "TEST_042", _
                  "Ýlk ARTIS kaydý oluþturulamadý." & _
                  vbCrLf & ErrorDescription

    End If

    If FirstAdjustmentID <= 0 Then

        Err.Raise vbObjectError + 9211, _
                  "TEST_042", _
                  "Ýlk ARTIS kaydý için ChargeID oluþmadý."

    End If

    '==========================================================================
    ' 8 - ÝLK ARTIS KAYDINI DOÐRULA
    '==========================================================================

    Set FirstAdjustment = Repo.GetByID(FirstAdjustmentID)

    If FirstAdjustment Is Nothing Then

        Err.Raise vbObjectError + 9212, _
                  "TEST_042", _
                  "Ýlk ARTIS Repository'den okunamadý."

    End If

    If StrComp( _
            Trim$(FirstAdjustment.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9213, _
                  "TEST_042", _
                  "Ýlk ARTIS ChargeType RESMI deðil."

    End If

    If StrComp( _
            Trim$(FirstAdjustment.AdjustmentType), _
            "ARTIS", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9214, _
                  "TEST_042", _
                  "Ýlk ARTIS AdjustmentType ARTIS deðil."

    End If

    If FirstAdjustment.SourceChargeID <> SourceChargeID Then

        Err.Raise vbObjectError + 9215, _
                  "TEST_042", _
                  "Ýlk ARTIS SourceChargeID kaynak tahakkuka baðlý deðil."

    End If

    '==========================================================================
    ' 9 - ARTIS KAYDINI TEKRAR ARTIS KAYNAÐI OLARAK KULLAN
    '
    ' Burada SourceCharge.AdjustmentType = ARTIS olacaktýr.
    '
    ' Beklenen:
    '
    '   7246
    '==============================================================================

    SecondAdjustmentID = 0
    ErrorOccurred = False
    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    SecondAdjustmentID = _
        Service.AddOfficialChargeAdjustment( _
            FirstAdjustmentID, _
            AdjustmentDate, _
            SecondAdjustmentAmount, _
            "TEST-042-ARTIS-2", _
            AdjustmentDate, _
            "TEST-042 - ARTIS üzerinden tekrar ARTIS")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 10 - SERVICE REDDÝ KONTROLÜ
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 9216, _
                  "TEST_042", _
                  "ARTIS kaynaklý ikinci ARTIS Service tarafýndan reddedilmedi."

    End If

    '==========================================================================
    ' 11 - ÝKÝNCÝ ARTIS KAYDI OLUÞMAMALI
    '==========================================================================

    If SecondAdjustmentID <> 0 Then

        Err.Raise vbObjectError + 9217, _
                  "TEST_042", _
                  "Ýkinci ARTIS için ChargeID oluþtu: " & _
                  SecondAdjustmentID

    End If

    '==========================================================================
    ' 12 - GERÇEK SERVICE HATA MESAJI
    '==========================================================================

    If InStr( _
            1, _
            ErrorDescription, _
            "Artýþ kaynaðý NORMAL bir resmi aidat tahakkuku olmalýdýr.", _
            vbTextCompare) = 0 Then

        Err.Raise vbObjectError + 9218, _
                  "TEST_042", _
                  "Beklenen 7246 hata mesajý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan mesaj:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 13 - ÝLK ARTIS KAYDININ DEÐÝÞMEDÝÐÝNÝ KONTROL ET
    '==========================================================================

    Set FirstAdjustment = Repo.GetByID(FirstAdjustmentID)

    If FirstAdjustment Is Nothing Then

        Err.Raise vbObjectError + 9219, _
                  "TEST_042", _
                  "Ýlk ARTIS kaydý beklenmedik þekilde silinmiþ."

    End If

    If StrComp( _
            Trim$(FirstAdjustment.AdjustmentType), _
            "ARTIS", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9220, _
                  "TEST_042", _
                  "Ýlk ARTIS kaydýnýn AdjustmentType deðeri deðiþmiþ."

    End If

    '==========================================================================
    ' 14 - ÝLK ARTIS CLEANUP
    '==========================================================================

    On Error Resume Next

    Err.Clear

    DeleteTestCharge FirstAdjustmentID

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 9221, _
                  "TEST_042", _
                  "Ýlk ARTIS cleanup edilemedi." & _
                  vbCrLf & ErrorDescription

    End If

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 15 - NORMAL KAYNAK CLEANUP
    '==========================================================================

    On Error Resume Next

    Err.Clear

    DeleteTestCharge SourceChargeID

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 9222, _
                  "TEST_042", _
                  "NORMAL kaynak cleanup edilemedi." & _
                  vbCrLf & ErrorDescription

    End If

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 16 - CLEANUP SONRASI KONTROL
    '==========================================================================

    If Not Repo.GetByID(FirstAdjustmentID) Is Nothing Then

        Err.Raise vbObjectError + 9223, _
                  "TEST_042", _
                  "Ýlk ARTIS cleanup sonrasýnda hâlâ mevcut."

    End If

    If Not Repo.GetByID(SourceChargeID) Is Nothing Then

        Err.Raise vbObjectError + 9224, _
                  "TEST_042", _
                  "NORMAL kaynak cleanup sonrasýnda hâlâ mevcut."

    End If

    '==========================================================================
    ' 17 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-042 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "NORMAL kaynak    : " & SourceChargeID & vbCrLf & _
        "Ýlk ARTIS        : " & FirstAdjustmentID & vbCrLf & _
        "Ýkinci ARTIS     : REDDEDÝLDÝ" & vbCrLf & vbCrLf & _
        "Kaynak tipi      : RESMI / ARTIS" & vbCrLf & _
        "Service reddi    : OK" & vbCrLf & _
        "2. ARTIS kaydý   : YOK" & vbCrLf & _
        "Ýlk ARTIS        : Deðiþmedi" & vbCrLf & _
        "Cleanup          : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BEKLENEN RET", _
        vbInformation, _
        "OAA - TEST-042"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If SecondAdjustmentID > 0 Then

        DeleteTestCharge SecondAdjustmentID

    End If

    If FirstAdjustmentID > 0 Then

        DeleteTestCharge FirstAdjustmentID

    End If

    If SourceChargeID > 0 Then

        DeleteTestCharge SourceChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-042 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description, _
        vbCritical, _
        "OAA - TEST-042"

End Sub

'==============================================================================
' TEST-043
'
' RESMI AÝDAT ARTISI - PASÝF TAHAKKUKA ARTIS REDDÝ
'
' AMAÇ:
'
'   AddOfficialChargeAdjustment metodunun Status = PASIF olan
'   kaynak tahakkuka ARTIS uygulanmasýný reddettiðini doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   SourceCharge.Status <> "AKTIF"
'       -> vbObjectError + 7247
'       -> "Pasif bir tahakkuka artýþ uygulanamaz."
'
' TEST HAZIRLIÐI:
'
'   Repository.Add kullanýlarak yalnýzca test amacýyla
'   PASIF durumlu geçici RESMI/NORMAL tahakkuk oluþturulur.
'
'   Böylece:
'
'       Service -> Repository.GetByID -> PASIF kaynak
'
'
' akýþý gerçek Service üzerinden test edilir.
'
' BEKLENEN:
'
'   1. Service 7247 ile reddetmelidir.
'   2. ARTIS ChargeID oluþmamalýdýr.
'   3. Geçici PASIF kaynak cleanup edilmelidir.
'
' GERÇEK KULLANICI VERÝSÝ:
'
'   KULLANILMAZ.
'==============================================================================

Public Sub TEST_043()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim TestCharge As clsMemberCharge
    Dim SourceCharge As clsMemberCharge

    Dim TestMemberID As Long

    Dim SourceChargeID As Long
    Dim AdjustmentChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim AdjustmentDate As Date

    Dim Amount As Currency
    Dim AdjustmentAmount As Currency

    Dim ErrorOccurred As Boolean
    Dim ErrorDescription As String

    Dim PeriodFound As Boolean

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    SourceChargeID = 0
    AdjustmentChargeID = 0

    '==========================================================================
    ' 2 - TEST PARAMETRELERÝ
    '==========================================================================

    FiscalYear = 2098

    Amount = 500@
    AdjustmentAmount = 100@

    ChargeDate = DateSerial(FiscalYear, 1, 1)
    AdjustmentDate = DateSerial(FiscalYear, 2, 1)

    '==========================================================================
    ' 3 - AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 9301, _
                  "TEST_043", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 9302, _
                  "TEST_043", _
                  "Test için üye bulunamadý."

    End If

    TestMemberID = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID

                Exit For

            End If

        End If

    Next Member

    If TestMemberID <= 0 Then

        Err.Raise vbObjectError + 9303, _
                  "TEST_043", _
                  "Test için aktif üye bulunamadý."

    End If

    '==========================================================================
    ' 4 - KULLANILMAMIÞ RESMI DÖNEM BUL
    '==========================================================================

    PeriodFound = False

    For DueMonth = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                DueMonth, _
                "RESMI") Then

            PeriodFound = True

            Exit For

        End If

    Next DueMonth

    If Not PeriodFound Then

        Err.Raise vbObjectError + 9304, _
                  "TEST_043", _
                  "TEST için kullanýlmamýþ RESMI dönem bulunamadý."

    End If

    ChargeDate = DateSerial(FiscalYear, DueMonth, 1)

    '==========================================================================
    ' 5 - PASÝF TEST KAYNAÐINI ENTITY OLARAK HAZIRLA
    '
    ' Repository'de Status güncelleme metodu bulunmadýðý için,
    ' test fixture doðrudan Repository.Add ile oluþturuluyor.
    '
    ' Bu kayýt:
    '
    '   ChargeType      = RESMI
    '   AdjustmentType  = NORMAL
    '   Status          = PASIF
    '
    ' olacaktýr.
    '==========================================================================

    Set TestCharge = New clsMemberCharge

    TestCharge.MemberID = TestMemberID
    TestCharge.ChargeType = "RESMI"
    TestCharge.ChargeDate = ChargeDate
    TestCharge.FiscalYear = FiscalYear
    TestCharge.DueMonth = DueMonth
    TestCharge.Amount = Amount
    TestCharge.AdjustmentType = "NORMAL"
    TestCharge.SourceChargeID = 0
    TestCharge.Description = _
        "TEST-043 - Geçici PASIF kaynak"
    TestCharge.DecisionNo = "TEST-043"
    TestCharge.DecisionDate = ChargeDate
    TestCharge.EntryDate = Now

    ' KRÝTÝK TEST DURUMU
    TestCharge.Status = "PASIF"

    '==========================================================================
    ' 6 - TEST KAYDINI REPOSITORY'YE EKLE
    '==========================================================================

    SourceChargeID = Repo.Add(TestCharge)

    If SourceChargeID <= 0 Then

        Err.Raise vbObjectError + 9305, _
                  "TEST_043", _
                  "PASIF test kaynak tahakkuku oluþturulamadý."

    End If

    '==========================================================================
    ' 7 - KAYNAK KAYDI DOÐRULA
    '==========================================================================

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 9306, _
                  "TEST_043", _
                  "PASIF kaynak Repository'den okunamadý."

    End If

    If SourceCharge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 9307, _
                  "TEST_043", _
                  "Kaynak MemberID hatalý."

    End If

    If StrComp( _
            Trim$(SourceCharge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9308, _
                  "TEST_043", _
                  "Kaynak ChargeType RESMI deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9309, _
                  "TEST_043", _
                  "Kaynak AdjustmentType NORMAL deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.Status), _
            "PASIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9310, _
                  "TEST_043", _
                  "Kaynak Status PASIF olarak oluþturulmadý."

    End If

    '==========================================================================
    ' 8 - PASÝF KAYNAK ÝLE ARTIS DENEMESÝ
    '==========================================================================

    AdjustmentChargeID = 0
    ErrorOccurred = False
    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    AdjustmentChargeID = _
        Service.AddOfficialChargeAdjustment( _
            SourceChargeID, _
            AdjustmentDate, _
            AdjustmentAmount, _
            "TEST-043", _
            AdjustmentDate, _
            "TEST-043 - Pasif tahakkuka ARTIS")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 9 - SERVICE REDDÝ KONTROLÜ
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 9311, _
                  "TEST_043", _
                  "PASIF kaynak tahakkuk Service tarafýndan reddedilmedi."

    End If

    '==========================================================================
    ' 10 - ARTIS KAYDI OLUÞMAMALI
    '==========================================================================

    If AdjustmentChargeID <> 0 Then

        Err.Raise vbObjectError + 9312, _
                  "TEST_043", _
                  "PASIF kaynakla ARTIS ChargeID oluþtu: " & _
                  AdjustmentChargeID

    End If

    '==========================================================================
    ' 11 - GERÇEK SERVICE HATA MESAJI
    '==========================================================================

    If InStr( _
            1, _
            ErrorDescription, _
            "Pasif bir tahakkuka artýþ uygulanamaz.", _
            vbTextCompare) = 0 Then

        Err.Raise vbObjectError + 9313, _
                  "TEST_043", _
                  "Beklenen 7247 hata mesajý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan mesaj:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 12 - KAYNAK KAYDIN DEÐÝÞMEDÝÐÝNÝ KONTROL ET
    '==========================================================================

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 9314, _
                  "TEST_043", _
                  "Kaynak kayýt beklenmedik þekilde silindi."

    End If

    If StrComp( _
            Trim$(SourceCharge.Status), _
            "PASIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9315, _
                  "TEST_043", _
                  "Kaynak Status deðeri test sýrasýnda deðiþti."

    End If

    '==========================================================================
    ' 13 - CLEANUP
    '==========================================================================

    On Error Resume Next

    Err.Clear

    DeleteTestCharge SourceChargeID

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 9316, _
                  "TEST_043", _
                  "PASIF test kaydý cleanup edilemedi." & _
                  vbCrLf & _
                  ErrorDescription

    End If

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 14 - CLEANUP SONRASI KONTROL
    '==========================================================================

    If Not Repo.GetByID(SourceChargeID) Is Nothing Then

        Err.Raise vbObjectError + 9317, _
                  "TEST_043", _
                  "Cleanup sonrasýnda PASIF test kaydý hâlâ mevcut."

    End If

    '==========================================================================
    ' 15 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-043 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "Kaynak ChargeID  : " & SourceChargeID & vbCrLf & _
        "Kaynak tipi      : RESMI / NORMAL" & vbCrLf & _
        "Kaynak Status    : PASIF" & vbCrLf & _
        "Artýþ tutarý     : " & AdjustmentAmount & " TL" & vbCrLf & vbCrLf & _
        "Kaynak kontrolü  : OK" & vbCrLf & _
        "Service reddi    : OK" & vbCrLf & _
        "ARTIS kaydý      : YOK" & vbCrLf & _
        "Kaynak deðiþimi  : YOK" & vbCrLf & _
        "Cleanup          : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BEKLENEN RET", _
        vbInformation, _
        "OAA - TEST-043"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If AdjustmentChargeID > 0 Then

        DeleteTestCharge AdjustmentChargeID

    End If

    If SourceChargeID > 0 Then

        DeleteTestCharge SourceChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-043 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description, _
        vbCritical, _
        "OAA - TEST-043"

End Sub
'==============================================================================
' TEST-044
'
' RESMI AÝDAT ARTISI - KAYNAK TAHAKKUKUN ÜYESÝ BULUNAMADI
'
' AMAÇ:
'
'   AddOfficialChargeAdjustment metodunun SourceCharge.MemberID deðeri
'   sistemde bulunmayan bir üye olduðunda iþlemi reddettiðini doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   Member = mMemberRepository.GetByID(SourceCharge.MemberID)
'
'   Member Is Nothing
'       -> vbObjectError + 7248
'       -> "Kaynak tahakkukun üyesi bulunamadý. Üye No: ..."
'
' TEST HAZIRLIÐI:
'
'   Repository.Add ile geçici RESMI / NORMAL / AKTIF kaynak tahakkuk
'   oluþturulur.
'
'   Kaynaðýn MemberID deðeri pozitif fakat sistemde bulunmayan
'   bir MemberID'dir.
'
' BEKLENEN:
'
'   1. Service 7248 ile reddetmelidir.
'   2. ARTIS ChargeID oluþmamalýdýr.
'   3. Geçici kaynak tahakkuk cleanup edilmelidir.
'
' GERÇEK KULLANICI VERÝSÝ:
'
'   Kullanýlmaz.
'==============================================================================

Public Sub TEST_044()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim TestCharge As clsMemberCharge
    Dim SourceCharge As clsMemberCharge

    Dim ExistingMemberID As Long
    Dim NonExistingMemberID As Long

    Dim SourceChargeID As Long
    Dim AdjustmentChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim AdjustmentDate As Date

    Dim Amount As Currency
    Dim AdjustmentAmount As Currency

    Dim ErrorOccurred As Boolean
    Dim ErrorDescription As String

    Dim PeriodFound As Boolean

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    SourceChargeID = 0
    AdjustmentChargeID = 0

    '==========================================================================
    ' 2 - TEST PARAMETRELERÝ
    '==========================================================================

    FiscalYear = 2098

    Amount = 500@
    AdjustmentAmount = 100@

    ChargeDate = DateSerial(FiscalYear, 1, 1)
    AdjustmentDate = DateSerial(FiscalYear, 2, 1)

    '==========================================================================
    ' 3 - MEVCUT BÝR MEMBERID BUL
    '
    ' Amaç:
    '   Güvenli þekilde sistemde olmayan pozitif bir MemberID üretmek.
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 9401, _
                  "TEST_044", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 9402, _
                  "TEST_044", _
                  "Üye listesi boþ."

    End If

    ExistingMemberID = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If Member.MemberID > ExistingMemberID Then

                ExistingMemberID = Member.MemberID

            End If

        End If

    Next Member

    If ExistingMemberID <= 0 Then

        Err.Raise vbObjectError + 9403, _
                  "TEST_044", _
                  "Geçerli MemberID bulunamadý."

    End If

    '--------------------------------------------------------------------------
    ' Pozitif fakat mevcut olmayan MemberID
    '--------------------------------------------------------------------------

    NonExistingMemberID = ExistingMemberID + 1000

    '==========================================================================
    ' 4 - MEMBERID'NÝN GERÇEKTEN OLMADIÐINI DOÐRULA
    '==========================================================================

    Set Member = MemberRepo.GetByID(NonExistingMemberID)

    If Not Member Is Nothing Then

        Err.Raise vbObjectError + 9404, _
                  "TEST_044", _
                  "Test için seçilen MemberID sistemde mevcut." & _
                  vbCrLf & _
                  "MemberID: " & NonExistingMemberID

    End If

    '==========================================================================
    ' 5 - KULLANILMAMIÞ RESMI DÖNEM BUL
    '
    ' Burada sadece dönem çakýþmasýný önlemek için mevcut üyelerin
    ' birinden kullanýlmamýþ dönem aranýr.
    ' Kaynak kaydýn MemberID'si ise bilerek geçersiz olacaktýr.
    '==========================================================================

    PeriodFound = False

    For DueMonth = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                ExistingMemberID, _
                FiscalYear, _
                DueMonth, _
                "RESMI") Then

            PeriodFound = True

            Exit For

        End If

    Next DueMonth

    If Not PeriodFound Then

        Err.Raise vbObjectError + 9405, _
                  "TEST_044", _
                  "TEST için kullanýlmamýþ RESMI dönem bulunamadý."

    End If

    ChargeDate = DateSerial(FiscalYear, DueMonth, 1)

    '==========================================================================
    ' 6 - GEÇERSÝZ MEMBERID'LÝ KAYNAK TAHAKKUK HAZIRLA
    '
    ' ÖNEMLÝ:
    '
    '   ChargeType     = RESMI
    '   AdjustmentType = NORMAL
    '   Status         = AKTIF
    '
    ' Böylece Service'in 7245, 7246 ve 7247 kontrolleri geçilir.
    '
    ' Daha sonra 7248:
    '
    '   Kaynak tahakkukun üyesi bulunamadý.
    '
    ' kontrolüne ulaþýlmasý beklenir.
    '==========================================================================

    Set TestCharge = New clsMemberCharge

    TestCharge.MemberID = NonExistingMemberID
    TestCharge.ChargeType = "RESMI"
    TestCharge.ChargeDate = ChargeDate
    TestCharge.FiscalYear = FiscalYear
    TestCharge.DueMonth = DueMonth
    TestCharge.Amount = Amount
    TestCharge.AdjustmentType = "NORMAL"
    TestCharge.SourceChargeID = 0
    TestCharge.Description = _
        "TEST-044 - Geçersiz üye kaynak tahakkuku"
    TestCharge.DecisionNo = "TEST-044"
    TestCharge.DecisionDate = ChargeDate
    TestCharge.EntryDate = Now
    TestCharge.Status = "AKTIF"

    '==========================================================================
    ' 7 - TEST KAYDINI REPOSITORY'YE EKLE
    '==========================================================================

    SourceChargeID = Repo.Add(TestCharge)

    If SourceChargeID <= 0 Then

        Err.Raise vbObjectError + 9406, _
                  "TEST_044", _
                  "Geçersiz MemberID'li kaynak tahakkuk oluþturulamadý."

    End If

    '==========================================================================
    ' 8 - KAYNAK KAYDI DOÐRULA
    '==========================================================================

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 9407, _
                  "TEST_044", _
                  "Kaynak tahakkuk Repository'den okunamadý."

    End If

    If SourceCharge.MemberID <> NonExistingMemberID Then

        Err.Raise vbObjectError + 9408, _
                  "TEST_044", _
                  "Kaynak MemberID beklenen geçersiz MemberID deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9409, _
                  "TEST_044", _
                  "Kaynak ChargeType RESMI deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9410, _
                  "TEST_044", _
                  "Kaynak AdjustmentType NORMAL deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9411, _
                  "TEST_044", _
                  "Kaynak Status AKTIF deðil."

    End If

    '==========================================================================
    ' 9 - GEÇERSÝZ ÜYE KAYNAÐI ÝLE ARTIS DENEMESÝ
    '==========================================================================

    AdjustmentChargeID = 0
    ErrorOccurred = False
    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    AdjustmentChargeID = _
        Service.AddOfficialChargeAdjustment( _
            SourceChargeID, _
            AdjustmentDate, _
            AdjustmentAmount, _
            "TEST-044", _
            AdjustmentDate, _
            "TEST-044 - Üyesi bulunamayan kaynak")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 10 - SERVICE REDDÝ KONTROLÜ
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 9412, _
                  "TEST_044", _
                  "Üyesi bulunamayan kaynak tahakkuk Service tarafýndan " & _
                  "reddedilmedi."

    End If

    '==========================================================================
    ' 11 - ARTIS KAYDI OLUÞMAMALI
    '==========================================================================

    If AdjustmentChargeID <> 0 Then

        Err.Raise vbObjectError + 9413, _
                  "TEST_044", _
                  "Üyesi bulunamayan kaynakla ARTIS ChargeID oluþtu: " & _
                  AdjustmentChargeID

    End If

    '==========================================================================
    ' 12 - GERÇEK SERVICE HATA MESAJI
    '==========================================================================

    If InStr( _
            1, _
            ErrorDescription, _
            "Kaynak tahakkukun üyesi bulunamadý.", _
            vbTextCompare) = 0 Then

        Err.Raise vbObjectError + 9414, _
                  "TEST_044", _
                  "Beklenen 7248 hata mesajý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan mesaj:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 13 - HATA MESAJINDA MEMBERID KONTROLÜ
    '==========================================================================

    If InStr( _
            1, _
            ErrorDescription, _
            CStr(NonExistingMemberID), _
            vbTextCompare) = 0 Then

        Err.Raise vbObjectError + 9415, _
                  "TEST_044", _
                  "Hata mesajýnda beklenen MemberID bulunamadý." & _
                  vbCrLf & _
                  "Beklenen MemberID: " & NonExistingMemberID & _
                  vbCrLf & _
                  "Alýnan mesaj:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 14 - KAYNAK KAYDIN DEÐÝÞMEDÝÐÝNÝ KONTROL ET
    '==========================================================================

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 9416, _
                  "TEST_044", _
                  "Kaynak tahakkuk beklenmedik þekilde silindi."

    End If

    If SourceCharge.MemberID <> NonExistingMemberID Then

        Err.Raise vbObjectError + 9417, _
                  "TEST_044", _
                  "Kaynak MemberID test sýrasýnda deðiþti."

    End If

    '==========================================================================
    ' 15 - CLEANUP
    '==========================================================================

    On Error Resume Next

    Err.Clear

    DeleteTestCharge SourceChargeID

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 9418, _
                  "TEST_044", _
                  "Geçici kaynak tahakkuk cleanup edilemedi." & _
                  vbCrLf & _
                  ErrorDescription

    End If

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 16 - CLEANUP SONRASI KONTROL
    '==========================================================================

    If Not Repo.GetByID(SourceChargeID) Is Nothing Then

        Err.Raise vbObjectError + 9419, _
                  "TEST_044", _
                  "Cleanup sonrasýnda kaynak tahakkuk hâlâ mevcut."

    End If

    '==========================================================================
    ' 17 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-044 BAÞARILI." & vbCrLf & vbCrLf & _
        "Olmayan MemberID : " & NonExistingMemberID & vbCrLf & _
        "Kaynak ChargeID  : " & SourceChargeID & vbCrLf & _
        "Kaynak tipi      : RESMI / NORMAL / AKTIF" & vbCrLf & _
        "Artýþ tutarý      : " & AdjustmentAmount & " TL" & vbCrLf & vbCrLf & _
        "Kaynak kontrolü   : OK" & vbCrLf & _
        "Üye bulunamadý    : OK" & vbCrLf & _
        "Service reddi     : OK" & vbCrLf & _
        "ARTIS kaydý       : YOK" & vbCrLf & _
        "Kaynak deðiþimi   : YOK" & vbCrLf & _
        "Cleanup           : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BEKLENEN RET", _
        vbInformation, _
        "OAA - TEST-044"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If AdjustmentChargeID > 0 Then

        DeleteTestCharge AdjustmentChargeID

    End If

    If SourceChargeID > 0 Then

        DeleteTestCharge SourceChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-044 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Service mesajý:" & vbCrLf & _
        ErrorDescription, _
        vbCritical, _
        "OAA - TEST-044"

End Sub
'==============================================================================
' TEST-045
'
' RESMI AÝDAT ARTISI - ÝSTÝFA TARÝHÝNDEN SONRA ARTIS REDDÝ
'
' AMAÇ:
'
'   Ýstifa etmiþ bir üyenin, istifa tarihinden sonraki bir tarihte
'   RESMI aidat ARTIS iþlemi alamadýðýný doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   CanReceiveOfficialCharge(Member, AdjustmentDate, PeriodEndDate)
'
'   ÝSTÝFA üyesi için:
'
'       AdjustmentDate <= LeaveDate
'           -> uygun
'
'       AdjustmentDate > LeaveDate
'           -> uygun deðil
'
'   Sonuç:
'
'       vbObjectError + 7249
'       "Üye bu tarihte resmi aidat artýþýna uygun deðildir."
'
' TEST KAYDI:
'
'   Mevcut ÝSTÝFA üye kullanýlacaktýr.
'   Üye kaydý DEÐÝÞTÝRÝLMEYECEKTÝR.
'
'   Yalnýzca geçici:
'
'       RESMI / NORMAL / AKTIF
'
'   kaynak tahakkuk Repository.Add ile oluþturulacaktýr.
'
' BEKLENEN:
'
'   1. Kaynak tahakkuk bulunmalýdýr.
'   2. Kaynak üye ÝSTÝFA durumunda olmalýdýr.
'   3. AdjustmentDate > LeaveDate olmalýdýr.
'   4. Service 7249 ile reddetmelidir.
'   5. ARTIS ChargeID oluþmamalýdýr.
'   6. Üye kaydý deðiþmemelidir.
'   7. Geçici kaynak tahakkuk cleanup edilmelidir.
'==============================================================================

Public Sub TEST_045()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim TestCharge As clsMemberCharge
    Dim SourceCharge As clsMemberCharge
    Dim TestMember As clsMember

    Dim TestMemberID As Long

    Dim SourceChargeID As Long
    Dim AdjustmentChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim AdjustmentDate As Date

    Dim Amount As Currency
    Dim AdjustmentAmount As Currency

    Dim PeriodEndDate As Date

    Dim ErrorOccurred As Boolean
    Dim ErrorDescription As String

    Dim OriginalStatus As String
    Dim OriginalLeaveDate As Date

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    SourceChargeID = 0
    AdjustmentChargeID = 0

    '==========================================================================
    ' 2 - ÝSTÝFA ETMÝÞ ÜYE BUL
    '
    ' Gerçek kullanýcý üyesinin Status ve LeaveDate alanlarý DEÐÝÞTÝRÝLMEZ.
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 9501, _
                  "TEST_045", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 9502, _
                  "TEST_045", _
                  "Üye listesi boþ."

    End If

    TestMemberID = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Ýstifa", _
                    vbTextCompare) = 0 Then

                If Member.LeaveDate > 0 Then

                    TestMemberID = Member.MemberID

                    Exit For

                End If

            End If

        End If

    Next Member

    If TestMemberID <= 0 Then

        Err.Raise vbObjectError + 9503, _
                  "TEST_045", _
                  "LeaveDate bilgisi bulunan ÝSTÝFA üye bulunamadý."

    End If

    '==========================================================================
    ' 3 - ÜYEYÝ TEKRAR OKU VE ORÝJÝNAL DURUMUNU SAKLA
    '==========================================================================

    Set TestMember = MemberRepo.GetByID(TestMemberID)

    If TestMember Is Nothing Then

        Err.Raise vbObjectError + 9504, _
                  "TEST_045", _
                  "Test üyesi Repository'den okunamadý."

    End If

    OriginalStatus = TestMember.Status
    OriginalLeaveDate = TestMember.LeaveDate

    If StrComp( _
            Trim$(OriginalStatus), _
            "Ýstifa", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9505, _
                  "TEST_045", _
                  "Test üyesinin Status deðeri Ýstifa deðil."

    End If

    If OriginalLeaveDate <= 0 Then

        Err.Raise vbObjectError + 9506, _
                  "TEST_045", _
                  "Test üyesinin LeaveDate deðeri geçersiz."

    End If

    '==========================================================================
    ' 4 - TEST DÖNEMÝ
    '
    ' Kaynak tahakkuk, istifa yýlýndaki bir RESMI/NORMAL kayýt olarak
    ' oluþturulacaktýr.
    '
    ' Kaynak ChargeDate:
    '   LeaveDate'den önce seçilir.
    '
    ' ARTIS tarihi:
    '   LeaveDate + 1 gün
    '
    ' Böylece yalnýzca 7249 kontrolü tetiklenir.
    '==========================================================================

    FiscalYear = Year(OriginalLeaveDate)

    If FiscalYear <= 0 Then

        Err.Raise vbObjectError + 9507, _
                  "TEST_045", _
                  "Ýstifa tarihinden mali yýl alýnamadý."

    End If

    PeriodEndDate = DateSerial(FiscalYear, 12, 31)

    ' Kaynak ay olarak Ocak kullanýlýr.
    DueMonth = 1

    ChargeDate = DateSerial(FiscalYear, 1, 1)

    ' Eðer istifa tarihi yýlýn ilk gününden önceyse kaynak tarih uygun
    ' olmayacaktýr. Bu durumda mevcut baþka bir ay seçilir.
    If ChargeDate > OriginalLeaveDate Then

        DueMonth = Month(OriginalLeaveDate)

        If DueMonth < 1 Or DueMonth > 12 Then

            Err.Raise vbObjectError + 9508, _
                      "TEST_045", _
                      "Ýstifa tarihinden geçerli kaynak ay oluþturulamadý."

        End If

        ChargeDate = OriginalLeaveDate

    End If

    ' Kritik deðer:
    ' Ýstifa tarihinden SONRA.
    AdjustmentDate = DateAdd("d", 1, OriginalLeaveDate)

    Amount = 500@
    AdjustmentAmount = 100@

    '==========================================================================
    ' 5 - GEÇÝCÝ RESMI / NORMAL / AKTIF KAYNAK HAZIRLA
    '
    ' Repository.Add doðrudan kullanýlýyor.
    ' Çünkü test kaydýnýn amacý Service'in 7249 kontrolüne ulaþmasýný
    ' saðlamaktýr.
    '==========================================================================

    Set TestCharge = New clsMemberCharge

    TestCharge.MemberID = TestMemberID
    TestCharge.ChargeType = "RESMI"
    TestCharge.ChargeDate = ChargeDate
    TestCharge.FiscalYear = FiscalYear
    TestCharge.DueMonth = DueMonth
    TestCharge.Amount = Amount
    TestCharge.AdjustmentType = "NORMAL"
    TestCharge.SourceChargeID = 0
    TestCharge.Description = _
        "TEST-045 - Geçici istifa sonrasý ARTIS kaynaðý"
    TestCharge.DecisionNo = "TEST-045"
    TestCharge.DecisionDate = ChargeDate
    TestCharge.EntryDate = Now
    TestCharge.Status = "AKTIF"

    '==========================================================================
    ' 6 - KAYNAK KAYDI OLUÞTUR
    '==========================================================================

    SourceChargeID = Repo.Add(TestCharge)

    If SourceChargeID <= 0 Then

        Err.Raise vbObjectError + 9509, _
                  "TEST_045", _
                  "Geçici kaynak tahakkuk oluþturulamadý."

    End If

    '==========================================================================
    ' 7 - KAYNAK KAYDI DOÐRULA
    '==========================================================================

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 9510, _
                  "TEST_045", _
                  "Kaynak tahakkuk Repository'den okunamadý."

    End If

    If SourceCharge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 9511, _
                  "TEST_045", _
                  "Kaynak MemberID hatalý."

    End If

    If StrComp( _
            Trim$(SourceCharge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9512, _
                  "TEST_045", _
                  "Kaynak ChargeType RESMI deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9513, _
                  "TEST_045", _
                  "Kaynak AdjustmentType NORMAL deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9514, _
                  "TEST_045", _
                  "Kaynak Status AKTIF deðil."

    End If

    '==========================================================================
    ' 8 - TARÝH SINIRI DOÐRULA
    '==========================================================================

    If AdjustmentDate <= OriginalLeaveDate Then

        Err.Raise vbObjectError + 9515, _
                  "TEST_045", _
                  "Test tarihi istifa tarihinden sonra deðil."

    End If

    '==========================================================================
    ' 9 - ARTIS DENEMESÝ
    '==========================================================================

    AdjustmentChargeID = 0
    ErrorOccurred = False
    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    AdjustmentChargeID = _
        Service.AddOfficialChargeAdjustment( _
            SourceChargeID, _
            AdjustmentDate, _
            AdjustmentAmount, _
            "TEST-045", _
            AdjustmentDate, _
            "TEST-045 - Ýstifa sonrasý ARTIS")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 10 - SERVICE REDDÝ KONTROLÜ
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 9516, _
                  "TEST_045", _
                  "Ýstifa tarihinden sonraki ARTIS Service tarafýndan " & _
                  "reddedilmedi."

    End If

    '==========================================================================
    ' 11 - ARTIS KAYDI OLUÞMAMALI
    '==========================================================================

    If AdjustmentChargeID <> 0 Then

        Err.Raise vbObjectError + 9517, _
                  "TEST_045", _
                  "Ýstifa sonrasý ARTIS için ChargeID oluþtu: " & _
                  AdjustmentChargeID

    End If

    '==========================================================================
    ' 12 - 7249 MESAJI KONTROLÜ
    '==========================================================================

    If InStr( _
            1, _
            ErrorDescription, _
            "Üye bu tarihte resmi aidat artýþýna uygun deðildir.", _
            vbTextCompare) = 0 Then

        Err.Raise vbObjectError + 9518, _
                  "TEST_045", _
                  "Beklenen 7249 hata mesajý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan mesaj:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 13 - ÜYE KAYDININ DEÐÝÞMEDÝÐÝNÝ KONTROL ET
    '==========================================================================

    Set TestMember = MemberRepo.GetByID(TestMemberID)

    If TestMember Is Nothing Then

        Err.Raise vbObjectError + 9519, _
                  "TEST_045", _
                  "Test üyesi iþlem sonrasýnda okunamadý."

    End If

    If StrComp( _
            Trim$(TestMember.Status), _
            Trim$(OriginalStatus), _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9520, _
                  "TEST_045", _
                  "Üyenin Status deðeri test sýrasýnda deðiþti."

    End If

    If TestMember.LeaveDate <> OriginalLeaveDate Then

        Err.Raise vbObjectError + 9521, _
                  "TEST_045", _
                  "Üyenin LeaveDate deðeri test sýrasýnda deðiþti."

    End If

    '==========================================================================
    ' 14 - KAYNAK KAYDIN DEÐÝÞMEDÝÐÝNÝ KONTROL ET
    '==========================================================================

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 9522, _
                  "TEST_045", _
                  "Kaynak tahakkuk beklenmedik þekilde silindi."

    End If

    If SourceCharge.Amount <> Amount Then

        Err.Raise vbObjectError + 9523, _
                  "TEST_045", _
                  "Kaynak tahakkuk tutarý deðiþti."

    End If

    If StrComp( _
            Trim$(SourceCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9524, _
                  "TEST_045", _
                  "Kaynak tahakkukun Status deðeri deðiþti."

    End If

    '==========================================================================
    ' 15 - CLEANUP
    '==========================================================================

    On Error Resume Next

    Err.Clear

    DeleteTestCharge SourceChargeID

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 9525, _
                  "TEST_045", _
                  "Geçici kaynak tahakkuk cleanup edilemedi." & _
                  vbCrLf & _
                  ErrorDescription

    End If

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 16 - CLEANUP SONRASI KONTROL
    '==========================================================================

    If Not Repo.GetByID(SourceChargeID) Is Nothing Then

        Err.Raise vbObjectError + 9526, _
                  "TEST_045", _
                  "Cleanup sonrasýnda kaynak tahakkuk hâlâ mevcut."

    End If

    '==========================================================================
    ' 17 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-045 BAÞARILI." & vbCrLf & vbCrLf & _
        "Ýstifa üyesi    : " & TestMemberID & vbCrLf & _
        "Ýstifa tarihi   : " & _
            Format$(OriginalLeaveDate, "dd.mm.yyyy") & vbCrLf & _
        "ARTIS tarihi    : " & _
            Format$(AdjustmentDate, "dd.mm.yyyy") & vbCrLf & _
        "Kaynak ChargeID : " & SourceChargeID & vbCrLf & _
        "Kaynak tipi     : RESMI / NORMAL / AKTIF" & vbCrLf & vbCrLf & _
        "7249 kontrolü   : OK" & vbCrLf & _
        "ARTIS kaydý     : YOK" & vbCrLf & _
        "Üye deðiþimi    : YOK" & vbCrLf & _
        "Kaynak deðiþimi : YOK" & vbCrLf & _
        "Cleanup         : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BEKLENEN RET", _
        vbInformation, _
        "OAA - TEST-045"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If AdjustmentChargeID > 0 Then

        DeleteTestCharge AdjustmentChargeID

    End If

    If SourceChargeID > 0 Then

        DeleteTestCharge SourceChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-045 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description, _
        vbCritical, _
        "OAA - TEST-045"

End Sub
'==============================================================================
' TEST-046
'
' RESMI AÝDAT ARTISI - BAÞARILI OLUÞTURMA
'
' AMAÇ:
'
'   AddOfficialChargeAdjustment metodunun tüm geçerli koþullar saðlandýðýnda
'   doðru bir ARTIS kaydý oluþturduðunu doðrulamak.
'
' BU TESTÝN ÖZELLÝÐÝ:
'
'   TEST-037 -> TEST-045 arasýnda ARTIS iþleminin reddedilme kurallarý
'   test edilmiþtir.
'
'   TEST-046 ise artýk BAÞARILI ARTIS oluþturma yolunu test eder.
'
' BEKLENEN ARTIS KAYDI:
'
'   ChargeType      = RESMI
'   AdjustmentType  = ARTIS
'   Status          = AKTIF
'   SourceChargeID  = kaynak NORMAL RESMI ChargeID
'   MemberID        = kaynak üyenin MemberID
'   FiscalYear      = kaynak tahakkukun mali yýlý
'   DueMonth        = kaynak tahakkukun ayý
'   Amount          = verilen artýþ tutarý
'   ChargeDate      = verilen artýþ tarihi
'
' ÖNEMLÝ:
'
'   Orijinal NORMAL kaynak tahakkuk deðiþtirilmemelidir.
'
' CLEANUP:
'
'   ARTIS ve geçici NORMAL kaynak tahakkuklarý temizlenir.
'==============================================================================

Public Sub TEST_046()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim SourceCharge As clsMemberCharge
    Dim AdjustmentCharge As clsMemberCharge
    Dim TestCharge As clsMemberCharge

    Dim TestMemberID As Long

    Dim SourceChargeID As Long
    Dim AdjustmentChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim AdjustmentDate As Date

    Dim SourceAmount As Currency
    Dim AdjustmentAmount As Currency

    Dim PeriodEndDate As Date

    Dim ErrorDescription As String

    Dim PeriodFound As Boolean

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    SourceChargeID = 0
    AdjustmentChargeID = 0

    '==========================================================================
    ' 2 - TEST PARAMETRELERÝ
    '==========================================================================

    FiscalYear = 2098

    SourceAmount = 500@
    AdjustmentAmount = 200@

    '==========================================================================
    ' 3 - AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 9601, _
                  "TEST_046", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 9602, _
                  "TEST_046", _
                  "Test için üye bulunamadý."

    End If

    TestMemberID = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID

                Exit For

            End If

        End If

    Next Member

    If TestMemberID <= 0 Then

        Err.Raise vbObjectError + 9603, _
                  "TEST_046", _
                  "Test için aktif üye bulunamadý."

    End If

    '==========================================================================
    ' 4 - KULLANILMAMIÞ RESMI DÖNEM BUL
    '==========================================================================

    PeriodFound = False

    For DueMonth = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                DueMonth, _
                "RESMI") Then

            PeriodFound = True

            Exit For

        End If

    Next DueMonth

    If Not PeriodFound Then

        Err.Raise vbObjectError + 9604, _
                  "TEST_046", _
                  "TEST için kullanýlmamýþ RESMI dönem bulunamadý."

    End If

    ChargeDate = DateSerial(FiscalYear, DueMonth, 1)

    PeriodEndDate = DateSerial(FiscalYear, 12, 31)

    ' ARTIS tarihi kaynak tahakkuk tarihinden sonra.
    AdjustmentDate = DateAdd("d", 1, ChargeDate)

    '==========================================================================
    ' 5 - GEÇÝCÝ NORMAL RESMI KAYNAK OLUÞTUR
    '==========================================================================

    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    SourceChargeID = _
        Service.AddOfficialCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            SourceAmount, _
            PeriodEndDate, _
            "TEST-046", _
            ChargeDate, _
            "TEST-046 - Geçici NORMAL kaynak")

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    If Len(ErrorDescription) > 0 Then

        Err.Raise vbObjectError + 9605, _
                  "TEST_046", _
                  "Geçici NORMAL RESMI kaynak oluþturulamadý." & _
                  vbCrLf & _
                  ErrorDescription

    End If

    If SourceChargeID <= 0 Then

        Err.Raise vbObjectError + 9606, _
                  "TEST_046", _
                  "Kaynak ChargeID oluþmadý."

    End If

    '==========================================================================
    ' 6 - KAYNAK KAYDI DOÐRULA
    '==========================================================================

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 9607, _
                  "TEST_046", _
                  "Kaynak tahakkuk Repository'den okunamadý."

    End If

    If SourceCharge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 9608, _
                  "TEST_046", _
                  "Kaynak MemberID hatalý."

    End If

    If StrComp( _
            Trim$(SourceCharge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9609, _
                  "TEST_046", _
                  "Kaynak ChargeType RESMI deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9610, _
                  "TEST_046", _
                  "Kaynak AdjustmentType NORMAL deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9611, _
                  "TEST_046", _
                  "Kaynak Status AKTIF deðil."

    End If

    '==========================================================================
    ' 7 - BAÞARILI ARTIS OLUÞTUR
    '==========================================================================

    AdjustmentChargeID = 0
    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    AdjustmentChargeID = _
        Service.AddOfficialChargeAdjustment( _
            SourceChargeID, _
            AdjustmentDate, _
            AdjustmentAmount, _
            "TEST-046-ARTIS", _
            AdjustmentDate, _
            "TEST-046 - Baþarýlý ARTIS")

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    If Len(ErrorDescription) > 0 Then

        Err.Raise vbObjectError + 9612, _
                  "TEST_046", _
                  "Geçerli ARTIS iþlemi reddedildi." & _
                  vbCrLf & _
                  ErrorDescription

    End If

    If AdjustmentChargeID <= 0 Then

        Err.Raise vbObjectError + 9613, _
                  "TEST_046", _
                  "Baþarýlý ARTIS iþleminde ChargeID oluþmadý."

    End If

    '==========================================================================
    ' 8 - ARTIS KAYDINI REPOSITORY'DEN OKU
    '==========================================================================

    Set AdjustmentCharge = Repo.GetByID(AdjustmentChargeID)

    If AdjustmentCharge Is Nothing Then

        Err.Raise vbObjectError + 9614, _
                  "TEST_046", _
                  "ARTIS kaydý Repository'den okunamadý."

    End If

    '==========================================================================
    ' 9 - MEMBERID
    '==========================================================================

    If AdjustmentCharge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 9615, _
                  "TEST_046", _
                  "ARTIS MemberID deðeri hatalý."

    End If

    '==========================================================================
    ' 10 - CHARGETYPE
    '==========================================================================

    If StrComp( _
            Trim$(AdjustmentCharge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9616, _
                  "TEST_046", _
                  "ARTIS ChargeType RESMI deðil."

    End If

    '==========================================================================
    ' 11 - ADJUSTMENTTYPE
    '==========================================================================

    If StrComp( _
            Trim$(AdjustmentCharge.AdjustmentType), _
            "ARTIS", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9617, _
                  "TEST_046", _
                  "AdjustmentType ARTIS deðil."

    End If

    '==========================================================================
    ' 12 - SOURCECHARGEID
    '==========================================================================

    If AdjustmentCharge.SourceChargeID <> SourceChargeID Then

        Err.Raise vbObjectError + 9618, _
                  "TEST_046", _
                  "ARTIS SourceChargeID kaynak tahakkuka baðlý deðil."

    End If

    '==========================================================================
    ' 13 - FISCALYEAR
    '==========================================================================

    If AdjustmentCharge.FiscalYear <> FiscalYear Then

        Err.Raise vbObjectError + 9619, _
                  "TEST_046", _
                  "ARTIS FiscalYear deðeri hatalý."

    End If

    '==========================================================================
    ' 14 - DUEMONTH
    '==========================================================================

    If AdjustmentCharge.DueMonth <> DueMonth Then

        Err.Raise vbObjectError + 9620, _
                  "TEST_046", _
                  "ARTIS DueMonth deðeri hatalý."

    End If

    '==========================================================================
    ' 15 - AMOUNT
    '==========================================================================

    If AdjustmentCharge.Amount <> AdjustmentAmount Then

        Err.Raise vbObjectError + 9621, _
                  "TEST_046", _
                  "ARTIS Amount deðeri hatalý."

    End If

    '==========================================================================
    ' 16 - CHARGEDATE
    '==========================================================================

    If AdjustmentCharge.ChargeDate <> AdjustmentDate Then

        Err.Raise vbObjectError + 9622, _
                  "TEST_046", _
                  "ARTIS ChargeDate deðeri hatalý."

    End If

    '==========================================================================
    ' 17 - STATUS
    '==========================================================================

    If StrComp( _
            Trim$(AdjustmentCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9623, _
                  "TEST_046", _
                  "ARTIS Status AKTIF deðil."

    End If

    '==========================================================================
    ' 18 - KAYNAK KAYDIN DEÐÝÞMEDÝÐÝNÝ KONTROL ET
    '
    ' ÖNEMLÝ:
    '
    ' AddOfficialChargeAdjustment kaynak NORMAL kaydý deðiþtirmemelidir.
    '==========================================================================

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 9624, _
                  "TEST_046", _
                  "Kaynak NORMAL tahakkuk beklenmedik þekilde silindi."

    End If

    If SourceCharge.Amount <> SourceAmount Then

        Err.Raise vbObjectError + 9625, _
                  "TEST_046", _
                  "Kaynak NORMAL tahakkukun tutarý deðiþti."

    End If

    If StrComp( _
            Trim$(SourceCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9626, _
                  "TEST_046", _
                  "Kaynak tahakkukun AdjustmentType deðeri deðiþti."

    End If

    If SourceCharge.SourceChargeID <> 0 Then

        Err.Raise vbObjectError + 9627, _
                  "TEST_046", _
                  "Kaynak tahakkukun SourceChargeID deðeri deðiþti."

    End If

    '==========================================================================
    ' 19 - CLEANUP: ARTIS
    '==========================================================================

    On Error Resume Next

    Err.Clear

    DeleteTestCharge AdjustmentChargeID

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 9628, _
                  "TEST_046", _
                  "ARTIS cleanup edilemedi." & _
                  vbCrLf & _
                  ErrorDescription

    End If

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 20 - CLEANUP: NORMAL KAYNAK
    '==========================================================================

    On Error Resume Next

    Err.Clear

    DeleteTestCharge SourceChargeID

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 9629, _
                  "TEST_046", _
                  "NORMAL kaynak cleanup edilemedi." & _
                  vbCrLf & _
                  ErrorDescription

    End If

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 21 - CLEANUP SONRASI KONTROL
    '==========================================================================

    If Not Repo.GetByID(AdjustmentChargeID) Is Nothing Then

        Err.Raise vbObjectError + 9630, _
                  "TEST_046", _
                  "ARTIS cleanup sonrasýnda kayýt hâlâ mevcut."

    End If

    If Not Repo.GetByID(SourceChargeID) Is Nothing Then

        Err.Raise vbObjectError + 9631, _
                  "TEST_046", _
                  "NORMAL kaynak cleanup sonrasýnda kayýt hâlâ mevcut."

    End If

    '==========================================================================
    ' 22 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-046 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "Kaynak ChargeID  : " & SourceChargeID & vbCrLf & _
        "ARTIS ChargeID   : " & AdjustmentChargeID & vbCrLf & _
        "Kaynak tutar     : " & SourceAmount & " TL" & vbCrLf & _
        "ARTIS tutarý     : " & AdjustmentAmount & " TL" & vbCrLf & _
        "ARTIS tarihi     : " & _
            Format$(AdjustmentDate, "dd.mm.yyyy") & vbCrLf & vbCrLf & _
        "ChargeType       : RESMI" & vbCrLf & _
        "AdjustmentType   : ARTIS" & vbCrLf & _
        "SourceChargeID   : DOÐRU" & vbCrLf & _
        "MemberID         : DOÐRU" & vbCrLf & _
        "FiscalYear       : DOÐRU" & vbCrLf & _
        "DueMonth         : DOÐRU" & vbCrLf & _
        "Amount           : DOÐRU" & vbCrLf & _
        "Status           : AKTIF" & vbCrLf & _
        "Kaynak deðiþimi  : YOK" & vbCrLf & _
        "Cleanup          : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-046"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If AdjustmentChargeID > 0 Then

        DeleteTestCharge AdjustmentChargeID

    End If

    If SourceChargeID > 0 Then

        DeleteTestCharge SourceChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-046 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Service mesajý:" & vbCrLf & _
        ErrorDescription, _
        vbCritical, _
        "OAA - TEST-046"

End Sub
'==============================================================================
' TEST-047
'
' RESMI AÝDAT ARTISI - KAYNAK BAÐLANTISI VE VERÝ BÜTÜNLÜÐÜ
'
' AMAÇ:
'
'   Baþarýlý oluþturulan ARTIS kaydýnýn doðru NORMAL RESMI kaynak
'   tahakkuka baðlandýðýný ve kaynak tahakkukun deðiþtirilmediðini
'   doðrulamak.
'
' BEKLENEN:
'
'   ARTIS:
'       ChargeType     = RESMI
'       AdjustmentType = ARTIS
'       SourceChargeID = NORMAL kaynak ChargeID
'       MemberID       = kaynak MemberID
'       DueMonth       = kaynak DueMonth
'       FiscalYear     = kaynak FiscalYear
'       Amount         = artýþ tutarý
'       Status         = AKTIF
'
'   Kaynak NORMAL kayýt:
'       Amount deðiþmemeli
'       AdjustmentType NORMAL kalmalý
'       SourceChargeID 0 kalmalý
'       Status AKTIF kalmalý
'
' CLEANUP:
'   ARTIS ve geçici NORMAL kaynak temizlenir.
'==============================================================================

Public Sub TEST_047()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim SourceCharge As clsMemberCharge
    Dim AdjustmentCharge As clsMemberCharge
    Dim TestCharge As clsMemberCharge

    Dim TestMemberID As Long

    Dim SourceChargeID As Long
    Dim AdjustmentChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim AdjustmentDate As Date
    Dim PeriodEndDate As Date

    Dim SourceAmount As Currency
    Dim AdjustmentAmount As Currency

    Dim ErrorDescription As String
    Dim PeriodFound As Boolean

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    SourceChargeID = 0
    AdjustmentChargeID = 0

    '==========================================================================
    ' 2 - TEST PARAMETRELERÝ
    '==========================================================================

    FiscalYear = 2098

    SourceAmount = 750@
    AdjustmentAmount = 250@

    PeriodEndDate = DateSerial(FiscalYear, 12, 31)

    '==========================================================================
    ' 3 - AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 9701, _
                  "TEST_047", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 9702, _
                  "TEST_047", _
                  "Üye listesi boþ."

    End If

    TestMemberID = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID

                Exit For

            End If

        End If

    Next Member

    If TestMemberID <= 0 Then

        Err.Raise vbObjectError + 9703, _
                  "TEST_047", _
                  "Test için aktif üye bulunamadý."

    End If

    '==========================================================================
    ' 4 - KULLANILMAMIÞ RESMI DÖNEM BUL
    '==========================================================================

    PeriodFound = False

    For DueMonth = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                DueMonth, _
                "RESMI") Then

            PeriodFound = True

            Exit For

        End If

    Next DueMonth

    If Not PeriodFound Then

        Err.Raise vbObjectError + 9704, _
                  "TEST_047", _
                  "TEST için kullanýlmamýþ RESMI dönem bulunamadý."

    End If

    ChargeDate = DateSerial(FiscalYear, DueMonth, 1)
    AdjustmentDate = DateAdd("d", 1, ChargeDate)

    '==========================================================================
    ' 5 - GEÇÝCÝ NORMAL RESMI KAYNAK OLUÞTUR
    '==========================================================================

    Set TestCharge = New clsMemberCharge

    TestCharge.MemberID = TestMemberID
    TestCharge.ChargeType = "RESMI"
    TestCharge.ChargeDate = ChargeDate
    TestCharge.FiscalYear = FiscalYear
    TestCharge.DueMonth = DueMonth
    TestCharge.Amount = SourceAmount
    TestCharge.AdjustmentType = "NORMAL"
    TestCharge.SourceChargeID = 0
    TestCharge.Description = _
        "TEST-047 - Geçici NORMAL kaynak"
    TestCharge.DecisionNo = "TEST-047"
    TestCharge.DecisionDate = ChargeDate
    TestCharge.EntryDate = Now
    TestCharge.Status = "AKTIF"

    SourceChargeID = Repo.Add(TestCharge)

    If SourceChargeID <= 0 Then

        Err.Raise vbObjectError + 9705, _
                  "TEST_047", _
                  "Geçici NORMAL kaynak oluþturulamadý."

    End If

    '==========================================================================
    ' 6 - KAYNAK KAYDI DOÐRULA
    '==========================================================================

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 9706, _
                  "TEST_047", _
                  "Kaynak tahakkuk okunamadý."

    End If

    If SourceCharge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 9707, _
                  "TEST_047", _
                  "Kaynak MemberID hatalý."

    End If

    If SourceCharge.Amount <> SourceAmount Then

        Err.Raise vbObjectError + 9708, _
                  "TEST_047", _
                  "Kaynak tutarý beklenen deðerde deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9709, _
                  "TEST_047", _
                  "Kaynak ChargeType RESMI deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9710, _
                  "TEST_047", _
                  "Kaynak AdjustmentType NORMAL deðil."

    End If

    If SourceCharge.SourceChargeID <> 0 Then

        Err.Raise vbObjectError + 9711, _
                  "TEST_047", _
                  "Kaynak SourceChargeID baþlangýçta 0 deðil."

    End If

    '==========================================================================
    ' 7 - ARTIS OLUÞTUR
    '==========================================================================

    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    AdjustmentChargeID = _
        Service.AddOfficialChargeAdjustment( _
            SourceChargeID, _
            AdjustmentDate, _
            AdjustmentAmount, _
            "TEST-047-ARTIS", _
            AdjustmentDate, _
            "TEST-047 - Kaynak baðlantýsý")

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    If Len(ErrorDescription) > 0 Then

        Err.Raise vbObjectError + 9712, _
                  "TEST_047", _
                  "ARTIS oluþturulamadý." & _
                  vbCrLf & ErrorDescription

    End If

    If AdjustmentChargeID <= 0 Then

        Err.Raise vbObjectError + 9713, _
                  "TEST_047", _
                  "ARTIS ChargeID oluþmadý."

    End If

    '==========================================================================
    ' 8 - ARTIS KAYDINI OKU
    '==========================================================================

    Set AdjustmentCharge = Repo.GetByID(AdjustmentChargeID)

    If AdjustmentCharge Is Nothing Then

        Err.Raise vbObjectError + 9714, _
                  "TEST_047", _
                  "ARTIS Repository'den okunamadý."

    End If

    '==========================================================================
    ' 9 - KAYNAK BAÐLANTISI
    '==========================================================================

    If AdjustmentCharge.SourceChargeID <> SourceChargeID Then

        Err.Raise vbObjectError + 9715, _
                  "TEST_047", _
                  "ARTIS SourceChargeID yanlýþ." & _
                  vbCrLf & _
                  "Beklenen: " & SourceChargeID & _
                  vbCrLf & _
                  "Gerçek: " & AdjustmentCharge.SourceChargeID

    End If

    '==========================================================================
    ' 10 - MEMBERID BAÐLANTISI
    '==========================================================================

    If AdjustmentCharge.MemberID <> SourceCharge.MemberID Then

        Err.Raise vbObjectError + 9716, _
                  "TEST_047", _
                  "ARTIS MemberID kaynak üye ile ayný deðil."

    End If

    '==========================================================================
    ' 11 - DÖNEM BAÐLANTISI
    '==========================================================================

    If AdjustmentCharge.FiscalYear <> SourceCharge.FiscalYear Then

        Err.Raise vbObjectError + 9717, _
                  "TEST_047", _
                  "ARTIS FiscalYear kaynak tahakkuktan farklý."

    End If

    If AdjustmentCharge.DueMonth <> SourceCharge.DueMonth Then

        Err.Raise vbObjectError + 9718, _
                  "TEST_047", _
                  "ARTIS DueMonth kaynak tahakkuktan farklý."

    End If

    '==========================================================================
    ' 12 - ARTIS TÝPÝ
    '==========================================================================

    If StrComp( _
            Trim$(AdjustmentCharge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9719, _
                  "TEST_047", _
                  "ARTIS ChargeType RESMI deðil."

    End If

    If StrComp( _
            Trim$(AdjustmentCharge.AdjustmentType), _
            "ARTIS", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9720, _
                  "TEST_047", _
                  "ARTIS AdjustmentType ARTIS deðil."

    End If

    '==========================================================================
    ' 13 - ARTIS TUTARI
    '==========================================================================

    If AdjustmentCharge.Amount <> AdjustmentAmount Then

        Err.Raise vbObjectError + 9721, _
                  "TEST_047", _
                  "ARTIS tutarý hatalý."

    End If

    '==========================================================================
    ' 14 - ARTIS DURUMU
    '==========================================================================

    If StrComp( _
            Trim$(AdjustmentCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9722, _
                  "TEST_047", _
                  "ARTIS Status AKTIF deðil."

    End If

    '==========================================================================
    ' 15 - KAYNAK KAYDININ DEÐÝÞMEDÝÐÝNÝ KONTROL ET
    '==========================================================================

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 9723, _
                  "TEST_047", _
                  "Kaynak kayýt beklenmedik þekilde silindi."

    End If

    If SourceCharge.Amount <> SourceAmount Then

        Err.Raise vbObjectError + 9724, _
                  "TEST_047", _
                  "ARTIS sonrasý kaynak tutarý deðiþti."

    End If

    If StrComp( _
            Trim$(SourceCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9725, _
                  "TEST_047", _
                  "ARTIS sonrasý kaynak AdjustmentType deðiþti."

    End If

    If SourceCharge.SourceChargeID <> 0 Then

        Err.Raise vbObjectError + 9726, _
                  "TEST_047", _
                  "ARTIS sonrasý kaynak SourceChargeID deðiþti."

    End If

    If StrComp( _
            Trim$(SourceCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9727, _
                  "TEST_047", _
                  "ARTIS sonrasý kaynak Status deðiþti."

    End If

    '==========================================================================
    ' 16 - CLEANUP ARTIS
    '==========================================================================

    On Error Resume Next

    Err.Clear

    DeleteTestCharge AdjustmentChargeID

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 9728, _
                  "TEST_047", _
                  "ARTIS cleanup edilemedi." & _
                  vbCrLf & ErrorDescription

    End If

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 17 - CLEANUP KAYNAK
    '==========================================================================

    On Error Resume Next

    Err.Clear

    DeleteTestCharge SourceChargeID

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 9729, _
                  "TEST_047", _
                  "Kaynak cleanup edilemedi." & _
                  vbCrLf & ErrorDescription

    End If

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 18 - CLEANUP SONRASI KONTROL
    '==========================================================================

    If Not Repo.GetByID(AdjustmentChargeID) Is Nothing Then

        Err.Raise vbObjectError + 9730, _
                  "TEST_047", _
                  "ARTIS cleanup sonrasý hâlâ mevcut."

    End If

    If Not Repo.GetByID(SourceChargeID) Is Nothing Then

        Err.Raise vbObjectError + 9731, _
                  "TEST_047", _
                  "Kaynak cleanup sonrasý hâlâ mevcut."

    End If

    '==========================================================================
    ' 19 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-047 BAÞARILI." & vbCrLf & vbCrLf & _
        "Üye              : " & TestMemberID & vbCrLf & _
        "Kaynak ChargeID  : " & SourceChargeID & vbCrLf & _
        "ARTIS ChargeID   : " & AdjustmentChargeID & vbCrLf & _
        "Kaynak tutarý    : " & SourceAmount & " TL" & vbCrLf & _
        "ARTIS tutarý     : " & AdjustmentAmount & " TL" & vbCrLf & vbCrLf & _
        "SourceChargeID   : DOÐRU" & vbCrLf & _
        "MemberID         : DOÐRU" & vbCrLf & _
        "FiscalYear       : DOÐRU" & vbCrLf & _
        "DueMonth         : DOÐRU" & vbCrLf & _
        "ChargeType       : RESMI" & vbCrLf & _
        "AdjustmentType   : ARTIS" & vbCrLf & _
        "Status           : AKTIF" & vbCrLf & _
        "Kaynak deðiþimi  : YOK" & vbCrLf & _
        "Cleanup          : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-047"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If AdjustmentChargeID > 0 Then

        DeleteTestCharge AdjustmentChargeID

    End If

    If SourceChargeID > 0 Then

        DeleteTestCharge SourceChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-047 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Service mesajý:" & vbCrLf & _
        ErrorDescription, _
        vbCritical, _
        "OAA - TEST-047"

End Sub
'==============================================================================
' TEST-048
'
' RESMI AÝDAT ARTISI - KARAR / AÇIKLAMA METADATA KONTROLÜ
'
' AMAÇ:
'
'   AddOfficialChargeAdjustment tarafýndan oluþturulan ARTIS kaydýnda
'   DecisionNo, DecisionDate, Description ve EntryDate alanlarýnýn
'   doðru þekilde kaydedildiðini doðrulamak.
'
' GERÇEK SERVICE KODU:
'
'   AdjustmentCharge.Description = Description
'   AdjustmentCharge.DecisionNo = DecisionNo
'   AdjustmentCharge.DecisionDate = DecisionDate
'   AdjustmentCharge.EntryDate = Now
'   AdjustmentCharge.Status = "AKTIF"
'
' BEKLENEN:
'
'   1. ARTIS baþarýyla oluþur.
'   2. DecisionNo doðru aktarýlýr.
'   3. DecisionDate doðru aktarýlýr.
'   4. Description doðru aktarýlýr.
'   5. EntryDate boþ/default kalmaz.
'   6. Status AKTIF olur.
'   7. SourceChargeID doðru kalýr.
'   8. Geçici kayýtlar cleanup edilir.
'==============================================================================

Public Sub TEST_048()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim TestCharge As clsMemberCharge
    Dim SourceCharge As clsMemberCharge
    Dim AdjustmentCharge As clsMemberCharge

    Dim TestMemberID As Long

    Dim SourceChargeID As Long
    Dim AdjustmentChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim AdjustmentDate As Date
    Dim DecisionDate As Date
    Dim PeriodEndDate As Date

    Dim SourceAmount As Currency
    Dim AdjustmentAmount As Currency

    Dim DecisionNo As String
    Dim Description As String

    Dim BeforeEntry As Date
    Dim AfterEntry As Date

    Dim ErrorDescription As String
    Dim PeriodFound As Boolean

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    SourceChargeID = 0
    AdjustmentChargeID = 0

    '==========================================================================
    ' 2 - TEST PARAMETRELERÝ
    '==========================================================================

    FiscalYear = 2098

    SourceAmount = 600@
    AdjustmentAmount = 150@

    DecisionNo = "TEST-048-KARAR-001"

    Description = _
        "TEST-048 - RESMI aidat artisi karar metadata testi"

    ChargeDate = DateSerial(FiscalYear, 1, 1)

    AdjustmentDate = DateSerial(FiscalYear, 1, 15)

    DecisionDate = DateSerial(FiscalYear, 1, 10)

    PeriodEndDate = DateSerial(FiscalYear, 12, 31)

    '==========================================================================
    ' 3 - AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 9801, _
                  "TEST_048", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 9802, _
                  "TEST_048", _
                  "Üye listesi boþ."

    End If

    TestMemberID = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID

                Exit For

            End If

        End If

    Next Member

    If TestMemberID <= 0 Then

        Err.Raise vbObjectError + 9803, _
                  "TEST_048", _
                  "Test için aktif üye bulunamadý."

    End If

    '==========================================================================
    ' 4 - KULLANILMAMIÞ RESMI DÖNEM BUL
    '==========================================================================

    PeriodFound = False

    For DueMonth = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                DueMonth, _
                "RESMI") Then

            PeriodFound = True

            Exit For

        End If

    Next DueMonth

    If Not PeriodFound Then

        Err.Raise vbObjectError + 9804, _
                  "TEST_048", _
                  "TEST için kullanýlmamýþ RESMI dönem bulunamadý."

    End If

    ChargeDate = DateSerial(FiscalYear, DueMonth, 1)

    AdjustmentDate = DateSerial(FiscalYear, DueMonth, 15)

    DecisionDate = DateSerial(FiscalYear, DueMonth, 10)

    '==========================================================================
    ' 5 - GEÇÝCÝ NORMAL RESMI KAYNAK OLUÞTUR
    '==========================================================================

    Set TestCharge = New clsMemberCharge

    TestCharge.MemberID = TestMemberID
    TestCharge.ChargeType = "RESMI"
    TestCharge.ChargeDate = ChargeDate
    TestCharge.FiscalYear = FiscalYear
    TestCharge.DueMonth = DueMonth
    TestCharge.Amount = SourceAmount
    TestCharge.AdjustmentType = "NORMAL"
    TestCharge.SourceChargeID = 0
    TestCharge.Description = _
        "TEST-048 - Geçici NORMAL kaynak"
    TestCharge.DecisionNo = "TEST-048-KAYNAK"
    TestCharge.DecisionDate = ChargeDate
    TestCharge.EntryDate = Now
    TestCharge.Status = "AKTIF"

    SourceChargeID = Repo.Add(TestCharge)

    If SourceChargeID <= 0 Then

        Err.Raise vbObjectError + 9805, _
                  "TEST_048", _
                  "Geçici NORMAL kaynak oluþturulamadý."

    End If

    '==========================================================================
    ' 6 - KAYNAÐI DOÐRULA
    '==========================================================================

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 9806, _
                  "TEST_048", _
                  "Kaynak tahakkuk okunamadý."

    End If

    If SourceCharge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 9807, _
                  "TEST_048", _
                  "Kaynak MemberID hatalý."

    End If

    If StrComp( _
            Trim$(SourceCharge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9808, _
                  "TEST_048", _
                  "Kaynak ChargeType RESMI deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9809, _
                  "TEST_048", _
                  "Kaynak AdjustmentType NORMAL deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9810, _
                  "TEST_048", _
                  "Kaynak Status AKTIF deðil."

    End If

    '==========================================================================
    ' 7 - ENTRYDATE ÝÇÝN ZAMAN SINIRI
    '==========================================================================

    BeforeEntry = Now

    '==========================================================================
    ' 8 - ARTIS OLUÞTUR
    '==========================================================================

    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    AdjustmentChargeID = _
        Service.AddOfficialChargeAdjustment( _
            SourceChargeID, _
            AdjustmentDate, _
            AdjustmentAmount, _
            DecisionNo, _
            DecisionDate, _
            Description)

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    AfterEntry = Now

    If Len(ErrorDescription) > 0 Then

        Err.Raise vbObjectError + 9811, _
                  "TEST_048", _
                  "ARTIS oluþturulamadý." & _
                  vbCrLf & ErrorDescription

    End If

    If AdjustmentChargeID <= 0 Then

        Err.Raise vbObjectError + 9812, _
                  "TEST_048", _
                  "ARTIS ChargeID oluþmadý."

    End If

    '==========================================================================
    ' 9 - ARTIS KAYDINI OKU
    '==========================================================================

    Set AdjustmentCharge = Repo.GetByID(AdjustmentChargeID)

    If AdjustmentCharge Is Nothing Then

        Err.Raise vbObjectError + 9813, _
                  "TEST_048", _
                  "ARTIS kaydý Repository'den okunamadý."

    End If

    '==========================================================================
    ' 10 - DECISIONNO
    '==========================================================================

    If StrComp( _
            AdjustmentCharge.DecisionNo, _
            DecisionNo, _
            vbBinaryCompare) <> 0 Then

        Err.Raise vbObjectError + 9814, _
                  "TEST_048", _
                  "DecisionNo doðru aktarýlmadý." & _
                  vbCrLf & _
                  "Beklenen: " & DecisionNo & _
                  vbCrLf & _
                  "Gerçek: " & AdjustmentCharge.DecisionNo

    End If

    '==========================================================================
    ' 11 - DECISIONDATE
    '==========================================================================

    If AdjustmentCharge.DecisionDate <> DecisionDate Then

        Err.Raise vbObjectError + 9815, _
                  "TEST_048", _
                  "DecisionDate doðru aktarýlmadý." & _
                  vbCrLf & _
                  "Beklenen: " & Format$(DecisionDate, "dd.mm.yyyy") & _
                  vbCrLf & _
                  "Gerçek: " & _
                  Format$(AdjustmentCharge.DecisionDate, "dd.mm.yyyy")

    End If

    '==========================================================================
    ' 12 - DESCRIPTION
    '==========================================================================

    If StrComp( _
            AdjustmentCharge.Description, _
            Description, _
            vbBinaryCompare) <> 0 Then

        Err.Raise vbObjectError + 9816, _
                  "TEST_048", _
                  "Description doðru aktarýlmadý." & _
                  vbCrLf & _
                  "Beklenen: " & Description & _
                  vbCrLf & _
                  "Gerçek: " & AdjustmentCharge.Description

    End If

    '==========================================================================
    ' 13 - ENTRYDATE
    '
    ' Service kodu EntryDate = Now atýyor.
    ' Bu nedenle test çaðrýsý sýrasýnda oluþmuþ olmasý gerekir.
    '==========================================================================

    If AdjustmentCharge.EntryDate <= 0 Then

        Err.Raise vbObjectError + 9817, _
                  "TEST_048", _
                  "ARTIS EntryDate boþ/default kaldý."

    End If

    If AdjustmentCharge.EntryDate < BeforeEntry Then

        Err.Raise vbObjectError + 9818, _
                  "TEST_048", _
                  "ARTIS EntryDate beklenen zaman aralýðýndan önce."

    End If

    If AdjustmentCharge.EntryDate > AfterEntry Then

        Err.Raise vbObjectError + 9819, _
                  "TEST_048", _
                  "ARTIS EntryDate beklenen zaman aralýðýndan sonra."

    End If

    '==========================================================================
    ' 14 - STATUS
    '==========================================================================

    If StrComp( _
            Trim$(AdjustmentCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9820, _
                  "TEST_048", _
                  "ARTIS Status AKTIF deðil."

    End If

    '==========================================================================
    ' 15 - SOURCECHARGEID
    '==========================================================================

    If AdjustmentCharge.SourceChargeID <> SourceChargeID Then

        Err.Raise vbObjectError + 9821, _
                  "TEST_048", _
                  "ARTIS SourceChargeID hatalý."

    End If

    '==========================================================================
    ' 16 - ARTIS TÝPÝ
    '==========================================================================

    If StrComp( _
            Trim$(AdjustmentCharge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9822, _
                  "TEST_048", _
                  "ARTIS ChargeType RESMI deðil."

    End If

    If StrComp( _
            Trim$(AdjustmentCharge.AdjustmentType), _
            "ARTIS", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9823, _
                  "TEST_048", _
                  "ARTIS AdjustmentType ARTIS deðil."

    End If

    '==========================================================================
    ' 17 - KAYNAK KAYDIN DEÐÝÞMEDÝÐÝNÝ KONTROL ET
    '==========================================================================

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 9824, _
                  "TEST_048", _
                  "Kaynak tahakkuk beklenmedik þekilde silindi."

    End If

    If SourceCharge.Amount <> SourceAmount Then

        Err.Raise vbObjectError + 9825, _
                  "TEST_048", _
                  "Kaynak tahakkuk tutarý deðiþti."

    End If

    If StrComp( _
            Trim$(SourceCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9826, _
                  "TEST_048", _
                  "Kaynak AdjustmentType deðiþti."

    End If

    '==========================================================================
    ' 18 - CLEANUP ARTIS
    '==========================================================================

    On Error Resume Next

    Err.Clear

    DeleteTestCharge AdjustmentChargeID

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 9827, _
                  "TEST_048", _
                  "ARTIS cleanup edilemedi." & _
                  vbCrLf & ErrorDescription

    End If

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 19 - CLEANUP KAYNAK
    '==========================================================================

    On Error Resume Next

    Err.Clear

    DeleteTestCharge SourceChargeID

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 9828, _
                  "TEST_048", _
                  "Kaynak cleanup edilemedi." & _
                  vbCrLf & ErrorDescription

    End If

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 20 - CLEANUP KONTROLÜ
    '==========================================================================

    If Not Repo.GetByID(AdjustmentChargeID) Is Nothing Then

        Err.Raise vbObjectError + 9829, _
                  "TEST_048", _
                  "ARTIS cleanup sonrasý kayýt hâlâ mevcut."

    End If

    If Not Repo.GetByID(SourceChargeID) Is Nothing Then

        Err.Raise vbObjectError + 9830, _
                  "TEST_048", _
                  "Kaynak cleanup sonrasý kayýt hâlâ mevcut."

    End If

    '==========================================================================
    ' 21 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-048 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "Kaynak ChargeID  : " & SourceChargeID & vbCrLf & _
        "ARTIS ChargeID   : " & AdjustmentChargeID & vbCrLf & vbCrLf & _
        "DecisionNo       : DOÐRU" & vbCrLf & _
        "DecisionDate     : DOÐRU" & vbCrLf & _
        "Description      : DOÐRU" & vbCrLf & _
        "EntryDate        : DOÐRU" & vbCrLf & _
        "Status           : AKTIF" & vbCrLf & _
        "ChargeType       : RESMI" & vbCrLf & _
        "AdjustmentType   : ARTIS" & vbCrLf & _
        "SourceChargeID   : DOÐRU" & vbCrLf & _
        "Kaynak deðiþimi  : YOK" & vbCrLf & _
        "Cleanup          : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-048"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If AdjustmentChargeID > 0 Then

        DeleteTestCharge AdjustmentChargeID

    End If

    If SourceChargeID > 0 Then

        DeleteTestCharge SourceChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-048 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Service mesajý:" & vbCrLf & _
        ErrorDescription, _
        vbCritical, _
        "OAA - TEST-048"

End Sub
'==============================================================================
' TEST-049
'
' TOPLU RESMI AÝDAT - GEÇERSÝZ MALÝ YIL
'
' AMAÇ:
'
'   AddBulkOfficialCharges metodunun FiscalYear <= 0 deðerini
'   reddettiðini doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   FiscalYear <= 0
'       -> vbObjectError + 7351
'       -> "Geçersiz mali yýl."
'
' BEKLENEN:
'
'   1. Service iþlemi reddetmelidir.
'   2. CreatedCount = 0
'   3. SkippedCount = 0
'   4. ErrorCount = 1
'   5. Hiçbir üye iþlenmemelidir.
'   6. Hiçbir test kaydý oluþmamalýdýr.
'
' CLEANUP:
'
'   Kayýt oluþmadýðý için cleanup gerekmez.
'==============================================================================

Public Sub TEST_049()

    Dim Service As clsMemberChargeService

    Dim CreatedCount As Long
    Dim SkippedCount As Long
    Dim ErrorCount As Long

    Dim Result As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim PeriodEndDate As Date

    Dim Amount As Currency

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    On Error GoTo TestError

    '==========================================================================
    ' 1 - SERVICE
    '==========================================================================

    Set Service = New clsMemberChargeService

    '==========================================================================
    ' 2 - GEÇERLÝ PARAMETRELER
    '
    ' Sadece FiscalYear bilerek geçersizdir.
    '
    ' Böylece doðrudan 7351 kontrolü test edilir.
    '==========================================================================

    FiscalYear = 0

    DueMonth = 1

    ChargeDate = DateSerial(2098, 1, 1)

    Amount = 500@

    PeriodEndDate = DateSerial(2098, 12, 31)

    CreatedCount = 0
    SkippedCount = 0
    ErrorCount = 0

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString

    '==========================================================================
    ' 3 - SERVICE ÇAÐRISI
    '==========================================================================

    On Error Resume Next

    Err.Clear

    Result = _
        Service.AddBulkOfficialCharges( _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            PeriodEndDate, _
            "TEST-049", _
            ChargeDate, _
            "TEST-049 - Geçersiz mali yýl", _
            CreatedCount, _
            SkippedCount, _
            ErrorCount)

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorNumber = Err.Number
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 4 - HATA OLUÞMALI
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 9901, _
                  "TEST_049", _
                  "Geçersiz mali yýl Service tarafýndan reddedilmedi."

    End If

    '==========================================================================
    ' 5 - BEKLENEN HATA MESAJI
    '==========================================================================

    If InStr( _
            1, _
            ErrorDescription, _
            "Geçersiz mali yýl.", _
            vbTextCompare) = 0 Then


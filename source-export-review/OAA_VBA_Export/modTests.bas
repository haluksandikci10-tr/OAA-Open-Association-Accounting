        "Service sonucu  : REDDEDÝLDÝ" & vbCrLf & _
        "Service kodu    : 7212" & vbCrLf & _
        "VBA Err.Number  : " & ErrorNumber & vbCrLf & _
        "Hata mesajý     : " & ErrorDescription & vbCrLf & _
        "ChargeID        : 0" & vbCrLf & _
        "Yeni kayýt      : YOK" & vbCrLf & _
        "Üye deðiþikliði : YOK" & vbCrLf & _
        "Cleanup         : GEREKMEDÝ" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _

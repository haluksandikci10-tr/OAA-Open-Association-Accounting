'==============================================================================
' TEST-009
' clsMemberChargeRepository Add / GetByID Testi
'
' Amaç:
'   - TBL_MEMBER_CHARGES tablosuna test kaydý eklemek
'   - ChargeID üretimini kontrol etmek
'   - Kaydý GetByID ile geri okumak
'
' Not:
'   Test sonunda oluþturulan kayýt silinir.
'==============================================================================

Public Sub Test_ClsMemberChargeRepository()

    Dim Repository As clsMemberChargeRepository
    Dim Charge As clsMemberCharge
    Dim LoadedCharge As clsMemberCharge

    Dim NewChargeID As Long

    On Error GoTo ErrorHandler

    '----------------------------------------------------------------------
    ' Repository oluþtur
    '----------------------------------------------------------------------
    Set Repository = New clsMemberChargeRepository

    '----------------------------------------------------------------------
    ' Test Entity oluþtur
    '----------------------------------------------------------------------
    Set Charge = New clsMemberCharge

    Charge.MemberID = 6
    Charge.ChargeType = "RESMI"
    Charge.ChargeDate = DateSerial(2027, 1, 1)
    Charge.FiscalYear = 2027
    Charge.DueMonth = 1
    Charge.Amount = 500@
    Charge.AdjustmentType = "NORMAL"
    Charge.SourceChargeID = 0
    Charge.Description = "TEST-009 - Ocak 2027 resmi aidat"
    Charge.DecisionNo = "TEST-009"
    Charge.DecisionDate = DateSerial(2026, 12, 25)
    Charge.EntryDate = Date
    Charge.Status = "AKTIF"

    '----------------------------------------------------------------------
    ' ADD
    '----------------------------------------------------------------------
    NewChargeID = Repository.Add(Charge)

    If NewChargeID <= 0 Then

        MsgBox "TEST-009 BAÞARISIZ." & vbCrLf & vbCrLf & _
               "Repository.Add geçerli bir ChargeID döndürmedi.", _
               vbCritical, "OAA - TEST-009"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' Entity içine dönen ID yazýlmýþ mý?
    '----------------------------------------------------------------------
    If Charge.ChargeID <> NewChargeID Then

        DeleteTestCharge NewChargeID

        MsgBox "TEST-009 BAÞARISIZ." & vbCrLf & vbCrLf & _
               "Add sonucu dönen ChargeID ile Entity ChargeID farklý.", _
               vbCritical, "OAA - TEST-009"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' GET BY ID
    '----------------------------------------------------------------------
    Set LoadedCharge = Repository.GetByID(NewChargeID)

    If LoadedCharge Is Nothing Then

        DeleteTestCharge NewChargeID

        MsgBox "TEST-009 BAÞARISIZ." & vbCrLf & vbCrLf & _
               "Eklenen kayýt GetByID ile bulunamadý.", _
               vbCritical, "OAA - TEST-009"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' Alan kontrolleri
    '----------------------------------------------------------------------

    If LoadedCharge.ChargeID <> NewChargeID Then GoTo DataError
    If LoadedCharge.MemberID <> 6 Then GoTo DataError
    If LoadedCharge.ChargeType <> "RESMI" Then GoTo DataError
    If LoadedCharge.ChargeDate <> DateSerial(2027, 1, 1) Then GoTo DataError
    If LoadedCharge.FiscalYear <> 2027 Then GoTo DataError
    If LoadedCharge.DueMonth <> 1 Then GoTo DataError
    If LoadedCharge.Amount <> 500@ Then GoTo DataError
    If LoadedCharge.AdjustmentType <> "NORMAL" Then GoTo DataError
    If LoadedCharge.SourceChargeID <> 0 Then GoTo DataError
    If LoadedCharge.Description <> _
       "TEST-009 - Ocak 2027 resmi aidat" Then GoTo DataError

    If LoadedCharge.DecisionNo <> "TEST-009" Then GoTo DataError

    If LoadedCharge.DecisionDate <> _
       DateSerial(2026, 12, 25) Then GoTo DataError

    If LoadedCharge.Status <> "AKTIF" Then GoTo DataError

    '----------------------------------------------------------------------
    ' TEST KAYDINI SÝL
    '----------------------------------------------------------------------
    DeleteTestCharge NewChargeID

    '----------------------------------------------------------------------
    ' BAÞARILI
    '----------------------------------------------------------------------
    MsgBox "TEST-009 BAÞARILI." & vbCrLf & vbCrLf & _
           "Repository.Add        : OK" & vbCrLf & _
           "ChargeID oluþturma    : OK" & vbCrLf & _
           "Repository.GetByID    : OK" & vbCrLf & _
           "14 alan geri okuma    : OK" & vbCrLf & vbCrLf & _
           "Test kaydý silindi.", _
           vbInformation, "OAA - TEST-009"

    Set LoadedCharge = Nothing
    Set Charge = Nothing
    Set Repository = Nothing

    Exit Sub


'==============================================================================
' Veri hatasý
'==============================================================================

DataError:

    DeleteTestCharge NewChargeID

    MsgBox "TEST-009 BAÞARISIZ." & vbCrLf & vbCrLf & _
           "Repository kaydý geri okudu ancak alanlardan biri " & _
           "beklenen deðeri vermedi." & vbCrLf & vbCrLf & _
           "Test kaydý silindi.", _
           vbCritical, "OAA - TEST-009"

    Set LoadedCharge = Nothing
    Set Charge = Nothing
    Set Repository = Nothing

    Exit Sub


'==============================================================================
' Hata
'==============================================================================

ErrorHandler:

    If NewChargeID > 0 Then
        DeleteTestCharge NewChargeID
    End If

    MsgBox "TEST-009 sýrasýnda hata oluþtu." & vbCrLf & vbCrLf & _
           "Hata No : " & Err.Number & vbCrLf & _
           "Hata    : " & Err.Description & vbCrLf & vbCrLf & _
           "Varsa test kaydý temizlendi.", _
           vbCritical, "OAA - TEST-009"

    Set LoadedCharge = Nothing
    Set Charge = Nothing
    Set Repository = Nothing

End Sub


'==============================================================================
' Test kaydýný temizler
'==============================================================================

Private Sub DeleteTestCharge(ByVal ChargeID As Long)

    Dim ws As Worksheet
    Dim tbl As ListObject
    Dim I As Long
    Dim Value As Variant

    On Error Resume Next

    Set ws = ThisWorkbook.Worksheets("ÜyeBorçlarý")
    Set tbl = ws.ListObjects("TBL_MEMBER_CHARGES")

    If tbl Is Nothing Then Exit Sub
    If tbl.DataBodyRange Is Nothing Then Exit Sub

    For I = tbl.ListRows.Count To 1 Step -1

        Value = tbl.ListRows(I).Range.Cells( _
                    1, _
                    tbl.ListColumns("ChargeID").Index _
                ).Value

        If IsNumeric(Value) Then

            If CLng(Value) = ChargeID Then
                tbl.ListRows(I).Delete
                Exit For
            End If

        End If

    Next I

    On Error GoTo 0

End Sub
'==============================================================================
' TEST-010
' clsMemberChargeRepository sorgulama testleri
'
' Test edilen:
'   1. GetByMemberID
'   2. ExistsNormalCharge
'
' Test sonunda oluþturulan kayýt silinir.
'==============================================================================

Public Sub Test_ClsMemberChargeRepositoryQueries()

    Dim Repository As clsMemberChargeRepository
    Dim Charge As clsMemberCharge
    Dim LoadedCharges As Collection

    Dim TestChargeID As Long

    On Error GoTo ErrorHandler

    '----------------------------------------------------------------------
    ' Repository
    '----------------------------------------------------------------------
    Set Repository = New clsMemberChargeRepository

    '----------------------------------------------------------------------
    ' Test kaydý oluþtur
    '----------------------------------------------------------------------

    Set Charge = New clsMemberCharge

    Charge.MemberID = 6
    Charge.ChargeType = "RESMI"
    Charge.ChargeDate = DateSerial(2027, 2, 1)
    Charge.FiscalYear = 2027
    Charge.DueMonth = 2
    Charge.Amount = 750@
    Charge.AdjustmentType = "NORMAL"
    Charge.SourceChargeID = 0
    Charge.Description = "TEST-010 - Þubat 2027 resmi aidat"
    Charge.DecisionNo = "TEST-010"
    Charge.DecisionDate = DateSerial(2027, 1, 15)
    Charge.EntryDate = Date
    Charge.Status = "AKTIF"

    '----------------------------------------------------------------------
    ' Kayýt ekle
    '----------------------------------------------------------------------

    TestChargeID = Repository.Add(Charge)

    If TestChargeID <= 0 Then

        MsgBox "TEST-010 BAÞARISIZ." & vbCrLf & vbCrLf & _
               "Test kaydý oluþturulamadý.", _
               vbCritical, "OAA - TEST-010"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' GetByMemberID
    '----------------------------------------------------------------------

    Set LoadedCharges = Repository.GetByMemberID(6)

    If LoadedCharges Is Nothing Then
        GoTo QueryError
    End If

    If LoadedCharges.Count <= 0 Then
        GoTo QueryError
    End If

    '----------------------------------------------------------------------
    ' Test kaydý Collection içinde var mý?
    '----------------------------------------------------------------------

    If Not CollectionContainsChargeID( _
        LoadedCharges, TestChargeID) Then

        GoTo QueryError

    End If

    '----------------------------------------------------------------------
    ' ExistsNormalCharge
    '
    ' Ayný üye + 2027 + Þubat + RESMI
    ' için TRUE bekleniyor.
    '----------------------------------------------------------------------

    If Repository.ExistsNormalCharge( _
        6, _
        2027, _
        2, _
        "RESMI") = False Then

        GoTo QueryError

    End If

    '----------------------------------------------------------------------
    ' Farklý ay için FALSE bekleniyor.
    '----------------------------------------------------------------------

    If Repository.ExistsNormalCharge( _
        6, _
        2027, _
        3, _
        "RESMI") = True Then

        GoTo QueryError

    End If

    '----------------------------------------------------------------------
    ' Farklý borç türü için FALSE bekleniyor.
    '----------------------------------------------------------------------

    If Repository.ExistsNormalCharge( _
        6, _
        2027, _
        2, _
        "TOPLANTI") = True Then

        GoTo QueryError

    End If

    '----------------------------------------------------------------------
    ' Test kaydýný sil
    '----------------------------------------------------------------------

    DeleteTestCharge TestChargeID

    '----------------------------------------------------------------------
    ' BAÞARILI
    '----------------------------------------------------------------------

    MsgBox "TEST-010 BAÞARILI." & vbCrLf & vbCrLf & _
           "GetByMemberID        : OK" & vbCrLf & _
           "Üye borçlarý bulundu : OK" & vbCrLf & _
           "ExistsNormalCharge   : OK" & vbCrLf & _
           "Ayný dönem kontrolü  : OK" & vbCrLf & _
           "Farklý dönem kontrolü: OK" & vbCrLf & _
           "Farklý tür kontrolü  : OK" & vbCrLf & vbCrLf & _
           "Test kaydý silindi.", _
           vbInformation, "OAA - TEST-010"

    Set LoadedCharges = Nothing
    Set Charge = Nothing
    Set Repository = Nothing

    Exit Sub


'==============================================================================
' Sorgu hatasý
'==============================================================================

QueryError:

    DeleteTestCharge TestChargeID

    MsgBox "TEST-010 BAÞARISIZ." & vbCrLf & vbCrLf & _
           "Repository sorgularýndan biri beklenen sonucu vermedi." & _
           vbCrLf & vbCrLf & _
           "Test kaydý silindi.", _
           vbCritical, "OAA - TEST-010"

    Set LoadedCharges = Nothing
    Set Charge = Nothing
    Set Repository = Nothing

    Exit Sub


'==============================================================================
' Hata yakalama
'==============================================================================

ErrorHandler:

    If TestChargeID > 0 Then
        DeleteTestCharge TestChargeID
    End If

    MsgBox "TEST-010 sýrasýnda hata oluþtu." & vbCrLf & vbCrLf & _
           "Hata No : " & Err.Number & vbCrLf & _
           "Hata    : " & Err.Description & vbCrLf & vbCrLf & _
           "Varsa test kaydý temizlendi.", _
           vbCritical, "OAA - TEST-010"

    Set LoadedCharges = Nothing
    Set Charge = Nothing
    Set Repository = Nothing

End Sub


'==============================================================================
' Collection içinde ChargeID arar
'==============================================================================

Private Function CollectionContainsChargeID( _
    ByVal Charges As Collection, _
    ByVal ChargeID As Long) As Boolean

    Dim Item As Variant
    Dim Charge As clsMemberCharge

    CollectionContainsChargeID = False

    For Each Item In Charges

        Set Charge = Item

        If Charge.ChargeID = ChargeID Then
            CollectionContainsChargeID = True
            Exit Function
        End If

    Next Item

End Function


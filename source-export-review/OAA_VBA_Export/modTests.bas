    If tblCharges.ListColumns(10).Name <> "Description" Then GoTo ChargeColumnError
    If tblCharges.ListColumns(11).Name <> "DecisionNo" Then GoTo ChargeColumnError
    If tblCharges.ListColumns(12).Name <> "DecisionDate" Then GoTo ChargeColumnError
    If tblCharges.ListColumns(13).Name <> "EntryDate" Then GoTo ChargeColumnError
    If tblCharges.ListColumns(14).Name <> "Status" Then GoTo ChargeColumnError


'==============================================================================
' TEST-038
'
' RESMI AÝDAT ARTISI - GEÇERSÝZ ARTIÞ TARÝHÝ REDDÝ
'
' AMAÇ:
'
'   AddOfficialChargeAdjustment metodunun geçersiz AdjustmentDate
'   deðerini Service katmanýnda reddettiðini doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   AdjustmentDate <= 0
'       -> vbObjectError + 7242
'       -> "Artýþ tarihi girilmelidir."
'
' TEST AKIÞI:
'
'   1. Aktif üye bulunur.
'   2. Kullanýlmamýþ bir RESMI dönem seçilir.
'   3. Geçici NORMAL RESMI tahakkuk oluþturulur.
'   4. SourceChargeID bu tahakkukun ID'si olarak kullanýlýr.
'   5. AdjustmentDate = 0 ile ARTIS denenir.
'   6. Service iþlemi reddetmelidir.
'   7. ARTIS kaydý oluþmamalýdýr.
'   8. Test sonunda kaynak tahakkuk temizlenir.
'
' CLEANUP:
'
'   Oluþturulan geçici NORMAL RESMI kayýt mutlaka silinir.
'==============================================================================

Public Sub TEST_038()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim SourceCharge As clsMemberCharge
    Dim TestMemberID As Long

    Dim SourceChargeID As Long
    Dim AdjustmentChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim AdjustmentDate As Date

    Dim Amount As Currency
    Dim AdjustmentAmount As Currency

    Dim PeriodEndDate As Date

    Dim ErrorOccurred As Boolean
    Dim ErrorDescription As String

    Dim PeriodFound As Boolean

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    SourceChargeID = 0
    AdjustmentChargeID = 0

    '==========================================================================
    ' 2 - TEST PARAMETRELERÝ
    '==========================================================================

    FiscalYear = 2098
    Amount = 500@
    AdjustmentAmount = 100@

    ' Geçersiz artýþ tarihi
    AdjustmentDate = 0

    ' Geçerli tahakkuk tarihi
    ChargeDate = DateSerial(2098, 1, 1)

    PeriodEndDate = DateSerial(2098, 12, 31)

    '==========================================================================
    ' 3 - AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 8801, _
                  "TEST_038", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 8802, _
                  "TEST_038", _
                  "Test için üye bulunamadý."

    End If

    TestMemberID = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID

                Exit For

            End If

        End If

    Next Member

    If TestMemberID <= 0 Then

        Err.Raise vbObjectError + 8803, _
                  "TEST_038", _
                  "Test için aktif üye bulunamadý."

    End If

    '==========================================================================
    ' 4 - KULLANILMAMIÞ RESMI DÖNEM BUL
    '==========================================================================

    PeriodFound = False

    For DueMonth = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                DueMonth, _
                "RESMI") Then

            PeriodFound = True
            Exit For

        End If

    Next DueMonth

    If Not PeriodFound Then

        Err.Raise vbObjectError + 8804, _
                  "TEST_038", _
                  "TEST için kullanýlmamýþ RESMI dönem bulunamadý."

    End If

    ChargeDate = DateSerial(FiscalYear, DueMonth, 1)

    '==========================================================================
    ' 5 - GEÇÝCÝ NORMAL RESMI TAHAKKUK OLUÞTUR
    '==========================================================================

    On Error Resume Next

    Err.Clear

    SourceChargeID = _
        Service.AddOfficialCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            PeriodEndDate, _
            "TEST-038", _
            ChargeDate, _
            "TEST-038 - Geçici kaynak tahakkuk")

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

    End If

    On Error GoTo ErrorHandler

    If Len(ErrorDescription) > 0 Then

        Err.Raise vbObjectError + 8805, _
                  "TEST_038", _
                  "Geçici kaynak RESMI tahakkuk oluþturulamadý." & _
                  vbCrLf & ErrorDescription

    End If

    If SourceChargeID <= 0 Then

        Err.Raise vbObjectError + 8806, _
                  "TEST_038", _
                  "Geçici kaynak tahakkuk için ChargeID oluþmadý."

    End If

    '==========================================================================
    ' 6 - KAYNAK KAYDI DOÐRULA
    '==========================================================================

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 8807, _
                  "TEST_038", _
                  "Geçici kaynak tahakkuk Repository'den okunamadý."

    End If

    If StrComp( _
            Trim$(SourceCharge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 8808, _
                  "TEST_038", _
                  "Kaynak tahakkuk RESMI deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 8809, _
                  "TEST_038", _
                  "Kaynak tahakkuk NORMAL deðil."

    End If

    '==========================================================================
    ' 7 - GEÇERSÝZ ARTIÞ TARÝHÝ ÝLE ARTIS DENEMESÝ
    '==========================================================================

    AdjustmentChargeID = 0
    ErrorOccurred = False
    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    AdjustmentChargeID = _
        Service.AddOfficialChargeAdjustment( _
            SourceChargeID, _
            AdjustmentDate, _
            AdjustmentAmount, _
            "TEST-038-ARTIS", _
            0, _
            "TEST-038 - Geçersiz artýþ tarihi")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 8 - SERVICE REDDÝ KONTROLÜ
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 8810, _
                  "TEST_038", _
                  "Geçersiz AdjustmentDate Service tarafýndan reddedilmedi."

    End If

    '==========================================================================
    ' 9 - ARTIS KAYDI OLUÞMAMALI
    '==========================================================================

    If AdjustmentChargeID <> 0 Then

        Err.Raise vbObjectError + 8811, _
                  "TEST_038", _
                  "Geçersiz artýþ tarihinde ARTIS ChargeID oluþtu: " & _
                  AdjustmentChargeID

    End If

    '==========================================================================
    ' 10 - GERÇEK SERVICE HATA MESAJI
    '==========================================================================

    If InStr( _
            1, _
            ErrorDescription, _
            "Artýþ tarihi girilmelidir.", _
            vbTextCompare) = 0 Then

        Err.Raise vbObjectError + 8812, _
                  "TEST_038", _
                  "Beklenen artýþ tarihi doðrulama mesajý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan mesaj:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 11 - KAYNAK KAYDI CLEANUP
    '==========================================================================

    On Error Resume Next

    Err.Clear

    DeleteTestCharge SourceChargeID

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 8813, _
                  "TEST_038", _
                  "Geçici kaynak tahakkuk cleanup edilemedi." & _
                  vbCrLf & ErrorDescription

    End If

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 12 - CLEANUP SONRASI KONTROL
    '==========================================================================

    If Not Repo.GetByID(SourceChargeID) Is Nothing Then

        Err.Raise vbObjectError + 8814, _
                  "TEST_038", _
                  "Cleanup sonrasýnda kaynak tahakkuk hâlâ mevcut."

    End If

    '==========================================================================
    ' 13 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-038 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "Kaynak ChargeID  : " & SourceChargeID & vbCrLf & _
        "Artýþ tarihi     : 0 (GEÇERSÝZ)" & vbCrLf & _
        "Artýþ tutarý     : " & AdjustmentAmount & " TL" & vbCrLf & vbCrLf & _
        "Kaynak RESMI     : OK" & vbCrLf & _
        "Service reddi    : OK" & vbCrLf & _
        "ARTIS kaydý      : YOK" & vbCrLf & _
        "Cleanup          : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BEKLENEN RET", _
        vbInformation, _
        "OAA - TEST-038"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If AdjustmentChargeID > 0 Then

        DeleteTestCharge AdjustmentChargeID

    End If

    If SourceChargeID > 0 Then

        DeleteTestCharge SourceChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-038 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description, _
        vbCritical, _
        "OAA - TEST-038"

End Sub

'==============================================================================
' TEST-039
'
' RESMI AÝDAT ARTISI - GEÇERSÝZ ARTIÞ TUTARI REDDÝ
'
' AMAÇ:
'
'   AddOfficialChargeAdjustment metodunun sýfýr / negatif AdjustmentAmount
'   deðerini Service katmanýnda reddettiðini doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   AdjustmentAmount <= 0
'       -> vbObjectError + 7243
'       -> "Artýþ tutarý sýfýrdan büyük olmalýdýr."
'
' TEST AKIÞI:
'
'   1. Aktif üye bulunur.
'   2. Kullanýlmamýþ RESMI dönem seçilir.
'   3. Geçici NORMAL RESMI tahakkuk oluþturulur.
'   4. SourceChargeID kaynak olarak kullanýlýr.
'   5. Geçerli AdjustmentDate ile AdjustmentAmount = 0 denenir.
'   6. Service iþlemi reddetmelidir.
'   7. ARTIS kaydý oluþmamalýdýr.
'   8. Kaynak tahakkuk cleanup ile silinir.
'==============================================================================

Public Sub TEST_039()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember
    Dim SourceCharge As clsMemberCharge

    Dim TestMemberID As Long

    Dim SourceChargeID As Long
    Dim AdjustmentChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim AdjustmentDate As Date

    Dim Amount As Currency
    Dim AdjustmentAmount As Currency

    Dim PeriodEndDate As Date

    Dim ErrorOccurred As Boolean
    Dim ErrorDescription As String

    Dim PeriodFound As Boolean

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    SourceChargeID = 0
    AdjustmentChargeID = 0

    '==========================================================================
    ' 2 - TEST PARAMETRELERÝ
    '==========================================================================

    FiscalYear = 2098

    Amount = 500@

    ' GEÇERSÝZ ARTIÞ TUTARI
    AdjustmentAmount = 0@

    ChargeDate = DateSerial(2098, 1, 1)

    ' GEÇERLÝ ARTIÞ TARÝHÝ
    AdjustmentDate = DateSerial(2098, 2, 1)

    PeriodEndDate = DateSerial(2098, 12, 31)

    '==========================================================================
    ' 3 - AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 8901, _
                  "TEST_039", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 8902, _
                  "TEST_039", _
                  "Test için üye bulunamadý."

    End If

    TestMemberID = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID

                Exit For

            End If

        End If

    Next Member

    If TestMemberID <= 0 Then

        Err.Raise vbObjectError + 8903, _
                  "TEST_039", _
                  "Test için aktif üye bulunamadý."

    End If

    '==========================================================================
    ' 4 - KULLANILMAMIÞ RESMI DÖNEM BUL
    '==========================================================================

    PeriodFound = False

    For DueMonth = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                DueMonth, _
                "RESMI") Then

            PeriodFound = True
            Exit For

        End If

    Next DueMonth

    If Not PeriodFound Then

        Err.Raise vbObjectError + 8904, _
                  "TEST_039", _
                  "TEST için kullanýlmamýþ RESMI dönem bulunamadý."


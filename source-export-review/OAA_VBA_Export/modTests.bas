                  "TEST_098", _
                  "Test sonrasinda uyenin Status degeri degisti." & _
                  vbCrLf & _
                  "Beklenen : Ýzinli" & _
                  vbCrLf & _
                  "Alinan   : " & Member.Status

    End If

    '==========================================================================
    ' 14 - BASARILI
    '==========================================================================

    Mesaj = "TEST-098 BASARILI." & vbCrLf & vbCrLf

    Mesaj = Mesaj & "Test edilen API : AddMeetingCharge" & vbCrLf


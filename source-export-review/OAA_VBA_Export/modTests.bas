    On Error GoTo ErrorHandler


    '======================================================================
    ' 1 - NESNELER
    '======================================================================

    Set Service = New clsMemberChargeService


    '======================================================================
    ' 2 - TEST PARAMETRELERÝ
    '======================================================================

    TestFiscalYear = 2027
    TestDueMonth = 1
    TestAmount = 500@

    TestChargeDate = DateSerial(2027, 1, 1)
    TestPeriodEnd = DateSerial(2027, 12, 31)


    '======================================================================
    ' 3 - TAHAKKUK TABLOSUNU AL
    '======================================================================

    Set wsCharges = _
        ThisWorkbook.Worksheets("ÜyeBorçlarý")

    Set tblCharges = _
        wsCharges.ListObjects("TBL_MEMBER_CHARGES")


    '======================================================================
    ' 4 - TABLO KONTROLÜ
    '======================================================================

    If tblCharges Is Nothing Then

        Err.Raise vbObjectError + 7401, _
                  "TEST_017", _
                  "TBL_MEMBER_CHARGES tablosu bulunamadý."

    End If


    '======================================================================
    ' 5 - SÜTUNLARI BUL
    '======================================================================

    ColChargeID = _
        tblCharges.ListColumns("ChargeID").Index

    ColMemberID = _
        tblCharges.ListColumns("MemberID").Index

    ColChargeType = _
        tblCharges.ListColumns("ChargeType").Index

    ColFiscalYear = _
        tblCharges.ListColumns("FiscalYear").Index

    ColDueMonth = _
        tblCharges.ListColumns("DueMonth").Index

    ColAmount = _
        tblCharges.ListColumns("Amount").Index

    ColAdjustmentType = _
        tblCharges.ListColumns("AdjustmentType").Index

    ColSourceChargeID = _
        tblCharges.ListColumns("SourceChargeID").Index

    ColDecisionNo = _
        tblCharges.ListColumns("DecisionNo").Index

    ColStatus = _
        tblCharges.ListColumns("Status").Index


    '======================================================================
    ' 6 - ESKÝ TEST KAYITLARINI TEMÝZLE
    '
    ' Önceki baþarýsýz bir testten kayýt kalmýþ olabilir.
    '======================================================================

    If Not tblCharges.DataBodyRange Is Nothing Then

        Dim CleanIndex As Long
        Dim CleanDecisionNo As String

        For CleanIndex = tblCharges.ListRows.Count To 1 Step -1

            CleanDecisionNo = _
                Trim$(CStr( _
                    tblCharges.ListRows(CleanIndex).Range.Cells( _
                        1, _
                        ColDecisionNo).Value))

            If CleanDecisionNo = "TEST-017" _
               Or CleanDecisionNo = "TEST-017-TEKRAR" Then

                tblCharges.ListRows(CleanIndex).Delete

            End If

        Next CleanIndex

    End If


    '======================================================================
    ' 7 - ÝLK TOPLU TAHAKKUK
    '======================================================================

    CreatedCount = 0
    SkippedCount = 0
    ErrorCount = 0

    Service.AddBulkOfficialCharges _
        TestFiscalYear, _
        TestDueMonth, _
        TestChargeDate, _
        TestAmount, _
        TestPeriodEnd, _
        "TEST-017", _
        DateSerial(2027, 1, 1), _
        "TEST-017 - Toplu resmi aidat", _
        CreatedCount, _
        SkippedCount, _
        ErrorCount


    '======================================================================
    ' 8 - SERVÝS HATA KONTROLÜ
    '======================================================================

    If ErrorCount <> 0 Then

        Err.Raise vbObjectError + 7402, _
                  "TEST_017", _
                  "Toplu tahakkuk sýrasýnda hata oluþtu."

    End If


    '======================================================================
    ' 9 - EN AZ BÝR TAHAKKUK OLUÞMALI
    '======================================================================

    If CreatedCount <= 0 Then

        Err.Raise vbObjectError + 7403, _
                  "TEST_017", _
                  "Hiçbir toplu resmi aidat tahakkuku oluþturulmadý."

    End If


    '======================================================================
    ' 10 - OLUÞAN TEST KAYITLARINI KONTROL ET
    '======================================================================

    TestRecordCount = 0


    If Not tblCharges.DataBodyRange Is Nothing Then

        For Each lrCharge In tblCharges.ListRows

            If Trim$(CStr( _
                lrCharge.Range.Cells(1, ColDecisionNo).Value)) = _
                "TEST-017" Then


                TestRecordCount = TestRecordCount + 1


                '----------------------------------------------------------
                ' ChargeID
                '----------------------------------------------------------

                ChargeID = CLng( _
                    lrCharge.Range.Cells(1, ColChargeID).Value)

                If ChargeID <= 0 Then

                    Err.Raise vbObjectError + 7404, _
                              "TEST_017", _
                              "Geçersiz ChargeID oluþturuldu."

                End If


                '----------------------------------------------------------
                ' MemberID
                '----------------------------------------------------------

                If CLng( _
                    lrCharge.Range.Cells(1, ColMemberID).Value) <= 0 Then

                    Err.Raise vbObjectError + 7405, _
                              "TEST_017", _
                              "Geçersiz MemberID."

                End If


                '----------------------------------------------------------
                ' ChargeType
                '----------------------------------------------------------

                If UCase$(Trim$(CStr( _
                    lrCharge.Range.Cells(1, ColChargeType).Value))) <> _
                    "RESMI" Then

                    Err.Raise vbObjectError + 7406, _
                              "TEST_017", _
                              "ChargeType RESMI deðil."

                End If


                '----------------------------------------------------------
                ' FiscalYear
                '----------------------------------------------------------

                If CLng( _
                    lrCharge.Range.Cells(1, ColFiscalYear).Value) <> _
                    TestFiscalYear Then

                    Err.Raise vbObjectError + 7407, _
                              "TEST_017", _
                              "FiscalYear hatalý."

                End If


                '----------------------------------------------------------
                ' DueMonth
                '----------------------------------------------------------

                If CLng( _
                    lrCharge.Range.Cells(1, ColDueMonth).Value) <> _
                    TestDueMonth Then

                    Err.Raise vbObjectError + 7408, _
                              "TEST_017", _
                              "DueMonth hatalý."

                End If


                '----------------------------------------------------------
                ' Amount
                '----------------------------------------------------------

                If CCur( _
                    lrCharge.Range.Cells(1, ColAmount).Value) <> _
                    TestAmount Then

                    Err.Raise vbObjectError + 7409, _
                              "TEST_017", _
                              "Aidat tutarý 500 TL deðil."

                End If


                '----------------------------------------------------------
                ' AdjustmentType
                '----------------------------------------------------------

                If UCase$(Trim$(CStr( _
                    lrCharge.Range.Cells(1, ColAdjustmentType).Value))) <> _
                    "NORMAL" Then

                    Err.Raise vbObjectError + 7410, _
                              "TEST_017", _
                              "AdjustmentType NORMAL deðil."

                End If


                '----------------------------------------------------------
                ' SourceChargeID
                '----------------------------------------------------------

                If Val( _
                    lrCharge.Range.Cells(1, ColSourceChargeID).Value) <> 0 Then

                    Err.Raise vbObjectError + 7411, _
                              "TEST_017", _
                              "NORMAL kaydýn SourceChargeID deðeri sýfýr deðil."

                End If


                '----------------------------------------------------------
                ' DecisionNo
                '----------------------------------------------------------

                If Trim$(CStr( _
                    lrCharge.Range.Cells(1, ColDecisionNo).Value)) <> _
                    "TEST-017" Then

                    Err.Raise vbObjectError + 7412, _
                              "TEST_017", _
                              "DecisionNo hatalý."

                End If


                '----------------------------------------------------------
                ' Status
                '----------------------------------------------------------

                If UCase$(Trim$(CStr( _
                    lrCharge.Range.Cells(1, ColStatus).Value))) <> _
                    "AKTIF" Then

                    Err.Raise vbObjectError + 7413, _
                              "TEST_017", _
                              "Tahakkuk Status deðeri AKTIF deðil."

                End If

            End If

        Next lrCharge

    End If


    '======================================================================
    ' 11 - GERÇEK KAYIT SAYISI KONTROLÜ
    '======================================================================

    If TestRecordCount <> CreatedCount Then

        Err.Raise vbObjectError + 7414, _
                  "TEST_017", _
                  "Oluþturulan kayýt sayýsý ile gerçek kayýt sayýsý uyuþmuyor."

    End If


    '======================================================================
    ' 12 - AYNI TOPLU TAHAKKUKU ÝKÝNCÝ KEZ ÇALIÞTIR
    '
    ' BEKLENEN:
    '   Yeni kayýt = 0
    '======================================================================

    CreatedCount2 = 0
    SkippedCount2 = 0
    ErrorCount2 = 0


    Service.AddBulkOfficialCharges _
        TestFiscalYear, _
        TestDueMonth, _
        TestChargeDate, _
        TestAmount, _
        TestPeriodEnd, _
        "TEST-017-TEKRAR", _
        DateSerial(2027, 1, 1), _
        "TEST-017 - Tekrar deneme", _
        CreatedCount2, _
        SkippedCount2, _
        ErrorCount2


    '======================================================================
    ' 13 - ÝKÝNCÝ ÇALIÞTIRMADA HATA OLMAMALI
    '======================================================================

    If ErrorCount2 <> 0 Then

        Err.Raise vbObjectError + 7415, _
                  "TEST_017", _
                  "Ýkinci toplu çalýþtýrmada hata oluþtu."

    End If


    '======================================================================
    ' 14 - MÜKERRER KAYIT OLUÞMAMALI
    '======================================================================

    If CreatedCount2 <> 0 Then

        Err.Raise vbObjectError + 7416, _
                  "TEST_017", _
                  "Mükerrer NORMAL resmi aidat oluþturuldu."

    End If


    '======================================================================
    ' 15 - TEST-017-TEKRAR KAYDI OLUÞMAMALI
    '======================================================================

    RepeatRecordCount = 0


    If Not tblCharges.DataBodyRange Is Nothing Then

        For Each lrCharge In tblCharges.ListRows

            If Trim$(CStr( _
                lrCharge.Range.Cells(1, ColDecisionNo).Value)) = _
                "TEST-017-TEKRAR" Then

                RepeatRecordCount = RepeatRecordCount + 1

            End If

        Next lrCharge

    End If


    If RepeatRecordCount <> 0 Then

        Err.Raise vbObjectError + 7417, _
                  "TEST_017", _
                  "TEST-017-TEKRAR kaydý oluþtu."

    End If


    '======================================================================
    ' 16 - TEST KAYITLARINI TEMÝZLE
    '======================================================================

    If Not tblCharges.DataBodyRange Is Nothing Then

        Dim DeleteIndex As Long
        Dim DeleteDecisionNo As String

        For DeleteIndex = tblCharges.ListRows.Count To 1 Step -1

            DeleteDecisionNo = _
                Trim$(CStr( _
                    tblCharges.ListRows(DeleteIndex).Range.Cells( _
                        1, _
                        ColDecisionNo).Value))

            If DeleteDecisionNo = "TEST-017" _
               Or DeleteDecisionNo = "TEST-017-TEKRAR" Then

                tblCharges.ListRows(DeleteIndex).Delete

            End If

        Next DeleteIndex

    End If


    '======================================================================
    ' 17 - BAÞARILI
    '======================================================================

    MsgBox _
        "TEST-017 BAÞARILI." & vbCrLf & vbCrLf & _
        "Mali yýl             : 2027" & vbCrLf & _
        "Aidat ayý            : Ocak" & vbCrLf & _
        "Aidat tutarý         : 500 TL" & vbCrLf & vbCrLf & _
        "Oluþturulan kayýt    : " & CreatedCount & vbCrLf & _
        "Atlanan kayýt        : " & SkippedCount & vbCrLf & _
        "Hata                 : " & ErrorCount & vbCrLf & _
        "Alan kontrolleri     : OK" & vbCrLf & _
        "Mükerrer kontrol     : OK" & vbCrLf & _
        "2. çalýþtýrma        : 0 yeni kayýt" & vbCrLf & _
        "Test kayýtlarý       : SÝLÝNDÝ", _
        vbInformation, _
        "OAA - TEST-017"


    Exit Sub


'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    ErrorNo = Err.Number
    ErrorDesc = Err.Description


    On Error Resume Next


    '----------------------------------------------------------------------
    ' HATA DURUMUNDA TEST KAYITLARINI TEMÝZLE
    '----------------------------------------------------------------------

    If Not tblCharges Is Nothing Then

        If Not tblCharges.DataBodyRange Is Nothing Then

            Dim ErrorDeleteIndex As Long
            Dim ErrorDecisionNo As String

            For ErrorDeleteIndex = _
                tblCharges.ListRows.Count To 1 Step -1

                ErrorDecisionNo = _
                    Trim$(CStr( _
                        tblCharges.ListRows(ErrorDeleteIndex).Range.Cells( _
                            1, _
                            ColDecisionNo).Value))

                If ErrorDecisionNo = "TEST-017" _
                   Or ErrorDecisionNo = "TEST-017-TEKRAR" Then

                    tblCharges.ListRows(ErrorDeleteIndex).Delete

                End If

            Next ErrorDeleteIndex

        End If

    End If


    On Error GoTo 0


    '----------------------------------------------------------------------
    ' HATA MESAJI
    '----------------------------------------------------------------------

    MsgBox _
        "TEST-017 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & ErrorNo & vbCrLf & _
        "Açýklama: " & ErrorDesc & vbCrLf & vbCrLf & _
        "Test kayýtlarý temizlendi.", _
        vbCritical, _
        "OAA - TEST-017"

End Sub
'==============================================================================
' TEST-018
' ÜYE BAZINDA BORÇ BAKÝYESÝ
'
' Senaryo:
'
'   NORMAL RESMI AÝDAT       : 500 TL
'   1. ARTIÞ                 : 200 TL
'   2. ARTIÞ                 : 100 TL
'   ----------------------------------
'   BEKLENEN BORÇ            : 800 TL
'
' Amaç:
'   Ayný üyeye ait aktif tahakkuklarýn toplamýnýn doðru hesaplandýðýný
'   doðrulamak.
'
' Test kayýtlarý:
'   TEST-018-NORMAL
'   TEST-018-ARTIS1
'   TEST-018-ARTIS2
'
' Test sonunda bütün kayýtlar silinir.
'==============================================================================

Public Sub TEST_018()

    Dim Repo As clsMemberChargeRepository

    Dim wsCharges As Worksheet
    Dim tblCharges As ListObject
    Dim lrCharge As ListRow

    Dim TestMemberID As Long

    Dim NormalChargeID As Long
    Dim Adjustment1ID As Long
    Dim Adjustment2ID As Long

    Dim ExpectedBalance As Currency
    Dim CalculatedBalance As Currency

    Dim AmountValue As Currency
    Dim StatusValue As String
    Dim MemberValue As Long
    Dim DecisionValue As String

    Dim ColMemberID As Long
    Dim ColAmount As Long
    Dim ColStatus As Long
    Dim ColDecisionNo As Long

    Dim DeleteIndex As Long
    Dim DeleteDecision As String

    On Error GoTo ErrorHandler


    '======================================================================
    ' REPOSITORY
    '======================================================================

    Set Repo = New clsMemberChargeRepository


    '======================================================================
    ' TEST ÜYESÝ
    '======================================================================

    TestMemberID = 3


    '======================================================================
    ' BEKLENEN BAKÝYE
    '======================================================================

    ExpectedBalance = 800@


    '======================================================================
    ' TAHAKKUK TABLOSU
    '======================================================================

    Set wsCharges = _
        ThisWorkbook.Worksheets("ÜyeBorçlarý")

    Set tblCharges = _
        wsCharges.ListObjects("TBL_MEMBER_CHARGES")


    '======================================================================
    ' SÜTUNLAR
    '======================================================================

    ColMemberID = _
        tblCharges.ListColumns("MemberID").Index

    ColAmount = _
        tblCharges.ListColumns("Amount").Index

    ColStatus = _
        tblCharges.ListColumns("Status").Index

    ColDecisionNo = _
        tblCharges.ListColumns("DecisionNo").Index


    '======================================================================
    ' ÖNCEKÝ TEST KAYITLARINI TEMÝZLE
    '======================================================================

    If Not tblCharges.DataBodyRange Is Nothing Then

        For DeleteIndex = _
            tblCharges.ListRows.Count To 1 Step -1

            DeleteDecision = _
                Trim$(CStr( _
                    tblCharges.ListRows(DeleteIndex).Range.Cells( _
                        1, _
                        ColDecisionNo).Value))

            If DeleteDecision = "TEST-018-NORMAL" _
               Or DeleteDecision = "TEST-018-ARTIS1" _
               Or DeleteDecision = "TEST-018-ARTIS2" Then

                tblCharges.ListRows(DeleteIndex).Delete

            End If

        Next DeleteIndex

    End If


    '======================================================================
    ' 1 - NORMAL AÝDAT
    '======================================================================

    Dim NormalCharge As clsMemberCharge

    Set NormalCharge = New clsMemberCharge

    With NormalCharge

        .MemberID = TestMemberID
        .ChargeType = "RESMI"
        .ChargeDate = DateSerial(2027, 1, 1)
        .FiscalYear = 2027
        .DueMonth = 1
        .Amount = 500@
        .AdjustmentType = "NORMAL"
        .SourceChargeID = 0
        .Description = "TEST-018 NORMAL"
        .DecisionNo = "TEST-018-NORMAL"
        .DecisionDate = DateSerial(2027, 1, 1)
        .EntryDate = Now
        .Status = "AKTIF"

    End With

    NormalChargeID = Repo.Add(NormalCharge)

    If NormalChargeID <= 0 Then

        Err.Raise vbObjectError + 7501, _
                  "TEST_018", _
                  "NORMAL tahakkuk oluþturulamadý."

    End If


    '======================================================================
    ' 2 - BÝRÝNCÝ ARTIÞ
    '======================================================================

    Dim Adjustment1 As clsMemberCharge

    Set Adjustment1 = New clsMemberCharge

    With Adjustment1

        .MemberID = TestMemberID
        .ChargeType = "RESMI"
        .ChargeDate = DateSerial(2027, 2, 1)
        .FiscalYear = 2027
        .DueMonth = 1
        .Amount = 200@
        .AdjustmentType = "ARTIS"
        .SourceChargeID = NormalChargeID
        .Description = "TEST-018 BÝRÝNCÝ ARTIÞ"
        .DecisionNo = "TEST-018-ARTIS1"
        .DecisionDate = DateSerial(2027, 2, 1)
        .EntryDate = Now
        .Status = "AKTIF"

    End With

    Adjustment1ID = Repo.Add(Adjustment1)

    If Adjustment1ID <= 0 Then

        Err.Raise vbObjectError + 7502, _
                  "TEST_018", _
                  "Birinci artýþ oluþturulamadý."

    End If


    '======================================================================
    ' 3 - ÝKÝNCÝ ARTIÞ
    '======================================================================

    Dim Adjustment2 As clsMemberCharge

    Set Adjustment2 = New clsMemberCharge

    With Adjustment2

        .MemberID = TestMemberID
        .ChargeType = "RESMI"
        .ChargeDate = DateSerial(2027, 6, 1)
        .FiscalYear = 2027
        .DueMonth = 1
        .Amount = 100@
        .AdjustmentType = "ARTIS"
        .SourceChargeID = NormalChargeID
        .Description = "TEST-018 ÝKÝNCÝ ARTIÞ"
        .DecisionNo = "TEST-018-ARTIS2"
        .DecisionDate = DateSerial(2027, 6, 1)
        .EntryDate = Now
        .Status = "AKTIF"

    End With

    Adjustment2ID = Repo.Add(Adjustment2)

    If Adjustment2ID <= 0 Then

        Err.Raise vbObjectError + 7503, _
                  "TEST_018", _
                  "Ýkinci artýþ oluþturulamadý."

    End If


    '======================================================================
    ' 4 - ÜYE BAKÝYESÝNÝ HESAPLA
    '
    ' Sadece:
    '   MemberID = TestMemberID
    '   Status   = AKTIF
    '
    ' olan tahakkuklar toplanýr.
    '======================================================================

    CalculatedBalance = 0@


    If Not tblCharges.DataBodyRange Is Nothing Then

        For Each lrCharge In tblCharges.ListRows

            MemberValue = CLng( _
                lrCharge.Range.Cells(1, ColMemberID).Value)

            If MemberValue = TestMemberID Then

                StatusValue = _
                    UCase$(Trim$(CStr( _
                        lrCharge.Range.Cells(1, ColStatus).Value)))

                If StatusValue = "AKTIF" Then

                    DecisionValue = _
                        Trim$(CStr( _
                            lrCharge.Range.Cells(1, ColDecisionNo).Value))

                    If DecisionValue = "TEST-018-NORMAL" _
                       Or DecisionValue = "TEST-018-ARTIS1" _
                       Or DecisionValue = "TEST-018-ARTIS2" Then

                        AmountValue = CCur( _
                            lrCharge.Range.Cells(1, ColAmount).Value)

                        CalculatedBalance = _
                            CalculatedBalance + AmountValue

                    End If

                End If

            End If

        Next lrCharge

    End If


    '======================================================================
    ' 5 - BAKÝYE KONTROLÜ
    '======================================================================

    If CalculatedBalance <> ExpectedBalance Then

        Err.Raise vbObjectError + 7504, _
                  "TEST_018", _
                  "Üye borç bakiyesi hatalý." & vbCrLf & _
                  "Beklenen: " & ExpectedBalance & vbCrLf & _
                  "Hesaplanan: " & CalculatedBalance

    End If


    '======================================================================
    ' 6 - KAYITLARIN ÜYEYE AÝT OLDUÐUNU KONTROL ET
    '======================================================================

    If TestMemberID <= 0 Then

        Err.Raise vbObjectError + 7505, _
                  "TEST_018", _
                  "Geçersiz test üyesi."

    End If


    '======================================================================
    ' 7 - TEST KAYITLARINI SÝL
    '======================================================================

    If Not tblCharges.DataBodyRange Is Nothing Then

        For DeleteIndex = _
            tblCharges.ListRows.Count To 1 Step -1

            DeleteDecision = _
                Trim$(CStr( _
                    tblCharges.ListRows(DeleteIndex).Range.Cells( _
                        1, _
                        ColDecisionNo).Value))

            If DeleteDecision = "TEST-018-NORMAL" _
               Or DeleteDecision = "TEST-018-ARTIS1" _
               Or DeleteDecision = "TEST-018-ARTIS2" Then

                tblCharges.ListRows(DeleteIndex).Delete

            End If

        Next DeleteIndex

    End If


    '======================================================================
    ' 8 - BAÞARILI
    '======================================================================

    MsgBox _
        "TEST-018 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi          : " & TestMemberID & vbCrLf & _
        "Normal aidat        : 500 TL" & vbCrLf & _
        "1. artýþ            : 200 TL" & vbCrLf & _
        "2. artýþ            : 100 TL" & vbCrLf & _
        "-----------------------------" & vbCrLf & _
        "Beklenen bakiye     : 800 TL" & vbCrLf & _
        "Hesaplanan bakiye   : " & _
            Format$(CalculatedBalance, "#,##0.00") & " TL" & vbCrLf & _
        "Bakiye kontrolü     : OK" & vbCrLf & _
        "Test kayýtlarý      : SÝLÝNDÝ", _
        vbInformation, _
        "OAA - TEST-018"


    Exit Sub


'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    Dim ErrorNo As Long
    Dim ErrorDescription As String

    ErrorNo = Err.Number
    ErrorDescription = Err.Description


    On Error Resume Next


    '----------------------------------------------------------------------
    ' Test kayýtlarýný temizle
    '----------------------------------------------------------------------

    If Not tblCharges Is Nothing Then

        If Not tblCharges.DataBodyRange Is Nothing Then

            For DeleteIndex = _
                tblCharges.ListRows.Count To 1 Step -1

                DeleteDecision = _
                    Trim$(CStr( _
                        tblCharges.ListRows(DeleteIndex).Range.Cells( _
                            1, _
                            ColDecisionNo).Value))

                If DeleteDecision = "TEST-018-NORMAL" _
                   Or DeleteDecision = "TEST-018-ARTIS1" _
                   Or DeleteDecision = "TEST-018-ARTIS2" Then

                    tblCharges.ListRows(DeleteIndex).Delete

                End If

            Next DeleteIndex

        End If

    End If


    On Error GoTo 0


    MsgBox _
        "TEST-018 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & ErrorNo & vbCrLf & _
        "Açýklama: " & ErrorDescription & vbCrLf & vbCrLf & _
        "Test kayýtlarý temizlendi.", _
        vbCritical, _
        "OAA - TEST-018"

End Sub
Public Sub TEST_019()

    Dim Service As clsMemberChargeService

    Dim TestMemberID As Long
    Dim Balance As Currency

    On Error GoTo ErrorHandler

    '==============================================================
    ' TEST ÜYESÝ
    '==============================================================

    TestMemberID = 3


    '==============================================================
    ' SERVICE
    '==============================================================

    Set Service = New clsMemberChargeService


    '==============================================================
    ' ÜYE BAKÝYESÝNÝ SERVICE ÜZERÝNDEN AL
    '==============================================================

    Balance = Service.GetMemberBalance(TestMemberID)


    '==============================================================
    ' KONTROL
    '
    ' TEST-018 kayýtlarý temizlendiði için burada mevcut gerçek
    ' bakiye 0 olabilir.
    '
    ' Bu nedenle TEST-019'un ilk amacý metodun çalýþmasýný ve
    ' hata vermeden bakiye döndürmesini doðrulamaktýr.
    '==============================================================

    If Balance < 0 Then

        Err.Raise vbObjectError + 7601, _
                  "TEST_019", _
                  "Üye bakiyesi negatif döndü."

    End If


    '==============================================================
    ' BAÞARILI
    '==============================================================

    MsgBox _
        "TEST-019 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi      : " & TestMemberID & vbCrLf & _
        "GetMemberBalance: OK" & vbCrLf & _
        "Dönen bakiye    : " & _
            Format$(Balance, "#,##0.00") & " TL", _
        vbInformation, _
        "OAA - TEST-019"

    Exit Sub


'==============================================================
' HATA
'==============================================================

ErrorHandler:

    MsgBox _
        "TEST-019 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description, _
        vbCritical, _
        "OAA - TEST-019"

End Sub

'==============================================================================
' TEST-020
'
' Gerçek üye bakiye hesabý
'
' TEST:
'   NORMAL RESMI     : 500 TL
'   ARTIS            : 200 TL
'   SAIR BORÇ        : 100 TL
'   -------------------------
'   TOPLAM           : 800 TL
'
' Amaç:
'   GetMemberBalance metodunun gerçek Service kayýtlarý üzerinden
'   doðru toplamý hesapladýðýný doðrulamak.
'
' Test kayýtlarý:
'   DecisionNo = TEST-020
'
' Test sonunda:
'   TEST-020 kayýtlarý silinir.
'==============================================================================

Public Sub TEST_020()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository

    Dim TestMemberID As Long

    Dim BeforeBalance As Currency
    Dim AfterBalance As Currency
    Dim ExpectedBalance As Currency

    Dim NormalChargeID As Long
    Dim AdjustmentChargeID As Long
    Dim OtherChargeID As Long

    Dim NormalCharge As clsMemberCharge
    Dim AdjustmentCharge As clsMemberCharge
    Dim OtherCharge As clsMemberCharge

    Dim ws As Worksheet
    Dim tbl As ListObject
    Dim I As Long

    Dim DeleteCount As Long

    On Error GoTo ErrorHandler

    '==========================================================================
    ' NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository

    '==========================================================================
    ' TEST ÜYESÝ
    '
    ' Önceki testlerde kullandýðýmýz üye.
    '==========================================================================

    TestMemberID = 3

    '==========================================================================
    ' TEST ÖNCESÝ BAKÝYE
    '==========================================================================

    BeforeBalance = Service.GetMemberBalance(TestMemberID)

    '==========================================================================
    ' 1 - NORMAL RESMI AÝDAT
    '
    ' 500 TL
    '==========================================================================

    NormalChargeID = Service.AddOfficialCharge( _
        TestMemberID, _
        2027, _
        1, _
        DateSerial(2027, 1, 1), _
        500@, _
        DateSerial(2027, 12, 31), _
        "TEST-020", _
        DateSerial(2027, 1, 1), _
        "TEST-020 - Normal resmi aidat")

    If NormalChargeID <= 0 Then

        Err.Raise vbObjectError + 7501, _
                  "TEST_020", _
                  "NORMAL resmi aidat oluþturulamadý."

    End If

    '==========================================================================
    ' 2 - RESMI AÝDAT ARTIÞI
    '
    ' 200 TL
    '
    ' SourceChargeID = NormalChargeID
    '==========================================================================

    AdjustmentChargeID = Service.AddOfficialChargeAdjustment( _
        NormalChargeID, _
        DateSerial(2027, 2, 1), _
        200@, _
        "TEST-020", _
        DateSerial(2027, 2, 1), _
        "TEST-020 - Resmi aidat artýþý")

    If AdjustmentChargeID <= 0 Then

        Err.Raise vbObjectError + 7502, _
                  "TEST_020", _
                  "RESMI aidat artýþý oluþturulamadý."

    End If

    '==========================================================================
    ' 3 - SAÝR BORÇ
    '
    ' 100 TL
    '==========================================================================

    OtherChargeID = Service.AddOtherCharge( _
        TestMemberID, _
        DateSerial(2027, 3, 1), _
        100@, _
        "TEST-020 - Sair borç", _
        "TEST-020", _
        DateSerial(2027, 3, 1))

    If OtherChargeID <= 0 Then

        Err.Raise vbObjectError + 7503, _
                  "TEST_020", _
                  "SAÝR borç oluþturulamadý."

    End If

    '==========================================================================
    ' KAYITLARI DOÐRULA
    '==========================================================================

    Set NormalCharge = Repo.GetByID(NormalChargeID)

    If NormalCharge Is Nothing Then

        Err.Raise vbObjectError + 7504, _
                  "TEST_020", _
                  "NORMAL kayýt Repository'den okunamadý."

    End If

    If NormalCharge.Amount <> 500@ Then

        Err.Raise vbObjectError + 7505, _
                  "TEST_020", _
                  "NORMAL kayýt tutarý 500 TL deðil."

    End If

    If NormalCharge.AdjustmentType <> "NORMAL" Then

        Err.Raise vbObjectError + 7506, _
                  "TEST_020", _
                  "NORMAL kayýt AdjustmentType hatalý."

    End If


    Set AdjustmentCharge = Repo.GetByID(AdjustmentChargeID)

    If AdjustmentCharge Is Nothing Then

        Err.Raise vbObjectError + 7507, _
                  "TEST_020", _
                  "ARTIS kayýt Repository'den okunamadý."

    End If

    If AdjustmentCharge.Amount <> 200@ Then

        Err.Raise vbObjectError + 7508, _
                  "TEST_020", _
                  "ARTIS kayýt tutarý 200 TL deðil."

    End If

    If AdjustmentCharge.AdjustmentType <> "ARTIS" Then

        Err.Raise vbObjectError + 7509, _
                  "TEST_020", _
                  "ARTIS kayýt AdjustmentType hatalý."

    End If

    If AdjustmentCharge.SourceChargeID <> NormalChargeID Then

        Err.Raise vbObjectError + 7510, _
                  "TEST_020", _
                  "ARTIS kaydýnýn SourceChargeID deðeri hatalý."

    End If


    Set OtherCharge = Repo.GetByID(OtherChargeID)

    If OtherCharge Is Nothing Then

        Err.Raise vbObjectError + 7511, _
                  "TEST_020", _
                  "SAIR kayýt Repository'den okunamadý."

    End If

    If OtherCharge.Amount <> 100@ Then

        Err.Raise vbObjectError + 7512, _
                  "TEST_020", _
                  "SAIR kayýt tutarý 100 TL deðil."

    End If

    '==========================================================================
    ' 4 - BAKÝYE HESABI
    '==========================================================================

    AfterBalance = Service.GetMemberBalance(TestMemberID)

    ExpectedBalance = BeforeBalance + 800@

    If AfterBalance <> ExpectedBalance Then

        Err.Raise vbObjectError + 7513, _
                  "TEST_020", _
                  "Bakiye hesabý hatalý." & vbCrLf & _
                  "Beklenen: " & Format$(ExpectedBalance, "#,##0.00") & _
                  " TL" & vbCrLf & _
                  "Gerçek: " & Format$(AfterBalance, "#,##0.00") & _
                  " TL"

    End If

    '==========================================================================
    ' 5 - TEST KAYITLARINI SÝL
    '
    ' Repository'de Delete metodu olmadýðý için test kayýtlarýný doðrudan
    ' tablo satýrlarýndan temizliyoruz.
    '
    ' SADECE DecisionNo = TEST-020 olan kayýtlar silinir.
    '==========================================================================

    Set ws = ThisWorkbook.Worksheets("ÜyeBorçlarý")
    Set tbl = ws.ListObjects("TBL_MEMBER_CHARGES")

    DeleteCount = 0

    If Not tbl.DataBodyRange Is Nothing Then

        For I = tbl.ListRows.Count To 1 Step -1

            If CStr(tbl.ListRows(I).Range.Cells( _
                1, tbl.ListColumns("DecisionNo").Index).Value) = _
                "TEST-020" Then

                tbl.ListRows(I).Delete

                DeleteCount = DeleteCount + 1

            End If

        Next I

    End If

    '==========================================================================
    ' TEMÝZLÝK KONTROLÜ
    '==========================================================================

    If DeleteCount <> 3 Then

        Err.Raise vbObjectError + 7514, _
                  "TEST_020", _
                  "TEST-020 kayýtlarýnýn tamamý silinemedi." & vbCrLf & _
                  "Beklenen: 3" & vbCrLf & _
                  "Silinen: " & DeleteCount

    End If

    '==========================================================================
    ' TEMÝZLÝK SONRASI BAKÝYE
    '==========================================================================

    AfterBalance = Service.GetMemberBalance(TestMemberID)

    If AfterBalance <> BeforeBalance Then

        Err.Raise vbObjectError + 7515, _
                  "TEST_020", _
                  "Test kayýtlarý silindikten sonra bakiye eski haline dönmedi." & _
                  vbCrLf & _
                  "Önce: " & Format$(BeforeBalance, "#,##0.00") & " TL" & _
                  vbCrLf & _
                  "Sonra: " & Format$(AfterBalance, "#,##0.00") & " TL"

    End If

    '==========================================================================
    ' BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-020 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "Normal aidat     : 500 TL" & vbCrLf & _
        "Aidat artýþý     : 200 TL" & vbCrLf & _
        "Sair borç        : 100 TL" & vbCrLf & _
        "-----------------------------" & vbCrLf & _
        "Test artýþý      : 800 TL" & vbCrLf & _
        "Önceki bakiye    : " & _
            Format$(BeforeBalance, "#,##0.00") & " TL" & vbCrLf & _
        "Test sonrasý     : " & _
            Format$(BeforeBalance + 800@, "#,##0.00") & " TL" & vbCrLf & _
        "Temizlik sonrasý : " & _
            Format$(AfterBalance, "#,##0.00") & " TL" & vbCrLf & _
        "Silinen kayýt    : " & DeleteCount, _
        vbInformation, _
        "OAA - TEST-020"

    Exit Sub


'==============================================================================
' HATA
'==============================================================================

ErrorHandler:

    MsgBox _
        "TEST-020 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description, _
        vbCritical, _
        "OAA - TEST-020"

End Sub

'==============================================================================
' TEST-021
'
' PASÝF TAHAKKUKA ARTIÞ YAPILAMAMASI
'
' Senaryo:
'
'   1. Geçerli NORMAL RESMI tahakkuk oluþtur.
'   2. Tahakkuku PASIF duruma getir.
'   3. Bu tahakkuka 200 TL artýþ uygulamayý dene.
'   4. Ýþlemin reddedilmesini bekle.
'
' Beklenen:
'
'   "Pasif bir tahakkuka artýþ uygulanamaz."
'
' Test sonunda:
'   TEST-021 kaydý silinir.
'==============================================================================

Public Sub TEST_021()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository

    Dim TestMemberID As Long

    Dim NormalChargeID As Long
    Dim AdjustmentChargeID As Long

    Dim NormalCharge As clsMemberCharge

    Dim ws As Worksheet
    Dim tbl As ListObject

    Dim I As Long
    Dim DeleteCount As Long

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    On Error GoTo ErrorHandler


    '==========================================================================
    ' NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository


    '==========================================================================
    ' TEST ÜYESÝ
    '==========================================================================

    TestMemberID = 3


    '==========================================================================
    ' TEST TABLOSU
    '==========================================================================

    Set ws = _
        ThisWorkbook.Worksheets("ÜyeBorçlarý")

    Set tbl = _
        ws.ListObjects("TBL_MEMBER_CHARGES")


    '==========================================================================
    ' ÖNCEKÝ TEST-021 KAYITLARINI TEMÝZLE
    '==========================================================================

    If Not tbl.DataBodyRange Is Nothing Then

        For I = tbl.ListRows.Count To 1 Step -1

            If CStr( _
                tbl.ListRows(I).Range.Cells( _
                    1, _
                    tbl.ListColumns("DecisionNo").Index).Value) = _
                "TEST-021" Then

                tbl.ListRows(I).Delete

            End If

        Next I

    End If


    '==========================================================================
    ' 1 - NORMAL RESMI TAHAKKUK OLUÞTUR
    '==========================================================================

    NormalChargeID = Service.AddOfficialCharge( _
        TestMemberID, _
        2027, _
        2, _
        DateSerial(2027, 2, 1), _
        500@, _
        DateSerial(2027, 12, 31), _
        "TEST-021", _
        DateSerial(2027, 2, 1), _
        "TEST-021 - Pasif tahakkuk testi")


    If NormalChargeID <= 0 Then

        Err.Raise vbObjectError + 7601, _
                  "TEST_021", _
                  "NORMAL resmi tahakkuk oluþturulamadý."

    End If


    '==========================================================================
    ' 2 - KAYDI REPOSITORY'DEN GERÝ OKU
    '==========================================================================

    Set NormalCharge = _
        Repo.GetByID(NormalChargeID)


    If NormalCharge Is Nothing Then

        Err.Raise vbObjectError + 7602, _
                  "TEST_021", _
                  "Oluþturulan tahakkuk Repository'den okunamadý."

    End If


    '==========================================================================
    ' 3 - TAHAKKUKU PASÝF YAP
    '
    ' Repository'de Update metodu kullanmadan, yalnýzca test amacýyla
    ' ilgili tablo hücresini deðiþtiriyoruz.
    '==========================================================================

    If Not tbl.DataBodyRange Is Nothing Then

        Dim RowIndex As Long
        Dim FoundRow As Boolean

        FoundRow = False

        For RowIndex = 1 To tbl.ListRows.Count

            If CLng( _
                tbl.ListRows(RowIndex).Range.Cells( _
                    1, _
                    tbl.ListColumns("ChargeID").Index).Value) = _
                NormalChargeID Then

                tbl.ListRows(RowIndex).Range.Cells( _
                    1, _
                    tbl.ListColumns("Status").Index).Value = _
                    "PASIF"

                FoundRow = True

                Exit For

            End If

        Next RowIndex

        If Not FoundRow Then

            Err.Raise vbObjectError + 7603, _
                      "TEST_021", _
                      "Test tahakkuk satýrý bulunamadý."

        End If

    End If


    '==========================================================================
    ' 4 - PASÝF OLDUÐUNU DOÐRULA
    '==========================================================================

    Set NormalCharge = _
        Repo.GetByID(NormalChargeID)


    If NormalCharge Is Nothing Then

        Err.Raise vbObjectError + 7604, _
                  "TEST_021", _
                  "Pasifleþtirilen tahakkuk okunamadý."

    End If


    If UCase$(Trim$(NormalCharge.Status)) <> "PASIF" Then

        Err.Raise vbObjectError + 7605, _
                  "TEST_021", _
                  "Tahakkuk PASIF duruma getirilemedi."

    End If


    '==========================================================================
    ' 5 - PASÝF TAHAKKUKA ARTIÞ UYGULAMAYI DENE
    '
    ' BURADA HATA BEKLÝYORUZ.
    '==========================================================================

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString


    On Error Resume Next

    Err.Clear

    AdjustmentChargeID = _
        Service.AddOfficialChargeAdjustment( _
            NormalChargeID, _
            DateSerial(2027, 3, 1), _
            200@, _
            "TEST-021", _
            DateSerial(2027, 3, 1), _
            "TEST-021 - Pasif tahakkuka artýþ denemesi")


    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorNumber = Err.Number
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler


    '==========================================================================
    ' 6 - HATA OLUÞMASI GEREKÝYOR
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 7606, _
                  "TEST_021", _
                  "HATA: Pasif tahakkuka artýþ yapýlmasýna izin verildi."

    End If


    '==========================================================================
    ' 7 - DOÐRU HATA MESAJI KONTROLÜ
    '==========================================================================

    If InStr(1, _
             ErrorDescription, _
             "Pasif bir tahakkuka artýþ uygulanamaz", _
             vbTextCompare) = 0 Then

        Err.Raise vbObjectError + 7607, _
                  "TEST_021", _
                  "Beklenen hata alýnmadý." & vbCrLf & vbCrLf & _
                  "Alýnan hata:" & vbCrLf & _
                  ErrorDescription

    End If


    '==========================================================================
    ' 8 - YENÝ ARTIÞ KAYDI OLUÞMADIÐINI KONTROL ET
    '==========================================================================

    If AdjustmentChargeID > 0 Then

        Err.Raise vbObjectError + 7608, _
                  "TEST_021", _
                  "Pasif tahakkuka ait artýþ kaydý oluþturuldu."

    End If


    '==========================================================================
    ' 9 - TEST KAYITLARINI TEMÝZLE
    '==========================================================================

    DeleteCount = 0


    If Not tbl.DataBodyRange Is Nothing Then

        For I = tbl.ListRows.Count To 1 Step -1

            If CStr( _
                tbl.ListRows(I).Range.Cells( _
                    1, _
                    tbl.ListColumns("DecisionNo").Index).Value) = _
                "TEST-021" Then

                tbl.ListRows(I).Delete

                DeleteCount = DeleteCount + 1

            End If

        Next I

    End If


    '==========================================================================
    ' 10 - TEMÝZLÝK KONTROLÜ
    '==========================================================================

    If DeleteCount <> 1 Then

        Err.Raise vbObjectError + 7609, _
                  "TEST_021", _
                  "TEST-021 kaydý temizlenemedi." & vbCrLf & _
                  "Silinen kayýt: " & DeleteCount

    End If


    '==========================================================================
    ' 11 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-021 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi              : " & TestMemberID & vbCrLf & _
        "NORMAL tahakkuk         : 500 TL" & vbCrLf & _
        "Tahakkuk durumu         : PASIF" & vbCrLf & _
        "Artýþ denemesi          : REDDEDÝLDÝ" & vbCrLf & _
        "Beklenen hata           : ALINDI" & vbCrLf & _
        "Yeni artýþ kaydý        : OLUÞMADI" & vbCrLf & _
        "Test kayýtlarý          : SÝLÝNDÝ", _
        vbInformation, _
        "OAA - TEST-021"


    Exit Sub


'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    Dim FinalErrorNumber As Long
    Dim FinalErrorDescription As String

    FinalErrorNumber = Err.Number
    FinalErrorDescription = Err.Description


    On Error Resume Next


    '----------------------------------------------------------------------
    ' Hata durumunda TEST-021 kayýtlarýný temizle
    '----------------------------------------------------------------------

    If Not tbl Is Nothing Then

        If Not tbl.DataBodyRange Is Nothing Then

            For I = tbl.ListRows.Count To 1 Step -1

                If CStr( _
                    tbl.ListRows(I).Range.Cells( _
                        1, _
                        tbl.ListColumns("DecisionNo").Index).Value) = _
                    "TEST-021" Then

                    tbl.ListRows(I).Delete

                End If

            Next I

        End If

    End If


    On Error GoTo 0


    MsgBox _
        "TEST-021 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & FinalErrorNumber & vbCrLf & _
        "Açýklama: " & FinalErrorDescription & vbCrLf & vbCrLf & _
        "Varsa TEST-021 kayýtlarý temizlendi.", _
        vbCritical, _
        "OAA - TEST-021"

End Sub

'==============================================================================
' TEST-022
'
' ÝSTÝFA TARÝHÝ SONRASI RESMÝ AÝDAT ENGELÝ
'
' KURAL:
'
'   Ýstifa tarihi : 30.06.2037
'
'   01.05.2037 -> RESMÝ AÝDAT OLUÞUR
'   30.06.2037 -> RESMÝ AÝDAT OLUÞUR
'   01.07.2037 -> REDDEDÝLÝR
'   01.12.2037 -> REDDEDÝLÝR
'
' Bu sürüm TBL_MEMBERS tablo adýný varsaymaz.
' Members sayfasýndaki tabloyu MemberID sütunundan bulur.
'==============================================================================

Public Sub TEST_022()

    Dim Service As clsMemberChargeService

    Dim TestMemberID As Long

    Dim wsMembers As Worksheet
    Dim tblMembers As ListObject
    Dim MemberRow As ListRow

    Dim wsCharges As Worksheet
    Dim tblCharges As ListObject

    Dim ColMemberID As Long
    Dim ColStatus As Long
    Dim ColLeaveDate As Long
    Dim ColDecisionNo As Long

    Dim OriginalStatus As String
    Dim OriginalLeaveDate As Variant

    Dim ChargeIDBefore As Long
    Dim ChargeIDOnLeaveDate As Long
    Dim ChargeIDAfterLeave As Long
    Dim ChargeIDAfterLeave2 As Long

    Dim ErrorOccurred As Boolean
    Dim ErrorDescription As String

    Dim I As Long
    Dim FoundMember As Boolean

    Dim Stage As String

    On Error GoTo ErrorHandler


    '==========================================================================
    ' BAÞLANGIÇ
    '==========================================================================

    Stage = "Service oluþturuluyor"

    Set Service = New clsMemberChargeService


    '==========================================================================
    ' TEST ÜYESÝ
    '==========================================================================

    TestMemberID = 3


    '==========================================================================
    ' MEMBERS SAYFASI
    '==========================================================================

    Stage = "Members sayfasý açýlýyor"

    Set wsMembers = _
        ThisWorkbook.Worksheets("Members")


    '==========================================================================
    ' MEMBERS TABLOSUNU BUL
    '
    ' Tablo adýný varsaymýyoruz.
    ' MemberID sütununu içeren ilk tabloyu buluyoruz.
    '==========================================================================

    Stage = "Members tablosu aranýyor"

    Set tblMembers = Nothing

    For Each tblMembers In wsMembers.ListObjects

        On Error Resume Next

        ColMemberID = _
            tblMembers.ListColumns("MemberID").Index

        If Err.Number = 0 Then

            On Error GoTo ErrorHandler

            Exit For

        End If

        Err.Clear

        On Error GoTo ErrorHandler

        Set tblMembers = Nothing

    Next tblMembers


    If tblMembers Is Nothing Then

        Err.Raise vbObjectError + 7710, _
                  "TEST_022", _
                  "Members sayfasýnda MemberID sütununu içeren tablo bulunamadý."

    End If


    '==========================================================================
    ' SÜTUNLARI BUL
    '==========================================================================

    Stage = "Members sütunlarý bulunuyor"


    On Error Resume Next

    ColMemberID = _
        tblMembers.ListColumns("MemberID").Index

    If Err.Number <> 0 Then

        Err.Clear

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 7711, _
                  "TEST_022", _
                  "MemberID sütunu bulunamadý."

    End If


    ColStatus = _
        tblMembers.ListColumns("Status").Index

    If Err.Number <> 0 Then

        Err.Clear

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 7712, _
                  "TEST_022", _
                  "Status sütunu bulunamadý."

    End If


    ColLeaveDate = _
        tblMembers.ListColumns("LeaveDate").Index

    If Err.Number <> 0 Then

        Err.Clear

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 7713, _
                  "TEST_022", _
                  "LeaveDate sütunu bulunamadý."

    End If

    On Error GoTo ErrorHandler


    '==========================================================================
    ' TEST ÜYESÝNÝ BUL
    '==========================================================================

    Stage = "Test üyesi aranýyor"

    FoundMember = False

    If Not tblMembers.DataBodyRange Is Nothing Then

        For I = 1 To tblMembers.ListRows.Count

            If CLng( _
                tblMembers.ListRows(I).Range.Cells( _
                    1, ColMemberID).Value) = TestMemberID Then

                Set MemberRow = tblMembers.ListRows(I)

                FoundMember = True

                Exit For

            End If

        Next I

    End If


    If Not FoundMember Then

        Err.Raise vbObjectError + 7714, _
                  "TEST_022", _
                  "Test üyesi bulunamadý. Üye No: " & TestMemberID

    End If


    '==========================================================================
    ' ORÝJÝNAL BÝLGÝLERÝ SAKLA
    '==========================================================================

    Stage = "Üye bilgileri saklanýyor"

    OriginalStatus = _
        CStr(MemberRow.Range.Cells(1, ColStatus).Value)

    OriginalLeaveDate = _
        MemberRow.Range.Cells(1, ColLeaveDate).Value


    '==========================================================================
    ' BORÇ TABLOSU
    '==========================================================================

    Stage = "ÜyeBorçlarý tablosu açýlýyor"

    Set wsCharges = _
        ThisWorkbook.Worksheets("ÜyeBorçlarý")


    If wsCharges.ListObjects.Count = 0 Then

        Err.Raise vbObjectError + 7715, _
                  "TEST_022", _
                  "ÜyeBorçlarý sayfasýnda tablo bulunamadý."

    End If


    ' Ýlk tabloyu kullan
    Set tblCharges = wsCharges.ListObjects(1)


    '==========================================================================
    ' DECISIONNO SÜTUNU
    '==========================================================================

    Stage = "DecisionNo sütunu bulunuyor"

    On Error Resume Next

    ColDecisionNo = _
        tblCharges.ListColumns("DecisionNo").Index

    If Err.Number <> 0 Then

        Err.Clear

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 7716, _
                  "TEST_022", _
                  "TBL_MEMBER_CHARGES içinde DecisionNo sütunu bulunamadý."

    End If

    On Error GoTo ErrorHandler


    '==========================================================================
    ' ESKÝ TEST-022 KAYITLARINI TEMÝZLE
    '==========================================================================

    Stage = "Eski TEST-022 kayýtlarý temizleniyor"

    If Not tblCharges.DataBodyRange Is Nothing Then

        For I = tblCharges.ListRows.Count To 1 Step -1

            If CStr( _
                tblCharges.ListRows(I).Range.Cells( _
                    1, ColDecisionNo).Value) = "TEST-022-1" _
            Or CStr( _
                tblCharges.ListRows(I).Range.Cells( _
                    1, ColDecisionNo).Value) = "TEST-022-2" _
            Or CStr( _
                tblCharges.ListRows(I).Range.Cells( _
                    1, ColDecisionNo).Value) = "TEST-022-3" _
            Or CStr( _
                tblCharges.ListRows(I).Range.Cells( _
                    1, ColDecisionNo).Value) = "TEST-022-4" Then

                tblCharges.ListRows(I).Delete

            End If

        Next I


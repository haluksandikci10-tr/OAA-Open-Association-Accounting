    Mesaj = Mesaj & "Status          : " & Member.Status & vbCrLf

    Mesaj = Mesaj & "FiscalYear      : " & TestFiscalYear & vbCrLf

    Mesaj = Mesaj & "DueMonth        : " & TestDueMonth & vbCrLf

    Mesaj = Mesaj & "ChargeDate      : " & _
                    Format$(TestChargeDate, "dd.mm.yyyy") & vbCrLf


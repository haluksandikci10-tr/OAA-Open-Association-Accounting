Public Sub TEST_077()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember
    Dim Charge As clsMemberCharge

    Dim TestMemberID As Long
    Dim TestChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim Amount As Currency

    Dim FoundMember As Boolean
    Dim FoundMonth As Boolean

    Dim MonthNo As Long

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    TestMemberID = 0
    TestChargeID = 0

    FoundMember = False
    FoundMonth = False

    '==========================================================================
    ' 2 - GEÇERLÝ AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 12701, _
                  "TEST_077", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 12702, _
                  "TEST_077", _
                  "Üye listesi boþ."

    End If

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID
                FoundMember = True

                Exit For

            End If

        End If

    Next Member

    If Not FoundMember Then

        Err.Raise vbObjectError + 12703, _
                  "TEST_077", _
                  "TEST-077 için AKTÝF üye bulunamadý."

    End If

    '==========================================================================
    ' 3 - KULLANILMAMIÞ TEST AYI BUL
    '
    ' 2098 yýlý kullanýlýr.
    ' Mevcut NORMAL TOPLANTI kaydý olmayan ay seçilir.
    '==========================================================================

    FiscalYear = 2098

    For MonthNo = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                MonthNo, _
                "TOPLANTI") Then

            DueMonth = MonthNo
            FoundMonth = True

            Exit For

        End If

    Next MonthNo

    If Not FoundMonth Then

        MsgBox _
            "TEST-077 UYGULANAMADI." & vbCrLf & vbCrLf & _
            "2098 yýlýnda kullanýlmamýþ TOPLANTI dönemi bulunamadý." & _
            vbCrLf & vbCrLf & _
            "Gerçek kullanýcý verileri deðiþtirilmedi." & vbCrLf & vbCrLf & _
            "Sonuç: TEST ÖN KOÞULU YOK", _
            vbExclamation, _
            "OAA - TEST-077"

        Exit Sub

    End If

    '==========================================================================
    ' 4 - TEST PARAMETRELERÝ
    '==========================================================================

    ChargeDate = _
        DateSerial(FiscalYear, DueMonth, 15)

    Amount = 150@

    '--------------------------------------------------------------------------
    ' ÖNEMLÝ:
    '
    ' DecisionNo gönderilmiyor.
    ' DecisionDate de gönderilmiyor.
    '
    ' Böylece AddMeetingCharge'ýn Optional varsayýlanlarý kullanýlýr:
    '
    '   DecisionNo   = vbNullString
    '   DecisionDate = 0
    '
    '-------------------------------------------------------------------------

    '==========================================================================
    ' 5 - SERVICE ÇAÐRISI
    '
    ' DecisionNo ve DecisionDate bilinçli olarak verilmemektedir.
    '==========================================================================

    TestChargeID = _
        Service.AddMeetingCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            , _
            , _
            "TEST-077 - DecisionDate opsiyonel testi")

    '==========================================================================
    ' 6 - CHARGEID KONTROLÜ
    '==========================================================================

    If TestChargeID <= 0 Then

        Err.Raise vbObjectError + 12704, _
                  "TEST_077", _
                  "DecisionDate verilmeden TOPLANTI tahakkuku oluþturulamadý." & _
                  vbCrLf & _
                  "ChargeID = " & TestChargeID

    End If

    '==========================================================================
    ' 7 - OLUÞAN KAYDI REPOSITORY'DEN OKU
    '==========================================================================

    Set Charge = Repo.GetByID(TestChargeID)

    If Charge Is Nothing Then

        Err.Raise vbObjectError + 12705, _
                  "TEST_077", _
                  "Oluþturulan TOPLANTI kaydý Repository'den okunamadý." & _
                  vbCrLf & _
                  "ChargeID = " & TestChargeID

    End If

    '==========================================================================
    ' 8 - MEMBERID KONTROLÜ
    '==========================================================================

    If Charge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 12706, _
                  "TEST_077", _
                  "Kayýt MemberID deðeri hatalý."

    End If

    '==========================================================================
    ' 9 - CHARGETYPE KONTROLÜ
    '==========================================================================

    If StrComp( _
            Trim$(Charge.ChargeType), _
            "TOPLANTI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 12707, _
                  "TEST_077", _
                  "Kayýt ChargeType deðeri TOPLANTI deðil."

    End If

    '==========================================================================
    ' 10 - ADJUSTMENTTYPE KONTROLÜ
    '==========================================================================

    If StrComp( _
            Trim$(Charge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 12708, _
                  "TEST_077", _
                  "Kayýt AdjustmentType deðeri NORMAL deðil."

    End If

    '==========================================================================
    ' 11 - FISCALYEAR KONTROLÜ
    '==========================================================================

    If Charge.FiscalYear <> FiscalYear Then

        Err.Raise vbObjectError + 12709, _
                  "TEST_077", _
                  "Kayýt FiscalYear deðeri hatalý."

    End If

    '==========================================================================
    ' 12 - DUEMONTH KONTROLÜ
    '==========================================================================

    If Charge.DueMonth <> DueMonth Then

        Err.Raise vbObjectError + 12710, _
                  "TEST_077", _
                  "Kayýt DueMonth deðeri hatalý."

    End If

    '==========================================================================
    ' 13 - AMOUNT KONTROLÜ
    '==========================================================================

    If Charge.Amount <> Amount Then

        Err.Raise vbObjectError + 12711, _
                  "TEST_077", _
                  "Kayýt Amount deðeri hatalý."

    End If

    '==========================================================================
    ' 14 - DECISIONNO KONTROLÜ
    '
    ' DecisionNo gönderilmediði için boþ olmasý beklenir.
    '==========================================================================

    If Len(Trim$(Charge.DecisionNo)) <> 0 Then

        Err.Raise vbObjectError + 12712, _
                  "TEST_077", _
                  "DecisionNo boþ býrakýldýðý halde kayýt üzerinde deðer var." & _
                  vbCrLf & _
                  "Alýnan: " & Charge.DecisionNo

    End If

    '==========================================================================
    ' 15 - DECISIONDATE KONTROLÜ
    '
    ' TEST-077'nin ana kontrolü.
    '
    ' DecisionDate verilmediði için 0 olmalýdýr.
    '==========================================================================

    If Charge.DecisionDate <> 0 Then

        Err.Raise vbObjectError + 12713, _
                  "TEST_077", _
                  "DecisionDate verilmeden oluþturulan kayýtta " & _
                  "DecisionDate = 0 deðil." & _
                  vbCrLf & _
                  "Alýnan: " & CStr(Charge.DecisionDate)

    End If

    '==========================================================================
    ' 16 - DESCRIPTION KONTROLÜ
    '==========================================================================

    If StrComp( _
            Trim$(Charge.Description), _
            "TEST-077 - DecisionDate opsiyonel testi", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 12714, _
                  "TEST_077", _
                  "Description deðeri hatalý."

    End If

    '==========================================================================
    ' 17 - STATUS KONTROLÜ
    '==========================================================================

    If StrComp( _
            Trim$(Charge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 12715, _
                  "TEST_077", _
                  "Oluþturulan TOPLANTI kaydýnýn Status deðeri AKTIF deðil."

    End If

    '==========================================================================
    ' 18 - CLEANUP
    '==========================================================================

    DeleteTestCharge TestChargeID

    '==========================================================================
    ' 19 - CLEANUP KONTROLÜ
    '==========================================================================

    Set Charge = Nothing

    Set Charge = Repo.GetByID(TestChargeID)

    If Not Charge Is Nothing Then

        Err.Raise vbObjectError + 12716, _
                  "TEST_077", _
                  "TEST-077 geçici kaydý cleanup sonrasýnda hâlâ mevcut." & _
                  vbCrLf & _
                  "ChargeID = " & TestChargeID

    End If

    '==========================================================================
    ' 20 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-077 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "Mali yýl         : " & FiscalYear & vbCrLf & _
        "Dönem ayý        : " & DueMonth & vbCrLf & _
        "ChargeID         : " & TestChargeID & vbCrLf & _
        "Amount           : " & Amount & " TL" & vbCrLf & vbCrLf & _
        "DecisionNo       : BOÞ" & vbCrLf & _
        "DecisionDate     : 0 / BOÞ" & vbCrLf & _
        "TOPLANTI kaydý   : OLUÞTU" & vbCrLf & _
        "Kayýt tipi       : TOPLANTI / NORMAL" & vbCrLf & _
        "Status           : AKTIF" & vbCrLf & _
        "Cleanup          : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-077"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    Dim TestErrorNumber As Long
    Dim TestErrorDescription As String

    TestErrorNumber = Err.Number
    TestErrorDescription = Err.Description

    '--------------------------------------------------------------------------
    ' Cleanup sýrasýnda gerçek hata bilgisini kaybetmemek için
    ' hata bilgisi önce saklanýr.
    '--------------------------------------------------------------------------

    On Error Resume Next

    If TestChargeID > 0 Then

        DeleteTestCharge TestChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-077 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & TestErrorNumber & vbCrLf & _
        "Açýklama: " & TestErrorDescription & vbCrLf & vbCrLf & _
        "ChargeID: " & TestChargeID & vbCrLf & _
        "Cleanup uygulanmaya çalýþýldý.", _
        vbCritical, _
        "OAA - TEST-077"

End Sub


'==============================================================================
' TEST-078
'
' RESMÝ AÝDAT - GEÇERSÝZ DÖNEM SONU TARÝHÝ
'
' AMAÇ:
'
'   AddOfficialCharge metodunun PeriodEndDate = 0 deðerini reddettiðini
'   doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   ValidateBasicChargeParameters içinde:
'
'       If PeriodEndDate <= 0 Then
'
'           Err.Raise vbObjectError + 7236, _
'                     "clsMemberChargeService", _
'                     "Dönem sonu tarihi girilmelidir."
'
'       End If
'
' TEST EDÝLEN:
'
'   PeriodEndDate = 0
'
' DÝÐER PARAMETRELER:
'
'   MemberID       : geçerli AKTÝF üye
'   FiscalYear     : geçerli
'   DueMonth       : geçerli
'   ChargeDate     : geçerli
'   Amount         : pozitif
'
' BEKLENEN:
'
'   Service hata vermelidir.
'
'   Service hata kodu:
'
'       7236
'
'   Gerçek VBA Err.Number:
'
'       vbObjectError + 7236
'
'   Hata mesajý:
'
'       Dönem sonu tarihi girilmelidir.
'
'   Yeni RESMI kayýt oluþmamalýdýr.
'
' GERÇEK ÜYE VERÝSÝ:
'
'   Deðiþtirilmez.
'
' CLEANUP:
'
'   Validation aþamasýnda hata beklendiði için kayýt oluþmaz.
'==============================================================================

Public Sub TEST_078()

    Dim Service As clsMemberChargeService
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim TestMemberID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim Amount As Currency
    Dim PeriodEndDate As Date

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    Dim ExpectedErrorNumber As Long

    Dim FoundMember As Boolean

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set MemberRepo = New clsMemberRepository

    TestMemberID = 0

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString

    FoundMember = False

    '==========================================================================
    ' 2 - BEKLENEN GERÇEK VBA HATA NUMARASI
    '
    ' Service:
    '
    '   Err.Raise vbObjectError + 7236
    '
    ' Dolayýsýyla Err.Number doðrudan 7236 deðildir.
    '==========================================================================

    ExpectedErrorNumber = _
        vbObjectError + 7236

    '==========================================================================
    ' 3 - GEÇERLÝ AKTÝF ÜYE BUL
    '
    ' Üye parametresinin geçerli olmasý gerekir.
    ' Böylece test doðrudan PeriodEndDate validation'ýna ulaþýr.
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 12801, _
                  "TEST_078", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 12802, _
                  "TEST_078", _
                  "Üye listesi boþ."

    End If

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID
                FoundMember = True

                Exit For

            End If

        End If

    Next Member

    If Not FoundMember Then

        Err.Raise vbObjectError + 12803, _
                  "TEST_078", _
                  "TEST-078 için AKTÝF üye bulunamadý."

    End If

    '==========================================================================
    ' 4 - TEST PARAMETRELERÝ
    '
    ' Yalnýzca PeriodEndDate geçersizdir.
    '==========================================================================

    FiscalYear = 2098

    DueMonth = 1

    ChargeDate = _
        DateSerial(FiscalYear, DueMonth, 15)

    Amount = 150@

    '--------------------------------------------------------------------------
    ' TEST EDÝLEN DEÐER
    '--------------------------------------------------------------------------

    PeriodEndDate = 0

    '==========================================================================
    ' 5 - SERVICE ÇAÐRISI
    '
    ' AddOfficialCharge'ýn gerçek parametre sýrasý:
    '
    '   MemberID
    '   FiscalYear
    '   DueMonth
    '   ChargeDate
    '   Amount
    '   PeriodEndDate
    '   DecisionNo
    '   DecisionDate
    '   Description
    '
    ' PeriodEndDate = 0 gönderiliyor.
    '==========================================================================

    On Error Resume Next

    Err.Clear

    Call Service.AddOfficialCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            PeriodEndDate, _
            "TEST-078", _
            ChargeDate, _
            "TEST-078 - Geçersiz dönem sonu tarihi testi")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorNumber = Err.Number
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 6 - SERVICE HATA VERMELÝ
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 12804, _
                  "TEST_078", _
                  "PeriodEndDate = 0 Service tarafýndan reddedilmedi."

    End If

    '==========================================================================
    ' 7 - HATA NUMARASI ALINMIÞ OLMALI
    '==========================================================================

    If ErrorNumber = 0 Then

        Err.Raise vbObjectError + 12805, _
                  "TEST_078", _
                  "Service hata verdi ancak Err.Number alýnamadý."

    End If

    '==========================================================================
    ' 8 - GERÇEK VBA HATA NUMARASINI KONTROL ET
    '
    ' Beklenen:
    '
    '   vbObjectError + 7236
    '==========================================================================

    If ErrorNumber <> ExpectedErrorNumber Then

        Err.Raise vbObjectError + 12806, _
                  "TEST_078", _
                  "Beklenen VBA hata numarasý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen Service kodu : 7236" & _
                  vbCrLf & _
                  "Beklenen Err.Number  : " & ExpectedErrorNumber & _
                  vbCrLf & _
                  "Alýnan Err.Number    : " & ErrorNumber & _
                  vbCrLf & vbCrLf & _
                  "Hata mesajý:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 9 - HATA MESAJINI TAM KONTROL ET
    '==========================================================================

    If StrComp( _
            Trim$(ErrorDescription), _
            "Dönem sonu tarihi girilmelidir.", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 12807, _
                  "TEST_078", _
                  "7236 hata mesajý beklenen metinle eþleþmiyor." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen:" & vbCrLf & _
                  "Dönem sonu tarihi girilmelidir." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan:" & vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 10 - BAÞARILI
    '
    ' Validation aþamasýnda hata oluþtuðundan Repository.Add çalýþmamýþtýr.
    ' Dolayýsýyla cleanup gerektiren geçici kayýt oluþmamýþtýr.
    '==========================================================================

    MsgBox _
        "TEST-078 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "Mali yýl         : " & FiscalYear & vbCrLf & _
        "DueMonth         : " & DueMonth & vbCrLf & _
        "ChargeDate       : " & _
            Format$(ChargeDate, "dd.mm.yyyy") & vbCrLf & _
        "Amount           : " & Amount & " TL" & vbCrLf & _
        "PeriodEndDate    : 0 (GEÇERSÝZ)" & vbCrLf & vbCrLf & _
        "Service reddi    : OK" & vbCrLf & _
        "Service kodu     : 7236" & vbCrLf & _
        "VBA Err.Number   : " & ErrorNumber & vbCrLf & _
        "Hata mesajý      : Dönem sonu tarihi girilmelidir." & _
            vbCrLf & _
        "Kayýt oluþumu    : YOK" & vbCrLf & _
        "Üye deðiþikliði  : YOK" & vbCrLf & _
        "Cleanup          : GEREKMEDÝ" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-078"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    MsgBox _
        "TEST-078 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Service Hatasý:" & vbCrLf & _
        ErrorDescription, _
        vbCritical, _
        "OAA - TEST-078"

End Sub



'==============================================================================
' TEST-079
'
' RESMÝ AÝDAT - DÖNEM SONU TARÝHÝ / TAHAKKUK TARÝHÝ SIRALAMA KONTROLÜ
'
' AMAÇ:
'
'   AddOfficialCharge metodunun PeriodEndDate deðerinin ChargeDate
'   deðerinden önce olmasýný reddettiðini doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   If PeriodEndDate < ChargeDate Then
'
'       Err.Raise vbObjectError + 7237, _
'                 "clsMemberChargeService", _
'                 "Dönem sonu tarihi tahakkuk tarihinden önce olamaz."
'
'   End If
'
' TEST EDÝLEN DURUM:
'
'   ChargeDate      = 15.01.2098
'   PeriodEndDate   = 14.01.2098
'
'   Yani:
'
'       PeriodEndDate < ChargeDate
'
' TEST PRENSÝBÝ:
'
'   Yalnýzca tarih sýralamasý geçersizdir.
'
'   MemberID       : geçerli AKTÝF üye
'   FiscalYear     : geçerli
'   DueMonth       : geçerli
'   ChargeDate     : geçerli
'   Amount         : pozitif
'   PeriodEndDate  : geçerli fakat ChargeDate'ten önce
'
' BEKLENEN:
'
'   Service hata vermelidir.
'
'   Service kodu:
'
'       7237
'
'   Gerçek VBA Err.Number:
'
'       vbObjectError + 7237
'
'   Hata mesajý:
'
'       Dönem sonu tarihi tahakkuk tarihinden önce olamaz.
'
'   Yeni RESMI kayýt oluþmamalýdýr.
'
' GERÇEK ÜYE VERÝSÝ:
'
'   Deðiþtirilmez.
'
' CLEANUP:
'
'   Validation aþamasýnda hata beklendiði için kayýt oluþmaz.
'==============================================================================

Public Sub TEST_079()

    Dim Service As clsMemberChargeService
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim TestMemberID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim Amount As Currency
    Dim PeriodEndDate As Date

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    Dim ExpectedErrorNumber As Long

    Dim FoundMember As Boolean

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set MemberRepo = New clsMemberRepository

    TestMemberID = 0
    FoundMember = False

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString

    '==========================================================================
    ' 2 - BEKLENEN GERÇEK VBA HATA NUMARASI
    '
    ' Service:
    '
    '   Err.Raise vbObjectError + 7237
    '
    ' Dolayýsýyla Err.Number doðrudan 7237 deðildir.
    '==========================================================================

    ExpectedErrorNumber = _
        vbObjectError + 7237

    '==========================================================================
    ' 3 - GEÇERLÝ AKTÝF ÜYE BUL
    '
    ' MemberID geçerli olmalýdýr.
    ' Böylece test tarih sýralamasý kontrolüne ulaþýr.
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 12901, _
                  "TEST_079", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 12902, _
                  "TEST_079", _
                  "Üye listesi boþ."

    End If

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID
                FoundMember = True

                Exit For

            End If

        End If

    Next Member

    If Not FoundMember Then

        Err.Raise vbObjectError + 12903, _
                  "TEST_079", _
                  "TEST-079 için AKTÝF üye bulunamadý."

    End If

    '==========================================================================
    ' 4 - TEST PARAMETRELERÝ
    '
    ' Yalnýzca PeriodEndDate / ChargeDate sýralamasý geçersizdir.
    '
    ' ChargeDate:
    '   15.01.2098
    '
    ' PeriodEndDate:
    '   14.01.2098
    '
    ' Böylece:
    '
    '   PeriodEndDate < ChargeDate
    '==========================================================================

    FiscalYear = 2098

    DueMonth = 1

    ChargeDate = _
        DateSerial(FiscalYear, DueMonth, 15)

    PeriodEndDate = _
        DateSerial(FiscalYear, DueMonth, 14)

    Amount = 150@

    '==========================================================================
    ' 5 - SERVICE ÇAÐRISI
    '
    ' Gerçek API:
    '
    '   AddOfficialCharge
    '
    ' PeriodEndDate, gerçek metodun 6. parametresidir.
    '==========================================================================

    On Error Resume Next

    Err.Clear

    Call Service.AddOfficialCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            PeriodEndDate, _
            "TEST-079", _
            ChargeDate, _
            "TEST-079 - Tarih sýralamasý testi")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorNumber = Err.Number
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 6 - SERVICE HATA VERMELÝ
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 12904, _
                  "TEST_079", _
                  "PeriodEndDate, ChargeDate deðerinden önce olmasýna raðmen " & _
                  "Service iþlemi reddetmedi."

    End If

    '==========================================================================
    ' 7 - HATA NUMARASI ALINMIÞ OLMALI
    '==========================================================================

    If ErrorNumber = 0 Then

        Err.Raise vbObjectError + 12905, _
                  "TEST_079", _
                  "Service hata verdi ancak Err.Number alýnamadý."

    End If

    '==========================================================================
    ' 8 - GERÇEK VBA HATA NUMARASINI KONTROL ET
    '
    ' Beklenen Service kodu:
    '
    '   7237
    '
    ' Beklenen VBA Err.Number:
    '
    '   vbObjectError + 7237
    '==========================================================================

    If ErrorNumber <> ExpectedErrorNumber Then

        Err.Raise vbObjectError + 12906, _
                  "TEST_079", _
                  "Beklenen VBA hata numarasý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen Service kodu : 7237" & _
                  vbCrLf & _
                  "Beklenen Err.Number  : " & ExpectedErrorNumber & _
                  vbCrLf & _
                  "Alýnan Err.Number    : " & ErrorNumber & _
                  vbCrLf & vbCrLf & _
                  "Hata mesajý:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 9 - HATA MESAJINI TAM KONTROL ET
    '==========================================================================

    If StrComp( _
            Trim$(ErrorDescription), _
            "Dönem sonu tarihi tahakkuk tarihinden önce olamaz.", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 12907, _
                  "TEST_079", _
                  "7237 hata mesajý beklenen metinle eþleþmiyor." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen:" & vbCrLf & _
                  "Dönem sonu tarihi tahakkuk tarihinden önce olamaz." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan:" & vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 10 - BAÞARILI
    '
    ' Hata ValidateBasicChargeParameters aþamasýnda oluþtuðu için
    ' Repository.Add çalýþmamýþtýr.
    '==========================================================================

    MsgBox _
        "TEST-079 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "Mali yýl         : " & FiscalYear & vbCrLf & _
        "DueMonth         : " & DueMonth & vbCrLf & _
        "ChargeDate       : " & _
            Format$(ChargeDate, "dd.mm.yyyy") & vbCrLf & _
        "PeriodEndDate    : " & _
            Format$(PeriodEndDate, "dd.mm.yyyy") & vbCrLf & _
        "Amount           : " & Amount & " TL" & vbCrLf & vbCrLf & _
        "Tarih sýralamasý : GEÇERSÝZ" & vbCrLf & _
        "Service reddi    : OK" & vbCrLf & _
        "Service kodu     : 7237" & vbCrLf & _
        "VBA Err.Number   : " & ErrorNumber & vbCrLf & _
        "Hata mesajý      : " & ErrorDescription & vbCrLf & _
        "Kayýt oluþumu    : YOK" & vbCrLf & _
        "Üye deðiþikliði  : YOK" & vbCrLf & _
        "Cleanup          : GEREKMEDÝ" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _

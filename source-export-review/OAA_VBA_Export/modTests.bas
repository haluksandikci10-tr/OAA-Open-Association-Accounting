    Expense.EntryDate = TestEntryDate
    Expense.DocumentNo = TestDocumentNo
    Expense.ExpenseType = TestExpenseType
    Expense.Description = TestDescription
    Expense.ExpenseAmount = TestAmount
    Expense.CashAmount = TestAmount
    Expense.BankAmount = CCur(0)


    '==========================================================================
    ' ADD EXPENSE WITH LEDGER
    '
    ' Gider ve Isletme Defteri hareketi birlikte olusturulur.
    '==========================================================================

    If Not Service.AddExpenseWithLedger(Expense) Then

        Err.Raise _
            vbObjectError + 13101, _
            "TEST-131", _
            "AddExpenseWithLedger gider ve defter hareketini olusturamadi."

    End If


    '==========================================================================
    ' OLUSTURULAN EXPENSE ID
    '==========================================================================

    TestExpenseID = Expense.ExpenseID

    If TestExpenseID <= 0 Then

        Err.Raise _
            vbObjectError + 13102, _
            "TEST-131", _
            "Olusturulan gider icin gecerli ExpenseID bulunamadi."

    End If


    '==========================================================================
    ' GET EXPENSE
    '==========================================================================

    Set LoadedExpense = _
        Service.GetExpense(TestExpenseID)

    If LoadedExpense Is Nothing Then

        Err.Raise _
            vbObjectError + 13103, _
            "TEST-131", _
            "Service.GetExpense kayit dondurmedi."

    End If


    '==========================================================================
    ' EXPENSE ALAN KONTROLLERI
    '==========================================================================

    If LoadedExpense.ExpenseID <> TestExpenseID Then GoTo DataError

    If LoadedExpense.EntryDate <> TestEntryDate Then GoTo DataError

    If LoadedExpense.DocumentNo <> TestDocumentNo Then GoTo DataError

    If LoadedExpense.ExpenseType <> TestExpenseType Then GoTo DataError

    If LoadedExpense.Description <> TestDescription Then GoTo DataError

    If LoadedExpense.ExpenseAmount <> TestAmount Then GoTo DataError

    If LoadedExpense.CashAmount <> TestAmount Then GoTo DataError

    If LoadedExpense.BankAmount <> CCur(0) Then GoTo DataError


    '==========================================================================
    ' GET ALL EXPENSES
    '==========================================================================

    Set AllExpenses = _
        Service.GetAllExpenses

    If AllExpenses Is Nothing Then

        Err.Raise _
            vbObjectError + 13104, _
            "TEST-131", _
            "Service.GetAllExpenses Nothing dondurdu."

    End If


    '==========================================================================
    ' TEST GIDERININ LISTEDE BULUNMASI
    '==========================================================================

    FoundExpense = False

    For I = 1 To AllExpenses.Count

        Set CurrentExpense = AllExpenses(I)

        If Not CurrentExpense Is Nothing Then

            If CurrentExpense.ExpenseID = TestExpenseID Then

                FoundExpense = True

                Exit For

            End If

        End If

    Next I


    If Not FoundExpense Then

        Err.Raise _
            vbObjectError + 13105, _
            "TEST-131", _
            "Eklenen gider GetAllExpenses icinde bulunamadi."

    End If


    '==========================================================================
    ' DELETE EXPENSE
    '
    ' Gider ve ExpenseID ile iliskili defter hareketi silinir.
    '==========================================================================

    If Not Service.DeleteExpense(TestExpenseID) Then

        Err.Raise _
            vbObjectError + 13106, _
            "TEST-131", _
            "Service.DeleteExpense test kaydini silemedi."

    End If


    '==========================================================================
    ' SILINEN GIDERIN TEKRAR SORGULANMASI
    '==========================================================================

    Set LoadedExpense = _
        Service.GetExpense(TestExpenseID)

    If Not LoadedExpense Is Nothing Then

        Err.Raise _
            vbObjectError + 13107, _
            "TEST-131", _
            "DeleteExpense sonrasinda test gideri hala mevcut."

    End If


    '==========================================================================
    ' BASARILI
    '==========================================================================

    TestExpenseID = 0

    Debug.Print String(70, "=")
    Debug.Print "TEST-131 BASARILI"
    Debug.Print "AddExpenseWithLedger : BASARILI"
    Debug.Print "GetExpense           : BASARILI"
    Debug.Print "GetAllExpenses       : BASARILI"
    Debug.Print "DeleteExpense        : BASARILI"
    Debug.Print "Cleanup              : BASARILI"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-131 BASARILI" & vbCrLf & vbCrLf & _
        "AddExpenseWithLedger : BASARILI" & vbCrLf & _
        "GetExpense           : BASARILI" & vbCrLf & _
        "GetAllExpenses       : BASARILI" & vbCrLf & _
        "DeleteExpense        : BASARILI" & vbCrLf & _
        "Cleanup              : BASARILI", _
        vbInformation, _
        "OAA - TEST-131"


    Set CurrentExpense = Nothing
    Set LoadedExpense = Nothing
    Set AllExpenses = Nothing
    Set Expense = Nothing
    Set Service = Nothing

    Exit Sub


'==============================================================================
' VERI HATASI
'==============================================================================

DataError:

    Err.Raise _
        vbObjectError + 13108, _
        "TEST-131", _
        "GetExpense ile okunan gider alanlarindan en az biri beklenen degerle eslesmiyor."


'==============================================================================
' TEST HATASI
'==============================================================================

TestError:

    ErrorNumber = Err.Number
    ErrorDescription = Err.Description

    '--------------------------------------------------------------------------
    ' HATA DURUMUNDA TEMIZLEME
    '
    ' Test kaydi olusturulmadiysa silme islemi yapilmaz.
    ' Olusturulduysa ExpenseID uzerinden servis temizligi denenir.
    '--------------------------------------------------------------------------

    On Error Resume Next

    If TestExpenseID > 0 Then

        Call Service.DeleteExpense(TestExpenseID)

    End If

    On Error GoTo 0


    Debug.Print String(70, "=")
    Debug.Print "TEST-131 BASARISIZ"
    Debug.Print "Hata No : " & ErrorNumber
    Debug.Print "Aciklama: " & ErrorDescription
    Debug.Print "Cleanup : Temizleme denendi"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-131 BASARISIZ" & vbCrLf & vbCrLf & _
        "Hata No : " & ErrorNumber & vbCrLf & _
        "Aciklama: " & ErrorDescription & vbCrLf & vbCrLf & _
        "Test kaydi icin temizleme denendi.", _
        vbCritical, _
        "OAA - TEST-131"


    Set CurrentExpense = Nothing
    Set LoadedExpense = Nothing
    Set AllExpenses = Nothing
    Set Expense = Nothing
    Set Service = Nothing

End Sub


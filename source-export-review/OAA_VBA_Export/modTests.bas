Public Sub TEST_121_ReceiptServiceGetMemberReceipts()

    Dim Service As clsReceiptService
    Dim Receipt1 As clsReceipt
    Dim Receipt2 As clsReceipt

    Dim Receipts As Collection
    Dim LoadedReceipt As clsReceipt

    Dim TestMemberID As Long

    Dim ReceiptID1 As Long
    Dim ReceiptID2 As Long

    Dim Found1 As Boolean
    Dim Found2 As Boolean

    Dim I As Long

    On Error GoTo TestError

    TestMemberID = 10

    Debug.Print String(70, "=")
    Debug.Print "TEST-121 - Receipt Service GetMemberReceipts"
    Debug.Print String(70, "=")


    '--------------------------------------------------------------------------
    ' SERVICE
    '--------------------------------------------------------------------------

    Set Service = New clsReceiptService


    '--------------------------------------------------------------------------
    ' BÝRÝNCÝ TEST TAHSÝLATI
    '--------------------------------------------------------------------------

    Set Receipt1 = New clsReceipt

    Receipt1.Series = "A"
    Receipt1.ReceiptNumber = 900010
    Receipt1.ReceiptDate = Date
    Receipt1.MemberID = TestMemberID
    Receipt1.Amount = CCur(300)
    Receipt1.PaymentMethod = "Nakit"

    ReceiptID1 = Service.AddReceipt(Receipt1)

    If ReceiptID1 <= 0 Then

        Err.Raise _
            vbObjectError + 12101, _
            "TEST-121", _
            "Birinci test tahsilatý oluþturulamadý."

    End If


    '--------------------------------------------------------------------------
    ' ÝKÝNCÝ TEST TAHSÝLATI
    '--------------------------------------------------------------------------

    Set Receipt2 = New clsReceipt

    Receipt2.Series = "A"
    Receipt2.ReceiptNumber = 900011
    Receipt2.ReceiptDate = Date
    Receipt2.MemberID = TestMemberID
    Receipt2.Amount = CCur(450)
    Receipt2.PaymentMethod = "Kredi Kartý"

    ReceiptID2 = Service.AddReceipt(Receipt2)

    If ReceiptID2 <= 0 Then

        Err.Raise _
            vbObjectError + 12102, _
            "TEST-121", _
            "Ýkinci test tahsilatý oluþturulamadý."

    End If


    '--------------------------------------------------------------------------
    ' ÜYE TAHSÝLATLARINI GETÝR
    '--------------------------------------------------------------------------

    Set Receipts = _
        Service.GetMemberReceipts(TestMemberID)


    If Receipts Is Nothing Then

        Err.Raise _
            vbObjectError + 12103, _
            "TEST-121", _
            "GetMemberReceipts Collection döndürmedi."

    End If


    If Receipts.Count < 2 Then

        Err.Raise _
            vbObjectError + 12104, _
            "TEST-121", _
            "Üyenin tahsilat kayýtlarý eksik döndü."

    End If


    '--------------------------------------------------------------------------
    ' TEST KAYITLARINI BUL
    '--------------------------------------------------------------------------

    Found1 = False
    Found2 = False

    For I = 1 To Receipts.Count

        Set LoadedReceipt = Receipts(I)

        If LoadedReceipt.ReceiptID = ReceiptID1 Then

            Found1 = True

        End If

        If LoadedReceipt.ReceiptID = ReceiptID2 Then

            Found2 = True

        End If

    Next I


    If Not Found1 Then

        Err.Raise _
            vbObjectError + 12105, _
            "TEST-121", _
            "Birinci Receipt GetMemberReceipts sonucunda bulunamadý."

    End If


    If Not Found2 Then

        Err.Raise _
            vbObjectError + 12106, _
            "TEST-121", _
            "Ýkinci Receipt GetMemberReceipts sonucunda bulunamadý."

    End If


    '--------------------------------------------------------------------------
    ' CLEANUP
    '--------------------------------------------------------------------------

    If Not Service.DeleteReceipt(ReceiptID1) Then

        Err.Raise _
            vbObjectError + 12107, _
            "TEST-121", _
            "Birinci test Receipt cleanup baþarýsýz."

    End If


    If Not Service.DeleteReceipt(ReceiptID2) Then

        Err.Raise _
            vbObjectError + 12108, _
            "TEST-121", _
            "Ýkinci test Receipt cleanup baþarýsýz."

    End If


    '--------------------------------------------------------------------------
    ' CLEANUP SONRASI KONTROL
    '--------------------------------------------------------------------------

    Set LoadedReceipt = Service.GetReceipt(ReceiptID1)

    If Not LoadedReceipt Is Nothing Then

        Err.Raise _
            vbObjectError + 12109, _
            "TEST-121", _
            "Birinci test Receipt cleanup sonrasýnda hâlâ mevcut."

    End If


    Set LoadedReceipt = Service.GetReceipt(ReceiptID2)

    If Not LoadedReceipt Is Nothing Then

        Err.Raise _
            vbObjectError + 12110, _
            "TEST-121", _
            "Ýkinci test Receipt cleanup sonrasýnda hâlâ mevcut."

    End If


    '--------------------------------------------------------------------------
    ' BAÞARILI
    '--------------------------------------------------------------------------

    Debug.Print "TEST-121 BAÞARILI"
    Debug.Print "MemberID       : " & TestMemberID
    Debug.Print "ReceiptID 1    : " & ReceiptID1
    Debug.Print "ReceiptID 2    : " & ReceiptID2
    Debug.Print "GetMemberReceipts : Baþarýlý"
    Debug.Print "Cleanup           : Baþarýlý"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-121 BAÞARILI" & vbCrLf & vbCrLf & _
        "Üyeye ait tahsilat kayýtlarýnýn getirilmesi doðrulandý." & vbCrLf & _
        "Test kayýtlarý temizlendi.", _
        vbInformation, _
        "OAA - TEST-121"


    Set LoadedReceipt = Nothing
    Set Receipts = Nothing
    Set Receipt2 = Nothing
    Set Receipt1 = Nothing
    Set Service = Nothing

    Exit Sub


'==============================================================================
' TEST HATASI
'==============================================================================

TestError:

    On Error Resume Next

    If ReceiptID1 > 0 Then

        Service.DeleteReceipt ReceiptID1

    End If

    If ReceiptID2 > 0 Then

        Service.DeleteReceipt ReceiptID2

    End If

    On Error GoTo 0


    Debug.Print "TEST-121 BAÞARISIZ"
    Debug.Print "Hata No : " & Err.Number
    Debug.Print "Açýklama: " & Err.Description
    Debug.Print "Cleanup : Uygulandý"
    Debug.Print String(70, "=")


    MsgBox _

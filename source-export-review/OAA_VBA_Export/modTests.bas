'==============================================================================
' TEST-085
'
' TOPLANTI AÝDATI - ÝSTÝFA ÜYE REDDÝ
'
' AMAÇ:
'
'   AddMeetingCharge metodunun ÝSTÝFA durumundaki üyeye TOPLANTI aidatý
'   uygulanmasýný reddettiðini doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   AKTÝF  -> uygulanýr
'   ÝZÝNLÝ -> reddedilir
'   ÝSTÝFA -> reddedilir
'
' GERÇEK HATA:
'
'   Service kodu : 7212
'
'   Mesaj:
'
'   "Ýzinli veya istifa durumundaki üyeye toplantý aidatý uygulanamaz."
'
' TEST PRENSÝBÝ:
'
'   Mevcut ÝSTÝFA üye kullanýlýr.
'
'   Üyenin Status veya LeaveDate alaný deðiþtirilmez.
'
' BEKLENEN:
'
'   1. Service hata vermelidir.
'   2. Hata kodu vbObjectError + 7212 olmalýdýr.
'   3. Hata mesajý doðru olmalýdýr.
'   4. ChargeID = 0 olmalýdýr.
'   5. Yeni TOPLANTI kaydý oluþmamalýdýr.
'   6. Üyenin Status deðeri test sonrasýnda hâlâ ÝSTÝFA olmalýdýr.
'
' GERÇEK ÜYE VERÝSÝ:
'
'   Deðiþtirilmez.
'
' CLEANUP:
'
'   Beklenen hata Service validation aþamasýnda oluþtuðu için kayýt oluþmaz.
'==============================================================================

Public Sub TEST_085()

    Dim Service As clsMemberChargeService
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim TestMemberID As Long
    Dim TestChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim Amount As Currency

    Dim FoundMember As Boolean
    Dim FoundMonth As Boolean

    Dim MonthNo As Long

    Dim OriginalStatus As String
    Dim OriginalLeaveDate As Date

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    Dim ExpectedErrorNumber As Long

    Dim TestErrorNumber As Long
    Dim TestErrorDescription As String

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set MemberRepo = New clsMemberRepository

    TestMemberID = 0
    TestChargeID = 0

    FoundMember = False
    FoundMonth = False

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString

    '==========================================================================
    ' 2 - BEKLENEN HATA NUMARASI
    '
    ' Gerçek Service:
    '
    '   Err.Raise vbObjectError + 7212
    '==========================================================================

    ExpectedErrorNumber = _
        vbObjectError + 7212

    '==========================================================================
    ' 3 - MEVCUT ÝSTÝFA ÜYEYÝ BUL
    '
    ' Gerçek kullanýcý üyesi kullanýlmaktadýr.
    ' Yeni üye oluþturulmaz.
    ' Üye Status deðeri deðiþtirilmez.
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 13501, _
                  "TEST_085", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 13502, _
                  "TEST_085", _
                  "Üye listesi boþ."

    End If

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Ýstifa", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID

                OriginalStatus = Member.Status
                OriginalLeaveDate = Member.LeaveDate

                FoundMember = True

                Exit For

            End If

        End If

    Next Member

    '==========================================================================
    ' 4 - ÝSTÝFA ÜYE YOKSA TEST UYGULANAMAZ
    '
    ' Gerçek kullanýcý verisini deðiþtirmemek için yapay üye oluþturulmaz.
    '==========================================================================

    If Not FoundMember Then

        MsgBox _
            "TEST-085 UYGULANAMADI." & vbCrLf & vbCrLf & _
            "Mevcut üyeler arasýnda ÝSTÝFA durumundaki üye bulunamadý." & _
            vbCrLf & vbCrLf & _
            "Test için yeni üye oluþturulmadý." & vbCrLf & _
            "Gerçek kullanýcý verileri deðiþtirilmedi." & vbCrLf & vbCrLf & _
            "Sonuç: TEST ÖN KOÞULU YOK", _
            vbExclamation, _
            "OAA - TEST-085"

        Exit Sub

    End If

    '==========================================================================
    ' 5 - TEST DÖNEMÝ
    '
    ' Service 7212 kontrolü mükerrerlikten önce gerçekleþtiði için
    ' herhangi bir geçerli dönem kullanýlabilir.
    '
    ' Mümkünse mevcut TOPLANTI NORMAL kaydý olmayan bir dönem seçilir.
    '==========================================================================

    FiscalYear = 2098

    For MonthNo = 1 To 12

        '--------------------------------------------------------------
        ' Burada yalnýzca mevcut üyenin dönemini test etmek istiyoruz.
        ' Repository nesnesini ayrýca oluþturmuyoruz.
        '
        ' Dönem kontrolü Service tarafýndan temel validation ile yapýlýr.
        ' 2098 / ay deðeri geçerlidir.
        '--------------------------------------------------------------

        DueMonth = MonthNo
        FoundMonth = True

        Exit For

    Next MonthNo

    If Not FoundMonth Then

        MsgBox _
            "TEST-085 UYGULANAMADI." & vbCrLf & vbCrLf & _
            "Geçerli test dönemi oluþturulamadý." & vbCrLf & vbCrLf & _
            "Gerçek kullanýcý verileri deðiþtirilmedi.", _
            vbExclamation, _
            "OAA - TEST-085"

        Exit Sub

    End If

    '==========================================================================
    ' 6 - TEST PARAMETRELERÝ
    '==========================================================================

    ChargeDate = _
        DateSerial(FiscalYear, DueMonth, 15)

    Amount = 150@

    '==========================================================================
    ' 7 - TOPLANTI AÝDATI OLUÞTURMAYI DENE
    '
    ' Üye ÝSTÝFA olduðu için Service'in 7212 üretmesi beklenmektedir.
    '==========================================================================

    On Error Resume Next

    Err.Clear

    TestChargeID = _
        Service.AddMeetingCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            "TEST-085", _
            ChargeDate, _
            "TEST-085 - ÝSTÝFA üye reddi")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorNumber = Err.Number
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 8 - SERVICE HATA VERMELÝ
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 13503, _
                  "TEST_085", _
                  "ÝSTÝFA üyeye TOPLANTI aidatý uygulanmasý " & _
                  "Service tarafýndan reddedilmedi."

    End If

    '==========================================================================
    ' 9 - CHARGEID OLUÞMAMALI
    '==========================================================================

    If TestChargeID <> 0 Then

        Err.Raise vbObjectError + 13504, _
                  "TEST_085", _
                  "ÝSTÝFA üye reddedildiði halde ChargeID oluþtu." & _
                  vbCrLf & _
                  "ChargeID = " & TestChargeID

    End If

    '==========================================================================
    ' 10 - HATA NUMARASI KONTROLÜ
    '==========================================================================

    If ErrorNumber = 0 Then

        Err.Raise vbObjectError + 13505, _
                  "TEST_085", _
                  "Service hata verdi ancak Err.Number alýnamadý."

    End If

    If ErrorNumber <> ExpectedErrorNumber Then

        Err.Raise vbObjectError + 13506, _
                  "TEST_085", _
                  "Beklenen VBA hata numarasý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen Service kodu : 7212" & _
                  vbCrLf & _
                  "Beklenen Err.Number  : " & ExpectedErrorNumber & _
                  vbCrLf & _
                  "Alýnan Err.Number    : " & ErrorNumber & _
                  vbCrLf & vbCrLf & _
                  "Hata mesajý:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 11 - HATA MESAJI KONTROLÜ
    '==========================================================================

    If StrComp( _
            Trim$(ErrorDescription), _
            "Ýzinli veya istifa durumundaki üyeye toplantý aidatý uygulanamaz.", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13507, _
                  "TEST_085", _
                  "7212 hata mesajý beklenen metinle eþleþmiyor." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen:" & vbCrLf & _
                  "Ýzinli veya istifa durumundaki üyeye toplantý aidatý uygulanamaz." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan:" & vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 12 - ÜYENÝN STATUS DEÐÝÞMEDÝ
    '
    ' Önceki TEST-084'te kullandýðýmýz doðru Repository API:
    '
    '   FindByID
    '==========================================================================

    Set Member = _
        MemberRepo.GetByID(TestMemberID)

    If Member Is Nothing Then

        Err.Raise vbObjectError + 13508, _
                  "TEST_085", _
                  "Test edilen ÝSTÝFA üye test sonrasýnda bulunamadý."

    End If

    If StrComp( _
            Trim$(Member.Status), _
            "Ýstifa", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13509, _
                  "TEST_085", _
                  "TEST-085 sonrasýnda üyenin Status deðeri deðiþti." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen: Ýstifa" & _
                  vbCrLf & _
                  "Alýnan  : " & Member.Status

    End If

    '==========================================================================
    ' 13 - LEAVEDATE DEÐÝÞMEMÝÞ OLMALI
    '==========================================================================

    If Member.LeaveDate <> OriginalLeaveDate Then

        Err.Raise vbObjectError + 13510, _
                  "TEST_085", _
                  "TEST-085 sonrasýnda üyenin LeaveDate deðeri deðiþti." & _
                  vbCrLf & vbCrLf & _
                  "Test öncesi: " & _
                    Format$(OriginalLeaveDate, "dd.mm.yyyy") & _
                  vbCrLf & _
                  "Test sonrasý: " & _
                    Format$(Member.LeaveDate, "dd.mm.yyyy")

    End If

    '==========================================================================
    ' 14 - BAÞLANGIÇ STATUS BÝLGÝSÝ DEÐÝÞMEMÝÞ OLMALI
    '==========================================================================

    If StrComp( _
            Trim$(OriginalStatus), _
            Trim$(Member.Status), _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13511, _
                  "TEST_085", _
                  "Üyenin baþlangýç Status deðeri korunmadý."

    End If

    '==========================================================================
    ' 15 - BAÞARILI
    '
    ' Service validation aþamasýnda hata oluþtuðu için Repository.Add
    ' çalýþmamalýdýr.
    '==========================================================================

    MsgBox _
        "TEST-085 BAÞARILI." & vbCrLf & vbCrLf & _
        "ÝSTÝFA üye      : " & TestMemberID & vbCrLf & _
        "Üye durumu      : Ýstifa" & vbCrLf & _
        "Mali yýl        : " & FiscalYear & vbCrLf & _
        "Dönem ayý       : " & DueMonth & vbCrLf & _
        "ChargeDate      : " & _
            Format$(ChargeDate, "dd.mm.yyyy") & vbCrLf & _
        "Amount          : " & Amount & " TL" & vbCrLf & vbCrLf & _
        "Service sonucu  : REDDEDÝLDÝ" & vbCrLf & _
        "Service kodu    : 7212" & vbCrLf & _
        "VBA Err.Number  : " & ErrorNumber & vbCrLf & _
        "Hata mesajý     : " & ErrorDescription & vbCrLf & _
        "ChargeID        : 0" & vbCrLf & _
        "Yeni kayýt      : YOK" & vbCrLf & _
        "Status deðiþimi : YOK" & vbCrLf & _
        "LeaveDate deðiþimi: YOK" & vbCrLf & _
        "Cleanup         : GEREKMEDÝ" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-085"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    TestErrorNumber = Err.Number
    TestErrorDescription = Err.Description

    On Error Resume Next

    If TestChargeID > 0 Then

        DeleteTestCharge TestChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-085 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & TestErrorNumber & vbCrLf & _
        "Açýklama: " & TestErrorDescription & vbCrLf & vbCrLf & _
        "Test Üyesi : " & TestMemberID & vbCrLf & _
        "ChargeID   : " & TestChargeID & vbCrLf & vbCrLf & _
        "Cleanup uygulanmaya çalýþýldý.", _
        vbCritical, _
        "OAA - TEST-085"

End Sub




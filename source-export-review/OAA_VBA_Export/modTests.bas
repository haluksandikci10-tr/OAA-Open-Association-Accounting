    If Not MemberRepository.Update(TestMember) Then

        MsgBox "TEST-014A BAÞARISIZ." & vbCrLf & vbCrLf & _
               "Üye geçici olarak Ýstifa durumuna getirilemedi." & vbCrLf & _
               "Üye No: " & TestMemberID, _
               vbCritical, "OAA - TEST-014A"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' ÝSTÝFA SONRASI AMA DÖNEM SONUNDAN ÖNCE
    '
    ' 15.01.2027 -> istifa
    ' 01.02.2027 -> tahakkuk
    ' 31.12.2027 -> dönem sonu
    '
    ' Tahakkuk BAÞARILI olmalý.
    '----------------------------------------------------------------------

    TestChargeID = Service.AddOfficialCharge( _
                        TestMemberID, _
                        2027, _
                        2, _
                        TestChargeDate, _
                        500@, _
                        TestPeriodEndDate, _
                        "TEST-014A", _
                        DateSerial(2027, 1, 10), _
                        "TEST-014A - Ýstifa sonrasý dönem içi resmi aidat")

    '----------------------------------------------------------------------
    ' ChargeID kontrolü
    '----------------------------------------------------------------------

    If TestChargeID <= 0 Then

        GoTo TestFailed

    End If

    '----------------------------------------------------------------------
    ' Tahakkuku geri oku
    '----------------------------------------------------------------------

    Set Charge = Repository.GetByID(TestChargeID)

    If Charge Is Nothing Then

        GoTo TestFailed

    End If

    '----------------------------------------------------------------------
    ' ALAN KONTROLLERÝ
    '----------------------------------------------------------------------

    If Charge.MemberID <> TestMemberID Then
        GoTo TestFailed
    End If

    If Charge.ChargeType <> "RESMI" Then
        GoTo TestFailed
    End If

    If Charge.ChargeDate <> TestChargeDate Then
        GoTo TestFailed
    End If

    If Charge.FiscalYear <> 2027 Then
        GoTo TestFailed
    End If

    If Charge.DueMonth <> 2 Then
        GoTo TestFailed
    End If


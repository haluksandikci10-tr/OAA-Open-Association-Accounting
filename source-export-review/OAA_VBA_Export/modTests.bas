'   5. DeleteByID
'
' Test sonunda oluþturulan gelir kaydý silinir.
'==============================================================================

Public Sub TEST_129_ClsIncomeRepository()

    Dim Repository As clsIncomeRepository

    Dim Income As clsIncome
    Dim LoadedIncome As clsIncome
    Dim CurrentIncome As clsIncome

    Dim AllIncomes As Collection

    Dim ExpectedIncomeID As Long
    Dim TestIncomeID As Long
    Dim NextIncomeID As Long

    Dim TestEntryDate As Date
    Dim TestDocumentNo As String
    Dim TestIncomeType As String
    Dim TestDescription As String
    Dim TestAmount As Currency

    Dim FoundIncome As Boolean
    Dim I As Long

    Dim ErrorNumber As Long
    Dim ErrorDescription As String


    On Error GoTo TestError


    '==========================================================================
    ' TEST VERÝLERÝ
    '==========================================================================

    TestEntryDate = Date
    TestIncomeType = "TEST-129"
    TestDescription = "TEST-129 - clsIncomeRepository testi"
    TestAmount = CCur(0.01)


    '==========================================================================
    ' REPOSITORY
    '==========================================================================

    Set Repository = New clsIncomeRepository


    '==========================================================================
    ' SONRAKÝ INCOME ID
    '==========================================================================

    ExpectedIncomeID = Repository.GetNextIncomeID

    If ExpectedIncomeID <= 0 Then

        Err.Raise _
            vbObjectError + 12901, _
            "TEST-129", _
            "Repository.GetNextIncomeID geçerli bir IncomeID döndürmedi."

    End If


    TestDocumentNo = _
        "TEST-129-" & CStr(ExpectedIncomeID)


    '==========================================================================
    ' TEST ENTITY
    '==========================================================================

    Set Income = New clsIncome

    Income.IncomeID = 0
    Income.EntryDate = TestEntryDate
    Income.DocumentNo = TestDocumentNo
    Income.IncomeType = TestIncomeType
    Income.Description = TestDescription
    Income.IncomeAmount = TestAmount
    Income.CashAmount = TestAmount
    Income.BankAmount = CCur(0)


    '==========================================================================
    ' ADD
    '==========================================================================

    TestIncomeID = Repository.Add(Income)

    If TestIncomeID <= 0 Then

        Err.Raise _
            vbObjectError + 12902, _
            "TEST-129", _
            "Repository.Add geçerli bir IncomeID döndürmedi."

    End If


    If TestIncomeID <> ExpectedIncomeID Then

        Err.Raise _
            vbObjectError + 12903, _
            "TEST-129", _
            "Repository.Add sonucu ile beklenen IncomeID eþleþmiyor."

    End If


    If Income.IncomeID <> TestIncomeID Then

        Err.Raise _
            vbObjectError + 12904, _
            "TEST-129", _
            "Repository.Add sonrasý Entity IncomeID deðeri hatalý."

    End If


    '==========================================================================
    ' GET BY ID
    '==========================================================================

    Set LoadedIncome = _
        Repository.GetByID(TestIncomeID)

    If LoadedIncome Is Nothing Then

        Err.Raise _
            vbObjectError + 12905, _
            "TEST-129", _
            "Eklenen gelir kaydý GetByID ile bulunamadý."

    End If


    If LoadedIncome.IncomeID <> TestIncomeID Then GoTo DataError
    If LoadedIncome.EntryDate <> TestEntryDate Then GoTo DataError
    If LoadedIncome.DocumentNo <> TestDocumentNo Then GoTo DataError
    If LoadedIncome.IncomeType <> TestIncomeType Then GoTo DataError
    If LoadedIncome.Description <> TestDescription Then GoTo DataError
    If LoadedIncome.IncomeAmount <> TestAmount Then GoTo DataError
    If LoadedIncome.CashAmount <> TestAmount Then GoTo DataError
    If LoadedIncome.BankAmount <> CCur(0) Then GoTo DataError


    '==========================================================================
    ' GET ALL
    '==========================================================================

    Set AllIncomes = Repository.GetAll

    If AllIncomes Is Nothing Then

        Err.Raise _
            vbObjectError + 12906, _
            "TEST-129", _
            "Repository.GetAll Nothing döndürdü."

    End If


    FoundIncome = False

    For I = 1 To AllIncomes.Count

        Set CurrentIncome = AllIncomes(I)

        If Not CurrentIncome Is Nothing Then

            If CurrentIncome.IncomeID = TestIncomeID Then

                FoundIncome = True

                Exit For

            End If

        End If

    Next I


    If Not FoundIncome Then

        Err.Raise _
            vbObjectError + 12907, _
            "TEST-129", _
            "Eklenen gelir kaydý GetAll içinde bulunamadý."

    End If


    '==========================================================================
    ' SONRAKÝ INCOME ID
    '==========================================================================

    NextIncomeID = Repository.GetNextIncomeID

    If NextIncomeID <> TestIncomeID + 1 Then

        Err.Raise _
            vbObjectError + 12908, _
            "TEST-129", _
            "Kayýt eklendikten sonra sonraki IncomeID hatalý."

    End If


    '==========================================================================
    ' CLEANUP
    '==========================================================================

    If Not Repository.DeleteByID(TestIncomeID) Then

        Err.Raise _
            vbObjectError + 12909, _
            "TEST-129", _
            "Test gelir kaydý silinemedi."

    End If


    Set LoadedIncome = _
        Repository.GetByID(TestIncomeID)

    If Not LoadedIncome Is Nothing Then

        Err.Raise _
            vbObjectError + 12910, _
            "TEST-129", _
            "Cleanup sonrasý test gelir kaydý hâlâ mevcut."

    End If


    TestIncomeID = 0


    '==========================================================================
    ' BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-129 BAÞARILI" & vbCrLf & vbCrLf & _
        "GetNextIncomeID : BAÞARILI" & vbCrLf & _
        "Add             : BAÞARILI" & vbCrLf & _
        "GetByID         : BAÞARILI" & vbCrLf & _
        "GetAll          : BAÞARILI" & vbCrLf & _
        "DeleteByID      : BAÞARILI" & vbCrLf & vbCrLf & _
        "Test kaydý silindi.", _
        vbInformation, _
        "OAA - TEST-129"


    Set CurrentIncome = Nothing
    Set AllIncomes = Nothing
    Set LoadedIncome = Nothing
    Set Income = Nothing
    Set Repository = Nothing

    Exit Sub


DataError:

    Err.Raise _
        vbObjectError + 12911, _
        "TEST-129", _
        "GetByID ile okunan gelir alanlarýndan biri beklenen deðeri vermedi."


TestError:

    ErrorNumber = Err.Number
    ErrorDescription = Err.Description


    On Error Resume Next

    If TestIncomeID > 0 Then

        Repository.DeleteByID TestIncomeID

    End If

    On Error GoTo 0


    MsgBox _
        "TEST-129 BAÞARISIZ" & vbCrLf & vbCrLf & _
        "Hata No : " & ErrorNumber & vbCrLf & _
        "Açýklama: " & ErrorDescription & vbCrLf & vbCrLf & _
        "Varsa test kaydý temizlendi.", _
        vbCritical, _
        "OAA - TEST-129"


    Set CurrentIncome = Nothing
    Set AllIncomes = Nothing
    Set LoadedIncome = Nothing
    Set Income = Nothing
    Set Repository = Nothing

End Sub

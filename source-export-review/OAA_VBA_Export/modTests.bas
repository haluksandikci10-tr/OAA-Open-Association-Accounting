'==============================================================================
' TEST-112
'
' TOPLU RESMI AIDAT - POZITIF TOPLU TAHAKKUK
'
' AMAC:
'
'   AddBulkOfficialCharges metodunun uygun uyeler icin toplu RESMI
'   tahakkuk olusturdugunu ve olusan test kayitlarinin Repository
'   uzerinden temizlenebildigini dogrulamak.
'
' TEST DONEMI:
'
'   FiscalYear    = 2099
'   DueMonth      = 1
'   ChargeDate    = 15.01.2099
'   PeriodEndDate = 31.12.2099
'   Amount        = 150
'
' BEKLENEN:
'
'   CreatedCount > 0
'   ErrorCount = 0
'   ReturnedCount = CreatedCount
'
'   Olusan kayitlar:
'       ChargeType      = RESMI
'       AdjustmentType  = NORMAL
'       Status          = AKTIF
'       FiscalYear      = 2099
'       DueMonth        = 1
'       Amount          = 150
'
' CLEANUP:
'
'   Sadece TEST-112 aciklamasiyla olusan kayitlar DeleteByID ile silinir.
'
' NOT:
'
'   Uye kayitlari degistirilmez.
'   Uye silinmez.
'   Mevcut kullanici tahakkuklarina dokunulmaz.
'==============================================================================

Public Sub TEST_112()

    Dim Service As clsMemberChargeService
    Dim MemberRepo As clsMemberRepository
    Dim ChargeRepo As clsMemberChargeRepository

    Dim Members As Collection
    Dim Charges As Collection

    Dim Member As clsMember
    Dim Charge As clsMemberCharge

    Dim TestFiscalYear As Long
    Dim TestDueMonth As Long

    Dim TestChargeDate As Date
    Dim TestAmount As Currency
    Dim TestPeriodEndDate As Date

    Dim TestDecisionNo As String
    Dim TestDescription As String

    Dim CreatedCount As Long
    Dim SkippedCount As Long
    Dim ErrorCount As Long

    Dim ReturnedCount As Long

    Dim TestRecordCount As Long
    Dim CleanupCount As Long

    Dim ChargeID As Long

    Dim DeleteResult As Boolean

    Dim EligibleMemberCount As Long
    Dim ExistingMemberCount As Long

    Dim Mesaj As String
    Dim HataNo As Long
    Dim HataAciklama As String

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService

    Set MemberRepo = New clsMemberRepository

    Set ChargeRepo = New clsMemberChargeRepository

    '==========================================================================
    ' 2 - TEST PARAMETRELERI
    '==========================================================================

    TestFiscalYear = 2099

    TestDueMonth = 1

    TestChargeDate = _
        DateSerial(2099, 1, 15)

    TestAmount = 150@

    TestPeriodEndDate = _
        DateSerial(2099, 12, 31)

    TestDecisionNo = _
        "TEST-112"

    TestDescription = _
        "TEST-112 - Toplu resmi aidat pozitif test"

    '==========================================================================
    ' 3 - UYE LISTESI
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 16201, _
                  "TEST_112", _
                  "Uye listesi alinamadi."

    End If

    If Members.Count = 0 Then

        Mesaj = "TEST-112 UYGULANAMADI." & vbCrLf & vbCrLf

        Mesaj = Mesaj & _
            "Uye listesi bos." & vbCrLf

        Mesaj = Mesaj & _
            "Test uyesi otomatik olusturulmadi." & vbCrLf

        Mesaj = Mesaj & _
            "Gercek veriler degistirilmedi." & vbCrLf & vbCrLf

        Mesaj = Mesaj & _
            "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-112"

        Exit Sub

    End If

    '==========================================================================
    ' 4 - TEST DONEMINDE ONCEDEN TEST KAYDI VAR MI?
    '
    ' Eski bir yarim kalmis TEST-112 kaydini otomatik silmiyoruz.
    ' Gercek veriyi yanlislikla silme riskini onlemek icin test durur.
    '==========================================================================

    For Each Member In Members

        If Not Member Is Nothing Then

            Set Charges = _
                ChargeRepo.GetByMemberID(Member.MemberID)

            If Not Charges Is Nothing Then

                For Each Charge In Charges

                    If Not Charge Is Nothing Then

                        If Charge.FiscalYear = TestFiscalYear _
                           And Charge.DueMonth = TestDueMonth _
                           And StrComp( _
                               Trim$(Charge.ChargeType), _
                               "RESMI", _
                               vbTextCompare) = 0 _
                           And StrComp( _
                               Trim$(Charge.Description), _
                               TestDescription, _
                               vbTextCompare) = 0 Then

                            Err.Raise vbObjectError + 16202, _
                                      "TEST_112", _
                                      "2099/01 doneminde daha once " & _
                                      "TEST-112 aciklamali kayit bulundu." & _
                                      vbCrLf & _
                                      "ChargeID = " & Charge.ChargeID & _
                                      vbCrLf & _
                                      "Kayit otomatik silinmedi."

                        End If

                    End If

                Next Charge

            End If

        End If

    Next Member

    '==========================================================================
    ' 5 - ON KOSUL KONTROLU
    '
    ' Aktif veya Ýzinli üyelerden 2099/01 icin mevcut NORMAL RESMI
    ' tahakkuku olmayanlar sayilir.
    '
    ' Bu sadece bilgi/on kosul kontroludur.
    '==========================================================================

    EligibleMemberCount = 0

    ExistingMemberCount = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 _
               Or _
               StrComp( _
                    Trim$(Member.Status), _
                    "Ýzinli", _
                    vbTextCompare) = 0 Then

                If ChargeRepo.ExistsNormalCharge( _
                        Member.MemberID, _
                        TestFiscalYear, _
                        TestDueMonth, _
                        "RESMI") Then

                    ExistingMemberCount = _
                        ExistingMemberCount + 1

                Else

                    EligibleMemberCount = _
                        EligibleMemberCount + 1

                End If

            End If

        End If

    Next Member

    '==========================================================================
    ' 6 - UYGUN UYE YOKSA TESTI UYGULAMA
    '==========================================================================

    If EligibleMemberCount = 0 Then

        Mesaj = "TEST-112 UYGULANAMADI." & vbCrLf & vbCrLf

        Mesaj = Mesaj & _
            "2099/01 doneminde yeni NORMAL RESMI " & _
            "tahakkuk olusturulabilecek Aktif/Ýzinli uye yok." & vbCrLf & vbCrLf

        Mesaj = Mesaj & _
            "Aktif/Ýzinli mevcut mukerrer: " & _
            ExistingMemberCount & vbCrLf

        Mesaj = Mesaj & _
            "Yeni test kaydi zorlanmadi." & vbCrLf

        Mesaj = Mesaj & _
            "Gercek veriler degistirilmedi." & vbCrLf & vbCrLf

        Mesaj = Mesaj & _
            "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-112"

        Exit Sub

    End If

    '==========================================================================
    ' 7 - SAYACLARI BASLAT
    '==========================================================================

    CreatedCount = 0

    SkippedCount = 0

    ErrorCount = 0

    '==========================================================================
    ' 8 - GERCEK SERVICE CAGRISI
    '==========================================================================

    ReturnedCount = _
        Service.AddBulkOfficialCharges( _
            TestFiscalYear, _
            TestDueMonth, _
            TestChargeDate, _
            TestAmount, _
            TestPeriodEndDate, _
            TestDecisionNo, _
            TestChargeDate, _
            TestDescription, _
            CreatedCount, _
            SkippedCount, _
            ErrorCount)

    '==========================================================================
    ' 9 - BEKLENMEYEN HATA
    '==========================================================================

    If ErrorCount <> 0 Then

        Err.Raise vbObjectError + 16203, _
                  "TEST_112", _
                  "Toplu resmi aidat islemi beklenmeyen hata ile " & _
                  "tamamlandi." & vbCrLf & _
                  "ErrorCount = " & ErrorCount

    End If

    '==========================================================================
    ' 10 - EN AZ BIR KAYIT OLUSMALI
    '==========================================================================

    If CreatedCount <= 0 Then

        Err.Raise vbObjectError + 16204, _
                  "TEST_112", _
                  "Pozitif toplu resmi aidat testinde " & _
                  "hicbir tahakkuk olusturulmadi." & vbCrLf & _
                  "CreatedCount = " & CreatedCount & vbCrLf & _
                  "EligibleMemberCount = " & _
                  EligibleMemberCount

    End If

    '==========================================================================
    ' 11 - DONUS DEGERI
    '==========================================================================

    If ReturnedCount <> CreatedCount Then

        Err.Raise vbObjectError + 16205, _
                  "TEST_112", _
                  "Fonksiyon donus degeri CreatedCount ile " & _
                  "eslesmiyor." & vbCrLf & _
                  "ReturnedCount = " & ReturnedCount & vbCrLf & _
                  "CreatedCount  = " & CreatedCount

    End If

    '==========================================================================
    ' 12 - GERCEK OLUSAN TEST KAYITLARINI SAY
    '==========================================================================

    TestRecordCount = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            Set Charges = _
                ChargeRepo.GetByMemberID(Member.MemberID)

            If Not Charges Is Nothing Then

                For Each Charge In Charges

                    If Not Charge Is Nothing Then

                        If Charge.FiscalYear = TestFiscalYear _
                           And Charge.DueMonth = TestDueMonth _
                           And StrComp( _
                               Trim$(Charge.ChargeType), _
                               "RESMI", _
                               vbTextCompare) = 0 _
                           And StrComp( _
                               Trim$(Charge.AdjustmentType), _
                               "NORMAL", _
                               vbTextCompare) = 0 _
                           And StrComp( _
                               Trim$(Charge.Status), _
                               "AKTIF", _
                               vbTextCompare) = 0 _
                           And Charge.Amount = TestAmount _
                           And StrComp( _
                               Trim$(Charge.Description), _
                               TestDescription, _
                               vbTextCompare) = 0 Then

                            TestRecordCount = _
                                TestRecordCount + 1

                        End If

                    End If

                Next Charge

            End If

        End If

    Next Member

    '==========================================================================
    ' 13 - GERCEK KAYIT SAYISI
    '==========================================================================

    If TestRecordCount <> CreatedCount Then

        Err.Raise vbObjectError + 16206, _
                  "TEST_112", _
                  "CreatedCount ile gercek test kaydi sayisi " & _
                  "eslesmiyor." & vbCrLf & _
                  "CreatedCount   = " & CreatedCount & vbCrLf & _
                  "TestRecordCount = " & TestRecordCount

    End If

    '==========================================================================
    ' 14 - CLEANUP
    '
    ' Once ChargeID'leri topluyoruz.
    ' Ardindan kayitlari siliyoruz.
    '
    ' Boylece Collection uzerinde silme yaparken For Each problemi
    ' olusmasi engellenir.
    '==========================================================================

    Dim TestChargeIDs As Collection

    Set TestChargeIDs = New Collection

    For Each Member In Members

        If Not Member Is Nothing Then

            Set Charges = _
                ChargeRepo.GetByMemberID(Member.MemberID)

            If Not Charges Is Nothing Then

                For Each Charge In Charges

                    If Not Charge Is Nothing Then

                        If Charge.FiscalYear = TestFiscalYear _
                           And Charge.DueMonth = TestDueMonth _
                           And StrComp( _
                               Trim$(Charge.ChargeType), _
                               "RESMI", _
                               vbTextCompare) = 0 _
                           And StrComp( _
                               Trim$(Charge.AdjustmentType), _
                               "NORMAL", _
                               vbTextCompare) = 0 _
                           And StrComp( _
                               Trim$(Charge.Description), _
                               TestDescription, _
                               vbTextCompare) = 0 Then

                            TestChargeIDs.Add Charge.ChargeID

                        End If

                    End If

                Next Charge

            End If

        End If

    Next Member

       '==========================================================================
    ' 15 - CLEANUP KAYITLARI SIL
    '==========================================================================

    Dim CleanupIndex As Long

    CleanupCount = 0

    For CleanupIndex = 1 To TestChargeIDs.Count

        ChargeID = _
            CLng(TestChargeIDs(CleanupIndex))

        DeleteResult = _
            ChargeRepo.DeleteByID(ChargeID)

        If Not DeleteResult Then

            Err.Raise vbObjectError + 16207, _
                      "TEST_112", _
                      "Test kaydi cleanup yapilamadi." & _
                      vbCrLf & _
                      "ChargeID = " & ChargeID

        End If

        CleanupCount = _
            CleanupCount + 1

    Next CleanupIndex

    '==========================================================================
    ' 16 - CLEANUP SAYISI
    '==========================================================================

    If CleanupCount <> CreatedCount Then

        Err.Raise vbObjectError + 16208, _
                  "TEST_112", _
                  "Cleanup edilen kayit sayisi CreatedCount ile " & _
                  "eslesmiyor." & vbCrLf & _
                  "CreatedCount = " & CreatedCount & vbCrLf & _
                  "CleanupCount = " & CleanupCount

    End If

    '==========================================================================
    ' 17 - CLEANUP SONRASI TEST KAYDI KALMAMALI
    '==========================================================================

    For Each Member In Members

        If Not Member Is Nothing Then

            Set Charges = _
                ChargeRepo.GetByMemberID(Member.MemberID)

            If Not Charges Is Nothing Then

                For Each Charge In Charges

                    If Not Charge Is Nothing Then

                        If Charge.FiscalYear = TestFiscalYear _
                           And Charge.DueMonth = TestDueMonth _
                           And StrComp( _
                               Trim$(Charge.ChargeType), _
                               "RESMI", _
                               vbTextCompare) = 0 _
                           And StrComp( _
                               Trim$(Charge.Description), _
                               TestDescription, _
                               vbTextCompare) = 0 Then

                            Err.Raise vbObjectError + 16209, _
                                      "TEST_112", _
                                      "Cleanup sonrasinda TEST-112 kaydi " & _
                                      "hala mevcut." & vbCrLf & _
                                      "ChargeID = " & Charge.ChargeID

                        End If

                    End If

                Next Charge

            End If

        End If

    Next Member

    '==========================================================================
    ' 18 - BASARILI
    '==========================================================================

    Mesaj = "TEST-112 BASARILI." & vbCrLf & vbCrLf

    Mesaj = Mesaj & _
        "Test edilen API : AddBulkOfficialCharges" & vbCrLf

    Mesaj = Mesaj & _
        "FiscalYear      : " & TestFiscalYear & vbCrLf

    Mesaj = Mesaj & _
        "DueMonth        : " & TestDueMonth & vbCrLf

    Mesaj = Mesaj & _
        "ChargeDate      : " & _
        Format$(TestChargeDate, "dd.mm.yyyy") & vbCrLf

    Mesaj = Mesaj & _
        "Amount          : " & TestAmount & " TL" & vbCrLf

    Mesaj = Mesaj & _
        "PeriodEndDate   : " & _
        Format$(TestPeriodEndDate, "dd.mm.yyyy") & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & _
        "Uygun uye       : " & _
        EligibleMemberCount & vbCrLf

    Mesaj = Mesaj & _
        "Mevcut mukerrer  : " & _
        ExistingMemberCount & vbCrLf

    Mesaj = Mesaj & _
        "CreatedCount     : " & _
        CreatedCount & vbCrLf

    Mesaj = Mesaj & _
        "SkippedCount     : " & _
        SkippedCount & vbCrLf

    Mesaj = Mesaj & _
        "ErrorCount       : " & _
        ErrorCount & vbCrLf

    Mesaj = Mesaj & _
        "ReturnedCount    : " & _
        ReturnedCount & vbCrLf

    Mesaj = Mesaj & _
        "Gercek kayit     : " & _
        TestRecordCount & vbCrLf

    Mesaj = Mesaj & _
        "Cleanup          : " & _
        CleanupCount & vbCrLf

    Mesaj = Mesaj & _
        "Kalan TEST-112   : 0" & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & _
        "Uye kayitlari degistirilmedi." & vbCrLf

    Mesaj = Mesaj & _
        "Test kayitlari temizlendi." & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & _
        "Sonuc: BASARILI"

    MsgBox Mesaj, vbInformation, "OAA - TEST-112"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    HataNo = Err.Number

    HataAciklama = Err.Description

    '--------------------------------------------------------------------------
    ' Hata durumunda da TEST-112 kayitlarini temizlemeyi dene.
    '--------------------------------------------------------------------------
    
    On Error Resume Next

    If Not Members Is Nothing Then

        For Each Member In Members

            If Not Member Is Nothing Then

                Set Charges = _
                    ChargeRepo.GetByMemberID(Member.MemberID)

                If Not Charges Is Nothing Then

                    For Each Charge In Charges

                        If Not Charge Is Nothing Then

                            If Charge.FiscalYear = TestFiscalYear _
                               And Charge.DueMonth = TestDueMonth _
                               And StrComp( _
                                   Trim$(Charge.ChargeType), _
                                   "RESMI", _
                                   vbTextCompare) = 0 _
                               And StrComp( _
                                   Trim$(Charge.Description), _
                                   TestDescription, _
                                   vbTextCompare) = 0 Then

                                ChargeRepo.DeleteByID Charge.ChargeID

                            End If

                        End If

                    Next Charge

                End If

            End If

        Next Member

    End If

    On Error GoTo 0

    '--------------------------------------------------------------------------
    ' HATA MESAJI
    '--------------------------------------------------------------------------

    Mesaj = "TEST-112 BASARISIZ." & vbCrLf & vbCrLf

    Mesaj = Mesaj & _
        "Hata No : " & HataNo & vbCrLf

    Mesaj = Mesaj & _
        "Aciklama: " & HataAciklama & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & _
        "FiscalYear   : " & TestFiscalYear & vbCrLf

    Mesaj = Mesaj & _
        "DueMonth     : " & TestDueMonth & vbCrLf

    Mesaj = Mesaj & _
        "CreatedCount : " & CreatedCount & vbCrLf

    Mesaj = Mesaj & _
        "SkippedCount : " & SkippedCount & vbCrLf

    Mesaj = Mesaj & _
        "ErrorCount   : " & ErrorCount & vbCrLf

    Mesaj = Mesaj & _
        "Cleanup denendi." & vbCrLf

    MsgBox Mesaj, vbCritical, "OAA - TEST-112"

End Sub


'==============================================================================
' TEST-113
'
' TOPLU RESMI AIDAT - MUKERRER NORMAL KAYDIN ATLANMASI
'
' AMAC:
'
'   AddBulkOfficialCharges metodunun ayný üye + mali yýl + ay +
'   RESMI için mevcut NORMAL tahakkuku tekrar oluþturmadiðini
'   ve ilgili üyeyi SkippedCount olarak saydýðýný doðrulamak.
'
' SENARYO:
'
'   1. Uygun bir üye bulunur.
'   2. Bu üyeye TEST-113 için NORMAL RESMI tahakkuk oluþturulur.
'   3. Ayný mali yýl ve ay için AddBulkOfficialCharges çalýþtýrýlýr.
'   4. Hazýrlanan üyenin mevcut tahakkuku nedeniyle atlandýðý doðrulanýr.
'   5. SkippedCount >= 1 olmalýdýr.
'   6. ErrorCount = 0 olmalýdýr.
'   7. Oluþan diðer TEST-113 bulk kayýtlarý temizlenir.
'   8. Hazýrlýk için oluþturulan tahakkuk da temizlenir.
'
' ÖNEMLÝ:
'
'   Gerçek kullanýcý üye kaydý deðiþtirilmez.
'   Üye silinmez.
'   Mevcut kullanýcý tahakkuklarý silinmez.
'   Sadece TEST-113 tarafýndan oluþturulan kayýtlar temizlenir.
'
' GERÇEK SERVICE KURALI:
'
'   ExistsNormalCharge(...)
'       True
'           ->
'       SkippedCount = SkippedCount + 1
'           ->
'       yeni tahakkuk oluþturulmaz.
'==============================================================================

Public Sub TEST_113()

    Dim Service As clsMemberChargeService
    Dim MemberRepo As clsMemberRepository
    Dim ChargeRepo As clsMemberChargeRepository

    Dim Members As Collection
    Dim Charges As Collection

    Dim Member As clsMember
    Dim Charge As clsMemberCharge

    Dim TestMemberID As Long
    Dim SetupChargeID As Long

    Dim TestFiscalYear As Long
    Dim TestDueMonth As Long

    Dim TestChargeDate As Date
    Dim TestPeriodEndDate As Date
    Dim TestAmount As Currency

    Dim SetupDecisionNo As String
    Dim SetupDescription As String

    Dim BulkDecisionNo As String
    Dim BulkDescription As String

    Dim CreatedCount As Long
    Dim SkippedCount As Long
    Dim ErrorCount As Long

    Dim ReturnedCount As Long

    Dim BulkCreatedRecordCount As Long

    Dim CleanupIndex As Long
    Dim CleanupCount As Long

    Dim TestChargeIDs As Collection
    Dim DeleteResult As Boolean

    Dim ExistingNormalFound As Boolean
    Dim EligibleMemberFound As Boolean

    Dim Mesaj As String
    Dim HataNo As Long
    Dim HataAciklama As String

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService

    Set MemberRepo = New clsMemberRepository

    Set ChargeRepo = New clsMemberChargeRepository

    '==========================================================================
    ' 2 - TEST PARAMETRELERI
    '
    ' 2099 / 2 secilmistir.
    '
    ' TEST-113 tarafindan olusturulan kayitlar Description ile ayrilir.
    '==========================================================================

    TestFiscalYear = 2099

    TestDueMonth = 2

    TestChargeDate = _
        DateSerial(2099, 2, 15)

    TestPeriodEndDate = _
        DateSerial(2099, 12, 31)

    TestAmount = 175@

    SetupDecisionNo = _
        "TEST-113-SETUP"

    SetupDescription = _
        "TEST-113 - MUKERRER KONTROL HAZIRLIK"

    BulkDecisionNo = _
        "TEST-113-BULK"

    BulkDescription = _
        "TEST-113 - MUKERRER BULK"

    TestMemberID = 0

    SetupChargeID = 0

    CreatedCount = 0

    SkippedCount = 0

    ErrorCount = 0

    ReturnedCount = 0

    BulkCreatedRecordCount = 0

    CleanupCount = 0

    ExistingNormalFound = False

    EligibleMemberFound = False

    '==========================================================================
    ' 3 - UYE LISTESI
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 16301, _
                  "TEST_113", _
                  "Uye listesi alinamadi."

    End If

    If Members.Count = 0 Then

        Mesaj = "TEST-113 UYGULANAMADI." & vbCrLf & vbCrLf

        Mesaj = Mesaj & _
            "Uye listesi bos." & vbCrLf

        Mesaj = Mesaj & _
            "Test uyesi olusturulmadi." & vbCrLf

        Mesaj = Mesaj & _
            "Gercek veriler degistirilmedi." & vbCrLf & vbCrLf

        Mesaj = Mesaj & _
            "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-113"

        Exit Sub

    End If

    '==========================================================================
    ' 4 - UYGUN BIR TEST UYESI BUL
    '
    ' Aktif veya Ýzinli bir uye aranir.
    '
    ' Ayni donemde mevcut NORMAL RESMI kaydi olmayan ilk uygun uye secilir.
    ' Boylece once kendi setup kaydimizi olusturabiliriz.
    '==========================================================================

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 _
               Or _
               StrComp( _
                    Trim$(Member.Status), _
                    "Ýzinli", _
                    vbTextCompare) = 0 Then

                If Not ChargeRepo.ExistsNormalCharge( _
                        Member.MemberID, _
                        TestFiscalYear, _
                        TestDueMonth, _
                        "RESMI") Then

                    TestMemberID = Member.MemberID

                    EligibleMemberFound = True

                    Exit For

                End If

            End If

        End If

    Next Member

    '==========================================================================
    ' 5 - UYGUN UYE YOK
    '==========================================================================

    If Not EligibleMemberFound Then

        Mesaj = "TEST-113 UYGULANAMADI." & vbCrLf & vbCrLf

        Mesaj = Mesaj & _
            "2099/02 doneminde mevcut NORMAL RESMI " & _
            "tahakkuku olmayan Aktif/Ýzinli uye bulunamadi." & vbCrLf & vbCrLf

        Mesaj = Mesaj & _
            "Gercek veriler degistirilmedi." & vbCrLf

        Mesaj = Mesaj & _
            "Yeni test kaydi olusturulmadi." & vbCrLf & vbCrLf

        Mesaj = Mesaj & _
            "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-113"

        Exit Sub

    End If

    '==========================================================================
    ' 6 - SECILEN UYE ICIN TEST HAZIRLIK KAYDI OLUSTUR
    '
    ' Bu kayit testin duplicate kosulunu olusturur.
    '==========================================================================

    SetupChargeID = _
        Service.AddOfficialCharge( _
            TestMemberID, _
            TestFiscalYear, _
            TestDueMonth, _
            TestChargeDate, _
            TestAmount, _
            TestPeriodEndDate, _
            SetupDecisionNo, _
            TestChargeDate, _
            SetupDescription)

    If SetupChargeID <= 0 Then

        Err.Raise vbObjectError + 16302, _
                  "TEST_113", _
                  "TEST-113 hazirlik tahakkuku olusturulamadi."

    End If

    '==========================================================================
    ' 7 - HAZIRLIK KAYDINI DOGRULA
    '==========================================================================

    Set Charge = _
        ChargeRepo.GetByID(SetupChargeID)

    If Charge Is Nothing Then

        Err.Raise vbObjectError + 16303, _
                  "TEST_113", _
                  "Hazirlik tahakkuku Repository uzerinden bulunamadi." & _
                  vbCrLf & _
                  "ChargeID = " & SetupChargeID

    End If

    If Charge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 16304, _
                  "TEST_113", _
                  "Hazirlik kaydinin MemberID degeri hatali." & _
                  vbCrLf & _
                  "Beklenen = " & TestMemberID & _
                  vbCrLf & _
                  "Alinan   = " & Charge.MemberID

    End If

    If StrComp( _
            Trim$(Charge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 16305, _
                  "TEST_113", _
                  "Hazirlik kaydi RESMI degil."

    End If

    If StrComp( _
            Trim$(Charge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 16306, _
                  "TEST_113", _
                  "Hazirlik kaydi NORMAL degil."

    End If

    If Charge.FiscalYear <> TestFiscalYear Then

        Err.Raise vbObjectError + 16307, _
                  "TEST_113", _
                  "Hazirlik kaydinin FiscalYear degeri hatali."

    End If

    If Charge.DueMonth <> TestDueMonth Then

        Err.Raise vbObjectError + 16308, _
                  "TEST_113", _
                  "Hazirlik kaydinin DueMonth degeri hatali."

    End If

    If Charge.Amount <> TestAmount Then

        Err.Raise vbObjectError + 16309, _
                  "TEST_113", _
                  "Hazirlik kaydinin Amount degeri hatali."

    End If

    '==========================================================================
    ' 8 - DUPLICATE KONTROLUNUN GERCEKTEN AKTIF OLDUGUNU DOGRULA
    '==========================================================================

    ExistingNormalFound = _
        ChargeRepo.ExistsNormalCharge( _
            TestMemberID, _
            TestFiscalYear, _
            TestDueMonth, _
            "RESMI")

    If Not ExistingNormalFound Then

        Err.Raise vbObjectError + 16310, _
                  "TEST_113", _
                  "Hazirlik kaydi olusturuldugu halde " & _
                  "ExistsNormalCharge True donmedi."

    End If

    '==========================================================================
    ' 9 - TOPLU RESMI AIDAT ISLEMI
    '
    ' Secilen TestMemberID icin zaten NORMAL RESMI kayit vardir.
    '
    ' Dolayisiyla:
    '
    '   SkippedCount en az 1
    '
    ' olmalidir.
    '==========================================================================

    CreatedCount = 0

    SkippedCount = 0

    ErrorCount = 0

    ReturnedCount = _
        Service.AddBulkOfficialCharges( _
            TestFiscalYear, _
            TestDueMonth, _
            TestChargeDate, _
            TestAmount, _
            TestPeriodEndDate, _
            BulkDecisionNo, _
            TestChargeDate, _
            BulkDescription, _
            CreatedCount, _
            SkippedCount, _
            ErrorCount)

    '==========================================================================
    ' 10 - BEKLENMEYEN HATA KONTROLU
    '==========================================================================

    If ErrorCount <> 0 Then

        Err.Raise vbObjectError + 16311, _
                  "TEST_113", _
                  "Toplu iþlem beklenmeyen hata ile tamamlandi." & _
                  vbCrLf & _
                  "ErrorCount = " & ErrorCount

    End If

    '==========================================================================
    ' 11 - EN AZ BIR UYE ATLANMALI
    '==========================================================================

    If SkippedCount < 1 Then

        Err.Raise vbObjectError + 16312, _
                  "TEST_113", _
                  "Mükerrer NORMAL RESMI tahakkuku olan uye " & _
                  "SkippedCount olarak sayilmadi." & _
                  vbCrLf & _
                  "SkippedCount = " & SkippedCount

    End If

    '==========================================================================
    ' 12 - SECILEN UYE ICIN YENI BULK KAYDI OLUSMAMALI
    '
    ' Setup kaydi mevcut kalmalidir.
    ' Bulk aciklamasiyla ayni uye icin ikinci kayit bulunmamali.
    '==========================================================================

    Set Charges = _
        ChargeRepo.GetByMemberID(TestMemberID)

    If Not Charges Is Nothing Then

        For Each Charge In Charges

            If Not Charge Is Nothing Then

                If Charge.FiscalYear = TestFiscalYear _
                   And Charge.DueMonth = TestDueMonth _
                   And StrComp( _
                       Trim$(Charge.ChargeType), _
                       "RESMI", _
                       vbTextCompare) = 0 _
                   And StrComp( _
                       Trim$(Charge.AdjustmentType), _
                       "NORMAL", _
                       vbTextCompare) = 0 Then

                    If StrComp( _
                            Trim$(Charge.Description), _
                            BulkDescription, _
                            vbTextCompare) = 0 Then

                        Err.Raise vbObjectError + 16313, _
                                  "TEST_113", _
                                  "Mükerrer tahakkuk kontrolune ragmen " & _
                                  "secilen uye icin yeni BULK tahakkuku " & _
                                  "olusturuldu." & vbCrLf & _
                                  "ChargeID = " & Charge.ChargeID

                    End If

                End If

            End If

        Next Charge

    End If

    '==========================================================================
    ' 13 - BULK TARAFINDAN OLUSTURULAN KAYITLARI SAY
    '
    ' Bu sayi 0 olabilir.
    ' Cunku sistemdeki diger uyelerin durumuna gore bulk kayitlari
    ' olusturulabilir veya atlanabilir.
    '==========================================================================

    BulkCreatedRecordCount = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            Set Charges = _
                ChargeRepo.GetByMemberID(Member.MemberID)

            If Not Charges Is Nothing Then

                For Each Charge In Charges

                    If Not Charge Is Nothing Then

                        If Charge.FiscalYear = TestFiscalYear _
                           And Charge.DueMonth = TestDueMonth _
                           And StrComp( _
                               Trim$(Charge.ChargeType), _
                               "RESMI", _
                               vbTextCompare) = 0 _
                           And StrComp( _
                               Trim$(Charge.AdjustmentType), _
                               "NORMAL", _
                               vbTextCompare) = 0 _
                           And StrComp( _
                               Trim$(Charge.Description), _
                               BulkDescription, _
                               vbTextCompare) = 0 Then

                            BulkCreatedRecordCount = _
                                BulkCreatedRecordCount + 1

                        End If

                    End If

                Next Charge

            End If

        End If

    Next Member

    '==========================================================================
    ' 14 - RETURNED COUNT = CREATED COUNT
    '==========================================================================

    If ReturnedCount <> CreatedCount Then

        Err.Raise vbObjectError + 16314, _
                  "TEST_113", _
                  "Fonksiyon donus degeri CreatedCount ile " & _
                  "eslesmiyor." & vbCrLf & _
                  "ReturnedCount = " & ReturnedCount & _
                  vbCrLf & _
                  "CreatedCount  = " & CreatedCount

    End If

    '==========================================================================
    ' 15 - BULK OLUSAN KAYIT SAYISI CREATEDCOUNT ILE ESIT OLMALI
    '==========================================================================

    If BulkCreatedRecordCount <> CreatedCount Then

        Err.Raise vbObjectError + 16315, _
                  "TEST_113", _
                  "Bulk tarafindan olusturulan gerçek kayit sayisi " & _
                  "CreatedCount ile eslesmiyor." & vbCrLf & _
                  "CreatedCount           = " & CreatedCount & _
                  vbCrLf & _
                  "BulkCreatedRecordCount = " & _
                  BulkCreatedRecordCount

    End If

    '==========================================================================
    ' 16 - CLEANUP ICIN BULK KAYIT ID'LERINI TOPLA
    '==========================================================================

    Set TestChargeIDs = New Collection

    For Each Member In Members

        If Not Member Is Nothing Then

            Set Charges = _
                ChargeRepo.GetByMemberID(Member.MemberID)

            If Not Charges Is Nothing Then

                For Each Charge In Charges

                    If Not Charge Is Nothing Then

                        If Charge.FiscalYear = TestFiscalYear _
                           And Charge.DueMonth = TestDueMonth _
                           And StrComp( _
                               Trim$(Charge.ChargeType), _
                               "RESMI", _
                               vbTextCompare) = 0 _
                           And StrComp( _
                               Trim$(Charge.AdjustmentType), _
                               "NORMAL", _
                               vbTextCompare) = 0 _
                           And StrComp( _
                               Trim$(Charge.Description), _
                               BulkDescription, _
                               vbTextCompare) = 0 Then

                            TestChargeIDs.Add Charge.ChargeID

                        End If

                    End If

                Next Charge

            End If

        End If

    Next Member

    '==========================================================================
    ' 17 - BULK TEST KAYITLARINI SIL
    '==========================================================================

    CleanupCount = 0

    For CleanupIndex = 1 To TestChargeIDs.Count

        SetupChargeID = _
            CLng(TestChargeIDs(CleanupIndex))

        DeleteResult = _
            ChargeRepo.DeleteByID(SetupChargeID)

        If Not DeleteResult Then

            Err.Raise vbObjectError + 16316, _
                      "TEST_113", _
                      "Bulk test kaydi cleanup edilemedi." & _
                      vbCrLf & _
                      "ChargeID = " & SetupChargeID

        End If

        CleanupCount = _
            CleanupCount + 1

    Next CleanupIndex

    '==========================================================================
    ' 18 - HAZIRLIK KAYDINI SIL
    '
    ' Bu kayit testin duplicate kosulunu olusturmak icin bizim tarafimizdan
    ' olusturulmustur.
    '==========================================================================

    If SetupChargeID > 0 Then

        '--------------------------------------------------------------------------
        ' Burada SetupChargeID artik son cleanup kaydinin ID'si olabilir.
        ' Bu nedenle orijinal setup ID'sini kullanmak icin tekrar buluyoruz.
        '--------------------------------------------------------------------------

        Dim OriginalSetupChargeID As Long

        OriginalSetupChargeID = 0

        Set Charges = _
            ChargeRepo.GetByMemberID(TestMemberID)

        If Not Charges Is Nothing Then

            For Each Charge In Charges

                If Not Charge Is Nothing Then

                    If Charge.FiscalYear = TestFiscalYear _
                       And Charge.DueMonth = TestDueMonth _
                       And StrComp( _
                           Trim$(Charge.ChargeType), _
                           "RESMI", _
                           vbTextCompare) = 0 _
                       And StrComp( _
                           Trim$(Charge.AdjustmentType), _
                           "NORMAL", _
                           vbTextCompare) = 0 _
                       And StrComp( _
                           Trim$(Charge.Description), _
                           SetupDescription, _
                           vbTextCompare) = 0 Then

                        OriginalSetupChargeID = _
                            Charge.ChargeID

                        Exit For

                    End If

                End If

            Next Charge

        End If

        If OriginalSetupChargeID > 0 Then

            DeleteResult = _
                ChargeRepo.DeleteByID(OriginalSetupChargeID)

            If Not DeleteResult Then

                Err.Raise vbObjectError + 16317, _
                          "TEST_113", _
                          "TEST-113 hazirlik kaydi cleanup edilemedi." & _
                          vbCrLf & _
                          "ChargeID = " & OriginalSetupChargeID

            End If

        End If

    End If

    '==========================================================================
    ' 19 - CLEANUP SONRASI BULK TEST KAYDI KALMAMALI
    '==========================================================================

    For Each Member In Members

        If Not Member Is Nothing Then

            Set Charges = _
                ChargeRepo.GetByMemberID(Member.MemberID)

            If Not Charges Is Nothing Then

                For Each Charge In Charges

                    If Not Charge Is Nothing Then

                        If Charge.FiscalYear = TestFiscalYear _
                           And Charge.DueMonth = TestDueMonth _
                           And StrComp( _
                               Trim$(Charge.ChargeType), _
                               "RESMI", _
                               vbTextCompare) = 0 _
                           And ( _
                               StrComp( _
                                   Trim$(Charge.Description), _
                                   BulkDescription, _
                                   vbTextCompare) = 0 _
                               Or _
                               StrComp( _
                                   Trim$(Charge.Description), _
                                   SetupDescription, _
                                   vbTextCompare) = 0 _
                           ) Then

                            Err.Raise vbObjectError + 16318, _
                                      "TEST_113", _
                                      "Cleanup sonrasinda TEST-113 kaydi " & _
                                      "hala mevcut." & vbCrLf & _
                                      "ChargeID = " & Charge.ChargeID

                        End If

                    End If

                Next Charge

            End If

        End If

    Next Member

    '==========================================================================
    ' 20 - BASARILI
    '==========================================================================

    Mesaj = "TEST-113 BASARILI." & vbCrLf & vbCrLf

    Mesaj = Mesaj & _
        "Test edilen API : AddBulkOfficialCharges" & vbCrLf

    Mesaj = Mesaj & _
        "Test MemberID   : " & TestMemberID & vbCrLf

    Mesaj = Mesaj & _
        "FiscalYear      : " & TestFiscalYear & vbCrLf

    Mesaj = Mesaj & _
        "DueMonth        : " & TestDueMonth & vbCrLf

    Mesaj = Mesaj & _
        "ChargeDate      : " & _
        Format$(TestChargeDate, "dd.mm.yyyy") & vbCrLf

    Mesaj = Mesaj & _
        "Amount          : " & TestAmount & " TL" & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & _
        "Hazirlik ChargeID : " & _
        OriginalSetupChargeID & vbCrLf

    Mesaj = Mesaj & _
        "CreatedCount     : " & _
        CreatedCount & vbCrLf

    Mesaj = Mesaj & _
        "SkippedCount     : " & _
        SkippedCount & vbCrLf

    Mesaj = Mesaj & _
        "ErrorCount       : " & _
        ErrorCount & vbCrLf

    Mesaj = Mesaj & _
        "ReturnedCount    : " & _
        ReturnedCount & vbCrLf

    Mesaj = Mesaj & _
        "Bulk kayit sayisi : " & _
        BulkCreatedRecordCount & vbCrLf

    Mesaj = Mesaj & _
        "Cleanup sayisi    : " & _
        CleanupCount & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & _
        "Mükerrer NORMAL RESMI kayit atlandi." & vbCrLf

    Mesaj = Mesaj & _
        "Yeni mükerrer kayit olusturulmadi." & vbCrLf

    Mesaj = Mesaj & _
        "Test kayitlari temizlendi." & vbCrLf

    Mesaj = Mesaj & _
        "Uye kaydi degistirilmedi." & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & _
        "Sonuc: BASARILI"

    MsgBox Mesaj, vbInformation, "OAA - TEST-113"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    HataNo = Err.Number

    HataAciklama = Err.Description

    '--------------------------------------------------------------------------
    ' Hata durumunda TEST-113'e ait geçici kayýtlarý temizlemeye çalýþ.
    '--------------------------------------------------------------------------

    On Error Resume Next

    If Not Members Is Nothing Then

        For Each Member In Members

            If Not Member Is Nothing Then

                Set Charges = _
                    ChargeRepo.GetByMemberID(Member.MemberID)

                If Not Charges Is Nothing Then

                    For Each Charge In Charges

                        If Not Charge Is Nothing Then

                            If Charge.FiscalYear = TestFiscalYear _
                               And Charge.DueMonth = TestDueMonth _
                               And StrComp( _
                                   Trim$(Charge.ChargeType), _
                                   "RESMI", _
                                   vbTextCompare) = 0 _
                               And ( _
                                   StrComp( _
                                       Trim$(Charge.Description), _
                                       BulkDescription, _
                                       vbTextCompare) = 0 _
                                   Or _
                                   StrComp( _
                                       Trim$(Charge.Description), _
                                       SetupDescription, _
                                       vbTextCompare) = 0 _
                               ) Then

                                ChargeRepo.DeleteByID Charge.ChargeID

                            End If

                        End If

                    Next Charge

                End If

            End If

        Next Member

    End If

    On Error GoTo 0

    '--------------------------------------------------------------------------
    ' HATA MESAJI
    '--------------------------------------------------------------------------

    Mesaj = "TEST-113 BASARISIZ." & vbCrLf & vbCrLf

    Mesaj = Mesaj & _
        "Hata No : " & HataNo & vbCrLf

    Mesaj = Mesaj & _
        "Aciklama: " & HataAciklama & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & _
        "Test MemberID : " & TestMemberID & vbCrLf

    Mesaj = Mesaj & _
        "FiscalYear    : " & TestFiscalYear & vbCrLf

    Mesaj = Mesaj & _
        "DueMonth      : " & TestDueMonth & vbCrLf

    Mesaj = Mesaj & _
        "SetupChargeID : " & SetupChargeID & vbCrLf

    Mesaj = Mesaj & _
        "CreatedCount  : " & CreatedCount & vbCrLf

    Mesaj = Mesaj & _
        "SkippedCount  : " & SkippedCount & vbCrLf

    Mesaj = Mesaj & _
        "ErrorCount    : " & ErrorCount & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & _
        "TEST-113 geçici kayýtlarý için cleanup denendi."

    MsgBox Mesaj, vbCritical, "OAA - TEST-113"

End Sub


'==============================================================================
' TEST-114
'
' TOPLU RESMI AIDAT - COKLU UYE ISLEMI
'
' AMAC:
'
'   AddBulkOfficialCharges metodunun birden fazla mevcut üyeyi ayný toplu
'   iþlem içinde iþleyebildiðini doðrulamak.
'
' TEST DONEMI:
'
'   FiscalYear    = 2099
'   DueMonth      = 3
'   ChargeDate    = 15.03.2099
'   Amount        = 200
'   PeriodEndDate = 31.12.2099
'
' BEKLENEN:
'
'   CreatedCount > 0
'   ErrorCount = 0
'   ReturnedCount = CreatedCount
'
'   Oluþan test kayýtlarýnýn:
'       FiscalYear     = 2099
'       DueMonth       = 3
'       ChargeType     = RESMI
'       AdjustmentType = NORMAL
'       Status         = AKTIF
'       Amount         = 200
'       Description    = TEST-114 açýklamasý
'
' CLEANUP:
'
'   Yalnýzca TEST-114 açýklamasýyla oluþturulan kayýtlar ChargeID üzerinden
'   DeleteByID ile silinir.
'
' ÜYE KAYDI:
'
'   Üyeler oluþturulmaz, deðiþtirilmez veya silinmez.
'==============================================================================

Public Sub TEST_114()

    Dim Service As clsMemberChargeService
    Dim MemberRepo As clsMemberRepository
    Dim ChargeRepo As clsMemberChargeRepository

    Dim Members As Collection
    Dim Charges As Collection
    Dim TestChargeIDs As Collection

    Dim Member As clsMember
    Dim Charge As clsMemberCharge

    Dim TestFiscalYear As Long
    Dim TestDueMonth As Long
    Dim TestChargeDate As Date
    Dim TestPeriodEndDate As Date
    Dim TestAmount As Currency

    Dim TestDecisionNo As String
    Dim TestDescription As String

    Dim CreatedCount As Long
    Dim SkippedCount As Long
    Dim ErrorCount As Long
    Dim ReturnedCount As Long

    Dim CreatedRecordCount As Long
    Dim CleanupCount As Long

    Dim CleanupIndex As Long
    Dim ChargeID As Long

    Dim DeleteResult As Boolean

    Dim EligibleMemberCount As Long
    Dim ExistingMemberCount As Long

    Dim Mesaj As String
    Dim HataNo As Long
    Dim HataAciklama As String

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set MemberRepo = New clsMemberRepository
    Set ChargeRepo = New clsMemberChargeRepository
    Set TestChargeIDs = New Collection

    '==========================================================================
    ' 2 - TEST PARAMETRELERI
    '==========================================================================

    TestFiscalYear = 2099

    TestDueMonth = 3

    TestChargeDate = _
        DateSerial(2099, 3, 15)

    TestPeriodEndDate = _
        DateSerial(2099, 12, 31)

    TestAmount = 200@

    TestDecisionNo = _
        "TEST-114"

    TestDescription = _
        "TEST-114 - Coklu uye toplu resmi aidat"

    CreatedCount = 0
    SkippedCount = 0
    ErrorCount = 0
    ReturnedCount = 0

    CreatedRecordCount = 0
    CleanupCount = 0

    EligibleMemberCount = 0
    ExistingMemberCount = 0

    '==========================================================================
    ' 3 - UYE LISTESI
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 16401, _
                  "TEST_114", _
                  "Uye listesi alinamadi."

    End If

    If Members.Count = 0 Then

        Mesaj = "TEST-114 UYGULANAMADI." & vbCrLf & vbCrLf

        Mesaj = Mesaj & _
            "Uye listesi bos." & vbCrLf

        Mesaj = Mesaj & _
            "Test uyesi olusturulmadi." & vbCrLf

        Mesaj = Mesaj & _
            "Gercek veriler degistirilmedi." & vbCrLf & vbCrLf

        Mesaj = Mesaj & _
            "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-114"

        Exit Sub

    End If

    '==========================================================================
    ' 4 - ONCEKI TEST-114 KAYDI KONTROLU
    '
    ' Eski bir TEST-114 kaydi varsa otomatik silinmez.
    '==========================================================================

    For Each Member In Members

        If Not Member Is Nothing Then

            Set Charges = _
                ChargeRepo.GetByMemberID(Member.MemberID)

            If Not Charges Is Nothing Then

                For Each Charge In Charges

                    If Not Charge Is Nothing Then

                        If Charge.FiscalYear = TestFiscalYear _
                           And Charge.DueMonth = TestDueMonth _
                           And StrComp( _
                               Trim$(Charge.ChargeType), _
                               "RESMI", _
                               vbTextCompare) = 0 _
                           And StrComp( _
                               Trim$(Charge.Description), _
                               TestDescription, _
                               vbTextCompare) = 0 Then

                            Err.Raise vbObjectError + 16402, _
                                      "TEST_114", _
                                      "TEST-114 icin daha once olusturulmus " & _
                                      "kayit bulundu." & vbCrLf & _
                                      "ChargeID = " & Charge.ChargeID & _
                                      vbCrLf & _
                                      "Kayit otomatik silinmedi."

                        End If

                    End If

                Next Charge

            End If

        End If

    Next Member

    '==========================================================================
    ' 5 - POZITIF TEST ICIN UYGUN UYE SAYISINI HESAPLA
    '
    ' Mevcut NORMAL RESMI kaydi olmayan Aktif/Ýzinli üyeler.
    '==========================================================================

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 _
               Or _
               StrComp( _
                    Trim$(Member.Status), _
                    "Ýzinli", _
                    vbTextCompare) = 0 Then

                If ChargeRepo.ExistsNormalCharge( _
                        Member.MemberID, _
                        TestFiscalYear, _
                        TestDueMonth, _
                        "RESMI") Then

                    ExistingMemberCount = _
                        ExistingMemberCount + 1

                Else

                    EligibleMemberCount = _
                        EligibleMemberCount + 1

                End If

            End If

        End If

    Next Member

    '==========================================================================
    ' 6 - EN AZ IKI UYGUN UYE GEREKIYOR
    '
    ' TEST-114'un amacý çoklu üye iþlemidir.
    ' Tek uygun üye varsa test senaryosu gerçekleþmez.
    '==========================================================================

    If EligibleMemberCount < 2 Then

        Mesaj = "TEST-114 UYGULANAMADI." & vbCrLf & vbCrLf

        Mesaj = Mesaj & _
            "2099/03 döneminde en az 2 uygun Aktif/Ýzinli uye gerekir." & vbCrLf

        Mesaj = Mesaj & _
            "Uygun uye sayisi : " & _
            EligibleMemberCount & vbCrLf

        Mesaj = Mesaj & _
            "Mevcut mukerrer  : " & _
            ExistingMemberCount & vbCrLf & vbCrLf

        Mesaj = Mesaj & _
            "Gercek veriler degistirilmedi." & vbCrLf

        Mesaj = Mesaj & _
            "Test kaydi olusturulmadi." & vbCrLf & vbCrLf

        Mesaj = Mesaj & _
            "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-114"

        Exit Sub

    End If

    '==========================================================================
    ' 7 - GERCEK SERVICE CAGRISI
    '==========================================================================

    ReturnedCount = _
        Service.AddBulkOfficialCharges( _
            TestFiscalYear, _
            TestDueMonth, _
            TestChargeDate, _
            TestAmount, _
            TestPeriodEndDate, _
            TestDecisionNo, _
            TestChargeDate, _
            TestDescription, _
            CreatedCount, _
            SkippedCount, _
            ErrorCount)

    '==========================================================================
    ' 8 - HATA OLMAMALI
    '==========================================================================

    If ErrorCount <> 0 Then

        Err.Raise vbObjectError + 16403, _
                  "TEST_114", _
                  "Toplu coklu uye islemi hata ile tamamlandi." & _
                  vbCrLf & _
                  "ErrorCount = " & ErrorCount

    End If

    '==========================================================================
    ' 9 - BIRDEN FAZLA KAYIT OLUSMALI
    '==========================================================================

    If CreatedCount < 2 Then

        Err.Raise vbObjectError + 16404, _
                  "TEST_114", _
                  "TEST-114 coklu uye testinde en az 2 kayit " & _
                  "olusturulmadi." & vbCrLf & _
                  "CreatedCount = " & CreatedCount

    End If

    '==========================================================================
    ' 10 - DONUS DEGERI
    '==========================================================================

    If ReturnedCount <> CreatedCount Then

        Err.Raise vbObjectError + 16405, _
                  "TEST_114", _
                  "Fonksiyon donus degeri CreatedCount ile " & _
                  "eslesmiyor." & vbCrLf & _
                  "ReturnedCount = " & ReturnedCount & vbCrLf & _
                  "CreatedCount  = " & CreatedCount

    End If

    '==========================================================================
    ' 11 - OLUSAN TEST KAYITLARINI BUL
    '==========================================================================

    CreatedRecordCount = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            Set Charges = _
                ChargeRepo.GetByMemberID(Member.MemberID)

            If Not Charges Is Nothing Then

                For Each Charge In Charges

                    If Not Charge Is Nothing Then

                        If Charge.FiscalYear = TestFiscalYear _
                           And Charge.DueMonth = TestDueMonth _
                           And StrComp( _
                               Trim$(Charge.ChargeType), _
                               "RESMI", _
                               vbTextCompare) = 0 _
                           And StrComp( _
                               Trim$(Charge.AdjustmentType), _
                               "NORMAL", _
                               vbTextCompare) = 0 _
                           And StrComp( _
                               Trim$(Charge.Status), _
                               "AKTIF", _
                               vbTextCompare) = 0 _
                           And Charge.Amount = TestAmount _
                           And StrComp( _
                               Trim$(Charge.Description), _
                               TestDescription, _
                               vbTextCompare) = 0 Then

                            CreatedRecordCount = _
                                CreatedRecordCount + 1

                            TestChargeIDs.Add _
                                Charge.ChargeID

                        End If

                    End If

                Next Charge

            End If

        End If

    Next Member

    '==========================================================================
    ' 12 - CREATEDCOUNT ILE GERCEK KAYIT SAYISI
    '==========================================================================

    If CreatedRecordCount <> CreatedCount Then

        Err.Raise vbObjectError + 16406, _
                  "TEST_114", _
                  "CreatedCount ile gercek test kaydi sayisi " & _
                  "eslesmiyor." & vbCrLf & _
                  "CreatedCount       = " & CreatedCount & vbCrLf & _
                  "CreatedRecordCount = " & CreatedRecordCount

    End If

    '==========================================================================
    ' 13 - TEST KAYITLARINI CLEANUP ET
    '==========================================================================

    CleanupCount = 0

    For CleanupIndex = 1 To TestChargeIDs.Count

        ChargeID = _
            CLng(TestChargeIDs(CleanupIndex))

        DeleteResult = _
            ChargeRepo.DeleteByID(ChargeID)

        If Not DeleteResult Then

            Err.Raise vbObjectError + 16407, _
                      "TEST_114", _
                      "Test kaydi cleanup edilemedi." & _
                      vbCrLf & _
                      "ChargeID = " & ChargeID

        End If

        CleanupCount = _
            CleanupCount + 1

    Next CleanupIndex

    '==========================================================================
    ' 14 - CLEANUP SAYISI
    '==========================================================================

    If CleanupCount <> CreatedCount Then

        Err.Raise vbObjectError + 16408, _
                  "TEST_114", _
                  "Cleanup sayisi CreatedCount ile eslesmiyor." & _
                  vbCrLf & _
                  "CreatedCount = " & CreatedCount & vbCrLf & _
                  "CleanupCount = " & CleanupCount

    End If

    '==========================================================================
    ' 15 - CLEANUP SONRASI TEST KAYDI KALMAMALI
    '==========================================================================

    For Each Member In Members

        If Not Member Is Nothing Then

            Set Charges = _
                ChargeRepo.GetByMemberID(Member.MemberID)

            If Not Charges Is Nothing Then

                For Each Charge In Charges

                    If Not Charge Is Nothing Then

                        If Charge.FiscalYear = TestFiscalYear _
                           And Charge.DueMonth = TestDueMonth _
                           And StrComp( _
                               Trim$(Charge.ChargeType), _
                               "RESMI", _
                               vbTextCompare) = 0 _
                           And StrComp( _
                               Trim$(Charge.Description), _
                               TestDescription, _
                               vbTextCompare) = 0 Then

                            Err.Raise vbObjectError + 16409, _
                                      "TEST_114", _
                                      "Cleanup sonrasinda TEST-114 kaydi " & _
                                      "hala mevcut." & vbCrLf & _
                                      "ChargeID = " & Charge.ChargeID

                        End If

                    End If

                Next Charge

            End If

        End If

    Next Member

    '==========================================================================
    ' 16 - BASARILI
    '==========================================================================

    Mesaj = "TEST-114 BASARILI." & vbCrLf & vbCrLf

    Mesaj = Mesaj & _
        "Test edilen API : AddBulkOfficialCharges" & vbCrLf

    Mesaj = Mesaj & _
        "FiscalYear      : " & TestFiscalYear & vbCrLf

    Mesaj = Mesaj & _
        "DueMonth        : " & TestDueMonth & vbCrLf

    Mesaj = Mesaj & _
        "ChargeDate      : " & _
        Format$(TestChargeDate, "dd.mm.yyyy") & vbCrLf

    Mesaj = Mesaj & _
        "Amount          : " & TestAmount & " TL" & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & _
        "Uygun uye       : " & _
        EligibleMemberCount & vbCrLf

    Mesaj = Mesaj & _
        "Mukerrer uye    : " & _
        ExistingMemberCount & vbCrLf

    Mesaj = Mesaj & _
        "CreatedCount    : " & _
        CreatedCount & vbCrLf

    Mesaj = Mesaj & _
        "SkippedCount    : " & _
        SkippedCount & vbCrLf

    Mesaj = Mesaj & _
        "ErrorCount      : " & _
        ErrorCount & vbCrLf

    Mesaj = Mesaj & _
        "ReturnedCount   : " & _
        ReturnedCount & vbCrLf

    Mesaj = Mesaj & _
        "Gercek kayit    : " & _
        CreatedRecordCount & vbCrLf

    Mesaj = Mesaj & _
        "Cleanup         : " & _
        CleanupCount & vbCrLf

    Mesaj = Mesaj & _
        "Kalan test kaydi: 0" & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & _
        "Birden fazla uye ayni toplu islemde basariyla islendi." & _
        vbCrLf

    Mesaj = Mesaj & _
        "Uye kayitlari degistirilmedi." & vbCrLf

    Mesaj = Mesaj & _
        "Test kayitlari temizlendi." & vbCrLf & vbCrLf

    Mesaj = Mesaj & _
        "Sonuc: BASARILI"

    MsgBox Mesaj, vbInformation, "OAA - TEST-114"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    HataNo = Err.Number

    HataAciklama = Err.Description

    '--------------------------------------------------------------------------
    ' Hata halinde de TEST-114 kayýtlarýný temizlemeyi dene.
    '--------------------------------------------------------------------------

    On Error Resume Next

    If Not Members Is Nothing Then

        For Each Member In Members

            If Not Member Is Nothing Then

                Set Charges = _
                    ChargeRepo.GetByMemberID(Member.MemberID)

                If Not Charges Is Nothing Then

                    For Each Charge In Charges

                        If Not Charge Is Nothing Then

                            If Charge.FiscalYear = TestFiscalYear _
                               And Charge.DueMonth = TestDueMonth _
                               And StrComp( _
                                   Trim$(Charge.ChargeType), _
                                   "RESMI", _
                                   vbTextCompare) = 0 _
                               And StrComp( _
                                   Trim$(Charge.Description), _
                                   TestDescription, _
                                   vbTextCompare) = 0 Then

                                ChargeRepo.DeleteByID _
                                    Charge.ChargeID

                            End If

                        End If

                    Next Charge

                End If

            End If

        Next Member

    End If

    On Error GoTo 0

    '--------------------------------------------------------------------------
    ' HATA MESAJI
    '--------------------------------------------------------------------------

    Mesaj = "TEST-114 BASARISIZ." & vbCrLf & vbCrLf

    Mesaj = Mesaj & _
        "Hata No : " & HataNo & vbCrLf

    Mesaj = Mesaj & _
        "Aciklama: " & HataAciklama & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & _
        "FiscalYear   : " & TestFiscalYear & vbCrLf

    Mesaj = Mesaj & _
        "DueMonth     : " & TestDueMonth & vbCrLf

    Mesaj = Mesaj & _
        "CreatedCount : " & CreatedCount & vbCrLf

    Mesaj = Mesaj & _
        "SkippedCount : " & SkippedCount & vbCrLf

    Mesaj = Mesaj & _
        "ErrorCount   : " & ErrorCount & vbCrLf

    Mesaj = Mesaj & _
        "Cleanup denendi." & vbCrLf

    MsgBox Mesaj, vbCritical, "OAA - TEST-114"

End Sub


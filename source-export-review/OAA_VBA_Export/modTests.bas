    ' CHARGE ID KONTROLÜ
    '--------------------------------------------------------------------------

    If LoadedReceipt.ChargeID <> TestChargeID Then

        Err.Raise _
            vbObjectError + 12203, _
            "TEST-122", _
            "ChargeID doðru kaydedilmedi veya okunamadý."

    End If


    '--------------------------------------------------------------------------
    ' MEMBER ID KONTROLÜ
    '--------------------------------------------------------------------------

    If LoadedReceipt.MemberID <> TestMemberID Then

        Err.Raise _
            vbObjectError + 12204, _
            "TEST-122", _
            "MemberID deðiþti."

    End If


    '--------------------------------------------------------------------------
    ' TUTAR KONTROLÜ
    '--------------------------------------------------------------------------

    If LoadedReceipt.Amount <> CCur(250) Then

        Err.Raise _
            vbObjectError + 12205, _
            "TEST-122", _
            "Receipt Amount deðeri hatalý."

    End If


    '--------------------------------------------------------------------------
    ' CLEANUP
    '--------------------------------------------------------------------------

    If Not Repo.DeleteByID(TestReceiptID) Then

        Err.Raise _
            vbObjectError + 12206, _
            "TEST-122", _
            "Test Receipt cleanup baþarýsýz."

    End If


    '--------------------------------------------------------------------------
    ' CLEANUP KONTROLÜ
    '--------------------------------------------------------------------------

    Set LoadedReceipt = _
        Repo.GetByID(TestReceiptID)

    If Not LoadedReceipt Is Nothing Then

        Err.Raise _
            vbObjectError + 12207, _
            "TEST-122", _
            "Cleanup sonrasýnda test Receipt kaydý hâlâ mevcut."

    End If


    '--------------------------------------------------------------------------
    ' BAÞARILI
    '--------------------------------------------------------------------------

    Debug.Print "TEST-122 BAÞARILI"
    Debug.Print "ReceiptID : " & TestReceiptID
    Debug.Print "MemberID  : " & TestMemberID
    Debug.Print "ChargeID  : " & TestChargeID
    Debug.Print "Amount    : 250"
    Debug.Print "Cleanup   : Baþarýlý"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-122 BAÞARILI" & vbCrLf & vbCrLf & _
        "Receipt › ChargeID baðlantýsý doðrulandý." & vbCrLf & _

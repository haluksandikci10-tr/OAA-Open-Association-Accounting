'==============================================================================

Public Sub Test_PermissionMemberMeetingChargeBlocked()

    Dim Service As clsMemberChargeService
    Dim Repository As clsMemberChargeRepository
    Dim MemberRepository As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember
    Dim TestMember As clsMember

    Dim Charge As clsMemberCharge

    Dim TestMemberID As Long
    Dim TestChargeID As Long

    Dim OriginalStatus As String

    Dim ErrorCaught As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    On Error GoTo ErrorHandler

    '----------------------------------------------------------------------
    ' Nesneler
    '----------------------------------------------------------------------

    Set Service = New clsMemberChargeService
    Set Repository = New clsMemberChargeRepository
    Set MemberRepository = New clsMemberRepository

    '----------------------------------------------------------------------
    ' Üyeleri getir
    '----------------------------------------------------------------------

    Set Members = MemberRepository.GetAll

    If Members Is Nothing Then

        MsgBox "TEST-013 BAÞARISIZ." & vbCrLf & vbCrLf & _
               "Üye listesi alýnamadý.", _
               vbCritical, "OAA - TEST-013"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' Test için AKTÝF üye bul
    '----------------------------------------------------------------------

    TestMemberID = 0

    For Each Member In Members

        If StrComp( _
            Trim$(Member.Status), _
            "Aktif", _
            vbTextCompare) = 0 Then

            TestMemberID = Member.MemberID
            OriginalStatus = Member.Status

            Set TestMember = Member

            Exit For

        End If

    Next Member

    '----------------------------------------------------------------------
    ' Aktif üye bulunamadý
    '----------------------------------------------------------------------

    If TestMemberID <= 0 Then

        MsgBox "TEST-013 UYGULANAMADI." & vbCrLf & vbCrLf & _
               "Test için Aktif durumda üye bulunamadý.", _
               vbExclamation, "OAA - TEST-013"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' Üyeyi geçici olarak ÝZÝNLÝ yap
    '----------------------------------------------------------------------

    TestMember.Status = "Ýzinli"

    If Not MemberRepository.Update(TestMember) Then

        MsgBox "TEST-013 BAÞARISIZ." & vbCrLf & vbCrLf & _
               "Üye geçici olarak Ýzinli durumuna getirilemedi." & vbCrLf & _
               "Üye No: " & TestMemberID, _
               vbCritical, "OAA - TEST-013"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' TOPLANTI AÝDATI OLUÞTURMAYA ÇALIÞ
    '
    ' Beklenen:
    '   Service hata üretmeli.
    '   Kayýt oluþturulmamalý.
    '----------------------------------------------------------------------

    On Error Resume Next

    TestChargeID = Service.AddMeetingCharge( _
                        TestMemberID, _
                        2027, _
                        2, _
                        DateSerial(2027, 2, 1), _
                        300@, _
                        "TEST-013", _
                        DateSerial(2027, 1, 15), _
                        "TEST-013 - Ýzinli üye toplantý aidatý")

    ErrorNumber = Err.Number
    ErrorDescription = Err.Description

    If ErrorNumber <> 0 Then
        ErrorCaught = True
    Else
        ErrorCaught = False
    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '----------------------------------------------------------------------
    ' HATA OLUÞMASI ZORUNLU
    '----------------------------------------------------------------------

    If Not ErrorCaught Then

        ' Beklenmedik þekilde kayýt oluþturulduysa temizle.
        If TestChargeID > 0 Then
            DeleteTestCharge TestChargeID
            TestChargeID = 0
        End If

        GoTo TestFailed

    End If

    '----------------------------------------------------------------------
    ' Kayýt oluþmamýþ olmalý
    '----------------------------------------------------------------------

    If TestChargeID > 0 Then

        DeleteTestCharge TestChargeID
        TestChargeID = 0

        GoTo TestFailed

    End If

    '----------------------------------------------------------------------
    ' Repository üzerinden tekrar kontrol
    '
    ' Ayný üye + 2027 + Þubat + TOPLANTI
    ' için NORMAL aktif kayýt bulunmamalý.
    '----------------------------------------------------------------------

    If Repository.ExistsNormalCharge( _
        TestMemberID, _
        2027, _
        2, _
        "TOPLANTI") Then

        GoTo TestFailed

    End If

    '----------------------------------------------------------------------
    ' Üyenin eski durumunu geri yükle
    '----------------------------------------------------------------------

    TestMember.Status = OriginalStatus

    If Not MemberRepository.Update(TestMember) Then

        MsgBox "TEST-013 UYARI." & vbCrLf & vbCrLf & _
               "Toplantý aidatý doðru þekilde engellendi." & vbCrLf & _
               "Ancak üyenin eski durumu geri yüklenemedi." & vbCrLf & _
               "Üye No: " & TestMemberID, _
               vbExclamation, "OAA - TEST-013"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' BAÞARILI
    '----------------------------------------------------------------------

    MsgBox "TEST-013 BAÞARILI." & vbCrLf & vbCrLf & _
           "Test üyesi             : " & TestMemberID & vbCrLf & _
           "Geçici durum           : Ýzinli" & vbCrLf & _
           "Toplantý aidatý        : ENGELLENDÝ" & vbCrLf & _
           "Beklenen hata          : ALINDI" & vbCrLf & _
           "Kayýt oluþmasý         : YOK" & vbCrLf & _
           "Repository kontrolü    : OK" & vbCrLf & _
           "Üye durumu geri alýndý : OK" & vbCrLf & vbCrLf & _
           "Hata No: " & ErrorNumber, _
           vbInformation, "OAA - TEST-013"

    Set Charge = Nothing
    Set TestMember = Nothing
    Set Members = Nothing
    Set MemberRepository = Nothing
    Set Repository = Nothing
    Set Service = Nothing

    Exit Sub



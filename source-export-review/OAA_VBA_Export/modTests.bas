                  vbCrLf & _
                  "Alinan   : " & ErrorCount

    End If

    '==========================================================================
    ' 12 - BASARILI
    '==========================================================================

    Mesaj = "TEST-111 BASARILI." & vbCrLf & vbCrLf

    Mesaj = Mesaj & _
        "Test edilen API : AddBulkOfficialCharges" & vbCrLf

    Mesaj = Mesaj & _
        "FiscalYear      : " & TestFiscalYear & vbCrLf

    Mesaj = Mesaj & _
        "DueMonth        : " & TestDueMonth & vbCrLf

    Mesaj = Mesaj & _
        "ChargeDate      : " & _
        Format$(TestChargeDate, "dd.mm.yyyy") & vbCrLf

    Mesaj = Mesaj & _
        "Amount          : " & _
        TestAmount & " TL" & vbCrLf

    Mesaj = Mesaj & _
        "PeriodEndDate   : GECERSIZ / 0" & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & _
        "Service sonucu  : REDDEDILDI" & vbCrLf

    Mesaj = Mesaj & _
        "Service kodu    : 7355" & vbCrLf

    Mesaj = Mesaj & _
        "Err.Number      : " & ErrorNumber & vbCrLf

    Mesaj = Mesaj & _
        "ChargeID        : 0" & vbCrLf

    Mesaj = Mesaj & _
        "CreatedCount    : " & CreatedCount & vbCrLf

    Mesaj = Mesaj & _
        "SkippedCount    : " & SkippedCount & vbCrLf

    Mesaj = Mesaj & _
        "ErrorCount      : " & ErrorCount & vbCrLf

    Mesaj = Mesaj & _
        "Yeni kayit      : YOK" & vbCrLf

    Mesaj = Mesaj & _
        "Cleanup         : GEREKMEDI" & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & _
        "Sonuc: BASARILI"

    MsgBox Mesaj, vbInformation, "OAA - TEST-111"

    Exit Sub

'==============================================================================

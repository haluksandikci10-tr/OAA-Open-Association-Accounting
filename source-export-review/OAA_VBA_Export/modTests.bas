'==============================================================================
' TEST-135
' Gider guncelleme ve Isletme Defteri tutarliligi
'
' Kontroller:
'   1. Gider ve defter hareketinin olusturulmasi
'   2. Giderin guncellenmesi
'   3. Gider alanlarinin dogrulanmasi
'   4. Defter hareketinin dogrulanmasi
'   5. ExpenseID ve LedgerID kimliklerinin korunmasi
'   6. Test kayitlarinin temizlenmesi
'==============================================================================

Public Sub TEST_135_ExpenseUpdateConsistency()

    Dim ExpenseService As clsExpenseService
    Dim LedgerService As clsLedgerService

    Dim Expense As clsExpense
    Dim LoadedExpense As clsExpense

    Dim Entry As clsLedgerEntry
    Dim LoadedEntry As clsLedgerEntry

    Dim Entries As Collection

    Dim TestExpenseID As Long
    Dim TestLedgerID As Long

    Dim OriginalAmount As Currency
    Dim UpdatedAmount As Currency

    Dim OriginalDescription As String
    Dim UpdatedDescription As String

    Dim FoundLedgerEntry As Boolean
    Dim I As Long

    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    On Error GoTo TestError

    '--------------------------------------------------------------------------
    ' TEST DEGERLERI
    '--------------------------------------------------------------------------

    OriginalAmount = CCur(10)
    UpdatedAmount = CCur(15)

    OriginalDescription = "TEST-135 - Ilk gider"
    UpdatedDescription = "TEST-135 - Guncellenmis gider"

    '--------------------------------------------------------------------------
    ' SERVICE NESNELERI
    '--------------------------------------------------------------------------

    Set ExpenseService = New clsExpenseService
    Set LedgerService = New clsLedgerService

    '--------------------------------------------------------------------------
    ' TEST GIDERI
    '--------------------------------------------------------------------------

    Set Expense = New clsExpense

    Expense.ExpenseID = 0
    Expense.EntryDate = Date
    Expense.DocumentNo = "TEST-135"
    Expense.ExpenseType = "TEST-135"
    Expense.Description = OriginalDescription
    Expense.ExpenseAmount = OriginalAmount
    Expense.CashAmount = OriginalAmount
    Expense.BankAmount = CCur(0)

    '--------------------------------------------------------------------------
    ' GIDER VE DEFTER HAREKETINI OLUSTUR
    '--------------------------------------------------------------------------

    If Not ExpenseService.AddExpenseWithLedger(Expense) Then

        Err.Raise _
            vbObjectError + 13501, _
            "TEST-135", _
            "AddExpenseWithLedger basarisiz."

    End If

    TestExpenseID = Expense.ExpenseID

    If TestExpenseID <= 0 Then

        Err.Raise _
            vbObjectError + 13502, _
            "TEST-135", _
            "Gecerli ExpenseID olusturulamadi."

    End If

    '--------------------------------------------------------------------------
    ' ILISKILI LEDGER HAREKETINI BUL
    '--------------------------------------------------------------------------

    Set Entries = LedgerService.GetAllEntries

    If Entries Is Nothing Then

        Err.Raise _
            vbObjectError + 13503, _
            "TEST-135", _
            "Ledger hareketleri okunamadi."

    End If

    FoundLedgerEntry = False
    TestLedgerID = 0

    For I = 1 To Entries.Count

        Set Entry = Entries(I)

        If Not Entry Is Nothing Then

            If Entry.ExpenseID = TestExpenseID Then

                TestLedgerID = Entry.LedgerID
                FoundLedgerEntry = True

                Exit For

            End If

        End If

    Next I

    If Not FoundLedgerEntry Or TestLedgerID <= 0 Then

        Err.Raise _
            vbObjectError + 13504, _
            "TEST-135", _
            "Gidere bagli defter hareketi bulunamadi."

    End If

    '--------------------------------------------------------------------------
    ' GIDERI GUNCELLE
    '--------------------------------------------------------------------------

    Expense.ExpenseAmount = UpdatedAmount
    Expense.CashAmount = UpdatedAmount
    Expense.BankAmount = CCur(0)
    Expense.Description = UpdatedDescription

    If Not ExpenseService.UpdateExpense(Expense) Then

        Err.Raise _
            vbObjectError + 13505, _
            "TEST-135", _
            "UpdateExpense basarisiz."

    End If

    '--------------------------------------------------------------------------
    ' GIDER KAYDINI YENIDEN OKU
    '--------------------------------------------------------------------------

    Set LoadedExpense = ExpenseService.GetExpense(TestExpenseID)

    If LoadedExpense Is Nothing Then

        Err.Raise _
            vbObjectError + 13506, _
            "TEST-135", _
            "Guncellenen gider okunamadi."

    End If

    If LoadedExpense.ExpenseID <> TestExpenseID Then

        Err.Raise _
            vbObjectError + 13507, _
            "TEST-135", _
            "ExpenseID degisti."

    End If

    If LoadedExpense.ExpenseAmount <> UpdatedAmount Then

        Err.Raise _
            vbObjectError + 13508, _
            "TEST-135", _
            "Gider tutari dogru guncellenmedi."

    End If

    If LoadedExpense.CashAmount <> UpdatedAmount Then

        Err.Raise _
            vbObjectError + 13509, _
            "TEST-135", _
            "Kasa tutari dogru guncellenmedi."

    End If

    If LoadedExpense.Description <> UpdatedDescription Then

        Err.Raise _
            vbObjectError + 13510, _
            "TEST-135", _
            "Gider aciklamasi dogru guncellenmedi."

    End If

    '--------------------------------------------------------------------------
    ' DEFTER HAREKETINI AYNI LEDGER ID ILE OKU
    '--------------------------------------------------------------------------

    Set LoadedEntry = LedgerService.GetEntry(TestLedgerID)

    If LoadedEntry Is Nothing Then

        Err.Raise _
            vbObjectError + 13511, _
            "TEST-135", _
            "Guncellenen defter hareketi okunamadi."

    End If

    If LoadedEntry.LedgerID <> TestLedgerID Then

        Err.Raise _
            vbObjectError + 13512, _
            "TEST-135", _
            "LedgerID degisti."

    End If

    If LoadedEntry.ExpenseID <> TestExpenseID Then

        Err.Raise _
            vbObjectError + 13513, _
            "TEST-135", _
            "Defter hareketinin ExpenseID degeri degisti."

    End If

    If LoadedEntry.ExpenseAmount <> UpdatedAmount Then

        Err.Raise _
            vbObjectError + 13514, _
            "TEST-135", _
            "Defter gider tutari dogru guncellenmedi."

    End If

    If LoadedEntry.CashAmount <> UpdatedAmount Then

        Err.Raise _
            vbObjectError + 13515, _
            "TEST-135", _
            "Defter kasa tutari dogru guncellenmedi."

    End If

    If LoadedEntry.Description <> UpdatedDescription Then

        Err.Raise _
            vbObjectError + 13516, _
            "TEST-135", _
            "Defter aciklamasi dogru guncellenmedi."

    End If

    '--------------------------------------------------------------------------
    ' BASARILI
    '--------------------------------------------------------------------------

    Debug.Print String(70, "=")
    Debug.Print "TEST-135 BASARILI"
    Debug.Print "Gider guncelleme       : BASARILI"
    Debug.Print "Defter hareketi        : BASARILI"
    Debug.Print "ExpenseID korunmasi    : BASARILI"
    Debug.Print "LedgerID korunmasi     : BASARILI"
    Debug.Print String(70, "=")

    ' Test kaydini sil.
    If Not ExpenseService.DeleteExpense(TestExpenseID) Then

        Err.Raise _
            vbObjectError + 13517, _
            "TEST-135", _
            "Test gideri temizlenemedi."

    End If

    TestExpenseID = 0

    MsgBox _
        "TEST-135 BASARILI" & vbCrLf & vbCrLf & _
        "Gider guncelleme: BASARILI" & vbCrLf & _
        "Defter hareketi: BASARILI" & vbCrLf & _
        "ExpenseID korunmasi: BASARILI" & vbCrLf & _
        "LedgerID korunmasi: BASARILI" & vbCrLf & _
        "Test kayitlarinin temizlenmesi: BASARILI", _
        vbInformation, _
        "OAA - TEST-135"

    Set LoadedEntry = Nothing
    Set Entry = Nothing
    Set Entries = Nothing
    Set LoadedExpense = Nothing
    Set Expense = Nothing
    Set LedgerService = Nothing
    Set ExpenseService = Nothing

    Exit Sub

TestError:

    ErrorNumber = Err.Number
    ErrorDescription = Err.Description

    '--------------------------------------------------------------------------
    ' HATA DURUMUNDA TEST KAYDINI TEMIZLEMEYI DENE
    '--------------------------------------------------------------------------

    On Error Resume Next

    If TestExpenseID > 0 Then

        Call ExpenseService.DeleteExpense(TestExpenseID)

    End If

    On Error GoTo 0

    Debug.Print String(70, "=")
    Debug.Print "TEST-135 BASARISIZ"
    Debug.Print "Hata No : " & ErrorNumber
    Debug.Print "Aciklama: " & ErrorDescription
    Debug.Print String(70, "=")

    MsgBox _
        "TEST-135 BASARISIZ" & vbCrLf & vbCrLf & _
        "Hata No: " & ErrorNumber & vbCrLf & _
        "Aciklama: " & ErrorDescription & vbCrLf & vbCrLf & _
        "Test kaydinin temizlenmesi denendi.", _
        vbCritical, _
        "OAA - TEST-135"

    Set LoadedEntry = Nothing
    Set Entry = Nothing
    Set Entries = Nothing
    Set LoadedExpense = Nothing
    Set Expense = Nothing
    Set LedgerService = Nothing
    Set ExpenseService = Nothing

End Sub


'==============================================================================
' TEST-116
' Receipt Repository CRUD Test
'
' Amaç:
'   clsReceiptRepository:
'       Add
'       GetByID
'       GetByMemberID
'       DeleteByID
'
'   metodlarýný doðrulamak.
'
' Test gerçek kullanýcý verilerini deðiþtirmez.
' Oluþturduðu test kaydýný test sonunda temizler.
'==============================================================================

Public Sub TEST_116_ReceiptRepositoryCRUD()

    Dim Repo As clsReceiptRepository

    Dim Receipt As clsReceipt
    Dim LoadedReceipt As clsReceipt

    Dim MemberReceipts As Collection

    Dim TestReceiptID As Long
    Dim TestMemberID As Long

    Dim FoundInMemberCollection As Boolean

    Dim I As Long

    On Error GoTo TestError


    '--------------------------------------------------------------------------
    ' TEST SABÝTLERÝ
    '--------------------------------------------------------------------------

    TestMemberID = 10


    Debug.Print String(70, "=")
    Debug.Print "TEST-116 - Receipt Repository CRUD"
    Debug.Print String(70, "=")


    '--------------------------------------------------------------------------
    ' REPOSITORY
    '--------------------------------------------------------------------------

    Set Repo = New clsReceiptRepository


    '--------------------------------------------------------------------------
    ' TEST ENTITY
    '--------------------------------------------------------------------------

    Set Receipt = New clsReceipt

    Receipt.Series = "A"

    Receipt.ReceiptNumber = 900001

    Receipt.ReceiptDate = Date

    Receipt.MemberID = TestMemberID

    Receipt.Amount = CCur(1250.5)

    Receipt.PaymentMethod = "Nakit"


    '--------------------------------------------------------------------------
    ' ADD
    '--------------------------------------------------------------------------

    TestReceiptID = Repo.Add(Receipt)

    If TestReceiptID <= 0 Then

        Err.Raise _
            vbObjectError + 11601, _
            "TEST-116", _
            "ReceiptRepository.Add yeni kayýt oluþturmadý."

    End If


    ' Entity üzerindeki ID kontrolü

    If Receipt.ReceiptID <> TestReceiptID Then

        Err.Raise _
            vbObjectError + 11602, _
            "TEST-116", _
            "Add sonrasý Entity ReceiptID güncellenmedi."

    End If


    '--------------------------------------------------------------------------
    ' GET BY ID
    '--------------------------------------------------------------------------

    Set LoadedReceipt = _
        Repo.GetByID(TestReceiptID)


    If LoadedReceipt Is Nothing Then

        Err.Raise _
            vbObjectError + 11603, _
            "TEST-116", _
            "GetByID oluþturulan Receipt kaydýný bulamadý."

    End If


    '--------------------------------------------------------------------------
    ' ALAN KONTROLLERÝ
    '--------------------------------------------------------------------------

    If LoadedReceipt.ReceiptID <> TestReceiptID Then

        Err.Raise _
            vbObjectError + 11604, _
            "TEST-116", _
            "GetByID ReceiptID deðeri hatalý."

    End If


    If LoadedReceipt.Series <> "A" Then

        Err.Raise _
            vbObjectError + 11605, _
            "TEST-116", _
            "GetByID Series deðeri hatalý."

    End If


    If LoadedReceipt.ReceiptNumber <> 900001 Then

        Err.Raise _
            vbObjectError + 11606, _
            "TEST-116", _
            "GetByID ReceiptNumber deðeri hatalý."

    End If


    If LoadedReceipt.ReceiptDate <> Date Then

        Err.Raise _
            vbObjectError + 11607, _
            "TEST-116", _
            "GetByID ReceiptDate deðeri hatalý."

    End If


    If LoadedReceipt.MemberID <> TestMemberID Then

        Err.Raise _
            vbObjectError + 11608, _
            "TEST-116", _
            "GetByID MemberID deðeri hatalý."

    End If


    If LoadedReceipt.Amount <> CCur(1250.5) Then

        Err.Raise _
            vbObjectError + 11609, _
            "TEST-116", _
            "GetByID Amount deðeri hatalý."

    End If


    If LoadedReceipt.PaymentMethod <> "Nakit" Then

        Err.Raise _
            vbObjectError + 11610, _
            "TEST-116", _
            "GetByID PaymentMethod deðeri hatalý."

    End If


    '--------------------------------------------------------------------------
    ' GET BY MEMBER ID
    '--------------------------------------------------------------------------

    Set MemberReceipts = _
        Repo.GetByMemberID(TestMemberID)


    If MemberReceipts Is Nothing Then

        Err.Raise _
            vbObjectError + 11611, _
            "TEST-116", _
            "GetByMemberID Collection döndürmedi."

    End If


    FoundInMemberCollection = False


    For I = 1 To MemberReceipts.Count

        If MemberReceipts(I).ReceiptID = TestReceiptID Then

            FoundInMemberCollection = True

            Exit For

        End If

    Next I


    If Not FoundInMemberCollection Then

        Err.Raise _
            vbObjectError + 11612, _
            "TEST-116", _
            "Oluþturulan Receipt GetByMemberID sonucunda bulunamadý."

    End If


    '--------------------------------------------------------------------------
    ' DELETE
    '--------------------------------------------------------------------------

    If Not Repo.DeleteByID(TestReceiptID) Then

        Err.Raise _
            vbObjectError + 11613, _
            "TEST-116", _
            "DeleteByID test kaydýný silemedi."

    End If


    '--------------------------------------------------------------------------
    ' DELETE SONRASI KONTROL
    '--------------------------------------------------------------------------

    Set LoadedReceipt = _
        Repo.GetByID(TestReceiptID)


    If Not LoadedReceipt Is Nothing Then

        Err.Raise _
            vbObjectError + 11614, _
            "TEST-116", _
            "DeleteByID sonrasýnda Receipt kaydý hâlâ bulunuyor."

    End If


    '--------------------------------------------------------------------------
    ' BAÞARILI
    '--------------------------------------------------------------------------

    Debug.Print "TEST-116 BAÞARILI"
    Debug.Print "TestReceiptID : " & TestReceiptID
    Debug.Print "TestMemberID  : " & TestMemberID
    Debug.Print "Amount        : " & CStr(1250.5)
    Debug.Print "Cleanup       : Baþarýlý"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-116 BAÞARILI" & vbCrLf & vbCrLf & _
        "Receipt Repository CRUD iþlemleri doðrulandý." & vbCrLf & _
        "Test kaydý baþarýyla temizlendi.", _
        vbInformation, _
        "OAA - TEST-116"


    Set LoadedReceipt = Nothing
    Set Receipt = Nothing
    Set Repo = Nothing

    Exit Sub


'==============================================================================
' TEST HATASI
'==============================================================================

TestError:

    '--------------------------------------------------------------------------
    ' OLUÞTURULMUÞ TEST KAYDINI TEMÝZLE
    '--------------------------------------------------------------------------

    On Error Resume Next

    If TestReceiptID > 0 Then

        Repo.DeleteByID TestReceiptID

    End If

    On Error GoTo 0


    Debug.Print "TEST-116 BAÞARISIZ"
    Debug.Print "Hata No : " & Err.Number
    Debug.Print "Açýklama: " & Err.Description
    Debug.Print "TestReceiptID : " & TestReceiptID
    Debug.Print "Cleanup uygulandý."
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-116 BAÞARISIZ" & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Test kaydý için cleanup uygulandý.", _
        vbCritical, _
        "OAA - TEST-116"


    Set LoadedReceipt = Nothing
    Set Receipt = Nothing
    Set Repo = Nothing

End Sub

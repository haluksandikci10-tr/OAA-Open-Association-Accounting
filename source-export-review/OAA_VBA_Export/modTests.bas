'==============================================================================
' TEST-123
' Receipt Service - Fazla Tahsilat Engelleme
'
' Amaç:
'   ChargeID = 1 için mevcut kalan borçtan daha yüksek tahsilatýn
'   Service tarafýndan reddedildiðini doðrulamak.
'
' Test:
'   Gerçek ChargeID = 1 kullanýlýr.
'   Kalan borç çalýþma anýnda hesaplanýr.
'   Kalan borç + 0,01 TL tahsilat denenir.
'
' Beklenen:
'   Tahsilat reddedilir.
'   Yeni Receipt oluþmaz.
'==============================================================================

Public Sub TEST_123_ReceiptServiceOverPayment()

    Dim Service As clsReceiptService
    Dim Receipt As clsReceipt
    Dim LoadedReceipt As clsReceipt

    Dim TestMemberID As Long
    Dim TestChargeID As Long

    Dim OutstandingAmount As Currency
    Dim TestAmount As Currency

    Dim TestReceiptID As Long

    Dim ErrorRaised As Boolean

    On Error GoTo UnexpectedError

    '--------------------------------------------------------------------------
    ' GERÇEK TEST KAYDI
    '--------------------------------------------------------------------------

    TestMemberID = 10
    TestChargeID = 1


    Debug.Print String(70, "=")
    Debug.Print "TEST-123 - Receipt Service Over Payment"
    Debug.Print String(70, "=")


    '--------------------------------------------------------------------------
    ' SERVICE
    '--------------------------------------------------------------------------

    Set Service = New clsReceiptService


    '--------------------------------------------------------------------------
    ' MEVCUT KALAN BORCU OKU
    '--------------------------------------------------------------------------

    OutstandingAmount = _
        Service.GetChargeOutstandingAmount(TestChargeID)


    Debug.Print "MemberID          : " & TestMemberID
    Debug.Print "ChargeID          : " & TestChargeID
    Debug.Print "Mevcut Kalan Borç: " & _
                Format$(OutstandingAmount, "#,##0.00")


    '--------------------------------------------------------------------------
    ' TEST EDÝLECEK BORÇ KONTROLÜ
    '
    ' Kalan borç yoksa fazla tahsilat testi anlamlý deðildir.
    ' Gerçek finans kaydýna dokunulmaz.
    '--------------------------------------------------------------------------

    If OutstandingAmount <= 0 Then

        Err.Raise _
            vbObjectError + 12301, _
            "TEST-123", _
            "ChargeID 1 için kalan borç bulunmadýðýndan " & _
            "fazla tahsilat testi yapýlamýyor."

    End If


    '--------------------------------------------------------------------------
    ' KALAN BORÇTAN 0,01 TL FAZLA
    '--------------------------------------------------------------------------

    TestAmount = _
        OutstandingAmount + CCur(0.01)


    '--------------------------------------------------------------------------
    ' TEST RECEIPT
    '--------------------------------------------------------------------------

    Set Receipt = New clsReceipt

    Receipt.Series = "A"
    Receipt.ReceiptNumber = 900013
    Receipt.ReceiptDate = Date
    Receipt.MemberID = TestMemberID
    Receipt.ChargeID = TestChargeID
    Receipt.Amount = TestAmount
    Receipt.PaymentMethod = "Nakit"


    '--------------------------------------------------------------------------
    ' FAZLA TAHSÝLAT DENEMESÝ
    '--------------------------------------------------------------------------

    ErrorRaised = False
    TestReceiptID = 0

    On Error Resume Next

    TestReceiptID = _
        Service.AddReceipt(Receipt)

    If Err.Number <> 0 Then

        ErrorRaised = True
        Err.Clear

    End If

    On Error GoTo UnexpectedError


    '--------------------------------------------------------------------------
    ' REDDEDÝLMÝÞ OLMALI
    '--------------------------------------------------------------------------

    If Not ErrorRaised Then

        ' Eðer kayýt oluþmuþsa güvenli þekilde temizle.
        If TestReceiptID > 0 Then

            Service.DeleteReceipt TestReceiptID

        End If

        Err.Raise _
            vbObjectError + 12302, _
            "TEST-123", _
            "Kalan borçtan yüksek tahsilat kabul edildi."

    End If


    '--------------------------------------------------------------------------
    ' OLUÞMUÞ TEST KAYDI VARSA TEMÝZLE
    '--------------------------------------------------------------------------

    If TestReceiptID > 0 Then

        Service.DeleteReceipt TestReceiptID

    End If


    '--------------------------------------------------------------------------
    ' RECEIPT ID KONTROLÜ
    '
    ' Reddedilen iþlemde Entity'nin ReceiptID'si kullanýlabilir durumda
    ' olmamalýdýr.
    '--------------------------------------------------------------------------

    If Receipt.ReceiptID > 0 Then

        Err.Raise _
            vbObjectError + 12303, _
            "TEST-123", _
            "Reddedilen fazla tahsilat için ReceiptID oluþturuldu."

    End If


    '--------------------------------------------------------------------------
    ' BAÞARILI
    '--------------------------------------------------------------------------

    Debug.Print "Test Tutarý       : " & _
                Format$(TestAmount, "#,##0.00")

    Debug.Print "Sonuç             : Reddedildi"
    Debug.Print "Yeni Receipt      : Oluþmadý"
    Debug.Print "Cleanup            : Gerekli kayýt yok"
    Debug.Print "TEST-123 BAÞARILI"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-123 BAÞARILI" & vbCrLf & vbCrLf & _
        "ChargeID       : " & TestChargeID & vbCrLf & _
        "Kalan borç     : " & _
            Format$(OutstandingAmount, "#,##0.00") & vbCrLf & _
        "Test tutarý    : " & _
            Format$(TestAmount, "#,##0.00") & vbCrLf & vbCrLf & _
        "Fazla tahsilat reddedildi." & vbCrLf & _
        "Yeni Receipt oluþturulmadý.", _
        vbInformation, _
        "OAA - TEST-123"


    Set LoadedReceipt = Nothing
    Set Receipt = Nothing
    Set Service = Nothing

    Exit Sub


'==============================================================================
' BEKLENMEYEN HATA
'==============================================================================

UnexpectedError:

    On Error Resume Next

    If TestReceiptID > 0 Then

        Service.DeleteReceipt TestReceiptID

    End If

    On Error GoTo 0


    Debug.Print "TEST-123 BAÞARISIZ"
    Debug.Print "Hata No : " & Err.Number
    Debug.Print "Açýklama: " & Err.Description
    Debug.Print "Cleanup : Uygulandý"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-123 BAÞARISIZ" & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Varsa test kaydý temizlendi.", _
        vbCritical, _
        "OAA - TEST-123"


    Set LoadedReceipt = Nothing
    Set Receipt = Nothing
    Set Service = Nothing

End Sub


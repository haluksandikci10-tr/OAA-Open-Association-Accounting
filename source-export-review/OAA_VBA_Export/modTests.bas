'==============================================================================
' TEST-035
'
' TOPLANTI AÝDATI - GEÇERLÝ SINIR AYI (12) KONTROLÜ
'
' AMAÇ:
'
'   DueMonth = 12 deðerinin geçerli olduðunu ve
'   AddMeetingCharge tarafýndan kabul edildiðini doðrulamak.
'
' SINIR KONTROLÜ:
'
'   TEST-034:
'       DueMonth = 13 -> RED
'
'   TEST-035:
'       DueMonth = 12 -> KABUL
'
' BEKLENEN:
'
'   1. Aktif üyeye toplantý aidatý oluþturulmalýdýr.
'   2. ChargeID > 0 olmalýdýr.
'   3. Kayýt Repository üzerinden okunabilmelidir.
'   4. ChargeType = TOPLANTI olmalýdýr.
'   5. AdjustmentType = NORMAL olmalýdýr.
'   6. Test kaydý cleanup ile silinmelidir.
'==============================================================================

Public Sub TEST_035()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember
    Dim Charge As clsMemberCharge

    Dim TestMemberID As Long
    Dim ChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim Amount As Currency

    Dim TestDecisionNo As String
    Dim TestDescription As String

    Dim ErrorDescription As String

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    '==========================================================================
    ' 2 - TEST PARAMETRELERÝ
    '==========================================================================

    FiscalYear = 2098

    ' GEÇERLÝ SINIR DEÐERÝ
    DueMonth = 12

    ChargeDate = DateSerial(2098, 12, 1)

    Amount = 250@

    TestDecisionNo = "TEST-035"

    TestDescription = _
        "TEST-035 - Geçerli sýnýr ayý 12"

    '==========================================================================
    ' 3 - AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 8501, _
                  "TEST_035", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 8502, _
                  "TEST_035", _
                  "Test için üye bulunamadý."

    End If

    TestMemberID = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID

                Exit For

            End If

        End If

    Next Member

    If TestMemberID <= 0 Then

        Err.Raise vbObjectError + 8503, _
                  "TEST_035", _
                  "Test için aktif üye bulunamadý."

    End If

    '==========================================================================
    ' 4 - TEST DÖNEMÝNDE MÜKERRER KAYIT OLMADIÐINI KONTROL ET
    '==========================================================================

    If Repo.ExistsNormalCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            "TOPLANTI") Then

        Err.Raise vbObjectError + 8504, _
                  "TEST_035", _
                  "TEST-035 dönemi için mevcut TOPLANTI kaydý bulundu."

    End If

    '==========================================================================
    ' 5 - TOPLANTI AÝDATI OLUÞTUR
    '==========================================================================

    ChargeID = 0
    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    ChargeID = _
        Service.AddMeetingCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            TestDecisionNo, _
            ChargeDate, _
            TestDescription)

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

    End If

    On Error GoTo ErrorHandler

    If Len(ErrorDescription) > 0 Then

        Err.Raise vbObjectError + 8505, _
                  "TEST_035", _
                  "Geçerli sýnýr ayý 12 reddedildi." & _
                  vbCrLf & vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 6 - CHARGEID KONTROLÜ
    '==========================================================================

    If ChargeID <= 0 Then

        Err.Raise vbObjectError + 8506, _
                  "TEST_035", _
                  "Geçerli DueMonth=12 için ChargeID oluþmadý."

    End If

    '==========================================================================
    ' 7 - REPOSITORY'DEN KAYDI OKU
    '==========================================================================

    Set Charge = Repo.GetByID(ChargeID)

    If Charge Is Nothing Then

        Err.Raise vbObjectError + 8507, _
                  "TEST_035", _
                  "Oluþturulan TOPLANTI kaydý Repository'den okunamadý."

    End If

    '==========================================================================
    ' 8 - ALAN KONTROLLERÝ
    '==========================================================================

    If Charge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 8508, _
                  "TEST_035", _
                  "MemberID deðeri hatalý."

    End If

    If Charge.FiscalYear <> FiscalYear Then

        Err.Raise vbObjectError + 8509, _
                  "TEST_035", _
                  "FiscalYear deðeri hatalý."

    End If

    If Charge.DueMonth <> 12 Then

        Err.Raise vbObjectError + 8510, _
                  "TEST_035", _
                  "DueMonth deðeri 12 olarak kaydedilmedi."

    End If

    If StrComp( _
            Trim$(Charge.ChargeType), _
            "TOPLANTI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 8511, _
                  "TEST_035", _
                  "ChargeType TOPLANTI deðil."

    End If

    If StrComp( _
            Trim$(Charge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 8512, _
                  "TEST_035", _
                  "AdjustmentType NORMAL deðil."

    End If

    If Charge.Amount <> Amount Then

        Err.Raise vbObjectError + 8513, _
                  "TEST_035", _
                  "Amount deðeri hatalý."

    End If

    If Charge.SourceChargeID <> 0 Then

        Err.Raise vbObjectError + 8514, _
                  "TEST_035", _
                  "SourceChargeID deðeri 0 olmalý."

    End If

    If StrComp( _
            Trim$(Charge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 8515, _
                  "TEST_035", _
                  "Charge Status AKTIF deðil."

    End If

    '==========================================================================
    ' 9 - CLEANUP
    '==========================================================================

    On Error Resume Next

    Err.Clear

    DeleteTestCharge ChargeID

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 8516, _
                  "TEST_035", _
                  "Test kaydý cleanup edilemedi." & _
                  vbCrLf & _
                  ErrorDescription

    End If

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 10 - CLEANUP SONRASI KONTROL
    '==========================================================================

    If Repo.GetByID(ChargeID) Is Nothing Then

        ' Beklenen durum.
        ' Kayýt silinmiþtir.

    Else

        Err.Raise vbObjectError + 8517, _
                  "TEST_035", _
                  "Cleanup sonrasýnda TEST-035 kaydý hâlâ mevcut."

    End If

    '==========================================================================
    ' 11 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-035 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "Mali yýl         : " & FiscalYear & vbCrLf & _
        "Aidat ayý        : 12 (GEÇERLÝ SINIR)" & vbCrLf & _
        "Tutar            : " & Amount & " TL" & vbCrLf & vbCrLf & _
        "Service           : OK" & vbCrLf & _
        "ChargeID          : " & ChargeID & vbCrLf & _
        "ChargeType        : TOPLANTI" & vbCrLf & _
        "AdjustmentType    : NORMAL" & vbCrLf & _
        "Repository        : OK" & vbCrLf & _
        "Cleanup            : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-035"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If ChargeID > 0 Then

        DeleteTestCharge ChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-035 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description, _
        vbCritical, _
        "OAA - TEST-035"

End Sub

'==============================================================================
' TEST-036
'
' TOPLANTI AÝDATI - OLMAYAN ÜYE ID REDDÝ
'
' AMAÇ:
'
'   Pozitif fakat sistemde bulunmayan MemberID ile toplantý aidatý
'   oluþturulmaya çalýþýldýðýnda Service'in iþlemi reddettiðini
'   doðrulamak.
'
' TEST-031:
'   MemberID = 0
'   -> Temel MemberID doðrulamasý
'
' TEST-036:
'   MemberID > 0 fakat Repository'de bulunmuyor
'   -> Üye bulunamadý kontrolü
'
' GERÇEK SERVICE KURALI:
'
'   Set Member = mMemberRepository.GetByID(MemberID)
'
'   If Member Is Nothing Then
'       -> vbObjectError + 7211
'       -> "Üye bulunamadý. Üye No: ..."
'
' BEKLENEN:
'
'   1. Service hata üretmelidir.
'   2. ChargeID = 0 olmalýdýr.
'   3. Yeni TOPLANTI kaydý oluþmamalýdýr.
'
' CLEANUP:
'
'   Service kayýt oluþturmadan reddettiði için cleanup gerekmez.
'==============================================================================

Public Sub TEST_036()

    Dim Service As clsMemberChargeService
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim TestMemberID As Long
    Dim NonExistingMemberID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim Amount As Currency

    Dim ChargeID As Long

    Dim ErrorOccurred As Boolean
    Dim ErrorDescription As String

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set MemberRepo = New clsMemberRepository

    '==========================================================================
    ' 2 - MEVCUT ÜYELERÝ AL
    '
    ' Gerçek bir MemberID'nin üzerine güvenli bir offset uygulanarak
    ' sistemde bulunmayan pozitif bir MemberID oluþturulur.
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 8601, _
                  "TEST_036", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 8602, _
                  "TEST_036", _
                  "Test için üye listesi boþ."

    End If

    '==========================================================================
    ' 3 - EN YÜKSEK MEVCUT MEMBERID'YÝ BUL
    '==========================================================================

    TestMemberID = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If Member.MemberID > TestMemberID Then

                TestMemberID = Member.MemberID

            End If

        End If

    Next Member

    If TestMemberID <= 0 Then

        Err.Raise vbObjectError + 8603, _
                  "TEST_036", _
                  "Geçerli MemberID bulunamadý."

    End If

    '--------------------------------------------------------------------------
    ' En yüksek mevcut ID'nin 1000 fazlasý kullanýlýyor.
    ' Pozitif fakat mevcut kayýtlardan farklý bir ID elde edilir.
    '--------------------------------------------------------------------------

    NonExistingMemberID = TestMemberID + 1000

    '==========================================================================
    ' 4 - ÜYENÝN GERÇEKTEN VAR OLMADIÐINI DOÐRULA
    '==========================================================================

    Set Member = MemberRepo.GetByID(NonExistingMemberID)

    If Not Member Is Nothing Then

        Err.Raise vbObjectError + 8604, _
                  "TEST_036", _
                  "Test için seçilen MemberID sistemde mevcut." & _
                  vbCrLf & _
                  "MemberID: " & NonExistingMemberID

    End If

    '==========================================================================
    ' 5 - GEÇERLÝ DÝÐER PARAMETRELER
    '
    ' Amaç doðrudan "üye bulunamadý" kuralýný test etmektir.
    '==========================================================================

    FiscalYear = 2098
    DueMonth = 11

    ChargeDate = DateSerial(2098, 11, 1)

    Amount = 250@

    ChargeID = 0

    ErrorOccurred = False
    ErrorDescription = vbNullString

    '==========================================================================
    ' 6 - OLMAYAN ÜYE ÝLE TOPLANTI AÝDATI DENEMESÝ
    '==========================================================================

    On Error Resume Next

    Err.Clear


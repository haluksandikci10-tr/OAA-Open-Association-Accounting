        GoTo TestFailed
    End If

    If Charge.AdjustmentType <> "NORMAL" Then
        GoTo TestFailed
    End If

    If Charge.SourceChargeID <> 0 Then
        GoTo TestFailed
    End If

    If Charge.DecisionNo <> "TEST-014A" Then
        GoTo TestFailed
    End If

    If Charge.Status <> "AKTIF" Then
        GoTo TestFailed
    End If

    '----------------------------------------------------------------------
    ' TEST KAYDINI SÝL
    '----------------------------------------------------------------------

    DeleteTestCharge TestChargeID
    TestChargeID = 0

    '----------------------------------------------------------------------
    ' ÜYENÝN ESKÝ DURUMUNU GERÝ YÜKLE
    '----------------------------------------------------------------------

    TestMember.Status = OriginalStatus
    TestMember.LeaveDate = OriginalLeaveDate

    If Not MemberRepository.Update(TestMember) Then

        MsgBox "TEST-014A UYARI." & vbCrLf & vbCrLf & _
               "Tahakkuk testi baþarýlý." & vbCrLf & _
               "Ancak üyenin eski bilgileri geri yüklenemedi." & vbCrLf & _
               "Üye No: " & TestMemberID, _
               vbExclamation, "OAA - TEST-014A"


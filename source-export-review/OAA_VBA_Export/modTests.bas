'==============================================================================
' TEST-099
'
' TOPLANTI AIDATI - MUKERRER NORMAL TAHAKKUK REDDI
'
' AMAC:
'
'   Ayni uye + mali yil + ay + TOPLANTI icin ikinci NORMAL tahakkukun
'   Service tarafindan reddedildigini dogrulamak.
'
' BEKLENEN:
'
'   Ilk AddMeetingCharge  -> basarili
'   Ikinci AddMeetingCharge -> 7213
'   Ikinci ChargeID        -> 0
'   Ilk test kaydi         -> cleanup
'
' GERCEK KURAL:
'
'   ExistsNormalCharge(MemberID, FiscalYear, DueMonth, "TOPLANTI")
'
'   True ise:
'
'       vbObjectError + 7213
'
'       "Bu üye için ayný döneme ait toplantý aidatý zaten tahakkuk edilmiþ."
'
' TEST VERISI:
'
'   Mevcut AKTIF bir uye kullanilir.
'   2098 yilinda NORMAL TOPLANTI tahakkuku olmayan ilk ay secilir.
'
' ONEMLI:
'
'   Gercek uye kaydi degistirilmez.
'   Yeni uye olusturulmaz.
'   Ilk tahakkuk test amacli olusturulur.
'   Test sonunda ilk ChargeID cleanup ile silinir.
'==============================================================================

Public Sub TEST_099()

    Dim Service As clsMemberChargeService
    Dim MemberRepo As clsMemberRepository
    Dim ChargeRepo As clsMemberChargeRepository

    Dim Members As Collection
    Dim ChargesBefore As Collection
    Dim ChargesAfter As Collection

    Dim Member As clsMember

    Dim TestMemberID As Long
    Dim TestFiscalYear As Long
    Dim TestDueMonth As Long

    Dim TestChargeDate As Date
    Dim TestAmount As Currency

    Dim FirstChargeID As Long
    Dim SecondChargeID As Long

    Dim ChargeCountBefore As Long
    Dim ChargeCountAfter As Long

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    Dim ExpectedErrorNumber As Long
    Dim ExpectedMessage As String

    Dim Mesaj As String
    Dim HataNo As Long
    Dim HataAciklama As String

    Dim MemberFound As Boolean
    Dim MonthFound As Boolean

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService

    Set MemberRepo = New clsMemberRepository

    Set ChargeRepo = New clsMemberChargeRepository

    '==========================================================================
    ' 2 - MEVCUT AKTIF UYEYI BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Mesaj = "TEST-099 UYGULANAMADI." & vbCrLf & vbCrLf
        Mesaj = Mesaj & "Uye listesi alinamadi." & vbCrLf
        Mesaj = Mesaj & "Gercek kullanici verileri degistirilmedi." & vbCrLf
        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-099"

        Exit Sub

    End If

    MemberFound = False

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID

                MemberFound = True

                Exit For

            End If

        End If

    Next Member

    '==========================================================================
    ' 3 - AKTIF UYE BULUNAMADI
    '==========================================================================

    If Not MemberFound Then

        Mesaj = "TEST-099 UYGULANAMADI." & vbCrLf & vbCrLf
        Mesaj = Mesaj & "Aktif durumda bir uye bulunamadi." & vbCrLf
        Mesaj = Mesaj & "Yeni uye olusturulmadi." & vbCrLf
        Mesaj = Mesaj & "Gercek kullanici verileri degistirilmedi." & vbCrLf
        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-099"

        Exit Sub

    End If

    '==========================================================================
    ' 4 - TEST MALI YILI
    '==========================================================================

    TestFiscalYear = 2098

    TestAmount = 150@

    '==========================================================================
    ' 5 - BOS TOPLANTI AYI BUL
    '
    ' Mevcut NORMAL TOPLANTI tahakkuku olmayan ilk ay secilir.
    '==========================================================================

    MonthFound = False

    For TestDueMonth = 1 To 12

        If Not ChargeRepo.ExistsNormalCharge( _
                TestMemberID, _
                TestFiscalYear, _
                TestDueMonth, _
                "TOPLANTI") Then

            MonthFound = True

            Exit For

        End If

    Next TestDueMonth

    '==========================================================================
    ' 6 - BOS AY BULUNAMADI
    '==========================================================================

    If Not MonthFound Then

        Mesaj = "TEST-099 UYGULANAMADI." & vbCrLf & vbCrLf
        Mesaj = Mesaj & "Test uyesi icin 2098 yilinda" & vbCrLf
        Mesaj = Mesaj & "NORMAL TOPLANTI tahakkuku olmayan ay bulunamadi." & vbCrLf
        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "Mevcut kayitlar degistirilmedi." & vbCrLf
        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-099"

        Exit Sub

    End If

    '==========================================================================
    ' 7 - TEST TARIHI
    '==========================================================================

    TestChargeDate = _
        DateSerial(TestFiscalYear, TestDueMonth, 15)

    '==========================================================================
    ' 8 - TEST ONCESI KAYIT SAYISI
    '==========================================================================

    Set ChargesBefore = _
        ChargeRepo.GetByMemberID(TestMemberID)

    If ChargesBefore Is Nothing Then

        ChargeCountBefore = 0

    Else

        ChargeCountBefore = ChargesBefore.Count

    End If

    '==========================================================================
    ' 9 - ILK TOPLANTI NORMAL TAHAKKUKU
    '
    ' Ilk kayit basarili olmalidir.
    '==========================================================================

    FirstChargeID = 0

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    FirstChargeID = Service.AddMeetingCharge( _
        TestMemberID, _
        TestFiscalYear, _
        TestDueMonth, _
        TestChargeDate, _
        TestAmount, _
        "TEST-099", _
        TestChargeDate, _
        "TEST-099 - Ilk NORMAL TOPLANTI test kaydi")

    If Err.Number <> 0 Then

        ErrorOccurred = True

        ErrorNumber = Err.Number

        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 10 - ILK KAYIT BASARILI OLMALI
    '==========================================================================

    If ErrorOccurred Then

        Err.Raise vbObjectError + 14901, _
                  "TEST_099", _
                  "Ilk NORMAL TOPLANTI tahakkuku olusturulamadi." & _
                  vbCrLf & _
                  "Err.Number = " & ErrorNumber & _
                  vbCrLf & _
                  "Mesaj = " & ErrorDescription

    End If

    If FirstChargeID <= 0 Then

        Err.Raise vbObjectError + 14902, _
                  "TEST_099", _
                  "Ilk NORMAL TOPLANTI tahakkuku icin " & _
                  "gecerli ChargeID olusmadi."

    End If

    '==========================================================================
    ' 11 - IKINCI AYNI DONEM TOPLANTI TAHAKKUKU
    '
    ' Ayni:
    '
    '   MemberID
    '   FiscalYear
    '   DueMonth
    '
    ' ile tekrar denenir.
    '
    ' BEKLENEN: 7213
    '==========================================================================

    SecondChargeID = 0

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString

    ExpectedErrorNumber = _
        vbObjectError + 7213

    ExpectedMessage = _
        "Bu üye için ayný döneme ait toplantý aidatý zaten tahakkuk edilmiþ."

    On Error Resume Next

    Err.Clear

    SecondChargeID = Service.AddMeetingCharge( _
        TestMemberID, _
        TestFiscalYear, _
        TestDueMonth, _
        TestChargeDate, _
        TestAmount, _
        "TEST-099-SECOND", _
        TestChargeDate, _
        "TEST-099 - Mukerrer NORMAL TOPLANTI test kaydi")

    If Err.Number <> 0 Then

        ErrorOccurred = True

        ErrorNumber = Err.Number

        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 12 - IKINCI ISLEM HATA VERMELI
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 14903, _
                  "TEST_099", _
                  "Ayni donem icin ikinci NORMAL TOPLANTI " & _
                  "tahakkuku reddedilmedi."

    End If

    '==========================================================================
    ' 13 - IKINCI CHARGEID OLUSMAMALI
    '==========================================================================

    If SecondChargeID <> 0 Then

        Err.Raise vbObjectError + 14904, _
                  "TEST_099", _
                  "Mükerrer TOPLANTI tahakkuku reddedilmesine " & _
                  "ragmen ikinci ChargeID olustu." & _
                  vbCrLf & _
                  "ChargeID = " & SecondChargeID

    End If

    '==========================================================================
    ' 14 - HATA NUMARASI KONTROLU
    '==========================================================================

    If ErrorNumber <> ExpectedErrorNumber Then

        Err.Raise vbObjectError + 14905, _
                  "TEST_099", _
                  "Beklenen hata kodu alinmadi." & _
                  vbCrLf & _
                  "Beklenen : " & ExpectedErrorNumber & _
                  vbCrLf & _
                  "Alinan   : " & ErrorNumber & _
                  vbCrLf & _
                  "Mesaj    : " & ErrorDescription

    End If

    '==========================================================================
    ' 15 - HATA MESAJI KONTROLU
    '==========================================================================

    If StrComp( _
            Trim$(ErrorDescription), _
            ExpectedMessage, _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 14906, _
                  "TEST_099", _
                  "7213 hata mesaji beklenen metinle eslesmiyor." & _
                  vbCrLf & _
                  "Beklenen : " & ExpectedMessage & _
                  vbCrLf & _
                  "Alinan   : " & ErrorDescription

    End If

    '==========================================================================
    ' 16 - ILK TEST KAYDINI CLEANUP ET
    '==========================================================================

    If FirstChargeID > 0 Then

        DeleteTestCharge FirstChargeID

    End If

    '==========================================================================
    ' 17 - CLEANUP SONRASI KAYIT SAYISI
    '==========================================================================

    Set ChargesAfter = _
        ChargeRepo.GetByMemberID(TestMemberID)

    If ChargesAfter Is Nothing Then

        ChargeCountAfter = 0

    Else

        ChargeCountAfter = ChargesAfter.Count

    End If

    If ChargeCountAfter <> ChargeCountBefore Then

        Err.Raise vbObjectError + 14907, _
                  "TEST_099", _
                  "Cleanup sonrasinda kayit sayisi eski haline donmedi." & _
                  vbCrLf & _
                  "Onceki : " & ChargeCountBefore & _
                  vbCrLf & _
                  "Sonraki: " & ChargeCountAfter

    End If

    '==========================================================================
    ' 18 - BASARILI
    '==========================================================================

    Mesaj = "TEST-099 BASARILI." & vbCrLf & vbCrLf

    Mesaj = Mesaj & "Test edilen API : AddMeetingCharge" & vbCrLf

    Mesaj = Mesaj & "MemberID        : " & TestMemberID & vbCrLf

    Mesaj = Mesaj & "FiscalYear      : " & TestFiscalYear & vbCrLf

    Mesaj = Mesaj & "DueMonth        : " & TestDueMonth & vbCrLf

    Mesaj = Mesaj & "ChargeDate      : " & _
                    Format$(TestChargeDate, "dd.mm.yyyy") & vbCrLf

    Mesaj = Mesaj & "Amount          : " & TestAmount & " TL" & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & "Ilk ChargeID    : " & FirstChargeID & vbCrLf

    Mesaj = Mesaj & "Ilk tahakkuk    : BASARILI" & vbCrLf

    Mesaj = Mesaj & "Ikinci tahakkuk : REDDEDILDI" & vbCrLf

    Mesaj = Mesaj & "Service kodu    : 7213" & vbCrLf

    Mesaj = Mesaj & "Err.Number      : " & ErrorNumber & vbCrLf

    Mesaj = Mesaj & "Ikinci ChargeID : 0" & vbCrLf

    Mesaj = Mesaj & "Cleanup         : TAMAM" & vbCrLf

    Mesaj = Mesaj & "Kayit sayisi    : " & _
                    ChargeCountBefore & " -> " & _
                    ChargeCountAfter & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & "Sonuc: BASARILI"

    MsgBox Mesaj, vbInformation, "OAA - TEST-099"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    HataNo = Err.Number

    HataAciklama = Err.Description

    On Error Resume Next

    If FirstChargeID > 0 Then

        DeleteTestCharge FirstChargeID

    End If

    On Error GoTo 0

    Mesaj = "TEST-099 BASARISIZ." & vbCrLf & vbCrLf

    Mesaj = Mesaj & "Hata No : " & HataNo & vbCrLf

    Mesaj = Mesaj & "Aciklama: " & HataAciklama & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & "MemberID      : " & TestMemberID & vbCrLf

    Mesaj = Mesaj & "FiscalYear    : " & TestFiscalYear & vbCrLf

    Mesaj = Mesaj & "DueMonth      : " & TestDueMonth & vbCrLf

    Mesaj = Mesaj & "FirstChargeID : " & FirstChargeID & vbCrLf

    Mesaj = Mesaj & "SecondChargeID: " & SecondChargeID & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & "Cleanup uygulanmaya calisildi."

    MsgBox Mesaj, vbCritical, "OAA - TEST-099"

End Sub



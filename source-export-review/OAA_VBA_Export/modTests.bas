'==============================================================================
' TEST-014B
' Ýstifa eden üye - dönem sonundan sonra resmi aidat ENGELLENMELÝ
'
' ÝÞ KURALI:
'
'   Üye istifa tarihinden dönem sonuna kadar resmi aidata borçlanabilir.
'
'   Ancak dönem sonundan sonra:
'
'       ÝSTÝFA / PASÝF ÜYE
'               v
'       RESMÝ AÝDAT
'               v
'             RED
'
' Test:
'   Ýstifa tarihi : 15.01.2027
'   Dönem sonu    : 31.12.2027
'   Tahakkuk      : 01.01.2028
'
' Beklenen:
'   Tahakkuk oluþturulmamalý.
'   Excel'e kayýt yazýlmamalý.
'==============================================================================

Public Sub Test_ResignedMemberOfficialChargeAfterPeriodEnd()

    Dim Service As clsMemberChargeService
    Dim Repository As clsMemberChargeRepository
    Dim MemberRepository As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember
    Dim TestMember As clsMember

    Dim TestMemberID As Long
    Dim TestChargeID As Long

    Dim OriginalStatus As String
    Dim OriginalLeaveDate As Date

    Dim TestLeaveDate As Date
    Dim TestChargeDate As Date
    Dim TestPeriodEndDate As Date

    Dim ErrorCaught As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    On Error GoTo ErrorHandler

    '----------------------------------------------------------------------
    ' TEST TARÝHLERÝ
    '----------------------------------------------------------------------

    TestLeaveDate = DateSerial(2027, 1, 15)
    TestPeriodEndDate = DateSerial(2027, 12, 31)

    ' Dönem sonrasýndaki ilk gün
    TestChargeDate = DateSerial(2028, 1, 1)

    '----------------------------------------------------------------------
    ' NESNELER
    '----------------------------------------------------------------------

    Set Service = New clsMemberChargeService
    Set Repository = New clsMemberChargeRepository
    Set MemberRepository = New clsMemberRepository

    '----------------------------------------------------------------------
    ' ÜYELERÝ GETÝR
    '----------------------------------------------------------------------

    Set Members = MemberRepository.GetAll

    If Members Is Nothing Then

        MsgBox "TEST-014B BAÞARISIZ." & vbCrLf & vbCrLf & _
               "Üye listesi alýnamadý.", _
               vbCritical, "OAA - TEST-014B"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' TEST ÝÇÝN AKTÝF ÜYE BUL
    '----------------------------------------------------------------------

    TestMemberID = 0

    For Each Member In Members

        If StrComp( _
            Trim$(Member.Status), _
            "Aktif", _
            vbTextCompare) = 0 Then

            TestMemberID = Member.MemberID

            OriginalStatus = Member.Status
            OriginalLeaveDate = Member.LeaveDate

            Set TestMember = Member

            Exit For

        End If

    Next Member

    '----------------------------------------------------------------------
    ' AKTÝF ÜYE YOK
    '----------------------------------------------------------------------

    If TestMemberID <= 0 Then

        MsgBox "TEST-014B UYGULANAMADI." & vbCrLf & vbCrLf & _
               "Test için Aktif durumda üye bulunamadý.", _
               vbExclamation, "OAA - TEST-014B"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' ÜYEYÝ GEÇÝCÝ OLARAK ÝSTÝFA YAP
    '----------------------------------------------------------------------

    TestMember.Status = "Ýstifa"
    TestMember.LeaveDate = TestLeaveDate

    If Not MemberRepository.Update(TestMember) Then

        MsgBox "TEST-014B BAÞARISIZ." & vbCrLf & vbCrLf & _
               "Üye geçici olarak Ýstifa durumuna getirilemedi." & vbCrLf & _
               "Üye No: " & TestMemberID, _
               vbCritical, "OAA - TEST-014B"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' DÖNEM SONRASINDA RESMÝ AÝDAT OLUÞTURMAYA ÇALIÞ
    '
    ' Beklenen:
    '   Service hata üretmeli.
    '   ChargeID oluþmamalý.
    '----------------------------------------------------------------------

    On Error Resume Next

    TestChargeID = Service.AddOfficialCharge( _
                        TestMemberID, _
                        2028, _
                        1, _
                        TestChargeDate, _
                        500@, _
                        TestPeriodEndDate, _
                        "TEST-014B", _
                        DateSerial(2027, 12, 20), _
                        "TEST-014B - Dönem sonrasý resmi aidat")

    ErrorNumber = Err.Number
    ErrorDescription = Err.Description

    If ErrorNumber <> 0 Then
        ErrorCaught = True
    Else
        ErrorCaught = False
    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '----------------------------------------------------------------------
    ' HATA OLUÞMASI ZORUNLU
    '----------------------------------------------------------------------

    If Not ErrorCaught Then

        If TestChargeID > 0 Then
            DeleteTestCharge TestChargeID
            TestChargeID = 0
        End If

        GoTo TestFailed

    End If

    '----------------------------------------------------------------------
    ' ChargeID OLUÞMAMALI
    '----------------------------------------------------------------------

    If TestChargeID > 0 Then

        DeleteTestCharge TestChargeID
        TestChargeID = 0

        GoTo TestFailed

    End If

    '----------------------------------------------------------------------
    ' REPOSITORY KONTROLÜ
    '
    ' 2028 Ocak RESMI NORMAL tahakkuk bulunmamalý.
    '----------------------------------------------------------------------

    If Repository.ExistsNormalCharge( _
        TestMemberID, _
        2028, _
        1, _
        "RESMI") Then

        GoTo TestFailed

    End If

    '----------------------------------------------------------------------
    ' ÜYENÝN ESKÝ BÝLGÝLERÝNÝ GERÝ YÜKLE
    '----------------------------------------------------------------------

    TestMember.Status = OriginalStatus
    TestMember.LeaveDate = OriginalLeaveDate

    If Not MemberRepository.Update(TestMember) Then

        MsgBox "TEST-014B UYARI." & vbCrLf & vbCrLf & _
               "Dönem sonrasý tahakkuk doðru þekilde engellendi." & vbCrLf & _
               "Ancak üyenin eski bilgileri geri yüklenemedi." & vbCrLf & _
               "Üye No: " & TestMemberID, _
               vbExclamation, "OAA - TEST-014B"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' BAÞARILI
    '----------------------------------------------------------------------

    MsgBox "TEST-014B BAÞARILI." & vbCrLf & vbCrLf & _
           "Test üyesi              : " & TestMemberID & vbCrLf & _
           "Ýstifa tarihi           : " & _
                Format$(TestLeaveDate, "dd.mm.yyyy") & vbCrLf & _
           "Dönem sonu              : " & _
                Format$(TestPeriodEndDate, "dd.mm.yyyy") & vbCrLf & _
           "Tahakkuk tarihi         : " & _
                Format$(TestChargeDate, "dd.mm.yyyy") & vbCrLf & vbCrLf & _
           "Dönem sonrasý tahakkuk  : ENGELLENDÝ" & vbCrLf & _
           "Beklenen hata           : ALINDI" & vbCrLf & _
           "Kayýt oluþmasý          : YOK" & vbCrLf & _
           "Repository kontrolü     : OK" & vbCrLf & _
           "Üye bilgileri geri alýndý : OK", _
           vbInformation, "OAA - TEST-014B"

    Set TestMember = Nothing
    Set Members = Nothing
    Set MemberRepository = Nothing
    Set Repository = Nothing
    Set Service = Nothing

    Exit Sub


'==============================================================================
' TEST BAÞARISIZ
'==============================================================================

TestFailed:

    On Error Resume Next

    If TestChargeID > 0 Then
        DeleteTestCharge TestChargeID
    End If

    If Not TestMember Is Nothing Then

        TestMember.Status = OriginalStatus
        TestMember.LeaveDate = OriginalLeaveDate

        MemberRepository.Update TestMember

    End If

    On Error GoTo 0

    MsgBox "TEST-014B BAÞARISIZ." & vbCrLf & vbCrLf & _
           "Ýstifa eden üyenin dönem sonrasý resmi aidatý " & _
           "engellenemedi." & vbCrLf & vbCrLf & _
           "Test kaydý temizlendi." & vbCrLf & _
           "Üye bilgileri geri yüklendi.", _
           vbCritical, "OAA - TEST-014B"

    Exit Sub


'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If TestChargeID > 0 Then
        DeleteTestCharge TestChargeID
    End If

    If Not TestMember Is Nothing Then

        TestMember.Status = OriginalStatus
        TestMember.LeaveDate = OriginalLeaveDate

        If Not MemberRepository Is Nothing Then
            MemberRepository.Update TestMember
        End If

    End If

    On Error GoTo 0

    MsgBox "TEST-014B sýrasýnda hata oluþtu." & vbCrLf & vbCrLf & _
           "Hata No : " & Err.Number & vbCrLf & _
           "Hata    : " & Err.Description & vbCrLf & vbCrLf & _
           "Varsa test kaydý temizlendi." & vbCrLf & _
           "Üyenin eski bilgileri geri yüklenmeye çalýþýldý.", _
           vbCritical, "OAA - TEST-014B"

End Sub

Public Sub TEST_015()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository

    Dim NormalCharge As clsMemberCharge
    Dim AdjustmentCharge As clsMemberCharge

    Dim TestMemberID As Long
    Dim SourceChargeID As Long
    Dim AdjustmentChargeID As Long

    Dim TotalAmount As Currency

    On Error GoTo ErrorHandler

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository

    '==============================================================
    ' TEST ÜYESÝ
    '==============================================================

    TestMemberID = 3

    '==============================================================
    ' 1 - NORMAL RESMÝ AÝDAT
    '==============================================================

    Set NormalCharge = New clsMemberCharge

    With NormalCharge

        .MemberID = TestMemberID
        .ChargeType = "RESMI"
        .ChargeDate = DateSerial(2027, 1, 1)
        .FiscalYear = 2027
        .DueMonth = 1
        .Amount = 500
        .AdjustmentType = "NORMAL"
        .SourceChargeID = 0
        .Description = "TEST-015 NORMAL AIDAT"
        .DecisionNo = "TEST-015"
        .DecisionDate = DateSerial(2027, 1, 1)
        .EntryDate = Now
        .Status = "AKTIF"

    End With

    SourceChargeID = Repo.Add(NormalCharge)

    If SourceChargeID <= 0 Then

        Err.Raise vbObjectError + 7301, _
                  "TEST_015", _
                  "NORMAL aidat oluþturulamadý."

    End If

    '==============================================================
    ' 2 - ORÝJÝNAL KAYDI GERÝ OKU
    '==============================================================

    Set NormalCharge = Repo.GetByID(SourceChargeID)

    If NormalCharge Is Nothing Then

        Err.Raise vbObjectError + 7302, _
                  "TEST_015", _
                  "NORMAL aidat geri okunamadý."

    End If

    If NormalCharge.Amount <> 500 Then

        Err.Raise vbObjectError + 7303, _
                  "TEST_015", _
                  "Orijinal aidat tutarý deðiþti."

    End If

    '==============================================================
    ' 3 - SONRADAN 200 TL ARTIÞ
    '==============================================================

    AdjustmentChargeID = _
        Service.AddOfficialChargeAdjustment( _
            SourceChargeID, _
            DateSerial(2027, 2, 1), _
            200, _
            "YK-2027-15", _
            DateSerial(2027, 2, 1), _
            "TEST-015 AIDAT ARTIÞI")

    If AdjustmentChargeID <= 0 Then

        Err.Raise vbObjectError + 7304, _
                  "TEST_015", _
                  "Aidat artýþ kaydý oluþturulamadý."

    End If

    '==============================================================
    ' 4 - ARTIÞ KAYDINI GERÝ OKU
    '==============================================================

    Set AdjustmentCharge = Repo.GetByID(AdjustmentChargeID)

    If AdjustmentCharge Is Nothing Then

        Err.Raise vbObjectError + 7305, _
                  "TEST_015", _
                  "Artýþ kaydý geri okunamadý."

    End If

    '==============================================================
    ' 5 - ARTIÞ KONTROLLERÝ
    '==============================================================

    If AdjustmentCharge.ChargeType <> "RESMI" Then

        Err.Raise vbObjectError + 7306, _
                  "TEST_015", _
                  "ChargeType RESMI deðil."

    End If

    If AdjustmentCharge.Amount <> 200 Then

        Err.Raise vbObjectError + 7307, _
                  "TEST_015", _
                  "Artýþ tutarý 200 TL deðil."

    End If

    If AdjustmentCharge.AdjustmentType <> "ARTIS" Then

        Err.Raise vbObjectError + 7308, _
                  "TEST_015", _
                  "AdjustmentType ARTIS deðil."

    End If

    If AdjustmentCharge.SourceChargeID <> SourceChargeID Then

        Err.Raise vbObjectError + 7309, _
                  "TEST_015", _
                  "SourceChargeID yanlýþ."

    End If

    '==============================================================
    ' 6 - ORÝJÝNAL KAYDIN DEÐÝÞMEDÝÐÝNÝ KONTROL ET
    '==============================================================

    Set NormalCharge = Repo.GetByID(SourceChargeID)

    If NormalCharge.Amount <> 500 Then

        Err.Raise vbObjectError + 7310, _
                  "TEST_015", _
                  "Orijinal tahakkuk deðiþtirilmiþ."

    End If

    '==============================================================
    ' 7 - TOPLAM
    '==============================================================

    TotalAmount = _
        NormalCharge.Amount + _
        AdjustmentCharge.Amount

    If TotalAmount <> 700 Then

        Err.Raise vbObjectError + 7311, _
                  "TEST_015", _
                  "Toplam tahakkuk 700 TL deðil."

    End If

    '==============================================================
    ' 8 - TEST KAYITLARINI SÝL
    '==============================================================

    DeleteTestCharge SourceChargeID
DeleteTestCharge AdjustmentChargeID

    MsgBox _
        "TEST-015 BAÞARILI." & vbCrLf & vbCrLf & _
        "Orijinal aidat       : 500 TL" & vbCrLf & _
        "Artýþ                 : 200 TL" & vbCrLf & _
        "Toplam                : 700 TL" & vbCrLf & _
        "AdjustmentType        : ARTIS" & vbCrLf & _
        "SourceChargeID        : OK" & vbCrLf & _
        "Orijinal kayýt        : DEÐÝÞMEDÝ" & vbCrLf & _
        "Test kayýtlarý        : SÝLÝNDÝ", _
        vbInformation, _
        "OAA - TEST-015"

    Exit Sub

ErrorHandler:

    On Error Resume Next

    If SourceChargeID > 0 Then _
        DeleteTestCharge SourceChargeID

    If AdjustmentChargeID > 0 Then _
        DeleteTestCharge AdjustmentChargeID

    MsgBox _
        "TEST-015 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No: " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description, _
        vbCritical, _
        "OAA - TEST-015"

End Sub


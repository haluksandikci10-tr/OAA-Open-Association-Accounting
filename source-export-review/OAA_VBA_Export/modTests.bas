    Set LedgerService = New clsLedgerService

    '==========================================================================
    ' BASLANGIC KAYIT SAYILARI VE BAKIYE
    '==========================================================================

    Set IncomeRecords = IncomeService.GetAllIncomes
    Set LedgerRecords = LedgerService.GetAllEntries

    If IncomeRecords Is Nothing Then

        Err.Raise _
            vbObjectError + 14301, _
            "TEST-143", _
            "Gelir kayitlari okunamadi."

    End If

    If LedgerRecords Is Nothing Then

        Err.Raise _
            vbObjectError + 14302, _
            "TEST-143", _
            "Defter kayitlari okunamadi."

    End If

    IncomeCountBefore = IncomeRecords.Count
    LedgerCountBefore = LedgerRecords.Count

    BalanceBefore = LedgerService.GetCurrentBalance

    '==========================================================================
    ' TEST GELIR KAYDI OLUSTUR
    '==========================================================================

    Set Income = New clsIncome

    With Income
        .IncomeID = 0
        .EntryDate = Date
        .DocumentNo = TestDocumentNo
        .IncomeType = "TEST-143"
        .Description = "TEST-143 Gelir silme testi"
        .IncomeAmount = TestAmount
        .CashAmount = TestCashAmount
        .BankAmount = TestBankAmount
    End With

    If Not IncomeService.AddIncomeWithLedger(Income) Then

        Err.Raise _
            vbObjectError + 14303, _
            "TEST-143", _

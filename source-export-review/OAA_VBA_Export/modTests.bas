           "RESMI aidat             : OK" & vbCrLf & _
           "Kayýt geri okuma        : OK" & vbCrLf & _
           "Test kaydý silindi      : OK" & vbCrLf & _
           "Üye bilgileri geri alýndý : OK", _
           vbInformation, "OAA - TEST-014A"


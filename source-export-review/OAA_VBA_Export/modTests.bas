'==============================================================================
' TEST-041
'
' RESMI AÝDAT ARTISI - RESMI OLMAYAN KAYNAK REDDÝ
'
' AMAÇ:
'
'   AddOfficialChargeAdjustment metodunun RESMI olmayan bir tahakkuku
'   ARTIS kaynaðý olarak kabul etmediðini doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   SourceCharge.ChargeType <> "RESMI"
'       -> vbObjectError + 7245
'       -> "Artýþ yalnýzca resmi aidat tahakkuklarýna uygulanabilir."
'
' TEST SENARYOSU:
'
'   Geçerli bir TOPLANTI/NORMAL tahakkuk oluþturulur.
'   Bu tahakkukun ChargeID'si ARTIS kaynaðý olarak kullanýlýr.
'
' BEKLENEN:
'
'   1. Service hata üretmelidir.
'   2. ARTIS ChargeID oluþmamalýdýr.
'   3. Kaynak TOPLANTI kaydý cleanup ile silinmelidir.
'
' GERÇEK KULLANICI VERÝSÝ:
'
'   Kullanýlmaz.
'   Geçici test kaydý iþlem sonunda silinir.
'==============================================================================

Public Sub TEST_041()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember
    Dim SourceCharge As clsMemberCharge

    Dim TestMemberID As Long

    Dim SourceChargeID As Long
    Dim AdjustmentChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim AdjustmentDate As Date

    Dim SourceAmount As Currency
    Dim AdjustmentAmount As Currency

    Dim ErrorOccurred As Boolean
    Dim ErrorDescription As String

    Dim PeriodFound As Boolean

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    SourceChargeID = 0
    AdjustmentChargeID = 0

    '==========================================================================
    ' 2 - TEST PARAMETRELERÝ
    '==========================================================================

    FiscalYear = 2098

    SourceAmount = 500@
    AdjustmentAmount = 100@

    AdjustmentDate = DateSerial(2098, 11, 1)

    '==========================================================================
    ' 3 - AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 9101, _
                  "TEST_041", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 9102, _
                  "TEST_041", _
                  "Test için üye bulunamadý."

    End If

    TestMemberID = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID

                Exit For

            End If

        End If

    Next Member

    If TestMemberID <= 0 Then

        Err.Raise vbObjectError + 9103, _
                  "TEST_041", _
                  "Test için aktif üye bulunamadý."

    End If

    '==========================================================================
    ' 4 - KULLANILMAMIÞ TOPLANTI DÖNEMÝ BUL
    '==========================================================================

    PeriodFound = False

    For DueMonth = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                DueMonth, _
                "TOPLANTI") Then

            PeriodFound = True
            Exit For

        End If

    Next DueMonth

    If Not PeriodFound Then

        Err.Raise vbObjectError + 9104, _
                  "TEST_041", _
                  "TEST için kullanýlmamýþ TOPLANTI dönemi bulunamadý."

    End If

    ChargeDate = DateSerial(FiscalYear, DueMonth, 1)

    '==========================================================================
    ' 5 - GEÇÝCÝ TOPLANTI/NORMAL KAYDI OLUÞTUR
    '
    ' Bu kayýt bilinçli olarak RESMI DEÐÝLDÝR.
    ' Amaç 7245 kuralýný test etmektir.
    '==========================================================================

    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    SourceChargeID = _
        Service.AddMeetingCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            SourceAmount, _
            "TEST-041", _
            ChargeDate, _
            "TEST-041 - Geçici TOPLANTI kaynak")

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    If Len(ErrorDescription) > 0 Then

        Err.Raise vbObjectError + 9105, _
                  "TEST_041", _
                  "Geçici TOPLANTI kaynak tahakkuku oluþturulamadý." & _
                  vbCrLf & ErrorDescription

    End If

    If SourceChargeID <= 0 Then

        Err.Raise vbObjectError + 9106, _
                  "TEST_041", _
                  "Geçici TOPLANTI kaynak tahakkuk için ChargeID oluþmadý."

    End If

    '==========================================================================
    ' 6 - KAYNAK KAYDI DOÐRULA
    '==========================================================================

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 9107, _
                  "TEST_041", _
                  "Geçici kaynak tahakkuk Repository'den okunamadý."

    End If

    If StrComp( _
            Trim$(SourceCharge.ChargeType), _
            "TOPLANTI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9108, _
                  "TEST_041", _
                  "Test kaynaðýnýn ChargeType deðeri TOPLANTI deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9109, _
                  "TEST_041", _
                  "Test kaynaðýnýn AdjustmentType deðeri NORMAL deðil."

    End If

    If StrComp( _
            Trim$(SourceCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 9110, _
                  "TEST_041", _
                  "Test kaynaðýnýn Status deðeri AKTIF deðil."

    End If

    '==========================================================================
    ' 7 - TOPLANTI KAYNAÐI ÝLE ARTIS DENEMESÝ
    '==========================================================================

    AdjustmentChargeID = 0
    ErrorOccurred = False
    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    AdjustmentChargeID = _
        Service.AddOfficialChargeAdjustment( _
            SourceChargeID, _
            AdjustmentDate, _
            AdjustmentAmount, _
            "TEST-041-ARTIS", _
            AdjustmentDate, _
            "TEST-041 - TOPLANTI kaynaðýyla ARTIS")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 8 - SERVICE REDDÝ KONTROLÜ
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 9111, _
                  "TEST_041", _
                  "TOPLANTI kaynaklý ARTIS Service tarafýndan reddedilmedi."

    End If

    '==========================================================================
    ' 9 - ARTIS KAYDI OLUÞMAMALI
    '==========================================================================

    If AdjustmentChargeID <> 0 Then

        Err.Raise vbObjectError + 9112, _
                  "TEST_041", _
                  "TOPLANTI kaynaklý ARTIS için ChargeID oluþtu: " & _
                  AdjustmentChargeID

    End If

    '==========================================================================
    ' 10 - GERÇEK SERVICE HATA MESAJI
    '==========================================================================

    If InStr( _
            1, _
            ErrorDescription, _
            "Artýþ yalnýzca resmi aidat tahakkuklarýna uygulanabilir.", _
            vbTextCompare) = 0 Then

        Err.Raise vbObjectError + 9113, _
                  "TEST_041", _
                  "Beklenen 7245 hata mesajý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan mesaj:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 11 - GEÇÝCÝ KAYNAK CLEANUP
    '==========================================================================

    On Error Resume Next

    Err.Clear

    DeleteTestCharge SourceChargeID

    If Err.Number <> 0 Then

        ErrorDescription = Err.Description

        On Error GoTo ErrorHandler

        Err.Raise vbObjectError + 9114, _
                  "TEST_041", _
                  "Geçici TOPLANTI kaynak cleanup edilemedi." & _
                  vbCrLf & ErrorDescription

    End If

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 12 - CLEANUP SONRASI KONTROL
    '==========================================================================

    If Not Repo.GetByID(SourceChargeID) Is Nothing Then

        Err.Raise vbObjectError + 9115, _
                  "TEST_041", _
                  "Cleanup sonrasýnda kaynak TOPLANTI tahakkuku hâlâ mevcut."

    End If

    '==========================================================================
    ' 13 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-041 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "Kaynak ChargeID  : " & SourceChargeID & vbCrLf & _
        "Kaynak tipi      : TOPLANTI / NORMAL" & vbCrLf & _
        "Artýþ tutarý     : " & AdjustmentAmount & " TL" & vbCrLf & vbCrLf & _
        "Kaynak kontrolü  : OK" & vbCrLf & _
        "Service reddi    : OK" & vbCrLf & _
        "ARTIS kaydý      : YOK" & vbCrLf & _
        "Cleanup          : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BEKLENEN RET", _
        vbInformation, _
        "OAA - TEST-041"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If AdjustmentChargeID > 0 Then

        DeleteTestCharge AdjustmentChargeID

    End If

    If SourceChargeID > 0 Then

        DeleteTestCharge SourceChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-041 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description, _
        vbCritical, _
        "OAA - TEST-041"

End Sub

'==============================================================================
' TEST-042
'

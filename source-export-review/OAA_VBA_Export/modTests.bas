    Err.Raise _
        vbObjectError + 14112, _
        "TEST-141", _
        "Defter hareketinin alanlari beklenen degerlerle eslesmiyor."


'==============================================================================
' TEST HATASI
'==============================================================================

TestError:

    ErrorNumber = Err.Number

    ErrorDescription = Err.Description


    '--------------------------------------------------------------------------
    ' HATA DURUMUNDA TEST KAYITLARINI TEMIZLE
    '--------------------------------------------------------------------------

    On Error Resume Next

    If TestIncomeID > 0 Then

        Call IncomeService.DeleteIncome(TestIncomeID)

    End If

    On Error GoTo 0


    Debug.Print String(70, "=")
    Debug.Print "TEST-141 BASARISIZ"
    Debug.Print "Hata numarasi : " & ErrorNumber
    Debug.Print "Hata aciklamasi: " & ErrorDescription
    Debug.Print "Temizlik      : Denendi"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-141 BASARISIZ" & vbCrLf & vbCrLf & _
        "Hata numarasi : " & ErrorNumber & vbCrLf & _
        "Hata aciklamasi: " & ErrorDescription & vbCrLf & vbCrLf & _
        "Test kayitlarinin temizlenmesi denendi.", _
        vbCritical, _
        "OAA - TEST-141"


'==============================================================================
' TEMIZ CIKIS
'==============================================================================

CleanExit:

    Set CurrentEntry = Nothing

    Set Entry = Nothing

    Set Entries = Nothing


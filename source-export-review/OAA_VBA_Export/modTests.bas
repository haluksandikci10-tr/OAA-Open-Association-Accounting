        "TEST-100 - Sifir tutar testi")

    If Err.Number <> 0 Then

        ErrorOccurred = True

        ErrorNumber = Err.Number

        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 5 - HATA OLMALI
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 15001, _
                  "TEST_100", _
                  "Amount = 0 icin AddOtherCharge islemi " & _
                  "reddedilmedi."

    End If

    '==========================================================================
    ' 6 - CHARGEID OLUSMAMALI
    '==========================================================================

    If TestChargeID <> 0 Then


'
' Amac:
'   Gelir kaydinin IncomeID ile isletme defterine baglandigini
'   ve finansal alanlarin tutarli oldugunu dogrulamak.
'
' Test verileri:
'   Gelir       : 0.01
'   Kasa        : 0.01
'   Banka       : 0.00
'
' Test sonunda olusturulan kayitlar temizlenir.
'==============================================================================

Public Sub TEST_141_IncomeLedgerRelationship()

    Dim IncomeService As clsIncomeService
    Dim LedgerService As clsLedgerService

    Dim Income As clsIncome
    Dim LoadedIncome As clsIncome

    Dim Entries As Collection
    Dim Entry As clsLedgerEntry
    Dim CurrentEntry As clsLedgerEntry

    Dim TestIncomeID As Long
    Dim TestDocumentNo As String
    Dim TestIncomeType As String
    Dim TestDescription As String

    Dim TestEntryDate As Date

    Dim TestAmount As Currency
    Dim TestCashAmount As Currency
    Dim TestBankAmount As Currency

    Dim BalanceBefore As Currency
    Dim BalanceAfter As Currency

    Dim MatchCount As Long
    Dim I As Long

    Dim CleanupSucceeded As Boolean

    Dim ErrorNumber As Long
    Dim ErrorDescription As String


    On Error GoTo TestError


    '==========================================================================
    ' TEST VERILERI
    '==========================================================================

    TestEntryDate = Date

    TestDocumentNo = _
        "TEST-141-" & Format$(Now, "yyyymmddhhnnss")

    TestIncomeType = "TEST-141"

    TestDescription = _
        "TEST-141 - Gelir ve defter iliski testi"

    TestAmount = CCur(0.01)

    TestCashAmount = CCur(0.01)

    TestBankAmount = CCur(0)


    '==========================================================================
    ' SERVICES
    '==========================================================================

    Set IncomeService = New clsIncomeService

    Set LedgerService = New clsLedgerService


    '==========================================================================
    ' BASLANGIC BAKIYESI
    '==========================================================================

    BalanceBefore = LedgerService.GetCurrentBalance


    '==========================================================================
    ' INCOME ENTITY
    '==========================================================================

    Set Income = New clsIncome

    Income.IncomeID = 0

    Income.EntryDate = TestEntryDate

    Income.DocumentNo = TestDocumentNo

    Income.IncomeType = TestIncomeType

    Income.Description = TestDescription

    Income.IncomeAmount = TestAmount

    Income.CashAmount = TestCashAmount

    Income.BankAmount = TestBankAmount


    '==========================================================================
    ' GELIR VE DEFTER KAYDI OLUSTURMA
    '==========================================================================

    If Not IncomeService.AddIncomeWithLedger(Income) Then

        Err.Raise _
            vbObjectError + 14101, _
            "TEST-141", _
            "Gelir ve defter kaydi olusturulamadi."

    End If


    TestIncomeID = Income.IncomeID


    If TestIncomeID <= 0 Then

        Err.Raise _
            vbObjectError + 14102, _
            "TEST-141", _
            "Gecerli IncomeID olusturulmadi."

    End If


    '==========================================================================
    ' GELIR KAYDI KONTROLU
    '==========================================================================

    Set LoadedIncome = _
        IncomeService.GetIncome(TestIncomeID)

    If LoadedIncome Is Nothing Then

        Err.Raise _
            vbObjectError + 14103, _
            "TEST-141", _
            "Olusturulan gelir kaydi okunamadi."

    End If


    If LoadedIncome.IncomeID <> TestIncomeID Then GoTo IncomeDataError

    If LoadedIncome.EntryDate <> TestEntryDate Then GoTo IncomeDataError

    If LoadedIncome.DocumentNo <> TestDocumentNo Then GoTo IncomeDataError

    If LoadedIncome.IncomeType <> TestIncomeType Then GoTo IncomeDataError

    If LoadedIncome.Description <> TestDescription Then GoTo IncomeDataError

    If LoadedIncome.IncomeAmount <> TestAmount Then GoTo IncomeDataError

    If LoadedIncome.CashAmount <> TestCashAmount Then GoTo IncomeDataError

    If LoadedIncome.BankAmount <> TestBankAmount Then GoTo IncomeDataError


    '==========================================================================
    ' DEFTER HAREKETI KONTROLU
    '==========================================================================

    Set Entries = LedgerService.GetAllEntries

    If Entries Is Nothing Then

        Err.Raise _
            vbObjectError + 14104, _
            "TEST-141", _
            "Isletme defteri kayitlari okunamadi."

    End If


    MatchCount = 0

    For I = 1 To Entries.Count

        Set CurrentEntry = Entries(I)

        If Not CurrentEntry Is Nothing Then

            If CurrentEntry.IncomeID = TestIncomeID Then

                MatchCount = MatchCount + 1

                Set Entry = CurrentEntry

            End If

        End If

    Next I


    If MatchCount <> 1 Then

        Err.Raise _
            vbObjectError + 14105, _
            "TEST-141", _
            "IncomeID ile tam olarak bir defter hareketi bulunamadi."

    End If


    '==========================================================================
    ' DEFTER ALANLARI KONTROLU
    '==========================================================================

    If Entry.IncomeID <> TestIncomeID Then GoTo LedgerDataError

    If Entry.EntryDate <> TestEntryDate Then GoTo LedgerDataError

    If Entry.DocumentNo <> TestDocumentNo Then GoTo LedgerDataError

    If Entry.Description <> TestDescription Then GoTo LedgerDataError

    If Entry.IncomeType <> TestIncomeType Then GoTo LedgerDataError

    If Entry.IncomeAmount <> TestAmount Then GoTo LedgerDataError

    If Entry.ExpenseAmount <> CCur(0) Then GoTo LedgerDataError

    If Entry.CashAmount <> TestCashAmount Then GoTo LedgerDataError

    If Entry.BankAmount <> TestBankAmount Then GoTo LedgerDataError

    If Entry.ExpenseID <> 0 Then GoTo LedgerDataError


    '==========================================================================
    ' BAKIYE KONTROLU
    '==========================================================================

    BalanceAfter = LedgerService.GetCurrentBalance

    If BalanceAfter <> BalanceBefore + TestAmount Then

        Err.Raise _
            vbObjectError + 14106, _
            "TEST-141", _
            "Gelir sonrasi isletme defteri bakiyesi hatali."

    End If


    '==========================================================================
    ' TEST KAYITLARINI TEMIZLE
    '==========================================================================

    If Not IncomeService.DeleteIncome(TestIncomeID) Then

        Err.Raise _
            vbObjectError + 14107, _
            "TEST-141", _
            "Test gelir kaydi ve defter hareketi silinemedi."

    End If


    TestIncomeID = 0

    CleanupSucceeded = True


    '==========================================================================
    ' TEMIZLIK KONTROLU
    '==========================================================================

    Set LoadedIncome = _
        IncomeService.GetIncome(Income.IncomeID)

    If Not LoadedIncome Is Nothing Then

        Err.Raise _
            vbObjectError + 14108, _
            "TEST-141", _
            "Test gelir kaydi temizlenemedi."

    End If


    Set Entries = LedgerService.GetAllEntries

    If Entries Is Nothing Then

        Err.Raise _
            vbObjectError + 14109, _
            "TEST-141", _
            "Temizlik sonrasi defter kayitlari okunamadi."

    End If


    For I = 1 To Entries.Count

        Set CurrentEntry = Entries(I)

        If Not CurrentEntry Is Nothing Then

            If CurrentEntry.IncomeID = Income.IncomeID Then

                Err.Raise _
                    vbObjectError + 14110, _
                    "TEST-141", _
                    "Test defter hareketi temizlenemedi."

            End If

        End If

    Next I


    '==========================================================================
    ' BASARILI
    '==========================================================================

    Debug.Print String(70, "=")
    Debug.Print "TEST-141 BASARILI"
    Debug.Print "Gelir kaydi olusturma       : BASARILI"
    Debug.Print "IncomeID kontrolu           : BASARILI"
    Debug.Print "Defter iliskisi              : BASARILI"
    Debug.Print "Tekil iliski kontrolu       : BASARILI"
    Debug.Print "Finansal alan kontrolu      : BASARILI"
    Debug.Print "Bakiye kontrolu             : BASARILI"
    Debug.Print "Test kayitlarinin temizligi : BASARILI"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-141 BASARILI" & vbCrLf & vbCrLf & _
        "Gelir kaydi olusturma       : BASARILI" & vbCrLf & _
        "IncomeID kontrolu           : BASARILI" & vbCrLf & _
        "Defter iliskisi              : BASARILI" & vbCrLf & _
        "Tekil iliski kontrolu       : BASARILI" & vbCrLf & _
        "Finansal alan kontrolu      : BASARILI" & vbCrLf & _
        "Bakiye kontrolu             : BASARILI" & vbCrLf & _
        "Test kayitlarinin temizligi : BASARILI", _
        vbInformation, _
        "OAA - TEST-141"


    GoTo CleanExit


'==============================================================================
' GELIR VERI HATASI
'==============================================================================

IncomeDataError:

    Err.Raise _
        vbObjectError + 14111, _
        "TEST-141", _
        "Gelir kaydinin alanlari beklenen degerlerle eslesmiyor."


'==============================================================================
' DEFTER VERI HATASI
'==============================================================================


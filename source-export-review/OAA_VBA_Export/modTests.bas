        Err.Raise vbObjectError + 11603, _
                  "TEST_066", _
                  "Test üyesi Repository'den tekrar okunamadý."

    End If

    '==========================================================================
    ' 5 - STATUS DOÐRULAMA
    '==========================================================================

    If StrComp( _
            Trim$(Member.Status), _
            "Ýstifa", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 11604, _
                  "TEST_066", _
                  "Test üyesinin Status deðeri Ýstifa deðil."

    End If

    '==========================================================================
    ' 6 - LEAVE DATE DOÐRULAMA
    '==========================================================================

    If Member.LeaveDate <= 0 Then

        Err.Raise vbObjectError + 11605, _
                  "TEST_066", _
                  "Test üyesinin LeaveDate deðeri geçersiz."

    End If

    LeaveDate = Member.LeaveDate

    '==========================================================================
    ' 7 - SINIR DEÐERÝ
    '
    ' KRÝTÝK:
    '
    ' ChargeDate = LeaveDate
    '
    ' olmalýdýr.
    '==========================================================================

    ChargeDate = LeaveDate

    Amount = 300@

    Description = _
        "TEST-066 - Ýstifa tarihi sýnýr testi"

    DecisionNo = _
        "TEST-066"

    DecisionDate = _
        ChargeDate

    '==========================================================================
    ' 8 - SERVICE ÇAÐRISI
    '
    ' Bu testte HATA BEKLENMÝYOR.
    '
    ' Çünkü ChargeDate > LeaveDate FALSE olacaktýr.
    '==========================================================================

    On Error Resume Next

    Err.Clear

    TestChargeID = _
        Service.AddOtherCharge( _
            TestMemberID, _
            ChargeDate, _
            Amount, _
            Description, _
            DecisionNo, _
            DecisionDate)

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorNumber = Err.Number
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 9 - HATA OLUÞMAMALI
    '==========================================================================

    If ErrorOccurred Then

        Err.Raise vbObjectError + 11606, _
                  "TEST_066", _
                  "ChargeDate = LeaveDate olmasýna raðmen Service borcu " & _
                  "reddetti." & _
                  vbCrLf & vbCrLf & _
                  "LeaveDate : " & _
                    Format$(LeaveDate, "dd.mm.yyyy") & _
                  vbCrLf & _
                  "ChargeDate: " & _
                    Format$(ChargeDate, "dd.mm.yyyy") & _
                  vbCrLf & vbCrLf & _
                  "Hata No  : " & ErrorNumber & _
                  vbCrLf & _
                  "Hata     : " & ErrorDescription

    End If

    '==========================================================================
    ' 10 - CHARGE ID OLUÞMUÞ OLMALI
    '==========================================================================

    If TestChargeID <= 0 Then

        Err.Raise vbObjectError + 11607, _
                  "TEST_066", _
                  "ChargeDate = LeaveDate için geçerli ChargeID " & _
                  "oluþturulmadý." & _
                  vbCrLf & _
                  "ChargeID = " & TestChargeID

    End If

    '==========================================================================
    ' 11 - KAYDI REPOSITORY'DEN OKU
    '==========================================================================

    Set TestCharge = Repo.GetByID(TestChargeID)

    If TestCharge Is Nothing Then

        Err.Raise vbObjectError + 11608, _
                  "TEST_066", _
                  "Oluþturulan SAIR hareket Repository'den okunamadý."

    End If

    '==========================================================================
    ' 12 - MEMBER ID
    '==========================================================================

    If TestCharge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 11609, _
                  "TEST_066", _
                  "Oluþturulan hareketin MemberID deðeri hatalý."

    End If

    '==========================================================================
    ' 13 - CHARGE TYPE
    '==========================================================================

    If StrComp( _
            Trim$(TestCharge.ChargeType), _
            "SAIR", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 11610, _
                  "TEST_066", _
                  "ChargeType SAIR deðil."

    End If

    '==========================================================================
    ' 14 - CHARGE DATE
    '==========================================================================

    If TestCharge.ChargeDate <> LeaveDate Then

        Err.Raise vbObjectError + 11611, _
                  "TEST_066", _
                  "ChargeDate LeaveDate ile eþleþmiyor." & _
                  vbCrLf & _
                  "Beklenen: " & _
                    Format$(LeaveDate, "dd.mm.yyyy") & _
                  vbCrLf & _
                  "Gerçek  : " & _
                    Format$(TestCharge.ChargeDate, "dd.mm.yyyy")

    End If

    '==========================================================================
    ' 15 - AMOUNT
    '==========================================================================

    If TestCharge.Amount <> Amount Then

        Err.Raise vbObjectError + 11612, _
                  "TEST_066", _
                  "Amount deðeri hatalý."

    End If

    '==========================================================================
    ' 16 - STATUS
    '==========================================================================

    If StrComp( _
            Trim$(TestCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 11613, _
                  "TEST_066", _
                  "Oluþturulan SAIR hareketin Status deðeri AKTIF deðil."

    End If

    '==========================================================================
    ' 17 - CLEANUP
    '==========================================================================

    DeleteTestCharge TestChargeID

    '==========================================================================
    ' 18 - CLEANUP KONTROLÜ
    '==========================================================================

    Set TestCharge = Repo.GetByID(TestChargeID)

    If Not TestCharge Is Nothing Then

        Err.Raise vbObjectError + 11614, _
                  "TEST_066", _
                  "TEST-066 kaydý cleanup sonrasýnda hâlâ mevcut."

    End If

    '==========================================================================
    ' 19 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-066 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi     : " & TestMemberID & vbCrLf & _
        "Status         : Ýstifa" & vbCrLf & _
        "LeaveDate      : " & _
            Format$(LeaveDate, "dd.mm.yyyy") & vbCrLf & _
        "ChargeDate     : " & _
            Format$(ChargeDate, "dd.mm.yyyy") & vbCrLf & _
        "Amount         : " & Amount & " TL" & vbCrLf & vbCrLf & _
        "ChargeDate = LeaveDate : EVET" & vbCrLf & _
        "Service reddi           : HAYIR" & vbCrLf & _
        "SAIR kayýt oluþumu      : EVET" & vbCrLf & _
        "ChargeType              : SAIR" & vbCrLf & _
        "Status                  : AKTIF" & vbCrLf & _
        "Cleanup                 : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-066"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    On Error Resume Next

    If TestChargeID > 0 Then

        DeleteTestCharge TestChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-066 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Service Hatasý:" & vbCrLf & _
        ErrorDescription & vbCrLf & vbCrLf & _
        "Cleanup uygulanmaya çalýþýldý.", _
        vbCritical, _
        "OAA - TEST-066"

End Sub


'==============================================================================
' TEST-067
'
' TOPLANTI AÝDATI - BAÞARILI OLUÞTURMA
'
' AMAÇ:
'
'   AddMeetingCharge metodunun geçerli bir AKTÝF üye için TOPLANTI
'   aidatý oluþturduðunu ve oluþturulan MemberCharge kaydýnýn
'   temel alanlarýnýn doðru olduðunu doðrulamak.
'
' DOÐRULANANLAR:
'
'   MemberID
'   ChargeType       = TOPLANTI
'   ChargeDate
'   FiscalYear
'   DueMonth
'   Amount
'   AdjustmentType   = NORMAL
'   SourceChargeID   = 0
'   Status           = AKTIF
'   ChargeID > 0
'
' TEST VERÝSÝ:
'
'   FiscalYear = 2098
'   Kullanýlmamýþ bir dönem ayý seçilir.
'
'   Gerçek kullanýcý üyesinin bilgileri deðiþtirilmez.
'
' CLEANUP:
'
'   Oluþturulan test ChargeID DeleteTestCharge ile silinir.
'==============================================================================

Public Sub TEST_067()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Charges As Collection

    Dim Member As clsMember
    Dim Charge As clsMemberCharge
    Dim TestCharge As clsMemberCharge

    Dim TestMemberID As Long
    Dim TestChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim Amount As Currency

    Dim Description As String
    Dim DecisionNo As String
    Dim DecisionDate As Date

    Dim FoundMember As Boolean
    Dim FoundMonth As Boolean

    Dim MonthNo As Long

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    TestMemberID = 0
    TestChargeID = 0

    FoundMember = False
    FoundMonth = False

    '==========================================================================
    ' 2 - AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 11701, _
                  "TEST_067", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 11702, _
                  "TEST_067", _
                  "Üye listesi boþ."

    End If

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID
                FoundMember = True

                Exit For

            End If

        End If

    Next Member

    If Not FoundMember Then

        Err.Raise vbObjectError + 11703, _
                  "TEST_067", _
                  "TEST-067 için AKTÝF üye bulunamadý."

    End If

    '==========================================================================
    ' 3 - TEST DÖNEMÝ
    '
    ' 2098 mali yýlýnda kullanýlmamýþ bir TOPLANTI dönemi bulunur.
    '
    ' Böylece mevcut kullanýcý verileriyle mükerrerlik çakýþmasý
    ' oluþturulmaz.
    '==========================================================================

    FiscalYear = 2098

    For MonthNo = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                MonthNo, _
                "TOPLANTI") Then

            DueMonth = MonthNo
            FoundMonth = True

            Exit For

        End If

    Next MonthNo

    If Not FoundMonth Then

        MsgBox _
            "TEST-067 UYGULANAMADI." & vbCrLf & vbCrLf & _
            "2098 mali yýlýnda test için kullanýlmamýþ " & _
            "TOPLANTI dönemi bulunamadý." & vbCrLf & vbCrLf & _
            "Gerçek kullanýcý verileri deðiþtirilmedi." & vbCrLf & vbCrLf & _
            "Sonuç: TEST ÖN KOÞULU YOK", _
            vbExclamation, _
            "OAA - TEST-067"

        Exit Sub

    End If

    '==========================================================================
    ' 4 - TEST PARAMETRELERÝ
    '==========================================================================

    ChargeDate = DateSerial(FiscalYear, DueMonth, 15)

    DecisionDate = ChargeDate

    Amount = 150@

    Description = _
        "TEST-067 - Baþarýlý TOPLANTI aidatý"

    DecisionNo = _
        "TEST-067"

    '==========================================================================
    ' 5 - TOPLANTI AÝDATI OLUÞTUR
    '==========================================================================

    TestChargeID = _
        Service.AddMeetingCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            DecisionNo, _
            DecisionDate, _
            Description)

    '==========================================================================
    ' 6 - CHARGE ID
    '==========================================================================

    If TestChargeID <= 0 Then

        Err.Raise vbObjectError + 11704, _
                  "TEST_067", _
                  "TOPLANTI aidatý oluþturuldu ancak geçerli ChargeID " & _
                  "dönmedi." & vbCrLf & _
                  "ChargeID = " & TestChargeID

    End If

    '==========================================================================
    ' 7 - REPOSITORY'DEN OKU
    '==========================================================================

    Set TestCharge = Repo.GetByID(TestChargeID)

    If TestCharge Is Nothing Then

        Err.Raise vbObjectError + 11705, _
                  "TEST_067", _
                  "Oluþturulan TOPLANTI kaydý Repository'den okunamadý."

    End If

    '==========================================================================
    ' 8 - MEMBER ID
    '==========================================================================

    If TestCharge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 11706, _
                  "TEST_067", _
                  "MemberID hatalý." & _
                  vbCrLf & _
                  "Beklenen: " & TestMemberID & _
                  vbCrLf & _
                  "Gerçek  : " & TestCharge.MemberID

    End If

    '==========================================================================
    ' 9 - CHARGE TYPE
    '==========================================================================

    If StrComp( _
            Trim$(TestCharge.ChargeType), _
            "TOPLANTI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 11707, _
                  "TEST_067", _
                  "ChargeType TOPLANTI deðil." & _
                  vbCrLf & _
                  "Gerçek: " & TestCharge.ChargeType

    End If

    '==========================================================================
    ' 10 - CHARGE DATE
    '==========================================================================

    If TestCharge.ChargeDate <> ChargeDate Then

        Err.Raise vbObjectError + 11708, _
                  "TEST_067", _
                  "ChargeDate hatalý." & _
                  vbCrLf & _
                  "Beklenen: " & _
                    Format$(ChargeDate, "dd.mm.yyyy") & _
                  vbCrLf & _
                  "Gerçek  : " & _
                    Format$(TestCharge.ChargeDate, "dd.mm.yyyy")

    End If

    '==========================================================================
    ' 11 - FISCAL YEAR
    '==========================================================================

    If TestCharge.FiscalYear <> FiscalYear Then

        Err.Raise vbObjectError + 11709, _
                  "TEST_067", _
                  "FiscalYear hatalý." & _
                  vbCrLf & _
                  "Beklenen: " & FiscalYear & _
                  vbCrLf & _
                  "Gerçek  : " & TestCharge.FiscalYear

    End If

    '==========================================================================
    ' 12 - DUE MONTH
    '==========================================================================

    If TestCharge.DueMonth <> DueMonth Then

        Err.Raise vbObjectError + 11710, _
                  "TEST_067", _
                  "DueMonth hatalý." & _
                  vbCrLf & _
                  "Beklenen: " & DueMonth & _
                  vbCrLf & _
                  "Gerçek  : " & TestCharge.DueMonth

    End If

    '==========================================================================
    ' 13 - AMOUNT
    '==========================================================================

    If TestCharge.Amount <> Amount Then

        Err.Raise vbObjectError + 11711, _
                  "TEST_067", _
                  "Amount hatalý." & _
                  vbCrLf & _
                  "Beklenen: " & Amount & _
                  vbCrLf & _
                  "Gerçek  : " & TestCharge.Amount

    End If

    '==========================================================================
    ' 14 - ADJUSTMENT TYPE
    '==========================================================================

    If StrComp( _
            Trim$(TestCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 11712, _
                  "TEST_067", _
                  "AdjustmentType NORMAL deðil." & _
                  vbCrLf & _
                  "Gerçek: " & TestCharge.AdjustmentType

    End If

    '==========================================================================
    ' 15 - SOURCE CHARGE ID
    '==========================================================================

    If TestCharge.SourceChargeID <> 0 Then

        Err.Raise vbObjectError + 11713, _
                  "TEST_067", _
                  "TOPLANTI NORMAL kaydýnda SourceChargeID 0 deðil." & _
                  vbCrLf & _
                  "Gerçek: " & TestCharge.SourceChargeID

    End If

    '==========================================================================
    ' 16 - DESCRIPTION
    '==========================================================================

    If StrComp( _
            Trim$(TestCharge.Description), _
            Description, _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 11714, _
                  "TEST_067", _
                  "Description hatalý." & _
                  vbCrLf & _
                  "Beklenen: " & Description & _
                  vbCrLf & _
                  "Gerçek  : " & TestCharge.Description

    End If

    '==========================================================================
    ' 17 - DECISION NO
    '==========================================================================

    If StrComp( _
            Trim$(TestCharge.DecisionNo), _
            DecisionNo, _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 11715, _
                  "TEST_067", _
                  "DecisionNo hatalý." & _
                  vbCrLf & _
                  "Beklenen: " & DecisionNo & _
                  vbCrLf & _
                  "Gerçek  : " & TestCharge.DecisionNo

    End If

    '==========================================================================
    ' 18 - DECISION DATE
    '==========================================================================

    If TestCharge.DecisionDate <> DecisionDate Then

        Err.Raise vbObjectError + 11716, _
                  "TEST_067", _
                  "DecisionDate hatalý." & _
                  vbCrLf & _
                  "Beklenen: " & _
                    Format$(DecisionDate, "dd.mm.yyyy") & _
                  vbCrLf & _
                  "Gerçek  : " & _
                    Format$(TestCharge.DecisionDate, "dd.mm.yyyy")

    End If

    '==========================================================================
    ' 19 - ENTRY DATE
    '==========================================================================

    If TestCharge.EntryDate <= 0 Then

        Err.Raise vbObjectError + 11717, _
                  "TEST_067", _
                  "EntryDate oluþturulmamýþ."

    End If

    '==========================================================================
    ' 20 - STATUS
    '==========================================================================

    If StrComp( _
            Trim$(TestCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 11718, _
                  "TEST_067", _
                  "Status AKTIF deðil." & _
                  vbCrLf & _
                  "Gerçek: " & TestCharge.Status

    End If

    '==========================================================================
    ' 21 - GETBYMEMBERID ÝÇÝNDE BULUNMALI
    '==========================================================================

    Set Charges = Repo.GetByMemberID(TestMemberID)

    If Charges Is Nothing Then

        Err.Raise vbObjectError + 11719, _
                  "TEST_067", _
                  "GetByMemberID Collection döndürmedi."

    End If

    Set TestCharge = Nothing

    For Each Charge In Charges

        If Not Charge Is Nothing Then

            If Charge.ChargeID = TestChargeID Then

                Set TestCharge = Charge

                Exit For

            End If

        End If

    Next Charge

    If TestCharge Is Nothing Then

        Err.Raise vbObjectError + 11720, _
                  "TEST_067", _
                  "Oluþturulan TOPLANTI hareketi GetByMemberID " & _
                  "içinde bulunamadý."

    End If

    '==========================================================================
    ' 22 - CLEANUP
    '==========================================================================

    DeleteTestCharge TestChargeID

    '==========================================================================
    ' 23 - CLEANUP KONTROLÜ
    '==========================================================================

    Set TestCharge = Repo.GetByID(TestChargeID)

    If Not TestCharge Is Nothing Then

        Err.Raise vbObjectError + 11721, _
                  "TEST_067", _
                  "TEST-067 kaydý cleanup sonrasýnda hâlâ mevcut."

    End If

    '==========================================================================
    ' 24 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-067 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi      : " & TestMemberID & vbCrLf & _
        "Mali yýl        : " & FiscalYear & vbCrLf & _
        "Dönem ayý       : " & DueMonth & vbCrLf & _
        "ChargeDate      : " & _
            Format$(ChargeDate, "dd.mm.yyyy") & vbCrLf & _
        "Amount          : " & Amount & " TL" & vbCrLf & vbCrLf & _
        "ChargeType      : TOPLANTI" & vbCrLf & _
        "AdjustmentType  : NORMAL" & vbCrLf & _
        "SourceChargeID  : 0" & vbCrLf & _
        "Status          : AKTIF" & vbCrLf & _
        "Repository Add  : OK" & vbCrLf & _
        "GetByID         : OK" & vbCrLf & _
        "GetByMemberID   : OK" & vbCrLf & _
        "Alan kontrolleri: OK" & vbCrLf & _
        "Cleanup         : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-067"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If TestChargeID > 0 Then

        DeleteTestCharge TestChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-067 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Cleanup uygulanmaya çalýþýldý.", _
        vbCritical, _
        "OAA - TEST-067"

End Sub



'==============================================================================
' TEST-068
'
' TOPLANTI AÝDATI - AKTÝF OLMAYAN ÜYE REDDÝ
'
' AMAÇ:
'
'   AddMeetingCharge metodunun AKTÝF olmayan bir üyeye TOPLANTI
'   aidatý uygulanmasýný reddettiðini doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   If Status <> "Aktif" Then
'
'       Err.Raise vbObjectError + 7212, _
'                 "clsMemberChargeService.AddMeetingCharge", _
'                 "Ýzinli veya istifa durumundaki üyeye toplantý aidatý uygulanamaz."
'
'   End If
'
' ÖNEMLÝ:
'
'   Mevcut üyeler içinde Ýzinli üye bulunmadýðý için test doðrudan
'   mevcut Ýstifa üyesi üzerinden AKTÝF OLMAYAN durum dalýný doðrular.
'
'   Ýzinli ve Ýstifa durumlarý mevcut Service kodunda ayný koþulla
'   reddedilmektedir.
'
' TEST VERÝSÝ:
'
'   Mevcut gerçek Ýstifa üyesi kullanýlýr.
'
'   Üyenin Status veya LeaveDate deðeri deðiþtirilmez.
'
'   Herhangi bir test üyesi oluþturulmaz.
'
' BEKLENEN:
'
'   Service hata vermelidir.
'
'   Hata kodu:
'
'       7212
'
'   Hata mesajý:
'
'       Ýzinli veya istifa durumundaki üyeye toplantý aidatý uygulanamaz.
'
'   Yeni TOPLANTI kaydý oluþmamalýdýr.
'
' CLEANUP:
'
'   Service temel üye durumu kontrolünde hata verdiði için
'   Repository.Add çaðrýlmamalýdýr.
'
'   Test herhangi bir üye kaydý oluþturmadýðý için üye cleanup
'   gerekmemektedir.
'==============================================================================

Public Sub TEST_068()

    Dim Service As clsMemberChargeService
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim TestMemberID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim Amount As Currency

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    Dim FoundTestMember As Boolean

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set MemberRepo = New clsMemberRepository

    TestMemberID = 0

    FoundTestMember = False

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString

    '==========================================================================
    ' 2 - MEVCUT AKTÝF OLMAYAN ÜYE BUL
    '
    ' Ýzinli üye mevcut deðil.
    '
    ' Service'in gerçek kodunda Ýzinli ve Ýstifa üyeleri ayný
    ' Status <> "Aktif" koþulunda reddedildiði için mevcut Ýstifa
    ' üyesi kullanýlmaktadýr.
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 11801, _
                  "TEST_068", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 11802, _
                  "TEST_068", _
                  "Üye listesi boþ."

    End If

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) <> 0 Then

                TestMemberID = Member.MemberID
                FoundTestMember = True

                Exit For

            End If

        End If

    Next Member

    '==========================================================================
    ' 3 - TEST ÖN KOÞULU
    '==========================================================================

    If Not FoundTestMember Then

        MsgBox _
            "TEST-068 UYGULANAMADI." & vbCrLf & vbCrLf & _
            "AKTÝF olmayan üye bulunamadý." & vbCrLf & vbCrLf & _
            "Aranan:" & vbCrLf & _
            "Status <> Aktif" & vbCrLf & vbCrLf & _
            "Mevcut gerçek üye kayýtlarý deðiþtirilmedi." & vbCrLf & vbCrLf & _
            "Sonuç: TEST ÖN KOÞULU YOK", _
            vbExclamation, _
            "OAA - TEST-068"

        Exit Sub

    End If

    '==========================================================================
    ' 4 - TEST ÜYESÝNÝ TEKRAR OKU
    '==========================================================================

    Set Member = MemberRepo.GetByID(TestMemberID)

    If Member Is Nothing Then

        Err.Raise vbObjectError + 11803, _
                  "TEST_068", _
                  "Test üyesi Repository'den tekrar okunamadý."

    End If

    '==========================================================================
    ' 5 - STATUS'UN AKTÝF OLMADIÐINI DOÐRULA
    '==========================================================================

    If StrComp( _
            Trim$(Member.Status), _
            "Aktif", _
            vbTextCompare) = 0 Then

        Err.Raise vbObjectError + 11804, _
                  "TEST_068", _
                  "Test için seçilen üye AKTÝF durumda."

    End If

    '==========================================================================
    ' 6 - TEST PARAMETRELERÝ
    '
    ' Üye durumu dýþýnda tüm parametreler geçerlidir.
    '==========================================================================

    FiscalYear = 2098

    DueMonth = 1

    ChargeDate = _
        DateSerial(FiscalYear, DueMonth, 15)

    Amount = 150@

    '==========================================================================
    ' 7 - SERVICE ÇAÐRISI
    '
    ' Beklenen:
    '
    '   7212
    '
    ' Service'in hata vermesi BAÞARILI test koþuludur.
    '==========================================================================

    On Error Resume Next

    Err.Clear

    Call Service.AddMeetingCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            "TEST-068", _
            ChargeDate, _
            "TEST-068 - Aktif olmayan üye testi")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorNumber = Err.Number
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 8 - SERVICE HATA VERMELÝ
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 11805, _
                  "TEST_068", _
                  "AKTÝF olmayan üyeye TOPLANTI aidatý " & _
                  "uygulanmasýna izin verildi."

    End If

    '==========================================================================
    ' 9 - HATA NUMARASI KONTROLÜ
    '==========================================================================

    If ErrorNumber = 0 Then

        Err.Raise vbObjectError + 11806, _
                  "TEST_068", _
                  "Service hata verdi ancak Err.Number alýnamadý."

    End If

    '==========================================================================
    ' 10 - BEKLENEN HATA MESAJI
    '==========================================================================

    If InStr( _
            1, _
            ErrorDescription, _
            "Ýzinli veya istifa durumundaki üyeye toplantý aidatý uygulanamaz.", _
            vbTextCompare) = 0 Then

        Err.Raise vbObjectError + 11807, _
                  "TEST_068", _
                  "Beklenen 7212 hata mesajý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen:" & vbCrLf & _
                  "Ýzinli veya istifa durumundaki üyeye toplantý aidatý uygulanamaz." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan:" & vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 11 - HATA MESAJINI TAM DOÐRULA
    '==========================================================================

    If StrComp( _
            Trim$(ErrorDescription), _
            "Ýzinli veya istifa durumundaki üyeye toplantý aidatý uygulanamaz.", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 11808, _
                  "TEST_068", _
                  "7212 hata mesajý beklenen metinle eþleþmiyor." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen:" & vbCrLf & _
                  "Ýzinli veya istifa durumundaki üyeye toplantý aidatý uygulanamaz." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan:" & vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 12 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-068 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi     : " & TestMemberID & vbCrLf & _
        "Gerçek Status  : " & Member.Status & vbCrLf & _
        "Mali yýl       : " & FiscalYear & vbCrLf & _
        "Dönem ayý      : " & DueMonth & vbCrLf & _
        "ChargeDate     : " & _
            Format$(ChargeDate, "dd.mm.yyyy") & vbCrLf & _
        "Amount         : " & Amount & " TL" & vbCrLf & vbCrLf & _
        "AKTÝF deðil    : EVET" & vbCrLf & _
        "Service reddi  : OK" & vbCrLf & _
        "Kontrol        : 7212" & vbCrLf & _
        "Hata mesajý    : Ýzinli veya istifa durumundaki üyeye " & _
            "toplantý aidatý uygulanamaz." & vbCrLf & _
        "Kayýt oluþumu  : YOK" & vbCrLf & _
        "Üye deðiþikliði: YOK" & vbCrLf & _
        "Cleanup        : GEREKMEDÝ" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-068"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    MsgBox _
        "TEST-068 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Service Hatasý:" & vbCrLf & _
        ErrorDescription, _
        vbCritical, _
        "OAA - TEST-068"

End Sub


'==============================================================================
' TEST-070
'
' TOPLANTI AÝDATI - MÜKERRER TAHAKKUK KONTROLÜ
'
' AMAÇ:
'
'   Ayný üye + ayný mali yýl + ayný DueMonth için ikinci NORMAL
'   TOPLANTI tahakkukunun Service tarafýndan reddedildiðini doðrulamak.
'
' TEST AKIÞI:
'
'   1. AKTÝF üye bulunur.
'   2. Test için kullanýlmamýþ TOPLANTI dönemi bulunur.
'   3. Ýlk TOPLANTI tahakkuku oluþturulur.
'   4. Ýlk kayýt Repository üzerinden doðrulanýr.
'   5. Ayný dönem için ikinci tahakkuk denenir.
'   6. Ýkinci tahakkuk reddedilmelidir.
'   7. Mükerrerlik hata mesajý doðrulanýr.
'   8. Ýlk geçerli kayýt korunmuþ olmalýdýr.
'   9. Ýlk test kaydý cleanup ile silinir.
'  10. Cleanup doðrulanýr.
'
' BEKLENEN:
'
'   Ýlk kayýt       : OLUÞUR
'   Ýkinci kayýt    : OLUÞMAZ
'   Mükerrer hata   : OLUÞUR
'
' GERÇEK ÜYE VERÝSÝ:
'
'   Üyenin hiçbir alaný deðiþtirilmez.
'
' TEST VERÝSÝ:
'
'   Sadece geçici MemberCharge kaydý oluþturulur.
'
' CLEANUP:
'
'   Oluþturulan ilk ChargeID mutlaka silinir.
'==============================================================================

Public Sub TEST_070()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection

    Dim Member As clsMember
    Dim Charge As clsMemberCharge

    Dim TestMemberID As Long
    Dim FirstChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim Amount As Currency
    Dim DecisionDate As Date

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    Dim FoundMember As Boolean
    Dim FoundMonth As Boolean

    Dim MonthNo As Long

    '--------------------------------------------------------------------------
    ' Hata bilgilerini ayrýca saklýyoruz.
    '
    ' Cleanup sýrasýnda Err nesnesinin deðiþmesini önlemek için gerçek test
    ' hatasý ayrý deðiþkenlerde tutulacaktýr.
    '--------------------------------------------------------------------------

    Dim TestFailed As Boolean
    Dim TestFailureNumber As Long
    Dim TestFailureDescription As String

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    TestMemberID = 0
    FirstChargeID = 0

    FoundMember = False
    FoundMonth = False

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString

    TestFailed = False
    TestFailureNumber = 0
    TestFailureDescription = vbNullString

    '==========================================================================
    ' 2 - AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 12001, _
                  "TEST_070", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 12002, _
                  "TEST_070", _
                  "Üye listesi boþ."

    End If

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID
                FoundMember = True

                Exit For

            End If

        End If

    Next Member

    If Not FoundMember Then

        Err.Raise vbObjectError + 12003, _
                  "TEST_070", _
                  "TEST-070 için AKTÝF üye bulunamadý."

    End If

    '==========================================================================
    ' 3 - KULLANILMAMIÞ TEST DÖNEMÝ BUL
    '
    ' 2098 yýlý kullanýlýyor.
    '
    ' Önceden NORMAL TOPLANTI kaydý olmayan ay seçilir.
    '==========================================================================

    FiscalYear = 2098

    For MonthNo = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                MonthNo, _
                "TOPLANTI") Then

            DueMonth = MonthNo
            FoundMonth = True

            Exit For

        End If

    Next MonthNo

    If Not FoundMonth Then

        MsgBox _
            "TEST-070 UYGULANAMADI." & vbCrLf & vbCrLf & _
            "2098 mali yýlýnda kullanýlmamýþ TOPLANTI dönemi bulunamadý." & _
            vbCrLf & vbCrLf & _
            "Gerçek kullanýcý verileri deðiþtirilmedi." & vbCrLf & vbCrLf & _
            "Sonuç: TEST ÖN KOÞULU YOK", _
            vbExclamation, _
            "OAA - TEST-070"

        Exit Sub

    End If

    '==========================================================================
    ' 4 - TEST PARAMETRELERÝ
    '==========================================================================

    ChargeDate = _
        DateSerial(FiscalYear, DueMonth, 15)

    DecisionDate = ChargeDate

    Amount = 150@

    '==========================================================================
    ' 5 - ÝLK TOPLANTI TAHAKKUKUNU OLUÞTUR
    '==========================================================================

    FirstChargeID = _
        Service.AddMeetingCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            "TEST-070-A", _
            DecisionDate, _
            "TEST-070 - Ýlk TOPLANTI tahakkuku")

    If FirstChargeID <= 0 Then

        Err.Raise vbObjectError + 12004, _
                  "TEST_070", _
                  "Ýlk TOPLANTI tahakkuku oluþturulamadý." & _
                  vbCrLf & _
                  "ChargeID = " & FirstChargeID

    End If

    '==========================================================================
    ' 6 - ÝLK KAYDI REPOSITORY'DEN DOÐRULA
    '==========================================================================

    Set Charge = Repo.GetByID(FirstChargeID)

    If Charge Is Nothing Then

        Err.Raise vbObjectError + 12005, _
                  "TEST_070", _
                  "Ýlk TOPLANTI kaydý Repository.GetByID ile bulunamadý." & _
                  vbCrLf & _
                  "ChargeID = " & FirstChargeID

    End If

    If Charge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 12006, _
                  "TEST_070", _
                  "Ýlk kaydýn MemberID deðeri hatalý."

    End If

    If StrComp( _
            Trim$(Charge.ChargeType), _
            "TOPLANTI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 12007, _
                  "TEST_070", _
                  "Ýlk kaydýn ChargeType deðeri TOPLANTI deðil."

    End If

    If Charge.FiscalYear <> FiscalYear Then

        Err.Raise vbObjectError + 12008, _
                  "TEST_070", _
                  "Ýlk kaydýn FiscalYear deðeri hatalý."

    End If

    If Charge.DueMonth <> DueMonth Then

        Err.Raise vbObjectError + 12009, _
                  "TEST_070", _
                  "Ýlk kaydýn DueMonth deðeri hatalý."

    End If

    If StrComp( _
            Trim$(Charge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 12010, _
                  "TEST_070", _
                  "Ýlk kaydýn AdjustmentType deðeri NORMAL deðil."

    End If

    If Charge.SourceChargeID <> 0 Then

        Err.Raise vbObjectError + 12011, _
                  "TEST_070", _
                  "Ýlk TOPLANTI kaydýnda SourceChargeID 0 deðil."

    End If

    If StrComp( _
            Trim$(Charge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 12012, _
                  "TEST_070", _
                  "Ýlk TOPLANTI kaydýnýn Status deðeri AKTIF deðil."

    End If

    '==========================================================================
    ' 7 - AYNI DÖNEME ÝKÝNCÝ TOPLANTI TAHAKKUKUNU DENE
    '
    ' Burada HATA BEKLENÝYOR.
    '==========================================================================

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    Call Service.AddMeetingCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            "TEST-070-B", _
            DecisionDate, _
            "TEST-070 - Mükerrer TOPLANTI tahakkuku")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorNumber = Err.Number
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 8 - ÝKÝNCÝ TAHAKKUK MUTLAKA REDDEDÝLMELÝ
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 12013, _
                  "TEST_070", _
                  "Ayný üye için ayný dönem TOPLANTI aidatý ikinci kez " & _
                  "oluþturuldu. Mükerrer kontrol çalýþmadý."

    End If

    '==========================================================================
    ' 9 - HATA MESAJINI KONTROL ET
    '
    ' Service'in gerçek mesajý:
    '
    '   "Bu üye için ayný döneme ait toplantý aidatý zaten tahakkuk edilmiþ."
    '
    '==========================================================================

    If InStr( _
            1, _
            ErrorDescription, _
            "Bu üye için ayný döneme ait toplantý aidatý zaten tahakkuk edilmiþ.", _
            vbTextCompare) = 0 Then

        Err.Raise vbObjectError + 12014, _
                  "TEST_070", _
                  "Mükerrer TOPLANTI için beklenen hata mesajý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan mesaj:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 10 - ÝLK GEÇERLÝ KAYDIN KORUNDUÐUNU KONTROL ET
    '
    ' Ýkinci tahakkukun reddedilmesi ilk geçerli kaydý silmemelidir.
    '
    ' Bu kontrol yalnýzca kayýt mevcut mu sorusunu doðrular.
    ' Gereksiz baþka Repository kontrolleri yapýlmýyor.
    '==========================================================================

    Set Charge = Nothing

    Set Charge = Repo.GetByID(FirstChargeID)

    If Charge Is Nothing Then

        Err.Raise vbObjectError + 12015, _
                  "TEST_070", _
                  "Mükerrer tahakkuk reddedildikten sonra ilk geçerli " & _
                  "TOPLANTI kaydý bulunamadý." & _
                  vbCrLf & _
                  "ChargeID = " & FirstChargeID

    End If

    '==========================================================================
    ' 11 - ÝLK KAYDIN ID'SÝNÝ TEKRAR DOÐRULA
    '==========================================================================

    If Charge.ChargeID <> FirstChargeID Then

        Err.Raise vbObjectError + 12016, _
                  "TEST_070", _
                  "Repository'den okunan ilk kaydýn ChargeID deðeri hatalý."

    End If

    '==========================================================================
    ' 12 - CLEANUP
    '
    ' Ýlk baþarýlý geçici kayýt silinir.
    '==========================================================================

    DeleteTestCharge FirstChargeID

    ' ChargeID artýk cleanup sonrasý kontrol için tutulmaya devam ediyor.
    '==========================================================================

    '==========================================================================
    ' 13 - CLEANUP KONTROLÜ
    '==========================================================================

    Set Charge = Nothing

    Set Charge = Repo.GetByID(FirstChargeID)

    If Not Charge Is Nothing Then

        Err.Raise vbObjectError + 12017, _
                  "TEST_070", _
                  "TEST-070 geçici kaydý cleanup sonrasýnda hâlâ mevcut." & _
                  vbCrLf & _
                  "ChargeID = " & FirstChargeID

    End If

    '==========================================================================
    ' 14 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-070 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "Mali yýl         : " & FiscalYear & vbCrLf & _
        "Dönem ayý        : " & DueMonth & vbCrLf & _
        "Ýlk ChargeID     : " & FirstChargeID & vbCrLf & vbCrLf & _
        "1. TOPLANTI      : OLUÞTU" & vbCrLf & _
        "2. TOPLANTI      : REDDEDÝLDÝ" & vbCrLf & _
        "Mükerrer kontrol : OK" & vbCrLf & _
        "Hata mesajý      : DOÐRU" & vbCrLf & _
        "Ýlk kayýt korundu: EVET" & vbCrLf & _
        "Cleanup          : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-070"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    '--------------------------------------------------------------------------
    ' GERÇEK HATA BÝLGÝSÝNÝ CLEANUP ÖNCESÝNDE SAKLA
    '--------------------------------------------------------------------------

    TestFailed = True
    TestFailureNumber = Err.Number
    TestFailureDescription = Err.Description

    '--------------------------------------------------------------------------
    ' CLEANUP
    '--------------------------------------------------------------------------

    On Error Resume Next

    If FirstChargeID > 0 Then

        DeleteTestCharge FirstChargeID

    End If

    On Error GoTo 0

    '--------------------------------------------------------------------------
    ' HATA BÝLGÝSÝNÝ KAYBETMEDEN GÖSTER
    '--------------------------------------------------------------------------

    MsgBox _
        "TEST-070 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & TestFailureNumber & vbCrLf & _
        "Açýklama: " & TestFailureDescription & vbCrLf & vbCrLf & _
        "Service Hatasý:" & vbCrLf & _
        ErrorDescription & vbCrLf & vbCrLf & _
        "Cleanup uygulanmaya çalýþýldý.", _
        vbCritical, _
        "OAA - TEST-070"

End Sub



'==============================================================================
' TEST-071
'
' TOPLANTI AÝDATI - GEÇERSÝZ MEMBERID
'
' AMAÇ:
'
'   AddMeetingCharge metodunun, pozitif ancak Repository'de bulunmayan
'   bir MemberID deðerini reddettiðini doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   Set Member = mMemberRepository.GetByID(MemberID)
'
'   If Member Is Nothing Then
'
'       Err.Raise vbObjectError + 7211, _
'                 "clsMemberChargeService.AddMeetingCharge", _
'                 "Üye bulunamadý. Üye No: " & MemberID
'
'   End If
'
' ÖNEMLÝ:
'
'   MemberID = 0 KULLANILMIYOR.
'
'   Çünkü ValidateBasicChargeParameters içinde:
'
'       MemberID <= 0
'
'   için 7231 oluþmaktadýr.
'
'   Bu testte amaç 7211'e ulaþmaktýr.
'
' TEST STRATEJÝSÝ:
'
'   Mevcut üyeler alýnýr.
'
'   Mevcut en yüksek MemberID bulunur.
'
'   Daha sonra Repository'de bulunmayan pozitif bir MemberID seçilir.
'
'   Böylece mevcut gerçek kullanýcý verileri deðiþtirilmez.
'
' BEKLENEN:
'
'   Service hata vermelidir.
'
'   Hata mesajý:
'
'       Üye bulunamadý. Üye No: X
'
'   Yeni TOPLANTI kaydý oluþmamalýdýr.
'
' CLEANUP:
'
'   Service Repository.Add aþamasýna ulaþmadýðý için
'   geçici kayýt oluþmaz.
'==============================================================================

Public Sub TEST_071()

    Dim Service As clsMemberChargeService
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim InvalidMemberID As Long
    Dim MaxMemberID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim Amount As Currency

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    Dim FoundInvalidID As Boolean

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set MemberRepo = New clsMemberRepository

    InvalidMemberID = 0
    MaxMemberID = 0

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString

    FoundInvalidID = False

    '==========================================================================
    ' 2 - MEVCUT ÜYELERÝ AL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 12101, _
                  "TEST_071", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 12102, _
                  "TEST_071", _
                  "Üye listesi boþ."

    End If

    '==========================================================================
    ' 3 - EN YÜKSEK MEMBERID'YÝ BUL
    '==========================================================================

    For Each Member In Members

        If Not Member Is Nothing Then

            If Member.MemberID > MaxMemberID Then

                MaxMemberID = Member.MemberID

            End If

        End If

    Next Member

    If MaxMemberID <= 0 Then

        Err.Raise vbObjectError + 12103, _
                  "TEST_071", _
                  "Geçerli bir mevcut MemberID bulunamadý."

    End If

    '==========================================================================
    ' 4 - REPOSITORY'DE OLMAYAN POZÝTÝF MEMBERID BUL
    '
    ' MaxMemberID + 1 ile baþlanýr.
    '
    ' Teorik olarak bu ID mevcut olabilir; bu nedenle FindByID ile
    ' kesin olarak kontrol edilir.
    '==========================================================================

    InvalidMemberID = MaxMemberID + 1

    Do While InvalidMemberID > MaxMemberID

        Set Member = MemberRepo.GetByID(InvalidMemberID)

        If Member Is Nothing Then

            FoundInvalidID = True

            Exit Do

        End If

        InvalidMemberID = InvalidMemberID + 1

        '----------------------------------------------------------------------
        ' Güvenlik sýnýrý
        '----------------------------------------------------------------------

        If InvalidMemberID > MaxMemberID + 10000 Then


'==============================================================================
' TEST-012
' Ýzinli üye resmi aidat tahakkuku
'
' Test yaklaþýmý:
'   Mevcut bir AKTÝF üye geçici olarak ÝZÝNLÝ yapýlýr.
'   Resmi aidat tahakkuku test edilir.
'   Test kaydý silinir.
'   Üyenin eski durumu geri yüklenir.
'
' GERÇEK VERÝ KORUMA:
'   Test sonunda üyenin orijinal durumu aynen geri yüklenir.
'==============================================================================

Public Sub Test_PermissionMemberOfficialCharge()

    Dim Service As clsMemberChargeService
    Dim Repository As clsMemberChargeRepository
    Dim MemberRepository As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim TestMember As clsMember
    Dim Charge As clsMemberCharge

    Dim TestChargeID As Long
    Dim TestMemberID As Long

    Dim OriginalStatus As String

    Dim TestPassed As Boolean

    On Error GoTo ErrorHandler

    '----------------------------------------------------------------------
    ' Nesneler
    '----------------------------------------------------------------------

    Set Service = New clsMemberChargeService
    Set Repository = New clsMemberChargeRepository
    Set MemberRepository = New clsMemberRepository

    '----------------------------------------------------------------------
    ' Tüm üyeleri getir
    '----------------------------------------------------------------------

    Set Members = MemberRepository.GetAll

    If Members Is Nothing Then

        MsgBox "TEST-012 BAÞARISIZ." & vbCrLf & vbCrLf & _
               "Üye listesi alýnamadý.", _
               vbCritical, "OAA - TEST-012"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' Test için AKTÝF bir üye bul
    '----------------------------------------------------------------------

    TestMemberID = 0

    For Each Member In Members

        If StrComp( _
            Trim$(Member.Status), _
            "Aktif", _
            vbTextCompare) = 0 Then

            TestMemberID = Member.MemberID
            OriginalStatus = Member.Status

            Set TestMember = Member

            Exit For

        End If

    Next Member

    '----------------------------------------------------------------------
    ' Aktif üye bulunamadý
    '----------------------------------------------------------------------

    If TestMemberID <= 0 Then

        MsgBox "TEST-012 UYGULANAMADI." & vbCrLf & vbCrLf & _
               "Test için Aktif durumda üye bulunamadý.", _
               vbExclamation, "OAA - TEST-012"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' Üyeyi geçici olarak ÝZÝNLÝ yap
    '----------------------------------------------------------------------

    TestMember.Status = "Ýzinli"

    If Not MemberRepository.Update(TestMember) Then

        MsgBox "TEST-012 BAÞARISIZ." & vbCrLf & vbCrLf & _
               "Üye geçici olarak Ýzinli durumuna getirilemedi." & vbCrLf & _
               "Üye No: " & TestMemberID, _
               vbCritical, "OAA - TEST-012"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' RESMÝ AÝDAT TAHAKKUKU
    '
    ' 2027 Ocak
    ' 500 TL
    '----------------------------------------------------------------------

    TestChargeID = Service.AddOfficialCharge( _
                        TestMemberID, _
                        2027, _
                        1, _
                        DateSerial(2027, 1, 1), _
                        500@, _
                        DateSerial(2027, 12, 31), _
                        "TEST-012", _
                        DateSerial(2026, 12, 25), _
                        "TEST-012 - Ýzinli üye resmi aidat")

    '----------------------------------------------------------------------
    ' ChargeID kontrolü
    '----------------------------------------------------------------------

    If TestChargeID <= 0 Then
        GoTo TestFailed
    End If

    '----------------------------------------------------------------------
    ' Tahakkuku geri oku
    '----------------------------------------------------------------------

    Set Charge = Repository.GetByID(TestChargeID)

    If Charge Is Nothing Then
        GoTo TestFailed
    End If

    '----------------------------------------------------------------------
    ' ALAN KONTROLLERÝ
    '----------------------------------------------------------------------

    If Charge.MemberID <> TestMemberID Then
        GoTo TestFailed
    End If

    If Charge.ChargeType <> "RESMI" Then
        GoTo TestFailed
    End If

    If Charge.FiscalYear <> 2027 Then
        GoTo TestFailed
    End If

    If Charge.DueMonth <> 1 Then
        GoTo TestFailed
    End If

    If Charge.Amount <> 500@ Then
        GoTo TestFailed
    End If

    If Charge.AdjustmentType <> "NORMAL" Then
        GoTo TestFailed
    End If

    If Charge.SourceChargeID <> 0 Then
        GoTo TestFailed
    End If

    If Charge.DecisionNo <> "TEST-012" Then
        GoTo TestFailed
    End If

    If Charge.Status <> "AKTIF" Then
        GoTo TestFailed
    End If

    '----------------------------------------------------------------------
    ' TEST BAÞARILI
    '----------------------------------------------------------------------

    TestPassed = True

    '----------------------------------------------------------------------
    ' Test kaydýný sil
    '----------------------------------------------------------------------

    If TestChargeID > 0 Then
        DeleteTestCharge TestChargeID
        TestChargeID = 0
    End If

    '----------------------------------------------------------------------
    ' ÜYENÝN ORÝJÝNAL DURUMUNU GERÝ YÜKLE
    '----------------------------------------------------------------------

    TestMember.Status = OriginalStatus

    If Not MemberRepository.Update(TestMember) Then

        MsgBox "TEST-012 TAMAMLANDI ANCAK UYARI VAR." & vbCrLf & vbCrLf & _
               "Tahakkuk testi baþarýlý." & vbCrLf & _
               "Ancak üyenin eski durumu geri yüklenemedi." & vbCrLf & _
               "Üye No: " & TestMemberID, _
               vbExclamation, "OAA - TEST-012"

        Exit Sub

    End If

    '----------------------------------------------------------------------
    ' BAÞARILI MESAJ
    '----------------------------------------------------------------------

    MsgBox "TEST-012 BAÞARILI." & vbCrLf & vbCrLf & _
           "Test üyesi         : " & TestMemberID & vbCrLf & _
           "Geçici durum       : Ýzinli" & vbCrLf & _
           "RESMI tahakkuk     : OK" & vbCrLf & _
           "Mali yýl           : OK" & vbCrLf & _
           "Aidat ayý          : OK" & vbCrLf & _
           "Tutar              : OK" & vbCrLf & _
           "Repository okuma   : OK" & vbCrLf & _
           "Test kaydý silindi : OK" & vbCrLf & _
           "Üye durumu geri alýndý : OK", _
           vbInformation, "OAA - TEST-012"

    Set Charge = Nothing
    Set TestMember = Nothing
    Set Members = Nothing
    Set MemberRepository = Nothing
    Set Repository = Nothing
    Set Service = Nothing

    Exit Sub


'==============================================================================
' TEST BAÞARISIZ
'==============================================================================

TestFailed:

    ' Test tahakkukunu temizle
    If TestChargeID > 0 Then
        DeleteTestCharge TestChargeID
        TestChargeID = 0
    End If

    ' Üyenin eski durumunu geri yükle
    If Not TestMember Is Nothing Then

        TestMember.Status = OriginalStatus
        MemberRepository.Update TestMember

    End If

    MsgBox "TEST-012 BAÞARISIZ." & vbCrLf & vbCrLf & _
           "Ýzinli üyenin resmi aidat testi beklenen sonucu vermedi." & vbCrLf & vbCrLf & _
           "Test üyesi      : " & TestMemberID & vbCrLf & _
           "Test kaydý      : Temizlendi" & vbCrLf & _
           "Üye durumu      : Geri yüklendi", _
           vbCritical, "OAA - TEST-012"

    Exit Sub


'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    ' Varsa test tahakkukunu temizle
    If TestChargeID > 0 Then
        DeleteTestCharge TestChargeID
    End If

    ' Varsa üyenin eski durumunu geri yükle
    If Not TestMember Is Nothing Then

        TestMember.Status = OriginalStatus

        If Not MemberRepository Is Nothing Then
            MemberRepository.Update TestMember
        End If

    End If

    MsgBox "TEST-012 sýrasýnda hata oluþtu." & vbCrLf & vbCrLf & _
           "Hata No : " & Err.Number & vbCrLf & _
           "Hata    : " & Err.Description & vbCrLf & vbCrLf & _
           "Test verileri temizlendi." & vbCrLf & _
           "Üyenin eski durumu geri yüklenmeye çalýþýldý.", _
           vbCritical, "OAA - TEST-012"

End Sub

'==============================================================================

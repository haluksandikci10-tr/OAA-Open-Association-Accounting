    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository

    '==========================================================================
    ' 2 - GERÇEKTEN OLMAYAN SOURCECHARGEID BELÝRLE
    '
    ' Pozitif bir deðer kullanýlmalýdýr.
    ' Böylece TEST-037'deki SourceChargeID <= 0 kontrolü aþýlýr.
    '==========================================================================
    
    SourceChargeID = 2147480000

    ' Önce bu ChargeID'nin gerçekten mevcut olmadýðýný doðrula.

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If Not SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 9001, _
                  "TEST_040", _
                  "Test için seçilen SourceChargeID sistemde mevcut." & _
                  vbCrLf & _
                  "ChargeID: " & SourceChargeID

    End If

    '==========================================================================
    ' 3 - DÝÐER PARAMETRELER GEÇERLÝ
    '
    ' Amaç doðrudan "kaynak tahakkuk bulunamadý" kontrolünü test etmektir.
    '==========================================================================
    
    AdjustmentDate = DateSerial(2098, 11, 1)

    AdjustmentAmount = 100@

    AdjustmentChargeID = 0

    ErrorOccurred = False
    ErrorDescription = vbNullString

    '==========================================================================
    ' 4 - OLMAYAN KAYNAK TAHAKKUK ÝLE ARTIS DENEMESÝ
    '==========================================================================

    On Error Resume Next

    Err.Clear

    AdjustmentChargeID = _
        Service.AddOfficialChargeAdjustment( _
            SourceChargeID, _
            AdjustmentDate, _
            AdjustmentAmount, _
            "TEST-040", _
            AdjustmentDate, _
            "TEST-040 - Olmayan kaynak tahakkuk")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 5 - SERVICE REDDÝ KONTROLÜ
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 9002, _
                  "TEST_040", _
                  "Olmayan SourceChargeID Service tarafýndan reddedilmedi."

    End If

    '==========================================================================
    ' 6 - ARTIS CHARGEID OLUÞMAMALI
    '==========================================================================

    If AdjustmentChargeID <> 0 Then

        Err.Raise vbObjectError + 9003, _
                  "TEST_040", _
                  "Olmayan kaynak tahakkukla ARTIS ChargeID oluþtu: " & _
                  AdjustmentChargeID

    End If

    '==========================================================================
    ' 7 - GERÇEK SERVICE HATA MESAJI KONTROLÜ
    '
    ' Beklenen:
    '
    '   "Kaynak tahakkuk bulunamadý. ChargeID: 2147480000"
    '==========================================================================

    If InStr( _
            1, _
            ErrorDescription, _
            "Kaynak tahakkuk bulunamadý.", _
            vbTextCompare) = 0 Then

        Err.Raise vbObjectError + 9004, _
                  "TEST_040", _
                  "Beklenen 'Kaynak tahakkuk bulunamadý.' mesajý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan mesaj:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 8 - HATA MESAJINDA CHARGEID KONTROLÜ
    '==========================================================================

    If InStr( _
            1, _
            ErrorDescription, _
            CStr(SourceChargeID), _
            vbTextCompare) = 0 Then

        Err.Raise vbObjectError + 9005, _
                  "TEST_040", _
                  "Hata mesajýnda beklenen SourceChargeID bulunamadý." & _
                  vbCrLf & _
                  "Beklenen ID: " & SourceChargeID & _
                  vbCrLf & _
                  "Alýnan mesaj:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 9 - KAYNAK KAYDIN HÂLÂ OLMADIÐINI KONTROL ET
    '
    ' Test hiçbir kayýt oluþturmamalýdýr.
    '==========================================================================

    Set SourceCharge = Repo.GetByID(SourceChargeID)

    If Not SourceCharge Is Nothing Then

        Err.Raise vbObjectError + 9006, _
                  "TEST_040", _
                  "TEST-040 sýrasýnda beklenmeyen kaynak tahakkuk oluþtu."

    End If

    '==========================================================================
    ' 10 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-040 BAÞARILI." & vbCrLf & vbCrLf & _
        "SourceChargeID   : " & SourceChargeID & _
            " (MEVCUT DEÐÝL)" & vbCrLf & _
        "Artýþ tarihi     : " & _
            Format$(AdjustmentDate, "dd.mm.yyyy") & vbCrLf & _
        "Artýþ tutarý     : " & AdjustmentAmount & " TL" & vbCrLf & vbCrLf & _
        "Repository       : Kaynak bulunamadý" & vbCrLf & _
        "Service reddi    : OK" & vbCrLf & _
        "ARTIS ChargeID   : 0" & vbCrLf & _
        "Kayýt oluþumu    : YOK" & vbCrLf & _
        "Cleanup          : GEREKMEDÝ" & vbCrLf & vbCrLf & _
        "Sonuç: BEKLENEN RET", _
        vbInformation, _
        "OAA - TEST-040"

    Exit Sub

'==============================================================================
' HATA YAKALAMA

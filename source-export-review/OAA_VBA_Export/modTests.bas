        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-098"

        Exit Sub

    End If

    '==========================================================================
    ' 5 - TEST PARAMETRELERI
    '
    ' Status kontrolu, mukerrer kontrolunden once yapildigi icin
    ' mevcut donem kayitlarindan bagimsiz olarak 7212 beklenir.
    '==========================================================================

    TestFiscalYear = 2098

    TestDueMonth = 1

    TestChargeDate = _
        DateSerial(TestFiscalYear, TestDueMonth, 15)

    TestAmount = 150@

    TestChargeID = 0

    ErrorOccurred = False

    ErrorNumber = 0

    ErrorDescription = vbNullString

    '==========================================================================
    ' 6 - BEKLENEN HATA
    '==========================================================================

    ExpectedErrorNumber = _
        vbObjectError + 7212

    ExpectedMessage = _
        "Ýzinli veya istifa durumundaki üyeye toplantý aidatý uygulanamaz."

    '==========================================================================
    ' 7 - GERCEK SERVICE CAGRISI
    '
    ' AddMeetingCharge gercek Service API'sidir.
    '
    ' IZINLI uye oldugu icin 7212 beklenir.
    '==========================================================================

    On Error Resume Next

    Err.Clear

    TestChargeID = Service.AddMeetingCharge( _
        TestMemberID, _
        TestFiscalYear, _
        TestDueMonth, _
        TestChargeDate, _
        TestAmount, _
        "TEST-098", _
        TestChargeDate, _
        "TEST-098 - Izýnli uye toplantý aidati testi")

    If Err.Number <> 0 Then

        ErrorOccurred = True

        ErrorNumber = Err.Number

        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 8 - SERVICE HATA VERMELI
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 14801, _
                  "TEST_098", _
                  "IZINLI durumundaki uye icin AddMeetingCharge " & _
                  "islemi reddetmedi."

    End If

    '==========================================================================
    ' 9 - CHARGEID OLUSMAMALI
    '==========================================================================

    If TestChargeID <> 0 Then

        Err.Raise vbObjectError + 14802, _
                  "TEST_098", _
                  "IZINLI uye reddedilmesine ragmen yeni " & _
                  "ChargeID olustu." & _
                  vbCrLf & _
                  "ChargeID = " & TestChargeID

    End If

    '==========================================================================
    ' 10 - HATA NUMARASI
    '==========================================================================

    If ErrorNumber <> ExpectedErrorNumber Then

        Err.Raise vbObjectError + 14803, _
                  "TEST_098", _
                  "Beklenen hata kodu alinmadi." & _
                  vbCrLf & _
                  "Beklenen : " & ExpectedErrorNumber & _
                  vbCrLf & _
                  "Alinan   : " & ErrorNumber & _
                  vbCrLf & _
                  "Mesaj    : " & ErrorDescription

    End If

    '==========================================================================
    ' 11 - HATA MESAJI
    '==========================================================================

    If StrComp( _
            Trim$(ErrorDescription), _
            ExpectedMessage, _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 14804, _
                  "TEST_098", _
                  "7212 hata mesaji beklenen metinle eslesmiyor." & _
                  vbCrLf & _
                  "Beklenen : " & ExpectedMessage & _
                  vbCrLf & _
                  "Alinan   : " & ErrorDescription

    End If

    '==========================================================================
    ' 12 - UYE HALA MEVCUT MU?
    '
    ' Test uye kaydini silmemeli.
    '==========================================================================

    Set Member = MemberRepo.GetByID(TestMemberID)

    If Member Is Nothing Then

        Err.Raise vbObjectError + 14805, _
                  "TEST_098", _
                  "Test edilen IZINLI uye test sonrasinda bulunamadi."

    End If

    '==========================================================================

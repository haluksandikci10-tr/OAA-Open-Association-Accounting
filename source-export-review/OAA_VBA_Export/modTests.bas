'==============================================================================
' TEST-125
' Ledger Repository - GetAll / GetNextLedgerID / DeleteByID
'
' Amaç:
'   clsLedgerRepository'nin:
'   - GetNextLedgerID
'   - Add
'   - GetAll
'   - DeleteByID
'   davranýþlarýný birlikte doðrulamak.
'
' Test kayýtlarý:
'   Ýki geçici Ledger kaydý oluþturulur.
'
' Cleanup:
'   Test sonunda her iki kayýt mutlaka silinir.
'==============================================================================

Public Sub TEST_125_LedgerRepositoryGetAllNextIDDelete()

    Dim Repo As clsLedgerRepository
    Dim Entry1 As clsLedgerEntry
    Dim Entry2 As clsLedgerEntry

    Dim LoadedEntry As clsLedgerEntry

    Dim Entries As Collection

    Dim LedgerID1 As Long
    Dim LedgerID2 As Long

    Dim FoundID1 As Boolean
    Dim FoundID2 As Boolean

    On Error GoTo UnexpectedError

    Debug.Print String(70, "=")
    Debug.Print "TEST-125 - Ledger Repository GetAll / GetNextID / Delete"
    Debug.Print String(70, "=")


    '--------------------------------------------------------------------------
    ' REPOSITORY
    '--------------------------------------------------------------------------

    Set Repo = New clsLedgerRepository


    '--------------------------------------------------------------------------
    ' FIRST ID
    '--------------------------------------------------------------------------

    LedgerID1 = Repo.GetNextLedgerID

    If LedgerID1 <= 0 Then

        Err.Raise _
            vbObjectError + 12501, _
            "TEST-125", _
            "Ýlk geçerli LedgerID üretilemedi."

    End If


    '--------------------------------------------------------------------------
    ' FIRST ENTITY
    '--------------------------------------------------------------------------

    Set Entry1 = New clsLedgerEntry

    Entry1.LedgerID = LedgerID1
    Entry1.EntryDate = Date
    Entry1.DocumentNo = "TEST-125-A"
    Entry1.ReceiptInvoice = "TEST-A-125"
    Entry1.Description = "TEST-125 Birinci Kayýt"
    Entry1.IncomeType = "TEST GELÝR"
    Entry1.ExpenseType = ""
    Entry1.IncomeAmount = CCur(100)
    Entry1.ExpenseAmount = CCur(0)
    Entry1.CashAmount = CCur(100)
    Entry1.BankAmount = CCur(0)
    Entry1.BalanceAmount = CCur(100)


    '--------------------------------------------------------------------------
    ' FIRST ADD
    '--------------------------------------------------------------------------

    If Not Repo.Add(Entry1) Then

        Err.Raise _
            vbObjectError + 12502, _
            "TEST-125", _
            "Birinci Ledger kaydý oluþturulamadý."

    End If


    '--------------------------------------------------------------------------
    ' SECOND ID
    '--------------------------------------------------------------------------

    LedgerID2 = Repo.GetNextLedgerID

    If LedgerID2 <= LedgerID1 Then

        Err.Raise _
            vbObjectError + 12503, _
            "TEST-125", _
            "GetNextLedgerID yeni kayýt için artýþ saðlamadý."

    End If


    '--------------------------------------------------------------------------
    ' SECOND ENTITY
    '--------------------------------------------------------------------------

    Set Entry2 = New clsLedgerEntry

    Entry2.LedgerID = LedgerID2
    Entry2.EntryDate = Date
    Entry2.DocumentNo = "TEST-125-B"
    Entry2.ReceiptInvoice = "TEST-B-125"
    Entry2.Description = "TEST-125 Ýkinci Kayýt"
    Entry2.IncomeType = "TEST GELÝR 2"
    Entry2.ExpenseType = ""
    Entry2.IncomeAmount = CCur(200)
    Entry2.ExpenseAmount = CCur(0)
    Entry2.CashAmount = CCur(200)
    Entry2.BankAmount = CCur(0)
    Entry2.BalanceAmount = CCur(300)


    '--------------------------------------------------------------------------
    ' SECOND ADD
    '--------------------------------------------------------------------------

    If Not Repo.Add(Entry2) Then

        Err.Raise _
            vbObjectError + 12504, _
            "TEST-125", _
            "Ýkinci Ledger kaydý oluþturulamadý."

    End If


    '--------------------------------------------------------------------------
    ' GET ALL
    '--------------------------------------------------------------------------

    Set Entries = Repo.GetAll

    If Entries Is Nothing Then

        Err.Raise _
            vbObjectError + 12505, _
            "TEST-125", _
            "GetAll Nothing döndürdü."

    End If


    If Entries.Count < 2 Then

        Err.Raise _
            vbObjectError + 12506, _
            "TEST-125", _
            "GetAll oluþturulan iki test kaydýný döndürmedi."

    End If


    '--------------------------------------------------------------------------
    ' GET ALL ÝÇÝN KAYITLARI BUL
    '--------------------------------------------------------------------------

    Dim Index As Long

    For Index = 1 To Entries.Count

        Set LoadedEntry = Entries(Index)

        If LoadedEntry.LedgerID = LedgerID1 Then

            FoundID1 = True

        End If

        If LoadedEntry.LedgerID = LedgerID2 Then

            FoundID2 = True

        End If

    Next Index


    If Not FoundID1 Then

        Err.Raise _
            vbObjectError + 12507, _
            "TEST-125", _
            "GetAll içinde birinci Ledger kaydý bulunamadý."

    End If


    If Not FoundID2 Then

        Err.Raise _
            vbObjectError + 12508, _
            "TEST-125", _
            "GetAll içinde ikinci Ledger kaydý bulunamadý."

    End If


    '--------------------------------------------------------------------------
    ' DELETE FIRST
    '--------------------------------------------------------------------------

    If Not Repo.DeleteByID(LedgerID1) Then

        Err.Raise _
            vbObjectError + 12509, _
            "TEST-125", _
            "Birinci Ledger kaydý DeleteByID ile silinemedi."

    End If


    '--------------------------------------------------------------------------
    ' DELETE SECOND
    '--------------------------------------------------------------------------

    If Not Repo.DeleteByID(LedgerID2) Then

        Err.Raise _
            vbObjectError + 12510, _
            "TEST-125", _
            "Ýkinci Ledger kaydý DeleteByID ile silinemedi."

    End If


    '--------------------------------------------------------------------------
    ' DELETE KONTROLÜ - FIRST
    '--------------------------------------------------------------------------

    Set LoadedEntry = Repo.GetByID(LedgerID1)

    If Not LoadedEntry Is Nothing Then

        Err.Raise _
            vbObjectError + 12511, _
            "TEST-125", _
            "Birinci test kaydý cleanup sonrasýnda hâlâ mevcut."

    End If


    '--------------------------------------------------------------------------
    ' DELETE KONTROLÜ - SECOND
    '--------------------------------------------------------------------------

    Set LoadedEntry = Repo.GetByID(LedgerID2)

    If Not LoadedEntry Is Nothing Then

        Err.Raise _
            vbObjectError + 12512, _
            "TEST-125", _
            "Ýkinci test kaydý cleanup sonrasýnda hâlâ mevcut."

    End If


    '--------------------------------------------------------------------------
    ' BAÞARILI
    '--------------------------------------------------------------------------

    Debug.Print "LedgerID 1        : " & LedgerID1
    Debug.Print "LedgerID 2        : " & LedgerID2
    Debug.Print "GetNextLedgerID   : BAÞARILI"
    Debug.Print "Add x2             : BAÞARILI"
    Debug.Print "GetAll             : BAÞARILI"
    Debug.Print "DeleteByID x2      : BAÞARILI"
    Debug.Print "Cleanup             : BAÞARILI"
    Debug.Print "TEST-125 BAÞARILI"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-125 BAÞARILI" & vbCrLf & vbCrLf & _
        "GetNextLedgerID : BAÞARILI" & vbCrLf & _
        "Add x2           : BAÞARILI" & vbCrLf & _
        "GetAll           : BAÞARILI" & vbCrLf & _
        "DeleteByID x2    : BAÞARILI" & vbCrLf & _
        "Cleanup          : BAÞARILI", _
        vbInformation, _
        "OAA - TEST-125"


    Set LoadedEntry = Nothing
    Set Entries = Nothing
    Set Entry1 = Nothing
    Set Entry2 = Nothing
    Set Repo = Nothing

    Exit Sub


'==============================================================================
' BEKLENMEYEN HATA
'==============================================================================

UnexpectedError:

    On Error Resume Next

    If LedgerID1 > 0 Then
        Repo.DeleteByID LedgerID1
    End If

    If LedgerID2 > 0 Then
        Repo.DeleteByID LedgerID2
    End If

    On Error GoTo 0


    Debug.Print "TEST-125 BAÞARISIZ"
    Debug.Print "Hata No : " & Err.Number
    Debug.Print "Açýklama: " & Err.Description
    Debug.Print "Cleanup : Uygulandý"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-125 BAÞARISIZ" & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Varsa test kayýtlarý temizlendi.", _
        vbCritical, _
        "OAA - TEST-125"


    Set LoadedEntry = Nothing
    Set Entries = Nothing
    Set Entry1 = Nothing
    Set Entry2 = Nothing
    Set Repo = Nothing

End Sub

'==============================================================================
' TEST-126
' Ledger Service - AddEntry / GetEntry / DeleteEntry
'
' Amaç:
'   clsLedgerService temel kayýt yaþam döngüsünü doðrulamak.
'
' Kapsam:
'   AddEntry
'   GetEntry
'   DeleteEntry
'
' Test verisi:
'   Geçici Ledger kaydý.
'
' Cleanup:
'   Test sonunda kayýt mutlaka silinir.
'==============================================================================

Public Sub TEST_126_LedgerServiceBasicCRUD()

    Dim Service As clsLedgerService
    Dim Entry As clsLedgerEntry
    Dim LoadedEntry As clsLedgerEntry

    Dim TestLedgerID As Long

    On Error GoTo UnexpectedError

    Debug.Print String(70, "=")
    Debug.Print "TEST-126 - Ledger Service Basic CRUD"
    Debug.Print String(70, "=")


    '--------------------------------------------------------------------------
    ' SERVICE
    '--------------------------------------------------------------------------

    Set Service = New clsLedgerService


    '--------------------------------------------------------------------------
    ' ENTITY
    '--------------------------------------------------------------------------

    Set Entry = New clsLedgerEntry

    Entry.EntryDate = Date
    Entry.DocumentNo = "TEST-126"
    Entry.ReceiptInvoice = "TEST-SERVICE-126"
    Entry.Description = "TEST-126 Ledger Service"
    Entry.IncomeType = "TEST GELÝR"
    Entry.ExpenseType = ""
    Entry.IncomeAmount = CCur(250)
    Entry.ExpenseAmount = CCur(0)
    Entry.CashAmount = CCur(250)
    Entry.BankAmount = CCur(0)
    Entry.BalanceAmount = CCur(250)


    '--------------------------------------------------------------------------
    ' ADD ENTRY
    '
    ' LedgerID özellikle verilmez.
    ' Service'in Repository üzerinden ID üretmesi doðrulanýr.
    '--------------------------------------------------------------------------

    If Not Service.AddEntry(Entry) Then

        Err.Raise _
            vbObjectError + 12601, _
            "TEST-126", _
            "Ledger kaydý Service.AddEntry ile oluþturulamadý."

    End If


    TestLedgerID = Entry.LedgerID


    If TestLedgerID <= 0 Then

        Err.Raise _
            vbObjectError + 12602, _
            "TEST-126", _
            "Service tarafýndan geçerli LedgerID oluþturulmadý."

    End If


    '--------------------------------------------------------------------------
    ' GET ENTRY
    '--------------------------------------------------------------------------

    Set LoadedEntry = Service.GetEntry(TestLedgerID)

    If LoadedEntry Is Nothing Then

        Err.Raise _
            vbObjectError + 12603, _
            "TEST-126", _
            "Oluþturulan kayýt Service.GetEntry ile bulunamadý."

    End If


    '--------------------------------------------------------------------------
    ' ALAN KONTROLLERÝ
    '--------------------------------------------------------------------------

    If LoadedEntry.LedgerID <> TestLedgerID Then

        Err.Raise _
            vbObjectError + 12604, _
            "TEST-126", _
            "LedgerID doðru okunamadý."

    End If


    If LoadedEntry.DocumentNo <> "TEST-126" Then

        Err.Raise _
            vbObjectError + 12605, _
            "TEST-126", _
            "DocumentNo doðru okunamadý."

    End If


    If LoadedEntry.Description <> "TEST-126 Ledger Service" Then

        Err.Raise _
            vbObjectError + 12606, _
            "TEST-126", _
            "Description doðru okunamadý."

    End If


    If LoadedEntry.IncomeAmount <> CCur(250) Then

        Err.Raise _
            vbObjectError + 12607, _
            "TEST-126", _
            "IncomeAmount doðru okunamadý."

    End If


    If LoadedEntry.CashAmount <> CCur(250) Then

        Err.Raise _
            vbObjectError + 12608, _
            "TEST-126", _
            "CashAmount doðru okunamadý."

    End If


    If LoadedEntry.BalanceAmount <> CCur(250) Then

        Err.Raise _
            vbObjectError + 12609, _
            "TEST-126", _
            "BalanceAmount doðru okunamadý."

    End If


    '--------------------------------------------------------------------------
    ' DELETE ENTRY
    '--------------------------------------------------------------------------

    If Not Service.DeleteEntry(TestLedgerID) Then

        Err.Raise _
            vbObjectError + 12610, _
            "TEST-126", _
            "Ledger kaydý Service.DeleteEntry ile silinemedi."

    End If


    '--------------------------------------------------------------------------
    ' DELETE KONTROLÜ
    '--------------------------------------------------------------------------

    Set LoadedEntry = Service.GetEntry(TestLedgerID)

    If Not LoadedEntry Is Nothing Then

        Err.Raise _
            vbObjectError + 12611, _
            "TEST-126", _
            "Test kaydý silme iþleminden sonra hâlâ mevcut."

    End If


    '--------------------------------------------------------------------------
    ' BAÞARILI
    '--------------------------------------------------------------------------

    Debug.Print "AddEntry          : BAÞARILI"
    Debug.Print "LedgerID üretimi  : BAÞARILI"
    Debug.Print "GetEntry          : BAÞARILI"
    Debug.Print "Alan kontrolleri  : BAÞARILI"
    Debug.Print "DeleteEntry       : BAÞARILI"
    Debug.Print "Cleanup           : BAÞARILI"
    Debug.Print "TEST-126 BAÞARILI"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-126 BAÞARILI" & vbCrLf & vbCrLf & _
        "AddEntry         : BAÞARILI" & vbCrLf & _
        "LedgerID üretimi : BAÞARILI" & vbCrLf & _
        "GetEntry         : BAÞARILI" & vbCrLf & _
        "Alan kontrolleri : BAÞARILI" & vbCrLf & _
        "DeleteEntry      : BAÞARILI" & vbCrLf & _
        "Cleanup          : BAÞARILI", _
        vbInformation, _
        "OAA - TEST-126"


    Set LoadedEntry = Nothing
    Set Entry = Nothing
    Set Service = Nothing

    Exit Sub


'==============================================================================
' BEKLENMEYEN HATA
'==============================================================================

UnexpectedError:

    On Error Resume Next

    If TestLedgerID > 0 Then

        Service.DeleteEntry TestLedgerID

    End If

    On Error GoTo 0


    Debug.Print "TEST-126 BAÞARISIZ"
    Debug.Print "Hata No : " & Err.Number
    Debug.Print "Açýklama: " & Err.Description
    Debug.Print "Cleanup : Uygulandý"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-126 BAÞARISIZ" & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Varsa test kaydý temizlendi.", _
        vbCritical, _
        "OAA - TEST-126"


    Set LoadedEntry = Nothing
    Set Entry = Nothing
    Set Service = Nothing

End Sub

'==============================================================================
' TEST-127
' Receipt Service -> Ledger Entegrasyonu
'
' Amaç:
'   Baþarýlý bir tahsilat iþleminin hem Receipt hem de Ledger kayýtlarýný
'   oluþturduðunu doðrulamak.
'
' Test verisi:
'
'   MemberID : 3
'   ChargeID : 1
'
'   ChargeID 1 -> MemberID 3
'
'   Receipt:
'       Series        = A
'       ReceiptNumber = 990127
'       Amount        = 0,01
'       PaymentMethod = Nakit
'
'==============================================================================

Public Sub TEST_127_ReceiptToLedgerIntegration()

    Dim ReceiptService As clsReceiptService
    Dim LedgerService As clsLedgerService

    Dim Receipt As clsReceipt
    Dim LoadedReceipt As clsReceipt

    Dim LedgerEntries As Collection
    Dim LedgerEntry As clsLedgerEntry

    Dim MemberID As Long
    Dim ChargeID As Long

    Dim TestReceiptID As Long
    Dim TestLedgerID As Long

    Dim PreviousBalance As Currency
    Dim ExpectedBalance As Currency
    Dim TestAmount As Currency

    Dim OutstandingAmount As Currency

    Dim FoundLedger As Boolean
    Dim I As Long

    Dim ErrorNumber As Long
    Dim ErrorDescription As String


    On Error GoTo TestError


    '==========================================================================
    ' TEST VERÝLERÝ
    '==========================================================================

    ' ChargeID = 1 gerçek test verisinde MemberID = 3'e aittir.
    MemberID = 3
    ChargeID = 1

    TestAmount = CCur(0.01)


    Debug.Print String(70, "=")
    Debug.Print "TEST-127 - Receipt -> Ledger Integration"
    Debug.Print String(70, "=")


    '==========================================================================
    ' SERVICE'LER
    '==========================================================================

    Set ReceiptService = New clsReceiptService
    Set LedgerService = New clsLedgerService


    '==========================================================================
    ' TEST BORCU KONTROLÜ
    '==========================================================================

    OutstandingAmount = _
        ReceiptService.GetChargeOutstandingAmount(ChargeID)


    Debug.Print "MemberID          : " & MemberID
    Debug.Print "ChargeID          : " & ChargeID
    Debug.Print "Kalan Borç        : " & _
                Format$(OutstandingAmount, "#,##0.00")
    Debug.Print "Test Tutarý       : " & _
                Format$(TestAmount, "#,##0.00")


    If OutstandingAmount <= 0 Then

        Err.Raise _
            vbObjectError + 12701, _
            "TEST-127", _
            "ChargeID 1 için tahsil edilebilir kalan borç bulunamadý."

    End If


    If OutstandingAmount < TestAmount Then

        Err.Raise _
            vbObjectError + 12702, _
            "TEST-127", _
            "Test tutarý ChargeID 1 kalan borcundan büyük."

    End If


    '==========================================================================
    ' ÖNCEKÝ LEDGER BAKÝYESÝ
    '==========================================================================

    PreviousBalance = _
        LedgerService.GetCurrentBalance


    Debug.Print "Önceki Ledger Bakiyesi : " & _
                Format$(PreviousBalance, "#,##0.00")


    '==========================================================================
    ' TEST RECEIPT ENTITY
    '==========================================================================

    Set Receipt = New clsReceipt


    Receipt.Series = "A"
    Receipt.ReceiptNumber = 990127
    Receipt.ReceiptDate = Date
    Receipt.MemberID = MemberID
    Receipt.ChargeID = ChargeID
    Receipt.Amount = TestAmount
    Receipt.PaymentMethod = "Nakit"


    '==========================================================================
    ' RECEIPT OLUÞTUR
    '==========================================================================

    TestReceiptID = _
        ReceiptService.AddReceipt(Receipt)


    If TestReceiptID <= 0 Then

        Err.Raise _
            vbObjectError + 12703, _
            "TEST-127", _
            "ReceiptService.AddReceipt baþarýlý bir Receipt oluþturamadý."

    End If


    Debug.Print "Oluþturulan ReceiptID : " & _
                TestReceiptID


    '==========================================================================
    ' ENTITY RECEIPT ID KONTROLÜ
    '==========================================================================

    If Receipt.ReceiptID <> TestReceiptID Then

        Err.Raise _
            vbObjectError + 12704, _
            "TEST-127", _
            "Receipt Entity üzerindeki ReceiptID hatalý."

    End If


    '==========================================================================
    ' RECEIPT'I GERÝ OKU
    '==========================================================================

    Set LoadedReceipt = _
        ReceiptService.GetReceipt(TestReceiptID)


    If LoadedReceipt Is Nothing Then

        Err.Raise _
            vbObjectError + 12705, _
            "TEST-127", _
            "Oluþturulan Receipt Service üzerinden okunamadý."

    End If


    '==========================================================================
    ' RECEIPT ALAN KONTROLLERÝ
    '==========================================================================

    If LoadedReceipt.MemberID <> MemberID Then

        Err.Raise _
            vbObjectError + 12706, _
            "TEST-127", _
            "Receipt MemberID hatalý."

    End If


    If LoadedReceipt.ChargeID <> ChargeID Then

        Err.Raise _
            vbObjectError + 12707, _
            "TEST-127", _
            "Receipt ChargeID hatalý."

    End If


    If LoadedReceipt.Amount <> TestAmount Then

        Err.Raise _
            vbObjectError + 12708, _
            "TEST-127", _
            "Receipt Amount hatalý."

    End If


    If LoadedReceipt.PaymentMethod <> "Nakit" Then

        Err.Raise _
            vbObjectError + 12709, _
            "TEST-127", _
            "Receipt PaymentMethod hatalý."

    End If


    If LoadedReceipt.Series <> "A" Then

        Err.Raise _
            vbObjectError + 12710, _
            "TEST-127", _
            "Receipt Series hatalý."

    End If


    If LoadedReceipt.ReceiptNumber <> 990127 Then

        Err.Raise _
            vbObjectError + 12711, _
            "TEST-127", _
            "ReceiptNumber hatalý."

    End If


    '==========================================================================
    ' BEKLENEN LEDGER BAKÝYESÝ
    '==========================================================================

    ExpectedBalance = _
        PreviousBalance + TestAmount


    '==========================================================================
    ' LEDGER KAYITLARINI OKU
    '==========================================================================

    Set LedgerEntries = _
        LedgerService.GetAllEntries


    If LedgerEntries Is Nothing Then

        Err.Raise _
            vbObjectError + 12712, _
            "TEST-127", _
            "Ledger kayýtlarý okunamadý."

    End If


    '==========================================================================
    ' TEST RECEIPT'E AÝT LEDGER KAYDINI BUL
    '==========================================================================

    FoundLedger = False
    TestLedgerID = 0


    For I = 1 To LedgerEntries.Count

        Set LedgerEntry = LedgerEntries(I)


        If Not LedgerEntry Is Nothing Then

            If LedgerEntry.DocumentNo = "A-990127" Then

                FoundLedger = True
                TestLedgerID = LedgerEntry.LedgerID

                Exit For

            End If

        End If

    Next I


    '==========================================================================
    ' LEDGER OLUÞTU MU?
    '==========================================================================

    If Not FoundLedger Then

        Err.Raise _
            vbObjectError + 12713, _
            "TEST-127", _
            "Receipt oluþturuldu ancak karþýlýk gelen Ledger kaydý bulunamadý."

    End If


    If TestLedgerID <= 0 Then

        Err.Raise _
            vbObjectError + 12714, _
            "TEST-127", _
            "Ledger kaydý bulundu ancak geçerli LedgerID yok."

    End If


    Debug.Print "Oluþturulan LedgerID : " & _
                TestLedgerID


    '==========================================================================
    ' LEDGER ALAN KONTROLLERÝ
    '==========================================================================

    If LedgerEntry.DocumentNo <> "A-990127" Then

        Err.Raise _
            vbObjectError + 12715, _
            "TEST-127", _
            "Ledger DocumentNo hatalý."

    End If


    If LedgerEntry.ReceiptInvoice <> "A-990127" Then

        Err.Raise _
            vbObjectError + 12716, _
            "TEST-127", _
            "Ledger ReceiptInvoice hatalý."

    End If


    '--------------------------------------------------------------------------
    ' GELÝR
    '--------------------------------------------------------------------------

    If LedgerEntry.IncomeAmount <> TestAmount Then

        Err.Raise _
            vbObjectError + 12717, _
            "TEST-127", _
            "Ledger IncomeAmount Receipt tutarýyla eþleþmiyor."

    End If


    '--------------------------------------------------------------------------
    ' GÝDER
    '--------------------------------------------------------------------------

    If LedgerEntry.ExpenseAmount <> CCur(0) Then

        Err.Raise _
            vbObjectError + 12718, _
            "TEST-127", _
            "Tahsilat Ledger kaydýnda ExpenseAmount sýfýr deðil."

    End If


    '--------------------------------------------------------------------------
    ' NAKÝT -> KASA
    '--------------------------------------------------------------------------

    If LedgerEntry.CashAmount <> TestAmount Then

        Err.Raise _
            vbObjectError + 12719, _
            "TEST-127", _
            "Nakit tahsilatta CashAmount Receipt tutarýyla eþleþmiyor."

    End If


    '--------------------------------------------------------------------------
    ' NAKÝT -> BANKA SIFIR
    '--------------------------------------------------------------------------

    If LedgerEntry.BankAmount <> CCur(0) Then

        Err.Raise _
            vbObjectError + 12720, _
            "TEST-127", _
            "Nakit tahsilatta BankAmount sýfýr olmalýdýr."

    End If


    '--------------------------------------------------------------------------
    ' BAKÝYE
    '--------------------------------------------------------------------------

    If LedgerEntry.BalanceAmount <> ExpectedBalance Then

        Err.Raise _
            vbObjectError + 12721, _
            "TEST-127", _
            "Ledger BalanceAmount beklenen deðere eþit deðil." & _
            vbCrLf & _
            "Beklenen: " & _
            Format$(ExpectedBalance, "#,##0.00") & _
            vbCrLf & _
            "Gerçek: " & _
            Format$(LedgerEntry.BalanceAmount, "#,##0.00")

    End If


    '==========================================================================
    ' RECEIPT -> LEDGER TUTAR EÞÝTLÝÐÝ
    '==========================================================================

    If LoadedReceipt.Amount <> LedgerEntry.IncomeAmount Then

        Err.Raise _
            vbObjectError + 12722, _
            "TEST-127", _
            "Receipt.Amount ile Ledger.IncomeAmount eþit deðil."

    End If


    '==========================================================================
    ' LEDGER'I SERVICE ÜZERÝNDEN TEKRAR OKU
    '==========================================================================

    Set LedgerEntry = _
        LedgerService.GetEntry(TestLedgerID)


    If LedgerEntry Is Nothing Then

        Err.Raise _
            vbObjectError + 12723, _
            "TEST-127", _
            "LedgerService.GetEntry ile oluþturulan Ledger okunamadý."

    End If


    '==========================================================================
    ' CLEANUP - LEDGER
    '==========================================================================

    If Not LedgerService.DeleteEntry(TestLedgerID) Then

        Err.Raise _
            vbObjectError + 12724, _
            "TEST-127", _
            "Test Ledger kaydý cleanup sýrasýnda silinemedi."

    End If


    '==========================================================================
    ' CLEANUP - RECEIPT
    '==========================================================================

    If Not ReceiptService.DeleteReceipt(TestReceiptID) Then

        Err.Raise _
            vbObjectError + 12725, _
            "TEST-127", _
            "Test Receipt kaydý cleanup sýrasýnda silinemedi."

    End If


    '==========================================================================
    ' RECEIPT CLEANUP KONTROLÜ
    '==========================================================================

    Set LoadedReceipt = _
        ReceiptService.GetReceipt(TestReceiptID)


    If Not LoadedReceipt Is Nothing Then

        Err.Raise _
            vbObjectError + 12726, _
            "TEST-127", _
            "Receipt cleanup sonrasýnda test kaydý hâlâ mevcut."

    End If


    '==========================================================================
    ' LEDGER CLEANUP KONTROLÜ
    '==========================================================================

    Set LedgerEntry = _
        LedgerService.GetEntry(TestLedgerID)


    If Not LedgerEntry Is Nothing Then

        Err.Raise _
            vbObjectError + 12727, _
            "TEST-127", _
            "Ledger cleanup sonrasýnda test kaydý hâlâ mevcut."

    End If


    '==========================================================================
    ' BAÞARILI
    '==========================================================================

    Debug.Print "Receipt oluþturma        : BAÞARILI"
    Debug.Print "Receipt alan kontrolleri: BAÞARILI"
    Debug.Print "Ledger oluþturma        : BAÞARILI"
    Debug.Print "IncomeAmount             : BAÞARILI"
    Debug.Print "CashAmount               : BAÞARILI"
    Debug.Print "BankAmount               : BAÞARILI"
    Debug.Print "BalanceAmount            : BAÞARILI"
    Debug.Print "Receipt -> Ledger        : BAÞARILI"
    Debug.Print "Receipt cleanup          : BAÞARILI"
    Debug.Print "Ledger cleanup           : BAÞARILI"
    Debug.Print "TEST-127 BAÞARILI"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-127 BAÞARILI" & vbCrLf & vbCrLf & _
        "Receipt oluþturma        : BAÞARILI" & vbCrLf & _
        "Ledger oluþturma         : BAÞARILI" & vbCrLf & _
        "Receipt -> Ledger        : BAÞARILI" & vbCrLf & _
        "IncomeAmount             : BAÞARILI" & vbCrLf & _
        "CashAmount               : BAÞARILI" & vbCrLf & _
        "BankAmount               : BAÞARILI" & vbCrLf & _
        "BalanceAmount            : BAÞARILI" & vbCrLf & _
        "Receipt cleanup          : BAÞARILI" & vbCrLf & _
        "Ledger cleanup           : BAÞARILI", _
        vbInformation, _
        "OAA - TEST-127"


    Set LedgerEntry = Nothing
    Set LedgerEntries = Nothing
    Set LoadedReceipt = Nothing
    Set Receipt = Nothing
    Set LedgerService = Nothing
    Set ReceiptService = Nothing

    Exit Sub


'==============================================================================
' TEST HATASI
'==============================================================================

TestError:

    ErrorNumber = Err.Number
    ErrorDescription = Err.Description


    '--------------------------------------------------------------------------
    ' HATA DURUMUNDA CLEANUP
    '--------------------------------------------------------------------------

    On Error Resume Next


    If TestLedgerID > 0 Then

        LedgerService.DeleteEntry TestLedgerID

    End If


    If TestReceiptID > 0 Then

        ReceiptService.DeleteReceipt TestReceiptID

    End If


    On Error GoTo 0


    Debug.Print "TEST-127 BAÞARISIZ"
    Debug.Print "Hata No : " & ErrorNumber
    Debug.Print "Açýklama: " & ErrorDescription
    Debug.Print "Cleanup : Uygulandý"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-127 BAÞARISIZ" & vbCrLf & vbCrLf & _
        "Hata No : " & ErrorNumber & vbCrLf & _
        "Açýklama: " & ErrorDescription & vbCrLf & vbCrLf & _
        "Varsa test kayýtlarý temizlendi.", _
        vbCritical, _
        "OAA - TEST-127"


    Set LedgerEntry = Nothing
    Set LedgerEntries = Nothing
    Set LoadedReceipt = Nothing
    Set Receipt = Nothing
    Set LedgerService = Nothing
    Set ReceiptService = Nothing

End Sub
'==============================================================================
' TEST-128
' Receipt Service -> Ledger Banka Entegrasyonu
'
' Amaç:
'   Banka ödeme yöntemi ile oluþturulan bir tahsilatýn Ledger üzerinde:
'
'       IncomeAmount = Receipt.Amount
'       CashAmount   = 0
'       BankAmount   = Receipt.Amount
'
'   olarak oluþturulduðunu doðrulamak.
'
' Ayrýca:
'
'       Önceki Ledger Bakiyesi + Tahsilat
'
'   hesaplamasý doðrulanýr.
'
' Test verisi:
'
'   MemberID : 3
'   ChargeID : 1
'
'   Receipt:
'       Series        = A
'       ReceiptNumber = 990128
'       Amount        = 0,01
'       PaymentMethod = Banka
'
' Cleanup:
'   Test sonunda oluþturulan Receipt ve Ledger kayýtlarý silinir.
'
' Mevcut gerçek kayýtlar deðiþtirilmez.
'==============================================================================

Public Sub TEST_128_ReceiptToLedgerBankIntegration()

    Dim ReceiptService As clsReceiptService
    Dim LedgerService As clsLedgerService

    Dim Receipt As clsReceipt
    Dim LoadedReceipt As clsReceipt

    Dim LedgerEntries As Collection
    Dim LedgerEntry As clsLedgerEntry

    Dim MemberID As Long
    Dim ChargeID As Long

    Dim TestReceiptID As Long
    Dim TestLedgerID As Long

    Dim PreviousBalance As Currency
    Dim ExpectedBalance As Currency
    Dim TestAmount As Currency

    Dim OutstandingAmount As Currency

    Dim FoundLedger As Boolean
    Dim I As Long

    Dim ErrorNumber As Long
    Dim ErrorDescription As String


    On Error GoTo TestError


    '==========================================================================
    ' TEST VERÝLERÝ
    '==========================================================================

    MemberID = 3
    ChargeID = 1

    TestAmount = CCur(0.01)


    Debug.Print String(70, "=")
    Debug.Print "TEST-128 - Receipt -> Ledger Bank Integration"
    Debug.Print String(70, "=")


    '==========================================================================
    ' SERVICE'LER
    '==========================================================================

    Set ReceiptService = New clsReceiptService
    Set LedgerService = New clsLedgerService


    '==========================================================================
    ' BORÇ BAKÝYESÝ KONTROLÜ
    '==========================================================================

    OutstandingAmount = _
        ReceiptService.GetChargeOutstandingAmount(ChargeID)


    Debug.Print "MemberID          : " & MemberID
    Debug.Print "ChargeID          : " & ChargeID
    Debug.Print "Kalan Borç        : " & _
                Format$(OutstandingAmount, "#,##0.00")
    Debug.Print "Test Tutarý       : " & _
                Format$(TestAmount, "#,##0.00")


    If OutstandingAmount <= 0 Then

        Err.Raise _
            vbObjectError + 12801, _
            "TEST-128", _
            "ChargeID 1 için tahsil edilebilir kalan borç bulunamadý."

    End If


    If OutstandingAmount < TestAmount Then

        Err.Raise _
            vbObjectError + 12802, _
            "TEST-128", _
            "Test tutarý ChargeID 1 kalan borcundan büyük."

    End If


    '==========================================================================
    ' ÖNCEKÝ LEDGER BAKÝYESÝ
    '==========================================================================

    PreviousBalance = _
        LedgerService.GetCurrentBalance


    Debug.Print "Önceki Ledger Bakiyesi : " & _
                Format$(PreviousBalance, "#,##0.00")


    '==========================================================================
    ' TEST RECEIPT
    '==========================================================================

    Set Receipt = New clsReceipt


    Receipt.Series = "A"
    Receipt.ReceiptNumber = 990128
    Receipt.ReceiptDate = Date
    Receipt.MemberID = MemberID
    Receipt.ChargeID = ChargeID
    Receipt.Amount = TestAmount
    Receipt.PaymentMethod = "Banka"


    '==========================================================================
    ' RECEIPT OLUÞTUR
    '==========================================================================

    TestReceiptID = _
        ReceiptService.AddReceipt(Receipt)


    If TestReceiptID <= 0 Then

        Err.Raise _
            vbObjectError + 12803, _
            "TEST-128", _
            "ReceiptService.AddReceipt baþarýlý bir Receipt oluþturamadý."

    End If


    Debug.Print "Oluþturulan ReceiptID : " & _
                TestReceiptID


    '==========================================================================
    ' RECEIPT ENTITY ID KONTROLÜ
    '==========================================================================

    If Receipt.ReceiptID <> TestReceiptID Then

        Err.Raise _
            vbObjectError + 12804, _
            "TEST-128", _
            "Receipt Entity üzerindeki ReceiptID hatalý."

    End If


    '==========================================================================
    ' RECEIPT'I GERÝ OKU
    '==========================================================================

    Set LoadedReceipt = _
        ReceiptService.GetReceipt(TestReceiptID)


    If LoadedReceipt Is Nothing Then

        Err.Raise _
            vbObjectError + 12805, _
            "TEST-128", _
            "Oluþturulan Receipt Service üzerinden okunamadý."

    End If


    '==========================================================================
    ' RECEIPT ALAN KONTROLLERÝ
    '==========================================================================

    If LoadedReceipt.MemberID <> MemberID Then

        Err.Raise _
            vbObjectError + 12806, _
            "TEST-128", _
            "Receipt MemberID hatalý."

    End If


    If LoadedReceipt.ChargeID <> ChargeID Then

        Err.Raise _
            vbObjectError + 12807, _
            "TEST-128", _
            "Receipt ChargeID hatalý."

    End If


    If LoadedReceipt.Amount <> TestAmount Then

        Err.Raise _
            vbObjectError + 12808, _
            "TEST-128", _
            "Receipt Amount hatalý."

    End If


    If LoadedReceipt.PaymentMethod <> "Banka" Then

        Err.Raise _
            vbObjectError + 12809, _
            "TEST-128", _
            "Receipt PaymentMethod hatalý."

    End If


    If LoadedReceipt.Series <> "A" Then

        Err.Raise _
            vbObjectError + 12810, _
            "TEST-128", _
            "Receipt Series hatalý."

    End If


    If LoadedReceipt.ReceiptNumber <> 990128 Then

        Err.Raise _
            vbObjectError + 12811, _
            "TEST-128", _
            "ReceiptNumber hatalý."

    End If


    '==========================================================================
    ' BEKLENEN BAKÝYE
    '==========================================================================

    ExpectedBalance = _
        PreviousBalance + TestAmount


    '==========================================================================
    ' LEDGER KAYITLARINI OKU
    '==========================================================================

    Set LedgerEntries = _
        LedgerService.GetAllEntries


    If LedgerEntries Is Nothing Then

        Err.Raise _
            vbObjectError + 12812, _
            "TEST-128", _
            "Ledger kayýtlarý okunamadý."

    End If


    '==========================================================================
    ' TEST RECEIPT'E AÝT LEDGER KAYDINI BUL
    '==========================================================================

    FoundLedger = False
    TestLedgerID = 0


    For I = 1 To LedgerEntries.Count

        Set LedgerEntry = LedgerEntries(I)


        If Not LedgerEntry Is Nothing Then

            If LedgerEntry.DocumentNo = "A-990128" Then

                FoundLedger = True
                TestLedgerID = LedgerEntry.LedgerID

                Exit For

            End If

        End If

    Next I


    '==========================================================================
    ' LEDGER BULUNDU MU?
    '==========================================================================

    If Not FoundLedger Then

        Err.Raise _
            vbObjectError + 12813, _
            "TEST-128", _
            "Banka tahsilatý için Ledger kaydý bulunamadý."

    End If


    If TestLedgerID <= 0 Then

        Err.Raise _
            vbObjectError + 12814, _
            "TEST-128", _
            "Ledger kaydý bulundu ancak geçerli LedgerID yok."

    End If


    Debug.Print "Oluþturulan LedgerID : " & _
                TestLedgerID


    '==========================================================================
    ' LEDGER DOCUMENT NO
    '==========================================================================

    If LedgerEntry.DocumentNo <> "A-990128" Then

        Err.Raise _
            vbObjectError + 12815, _
            "TEST-128", _
            "Ledger DocumentNo hatalý."

    End If


    '==========================================================================
    ' LEDGER RECEIPT / INVOICE
    '==========================================================================

    If LedgerEntry.ReceiptInvoice <> "A-990128" Then

        Err.Raise _
            vbObjectError + 12816, _
            "TEST-128", _
            "Ledger ReceiptInvoice hatalý."

    End If


    '==========================================================================
    ' GELÝR TUTARI
    '==========================================================================

    If LedgerEntry.IncomeAmount <> TestAmount Then

        Err.Raise _
            vbObjectError + 12817, _
            "TEST-128", _
            "Ledger IncomeAmount Receipt tutarýyla eþleþmiyor."

    End If


    '==========================================================================
    ' GÝDER SIFIR
    '==========================================================================

    If LedgerEntry.ExpenseAmount <> CCur(0) Then

        Err.Raise _
            vbObjectError + 12818, _
            "TEST-128", _
            "Tahsilat Ledger kaydýnda ExpenseAmount sýfýr deðil."

    End If


    '==========================================================================
    ' BANKA TUTARI
    '
    ' TEST-128'in temel kontrolü.
    '==========================================================================

    If LedgerEntry.BankAmount <> TestAmount Then

        Err.Raise _
            vbObjectError + 12819, _
            "TEST-128", _
            "Banka tahsilatýnda BankAmount Receipt tutarýyla eþleþmiyor."

    End If


    '==========================================================================
    ' KASA SIFIR
    '==========================================================================

    If LedgerEntry.CashAmount <> CCur(0) Then

        Err.Raise _
            vbObjectError + 12820, _
            "TEST-128", _
            "Banka tahsilatýnda CashAmount sýfýr olmalýdýr."

    End If


    '==========================================================================
    ' BAKÝYE
    '==========================================================================

    If LedgerEntry.BalanceAmount <> ExpectedBalance Then

        Err.Raise _
            vbObjectError + 12821, _
            "TEST-128", _
            "Ledger BalanceAmount beklenen deðere eþit deðil." & _
            vbCrLf & _
            "Beklenen: " & _
            Format$(ExpectedBalance, "#,##0.00") & _
            vbCrLf & _
            "Gerçek: " & _
            Format$(LedgerEntry.BalanceAmount, "#,##0.00")

    End If


    '==========================================================================
    ' RECEIPT -> LEDGER TUTAR EÞÝTLÝÐÝ
    '==========================================================================

    If LoadedReceipt.Amount <> LedgerEntry.IncomeAmount Then

        Err.Raise _
            vbObjectError + 12822, _
            "TEST-128", _
            "Receipt.Amount ile Ledger.IncomeAmount eþit deðil."

    End If


    '==========================================================================
    ' LEDGER SERVICE GET ENTRY
    '==========================================================================

    Set LedgerEntry = _
        LedgerService.GetEntry(TestLedgerID)


    If LedgerEntry Is Nothing Then

        Err.Raise _
            vbObjectError + 12823, _
            "TEST-128", _
            "LedgerService.GetEntry ile Ledger okunamadý."

    End If


    '==========================================================================
    ' CLEANUP - LEDGER
    '==========================================================================

    If Not LedgerService.DeleteEntry(TestLedgerID) Then

        Err.Raise _
            vbObjectError + 12824, _
            "TEST-128", _
            "Test Ledger kaydý cleanup sýrasýnda silinemedi."

    End If


    '==========================================================================
    ' CLEANUP - RECEIPT
    '==========================================================================

    If Not ReceiptService.DeleteReceipt(TestReceiptID) Then

        Err.Raise _
            vbObjectError + 12825, _
            "TEST-128", _
            "Test Receipt kaydý cleanup sýrasýnda silinemedi."

    End If


    '==========================================================================
    ' RECEIPT CLEANUP KONTROLÜ
    '==========================================================================

    Set LoadedReceipt = _
        ReceiptService.GetReceipt(TestReceiptID)


    If Not LoadedReceipt Is Nothing Then

        Err.Raise _
            vbObjectError + 12826, _
            "TEST-128", _
            "Receipt cleanup sonrasýnda test kaydý hâlâ mevcut."

    End If


    '==========================================================================
    ' LEDGER CLEANUP KONTROLÜ
    '==========================================================================

    Set LedgerEntry = _
        LedgerService.GetEntry(TestLedgerID)


    If Not LedgerEntry Is Nothing Then

        Err.Raise _
            vbObjectError + 12827, _
            "TEST-128", _
            "Ledger cleanup sonrasýnda test kaydý hâlâ mevcut."

    End If


    '==========================================================================
    ' BAÞARILI
    '==========================================================================

    Debug.Print "Receipt oluþturma        : BAÞARILI"
    Debug.Print "Receipt alan kontrolleri: BAÞARILI"
    Debug.Print "Ledger oluþturma        : BAÞARILI"
    Debug.Print "IncomeAmount             : BAÞARILI"
    Debug.Print "BankAmount               : BAÞARILI"
    Debug.Print "CashAmount               : BAÞARILI"
    Debug.Print "BalanceAmount            : BAÞARILI"

'   Gercek uye kaydi degistirilmez.
'   Yeni uye olusturulmaz.
'   Uye silinmez.
'   Test tahakkuku olusmamasi beklenmektedir.
'
' BEKLENEN:
'
'   Hata kodu : 7202
'   ChargeID  : 0
'   Yeni kayit: YOK
'==============================================================================

Public Sub TEST_096()

    Dim Service As clsMemberChargeService
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim TestMemberID As Long

    Dim LeaveDate As Date
    Dim ChargeDate As Date
    Dim PeriodEndDate As Date

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim Amount As Currency

    Dim TestChargeID As Long

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    Dim ExpectedErrorNumber As Long
    Dim ExpectedMessage As String

    Dim Mesaj As String

    On Error GoTo TestError

    '==========================================================================
    ' 1 - SERVICE / REPOSITORY
    '==========================================================================

    Set Service = New clsMemberChargeService

    Set MemberRepo = New clsMemberRepository

    '==========================================================================
    ' 2 - MEVCUT UYELERI AL
    '
    ' Gercek Repository API kullaniliyor.
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Mesaj = "TEST-096 UYGULANAMADI." & vbCrLf & vbCrLf
        Mesaj = Mesaj & "Uye listesi alinamadi." & vbCrLf
        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "Gercek kullanici verileri degistirilmedi." & vbCrLf
        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-096"

        Exit Sub

    End If

    '==========================================================================
    ' 3 - ISTIFA DURUMUNDAKI UYEYI BUL
    '
    ' Yalnizca:
    '
    '   Status = Istifa
    '   LeaveDate > 0
    '
    ' olan uye kabul edilir.
    '==========================================================================

    TestMemberID = 0

    LeaveDate = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Ýstifa", _
                    vbTextCompare) = 0 Then

                If Member.LeaveDate > 0 Then

                    TestMemberID = Member.MemberID

                    LeaveDate = Member.LeaveDate

                    Exit For

                End If

            End If

        End If

    Next Member

    '==========================================================================
    ' 4 - UYGUN ISTIFA UYESI BULUNAMADI
    '==========================================================================

    If TestMemberID <= 0 Then

        Mesaj = "TEST-096 UYGULANAMADI." & vbCrLf & vbCrLf
        Mesaj = Mesaj & "LeaveDate bilgisi bulunan ISTIFA durumundaki"
        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "bir uye bulunamadi." & vbCrLf
        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "Yeni test uyesi olusturulmadi." & vbCrLf
        Mesaj = Mesaj & "Gercek uye verileri degistirilmedi." & vbCrLf
        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-096"

        Exit Sub

    End If

    '==========================================================================
    ' 5 - TEST PARAMETRELERI
    '
    ' ChargeDate kesin olarak LeaveDate sonrasidir.
    '==========================================================================

    ChargeDate = DateAdd("d", 1, LeaveDate)

    FiscalYear = Year(ChargeDate)

    DueMonth = Month(ChargeDate)

    PeriodEndDate = DateSerial(FiscalYear, 12, 31)

    Amount = 150@

    TestChargeID = 0

    ErrorOccurred = False

    ErrorNumber = 0

    ErrorDescription = vbNullString

    '==========================================================================
    ' 6 - BEKLENEN HATA
    '==========================================================================

    ExpectedErrorNumber = vbObjectError + 7202

    ExpectedMessage = _
        "Üye bu dönem için resmi aidata borçlandýrýlamaz."

    '==========================================================================
    ' 7 - GERCEK SERVICE CAGRISI
    '
    ' AddOfficialCharge gercek API'dir.
    '
    ' ChargeDate > LeaveDate oldugu icin 7202 beklenir.
    '==========================================================================

    On Error Resume Next

    Err.Clear

    TestChargeID = Service.AddOfficialCharge( _
        TestMemberID, _
        FiscalYear, _
        DueMonth, _
        ChargeDate, _
        Amount, _
        PeriodEndDate, _
        "TEST-096", _
        LeaveDate, _
        "TEST-096 - Istifa sonrasi resmi aidat testi")

    If Err.Number <> 0 Then

        ErrorOccurred = True

        ErrorNumber = Err.Number

        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 8 - HATA OLMALI
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 14601, _
                  "TEST_096", _
                  "Istifa tarihinden sonraki ChargeDate icin " & _
                  "AddOfficialCharge islemi reddetmedi."

    End If

    '==========================================================================
    ' 9 - CHARGEID OLUSMAMALI
    '==========================================================================

    If TestChargeID <> 0 Then

        Err.Raise vbObjectError + 14602, _
                  "TEST_096", _
                  "Reddedilmesi gereken islem icin ChargeID olustu." & _
                  vbCrLf & _
                  "ChargeID = " & TestChargeID

    End If

    '==========================================================================
    ' 10 - HATA NUMARASI KONTROLU
    '==========================================================================

    If ErrorNumber <> ExpectedErrorNumber Then

        Err.Raise vbObjectError + 14603, _
                  "TEST_096", _
                  "Beklenen hata kodu alinmadi." & _
                  vbCrLf & _
                  "Beklenen = " & ExpectedErrorNumber & _
                  vbCrLf & _
                  "Alinan   = " & ErrorNumber & _
                  vbCrLf & _
                  "Mesaj    = " & ErrorDescription

    End If

    '==========================================================================
    ' 11 - HATA MESAJI KONTROLU
    '==========================================================================

    If StrComp( _
            Trim$(ErrorDescription), _
            ExpectedMessage, _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 14604, _
                  "TEST_096", _
                  "Beklenen hata mesaji alinmadi." & _
                  vbCrLf & _
                  "Beklenen = " & ExpectedMessage & _
                  vbCrLf & _
                  "Alinan   = " & ErrorDescription

    End If

    '==========================================================================
    ' 12 - UYE HALA MEVCUT MU?
    '
    ' Test uye kaydini silmemelidir.
    '==========================================================================

    Set Member = MemberRepo.GetByID(TestMemberID)

    If Member Is Nothing Then

        Err.Raise vbObjectError + 14605, _
                  "TEST_096", _
                  "Test edilen uye test sonrasinda bulunamadi."

    End If

    '==========================================================================
    ' 13 - BASARILI MESAJ
    '==========================================================================

    Mesaj = "TEST-096 BASARILI." & vbCrLf & vbCrLf

    Mesaj = Mesaj & "Test edilen API : AddOfficialCharge" & vbCrLf

    Mesaj = Mesaj & "MemberID        : " & TestMemberID & vbCrLf

    Mesaj = Mesaj & "Status          : " & Member.Status & vbCrLf

    Mesaj = Mesaj & "LeaveDate       : " & _
                    Format$(LeaveDate, "dd.mm.yyyy") & vbCrLf

    Mesaj = Mesaj & "ChargeDate      : " & _
                    Format$(ChargeDate, "dd.mm.yyyy") & vbCrLf

    Mesaj = Mesaj & "FiscalYear      : " & FiscalYear & vbCrLf

    Mesaj = Mesaj & "DueMonth        : " & DueMonth & vbCrLf

    Mesaj = Mesaj & "Amount          : " & Amount & " TL" & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & "ChargeDate > LeaveDate : EVET" & vbCrLf

    Mesaj = Mesaj & "Service sonucu          : REDDEDILDI" & vbCrLf

    Mesaj = Mesaj & "Service kodu            : 7202" & vbCrLf

    Mesaj = Mesaj & "Err.Number              : " & ErrorNumber & vbCrLf

    Mesaj = Mesaj & "ChargeID                : 0" & vbCrLf

    Mesaj = Mesaj & "Yeni kayit              : YOK" & vbCrLf

    Mesaj = Mesaj & "Uye kaydi               : KORUNDU" & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & "Sonuc: BASARILI"

    MsgBox Mesaj, vbInformation, "OAA - TEST-096"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    Dim HataNo As Long
    Dim HataAciklama As String

    HataNo = Err.Number
    HataAciklama = Err.Description

    On Error Resume Next

    If TestChargeID > 0 Then

        DeleteTestCharge TestChargeID

    End If

    On Error GoTo 0

    Mesaj = "TEST-096 BASARISIZ." & vbCrLf & vbCrLf

    Mesaj = Mesaj & "Hata No : " & HataNo & vbCrLf

    Mesaj = Mesaj & "Aciklama: " & HataAciklama & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & "MemberID : " & TestMemberID & vbCrLf

    Mesaj = Mesaj & "ChargeID : " & TestChargeID & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & "Cleanup uygulanmaya calisildi."

    MsgBox Mesaj, vbCritical, "OAA - TEST-096"

End Sub



'==============================================================================
' TEST-097
'
' RESMI AIDAT - MUKERRER NORMAL TAHAKKUK
'
' AMAC:
'
'   Ayni uye + mali yil + ay + RESMI icin ikinci NORMAL tahakkukun
'   Service tarafindan reddedildigini dogrulamak.
'
' BEKLENEN:
'
'   Ilk AddOfficialCharge -> basarili
'   Ikinci AddOfficialCharge -> 7203
'   Yeni ikinci ChargeID -> 0
'
' TEST VERISI:
'
'   Mevcut AKTIF bir uye kullanilir.
'   2098 mali yilinda mevcut NORMAL RESMI tahakkuku olmayan
'   bir ay otomatik olarak bulunur.
'
' CLEANUP:
'
'   Ilk tahakkukun ChargeID degeri DeleteTestCharge ile temizlenir.
'
' GERCEK KURAL:
'
'   Ayný uye + mali yil + ay + RESMI icin
'   ikinci NORMAL tahakkuk olusturulamaz.
'==============================================================================

Public Sub TEST_097()

    Dim Service As clsMemberChargeService
    Dim MemberRepo As clsMemberRepository
    Dim ChargeRepo As clsMemberChargeRepository

    Dim Members As Collection
    Dim ChargesBefore As Collection
    Dim ChargesAfter As Collection

    Dim Member As clsMember

    Dim TestMemberID As Long
    Dim TestFiscalYear As Long
    Dim TestDueMonth As Long

    Dim TestChargeDate As Date
    Dim TestPeriodEndDate As Date
    Dim TestAmount As Currency

    Dim FirstChargeID As Long
    Dim SecondChargeID As Long

    Dim ChargeCountBefore As Long
    Dim ChargeCountAfter As Long

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    Dim ExpectedErrorNumber As Long
    Dim ExpectedMessage As String

    Dim Mesaj As String
    Dim HataNo As Long
    Dim HataAciklama As String

    Dim MonthFound As Boolean
    Dim MemberFound As Boolean

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set MemberRepo = New clsMemberRepository
    Set ChargeRepo = New clsMemberChargeRepository

    '==========================================================================
    ' 2 - MEVCUT AKTIF UYEYI BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Mesaj = "TEST-097 UYGULANAMADI." & vbCrLf & vbCrLf
        Mesaj = Mesaj & "Uye listesi alinamadi." & vbCrLf
        Mesaj = Mesaj & "Gercek kullanici verileri degistirilmedi." & vbCrLf
        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-097"

        Exit Sub

    End If

    MemberFound = False

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID

                MemberFound = True

                Exit For

            End If

        End If

    Next Member

    '==========================================================================
    ' 3 - AKTIF UYE BULUNAMADI
    '==========================================================================

    If Not MemberFound Then

        Mesaj = "TEST-097 UYGULANAMADI." & vbCrLf & vbCrLf
        Mesaj = Mesaj & "Aktif durumda bir uye bulunamadi." & vbCrLf
        Mesaj = Mesaj & "Yeni uye olusturulmadi." & vbCrLf
        Mesaj = Mesaj & "Gercek kullanici verileri degistirilmedi." & vbCrLf
        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-097"

        Exit Sub

    End If

    '==========================================================================
    ' 4 - TEST DONEMI
    '==========================================================================

    TestFiscalYear = 2098

    TestAmount = 150@

    TestPeriodEndDate = _
        DateSerial(TestFiscalYear, 12, 31)

    '==========================================================================
    ' 5 - 2098 ICINDE BOS RESMI AY BUL
    '
    ' Mevcut NORMAL RESMI kaydi olmayan ilk ay kullanilir.
    ' Böylece test gercek kullanici verileriyle cakisma yapmaz.
    '==========================================================================

    MonthFound = False

    For TestDueMonth = 1 To 12

        If Not ChargeRepo.ExistsNormalCharge( _
                TestMemberID, _
                TestFiscalYear, _
                TestDueMonth, _
                "RESMI") Then

            MonthFound = True

            Exit For

        End If

    Next TestDueMonth

    '==========================================================================
    ' 6 - BOS DONEM BULUNAMADI
    '==========================================================================

    If Not MonthFound Then

        Mesaj = "TEST-097 UYGULANAMADI." & vbCrLf & vbCrLf
        Mesaj = Mesaj & "Test uyesi icin 2098 yilinda" & vbCrLf
        Mesaj = Mesaj & "NORMAL RESMI tahakkuku bulunmayan ay yok." & vbCrLf
        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "Test icin mevcut kayitlar degistirilmedi." & vbCrLf
        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-097"

        Exit Sub

    End If

    '==========================================================================
    ' 7 - TEST TARIHI
    '==========================================================================

    TestChargeDate = _
        DateSerial(TestFiscalYear, TestDueMonth, 15)

    '==========================================================================
    ' 8 - TEST ONCESI KAYIT SAYISI
    '==========================================================================

    Set ChargesBefore = _
        ChargeRepo.GetByMemberID(TestMemberID)

    If ChargesBefore Is Nothing Then

        ChargeCountBefore = 0

    Else

        ChargeCountBefore = ChargesBefore.Count

    End If

    '==========================================================================
    ' 9 - ILK RESMI NORMAL TAHAKKUK
    '
    ' Ilk cagri basarili olmalidir.
    '==========================================================================

    FirstChargeID = 0

    On Error Resume Next

    Err.Clear

    FirstChargeID = Service.AddOfficialCharge( _
        TestMemberID, _
        TestFiscalYear, _
        TestDueMonth, _
        TestChargeDate, _
        TestAmount, _
        TestPeriodEndDate, _
        "TEST-097", _
        TestChargeDate, _
        "TEST-097 - Ilk NORMAL RESMI test kaydi")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorNumber = Err.Number
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 10 - ILK KAYIT OLUSMALI
    '==========================================================================

    If ErrorOccurred Then

        Err.Raise vbObjectError + 14701, _
                  "TEST_097", _
                  "Ilk NORMAL RESMI test tahakkuku olusturulamadi." & _
                  vbCrLf & _
                  "Err.Number = " & ErrorNumber & _
                  vbCrLf & _
                  "Mesaj = " & ErrorDescription

    End If

    If FirstChargeID <= 0 Then

        Err.Raise vbObjectError + 14702, _
                  "TEST_097", _
                  "Ilk NORMAL RESMI tahakkuk icin gecerli ChargeID olusmadi."

    End If

    '==========================================================================
    ' 11 - IKINCI AYNI TAHAKKUK
    '
    ' Ayni:
    '
    '   MemberID
    '   FiscalYear
    '   DueMonth
    '
    ' ile tekrar denenir.
    '
    ' BEKLENEN: 7203
    '==========================================================================

    SecondChargeID = 0

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString

    ExpectedErrorNumber = _
        vbObjectError + 7203

    ExpectedMessage = _
        "Bu üye için ayný döneme ait resmi aidat zaten tahakkuk edilmiþ."

    On Error Resume Next

    Err.Clear

    SecondChargeID = Service.AddOfficialCharge( _
        TestMemberID, _
        TestFiscalYear, _
        TestDueMonth, _
        TestChargeDate, _
        TestAmount, _
        TestPeriodEndDate, _
        "TEST-097-SECOND", _
        TestChargeDate, _
        "TEST-097 - Mukerrer NORMAL RESMI test")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorNumber = Err.Number
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 12 - IKINCI ISLEM HATA VERMELI
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 14703, _
                  "TEST_097", _
                  "Ayni donem icin ikinci NORMAL RESMI tahakkuk " & _
                  "reddedilmedi."

    End If

    '==========================================================================
    ' 13 - IKINCI CHARGEID OLUSMAMALI
    '==========================================================================

    If SecondChargeID <> 0 Then

        Err.Raise vbObjectError + 14704, _
                  "TEST_097", _
                  "Mükerrer tahakkuk reddedilmesine ragmen " & _
                  "ikinci ChargeID olustu." & _
                  vbCrLf & _
                  "ChargeID = " & SecondChargeID

    End If

    '==========================================================================
    ' 14 - HATA NUMARASI
    '==========================================================================

    If ErrorNumber <> ExpectedErrorNumber Then

        Err.Raise vbObjectError + 14705, _
                  "TEST_097", _
                  "Beklenen hata kodu alinmadi." & _
                  vbCrLf & _
                  "Beklenen : " & ExpectedErrorNumber & _
                  vbCrLf & _
                  "Alinan   : " & ErrorNumber & _
                  vbCrLf & _
                  "Mesaj    : " & ErrorDescription

    End If

    '==========================================================================
    ' 15 - HATA MESAJI
    '==========================================================================

    If StrComp( _
            Trim$(ErrorDescription), _
            ExpectedMessage, _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 14706, _
                  "TEST_097", _
                  "7203 hata mesaji beklenen metinle eslesmiyor." & _
                  vbCrLf & _
                  "Beklenen : " & ExpectedMessage & _
                  vbCrLf & _
                  "Alinan   : " & ErrorDescription

    End If

    '==========================================================================
    ' 16 - CLEANUP
    '
    ' Ilk test kaydini temizle.
    '==========================================================================

    If FirstChargeID > 0 Then

        DeleteTestCharge FirstChargeID

    End If

    '==========================================================================
    ' 17 - CLEANUP SONRASI KAYIT SAYISI
    '==========================================================================

    Set ChargesAfter = _
        ChargeRepo.GetByMemberID(TestMemberID)

    If ChargesAfter Is Nothing Then

        ChargeCountAfter = 0

    Else

        ChargeCountAfter = ChargesAfter.Count

    End If

    If ChargeCountAfter <> ChargeCountBefore Then

        Err.Raise vbObjectError + 14707, _
                  "TEST_097", _
                  "Cleanup sonrasinda kayit sayisi eski haline donmedi." & _
                  vbCrLf & _
                  "Onceki kayit sayisi : " & ChargeCountBefore & _
                  vbCrLf & _
                  "Sonraki kayit sayisi: " & ChargeCountAfter

    End If

    '==========================================================================
    ' 18 - BASARILI
    '==========================================================================

    Mesaj = "TEST-097 BASARILI." & vbCrLf & vbCrLf

    Mesaj = Mesaj & "Test edilen API : AddOfficialCharge" & vbCrLf

    Mesaj = Mesaj & "MemberID        : " & TestMemberID & vbCrLf

    Mesaj = Mesaj & "FiscalYear      : " & TestFiscalYear & vbCrLf

    Mesaj = Mesaj & "DueMonth        : " & TestDueMonth & vbCrLf

    Mesaj = Mesaj & "ChargeDate      : " & _
                    Format$(TestChargeDate, "dd.mm.yyyy") & vbCrLf

    Mesaj = Mesaj & "Amount          : " & TestAmount & " TL" & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & "Ilk ChargeID    : " & FirstChargeID & vbCrLf

    Mesaj = Mesaj & "Ilk tahakkuk    : BASARILI" & vbCrLf

    Mesaj = Mesaj & "Ikinci tahakkuk : REDDEDILDI" & vbCrLf

    Mesaj = Mesaj & "Service kodu    : 7203" & vbCrLf

    Mesaj = Mesaj & "Err.Number      : " & ErrorNumber & vbCrLf

    Mesaj = Mesaj & "Ikinci ChargeID : 0" & vbCrLf

    Mesaj = Mesaj & "Cleanup         : TAMAM" & vbCrLf

    Mesaj = Mesaj & "Kayit sayisi    : " & _
                    ChargeCountBefore & " -> " & _
                    ChargeCountAfter & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & "Sonuc: BASARILI"

    MsgBox Mesaj, vbInformation, "OAA - TEST-097"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    HataNo = Err.Number
    HataAciklama = Err.Description

    On Error Resume Next

    If FirstChargeID > 0 Then

        DeleteTestCharge FirstChargeID

    End If

    On Error GoTo 0

    Mesaj = "TEST-097 BASARISIZ." & vbCrLf & vbCrLf

    Mesaj = Mesaj & "Hata No : " & HataNo & vbCrLf

    Mesaj = Mesaj & "Aciklama: " & HataAciklama & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & "MemberID      : " & TestMemberID & vbCrLf

    Mesaj = Mesaj & "FiscalYear    : " & TestFiscalYear & vbCrLf

    Mesaj = Mesaj & "DueMonth      : " & TestDueMonth & vbCrLf

    Mesaj = Mesaj & "FirstChargeID  : " & FirstChargeID & vbCrLf

    Mesaj = Mesaj & "SecondChargeID : " & SecondChargeID & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & "Cleanup uygulanmaya calisildi."

    MsgBox Mesaj, vbCritical, "OAA - TEST-097"

End Sub



'==============================================================================
' TEST-080
'
' RESMÝ AÝDAT - PERIODENDDATE = CHARGEDATE SINIR DURUMU
'
' AMAÇ:
'
'   PeriodEndDate deðerinin ChargeDate deðerine EÞÝT olduðu durumda
'   resmi aidat tahakkukunun kabul edildiðini doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   PeriodEndDate < ChargeDate
'       -> 7237 RET
'
'   PeriodEndDate = ChargeDate
'       -> RET YOK
'
' TEST EDÝLEN SINIR:
'
'   ChargeDate    = 15.01.2098
'   PeriodEndDate = 15.01.2098
'
'   Yani:
'
'       PeriodEndDate = ChargeDate
'
' BEKLENEN:
'
'   1. Service hata vermemeli.
'   2. ChargeID > 0 olmalý.
'   3. RESMI / NORMAL kayýt oluþmalý.
'   4. ChargeDate doðru olmalý.
'   5. PeriodEndDate API tarafýndan kabul edilmeli.
'   6. Cleanup baþarýlý olmalý.
'
' NOT:
'
'   AddOfficialCharge gerçek PeriodEndDate parametresini kabul eder.
'   AddMeetingCharge kullanýlmamaktadýr.
'
' GERÇEK ÜYE VERÝSÝ:
'
'   Deðiþtirilmez.
'
' TEST VERÝSÝ:
'
'   Sadece geçici RESMI MemberCharge oluþturulur.
'
' CLEANUP:
'
'   Oluþturulan ChargeID silinir.
'==============================================================================

Public Sub TEST_080()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember
    Dim Charge As clsMemberCharge

    Dim TestMemberID As Long
    Dim TestChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim PeriodEndDate As Date
    Dim Amount As Currency

    Dim FoundMember As Boolean
    Dim FoundMonth As Boolean

    Dim MonthNo As Long

    Dim TestErrorNumber As Long
    Dim TestErrorDescription As String

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    TestMemberID = 0
    TestChargeID = 0

    FoundMember = False
    FoundMonth = False

    '==========================================================================
    ' 2 - GEÇERLÝ AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 13001, _
                  "TEST_080", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 13002, _
                  "TEST_080", _
                  "Üye listesi boþ."

    End If

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID
                FoundMember = True

                Exit For

            End If

        End If

    Next Member

    If Not FoundMember Then

        Err.Raise vbObjectError + 13003, _
                  "TEST_080", _
                  "TEST-080 için AKTÝF üye bulunamadý."

    End If

    '==========================================================================
    ' 3 - KULLANILMAMIÞ TEST DÖNEMÝ BUL
    '
    ' 2098 yýlý kullanýlýr.
    ' Böylece gerçek mevcut NORMAL RESMI kaydýyla çakýþma önlenir.
    '==========================================================================

    FiscalYear = 2098

    For MonthNo = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                MonthNo, _
                "RESMI") Then

            DueMonth = MonthNo
            FoundMonth = True

            Exit For

        End If

    Next MonthNo

    If Not FoundMonth Then

        MsgBox _
            "TEST-080 UYGULANAMADI." & vbCrLf & vbCrLf & _
            "2098 yýlýnda kullanýlmamýþ NORMAL RESMI dönem bulunamadý." & _
            vbCrLf & vbCrLf & _
            "Gerçek kullanýcý verileri deðiþtirilmedi." & vbCrLf & vbCrLf & _
            "Sonuç: TEST ÖN KOÞULU YOK", _
            vbExclamation, _
            "OAA - TEST-080"

        Exit Sub

    End If

    '==========================================================================
    ' 4 - TEST PARAMETRELERÝ
    '
    ' TESTÝN ANA NOKTASI:
    '
    '   PeriodEndDate = ChargeDate
    '==========================================================================

    ChargeDate = _
        DateSerial(FiscalYear, DueMonth, 15)

    PeriodEndDate = _
        ChargeDate

    Amount = 150@

    '==========================================================================
    ' 5 - SERVICE ÇAÐRISI
    '
    ' Gerçek API:
    '
    '   AddOfficialCharge
    '
    ' DecisionNo ve DecisionDate opsiyonel olarak geçerli deðerlerle
    ' gönderilmektedir.
    '==========================================================================

    TestChargeID = _
        Service.AddOfficialCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            PeriodEndDate, _
            "TEST-080", _
            ChargeDate, _
            "TEST-080 - PeriodEndDate eþitlik sýnýrý")

    '==========================================================================
    ' 6 - CHARGEID KONTROLÜ
    '==========================================================================

    If TestChargeID <= 0 Then

        Err.Raise vbObjectError + 13004, _
                  "TEST_080", _
                  "PeriodEndDate = ChargeDate olduðu halde " & _
                  "RESMI tahakkuk oluþturulamadý." & _
                  vbCrLf & _
                  "ChargeID = " & TestChargeID

    End If

    '==========================================================================
    ' 7 - KAYDI REPOSITORY'DEN OKU
    '==========================================================================

    Set Charge = Repo.GetByID(TestChargeID)

    If Charge Is Nothing Then

        Err.Raise vbObjectError + 13005, _
                  "TEST_080", _
                  "Oluþturulan RESMI kayýt Repository'den okunamadý." & _
                  vbCrLf & _
                  "ChargeID = " & TestChargeID

    End If

    '==========================================================================
    ' 8 - MEMBERID
    '==========================================================================

    If Charge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 13006, _
                  "TEST_080", _
                  "Kayýt MemberID deðeri hatalý."

    End If

    '==========================================================================
    ' 9 - CHARGETYPE
    '==========================================================================

    If StrComp( _
            Trim$(Charge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13007, _
                  "TEST_080", _
                  "Kayýt ChargeType deðeri RESMI deðil."

    End If

    '==========================================================================
    ' 10 - ADJUSTMENTTYPE
    '==========================================================================

    If StrComp( _
            Trim$(Charge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13008, _
                  "TEST_080", _
                  "Kayýt AdjustmentType deðeri NORMAL deðil."

    End If

    '==========================================================================
    ' 11 - FISCALYEAR
    '==========================================================================

    If Charge.FiscalYear <> FiscalYear Then

        Err.Raise vbObjectError + 13009, _
                  "TEST_080", _
                  "Kayýt FiscalYear deðeri hatalý."

    End If

    '==========================================================================
    ' 12 - DUEMONTH
    '==========================================================================

    If Charge.DueMonth <> DueMonth Then

        Err.Raise vbObjectError + 13010, _
                  "TEST_080", _
                  "Kayýt DueMonth deðeri hatalý."

    End If

    '==========================================================================
    ' 13 - CHARGEDATE
    '==========================================================================

    If Charge.ChargeDate <> ChargeDate Then

        Err.Raise vbObjectError + 13011, _
                  "TEST_080", _
                  "Kayýt ChargeDate deðeri hatalý."

    End If

    '==========================================================================
    ' 14 - AMOUNT
    '==========================================================================

    If Charge.Amount <> Amount Then

        Err.Raise vbObjectError + 13012, _
                  "TEST_080", _
                  "Kayýt Amount deðeri hatalý."

    End If

    '==========================================================================
    ' 15 - DECISIONNO
    '==========================================================================

    If StrComp( _
            Trim$(Charge.DecisionNo), _
            "TEST-080", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13013, _
                  "TEST_080", _
                  "DecisionNo deðeri hatalý."

    End If

    '==========================================================================
    ' 16 - DECISIONDATE
    '==========================================================================

    If Charge.DecisionDate <> ChargeDate Then

        Err.Raise vbObjectError + 13014, _
                  "TEST_080", _
                  "DecisionDate deðeri hatalý."

    End If

    '==========================================================================
    ' 17 - DESCRIPTION
    '==========================================================================

    If StrComp( _
            Trim$(Charge.Description), _
            "TEST-080 - PeriodEndDate eþitlik sýnýrý", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13015, _
                  "TEST_080", _
                  "Description deðeri hatalý."

    End If

    '==========================================================================
    ' 18 - STATUS
    '==========================================================================

    If StrComp( _
            Trim$(Charge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13016, _
                  "TEST_080", _
                  "Oluþturulan RESMI kaydýn Status deðeri AKTIF deðil."

    End If

    '==========================================================================
    ' 19 - CLEANUP
    '==========================================================================

    DeleteTestCharge TestChargeID

    '==========================================================================
    ' 20 - CLEANUP KONTROLÜ
    '==========================================================================

    Set Charge = Nothing

    Set Charge = Repo.GetByID(TestChargeID)

    If Not Charge Is Nothing Then

        Err.Raise vbObjectError + 13017, _
                  "TEST_080", _
                  "TEST-080 geçici kaydý cleanup sonrasýnda hâlâ mevcut." & _
                  vbCrLf & _
                  "ChargeID = " & TestChargeID

    End If

    '==========================================================================
    ' 21 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-080 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "Mali yýl         : " & FiscalYear & vbCrLf & _
        "Dönem ayý        : " & DueMonth & vbCrLf & _
        "ChargeID         : " & TestChargeID & vbCrLf & _
        "Amount           : " & Amount & " TL" & vbCrLf & vbCrLf & _
        "ChargeDate       : " & _
            Format$(ChargeDate, "dd.mm.yyyy") & vbCrLf & _
        "PeriodEndDate    : " & _
            Format$(PeriodEndDate, "dd.mm.yyyy") & vbCrLf & _
        "Tarih karþýlaþtýr : EÞÝT" & vbCrLf & _
        "Service sonucu    : KABUL" & vbCrLf & _
        "ChargeType        : RESMI" & vbCrLf & _
        "AdjustmentType    : NORMAL" & vbCrLf & _
        "Status            : AKTIF" & vbCrLf & _
        "Cleanup            : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-080"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    TestErrorNumber = Err.Number
    TestErrorDescription = Err.Description

    On Error Resume Next

    If TestChargeID > 0 Then

        DeleteTestCharge TestChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-080 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & TestErrorNumber & vbCrLf & _
        "Açýklama: " & TestErrorDescription & vbCrLf & vbCrLf & _
        "ChargeID: " & TestChargeID & vbCrLf & _
        "Cleanup uygulanmaya çalýþýldý.", _
        vbCritical, _
        "OAA - TEST-080"

End Sub


'==============================================================================
' TEST-081
'
' RESMI AÝDAT - AYNI DÖNEMDE MÜKERRER NORMAL TAHAKKUK REDDÝ
'
' AMAÇ:
'
'   Ayný üye + mali yýl + ay + RESMI için ikinci NORMAL tahakkukun
'   oluþturulamadýðýný doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   mChargeRepository.ExistsNormalCharge( _
'       MemberID, _
'       FiscalYear, _
'       DueMonth, _
'       "RESMI")
'
'   True ise:
'
'       Err.Raise vbObjectError + 7203, _
'                 "clsMemberChargeService.AddOfficialCharge", _
'                 "Bu üye için ayný döneme ait resmi aidat zaten tahakkuk edilmiþ."
'
' TEST AKIÞI:
'
'   1. Kullanýlmamýþ bir dönem bulunur.
'   2. Ýlk NORMAL RESMI tahakkuk oluþturulur.
'   3. Ýlk kayýt doðrulanýr.
'   4. Ayný parametrelerle ikinci NORMAL RESMI tahakkuk denenir.
'   5. Ýkinci iþlem 7203 ile reddedilmelidir.
'   6. Ýlk geçici kayýt cleanup edilir.
'
' BEKLENEN:
'
'   Ýlk kayýt:
'       Baþarýlý
'
'   Ýkinci kayýt:
'       Reddedilmeli
'
'   Service kodu:
'       7203
'
'   Gerçek VBA Err.Number:
'       vbObjectError + 7203
'
'   Hata mesajý:
'       Bu üye için ayný döneme ait resmi aidat zaten tahakkuk edilmiþ.
'
' GERÇEK ÜYE VERÝSÝ:
'
'   Deðiþtirilmez.
'
' CLEANUP:
'
'   Ýlk test kaydý ChargeID üzerinden silinir.
'
'   Ýkinci iþlem reddedildiði için ikinci ChargeID oluþmamalýdýr.
'==============================================================================

Public Sub TEST_081()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim FirstCharge As clsMemberCharge
    Dim SecondCharge As clsMemberCharge

    Dim TestMemberID As Long

    Dim FirstChargeID As Long
    Dim SecondChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim PeriodEndDate As Date
    Dim Amount As Currency

    Dim FoundMember As Boolean
    Dim FoundMonth As Boolean

    Dim MonthNo As Long

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    Dim ExpectedErrorNumber As Long

    Dim TestErrorNumber As Long
    Dim TestErrorDescription As String

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    TestMemberID = 0
    FirstChargeID = 0
    SecondChargeID = 0

    FoundMember = False
    FoundMonth = False

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString

    '==========================================================================
    ' 2 - BEKLENEN GERÇEK VBA HATA NUMARASI
    '
    ' Service kodu:
    '
    '   vbObjectError + 7203
    '
    ' olduðu için Err.Number doðrudan 7203 deðildir.
    '==========================================================================

    ExpectedErrorNumber = _
        vbObjectError + 7203

    '==========================================================================
    ' 3 - GEÇERLÝ AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 13101, _
                  "TEST_081", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 13102, _
                  "TEST_081", _
                  "Üye listesi boþ."

    End If

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID
                FoundMember = True

                Exit For

            End If

        End If

    Next Member

    If Not FoundMember Then

        Err.Raise vbObjectError + 13103, _
                  "TEST_081", _
                  "TEST-081 için AKTÝF üye bulunamadý."

    End If

    '==========================================================================
    ' 4 - KULLANILMAMIÞ RESMI DÖNEM BUL
    '
    ' 2098 yýlý kullanýlýr.
    ' Mevcut NORMAL RESMI kaydý olmayan ay seçilir.
    '==========================================================================

    FiscalYear = 2098

    For MonthNo = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                MonthNo, _
                "RESMI") Then

            DueMonth = MonthNo
            FoundMonth = True

            Exit For

        End If

    Next MonthNo

    If Not FoundMonth Then

        MsgBox _
            "TEST-081 UYGULANAMADI." & vbCrLf & vbCrLf & _
            "2098 yýlýnda kullanýlmamýþ NORMAL RESMI dönem bulunamadý." & _
            vbCrLf & vbCrLf & _
            "Gerçek kullanýcý verileri deðiþtirilmedi." & vbCrLf & vbCrLf & _
            "Sonuç: TEST ÖN KOÞULU YOK", _
            vbExclamation, _
            "OAA - TEST-081"

        Exit Sub

    End If

    '==========================================================================
    ' 5 - TEST PARAMETRELERÝ
    '==========================================================================

    ChargeDate = _
        DateSerial(FiscalYear, DueMonth, 15)

    PeriodEndDate = _
        DateSerial(FiscalYear, 12, 31)

    Amount = 150@

    '==========================================================================
    ' 6 - ÝLK NORMAL RESMI TAHAKKUK
    '
    ' Ýlk kayýt baþarýlý olmalýdýr.
    '==========================================================================

    FirstChargeID = _
        Service.AddOfficialCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            PeriodEndDate, _
            "TEST-081-1", _
            ChargeDate, _
            "TEST-081 - Ýlk NORMAL RESMI tahakkuk")

    If FirstChargeID <= 0 Then

        Err.Raise vbObjectError + 13104, _
                  "TEST_081", _
                  "Ýlk NORMAL RESMI tahakkuk oluþturulamadý."

    End If

    '==========================================================================
    ' 7 - ÝLK KAYDI REPOSITORY'DEN OKU
    '==========================================================================

    Set FirstCharge = _
        Repo.GetByID(FirstChargeID)

    If FirstCharge Is Nothing Then

        Err.Raise vbObjectError + 13105, _
                  "TEST_081", _
                  "Ýlk NORMAL RESMI kayýt Repository'den okunamadý."

    End If

    '==========================================================================
    ' 8 - ÝLK KAYIT KONTROLLERÝ
    '==========================================================================

    If FirstCharge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 13106, _
                  "TEST_081", _
                  "Ýlk kaydýn MemberID deðeri hatalý."

    End If

    If StrComp( _
            Trim$(FirstCharge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13107, _
                  "TEST_081", _
                  "Ýlk kaydýn ChargeType deðeri RESMI deðil."

    End If

    If StrComp( _
            Trim$(FirstCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13108, _
                  "TEST_081", _
                  "Ýlk kaydýn AdjustmentType deðeri NORMAL deðil."

    End If

    If FirstCharge.FiscalYear <> FiscalYear Then

        Err.Raise vbObjectError + 13109, _
                  "TEST_081", _
                  "Ýlk kaydýn FiscalYear deðeri hatalý."

    End If

    If FirstCharge.DueMonth <> DueMonth Then

        Err.Raise vbObjectError + 13110, _
                  "TEST_081", _
                  "Ýlk kaydýn DueMonth deðeri hatalý."

    End If

    If FirstCharge.Amount <> Amount Then

        Err.Raise vbObjectError + 13111, _
                  "TEST_081", _
                  "Ýlk kaydýn Amount deðeri hatalý."

    End If

    If StrComp( _
            Trim$(FirstCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13112, _
                  "TEST_081", _
                  "Ýlk kaydýn Status deðeri AKTIF deðil."

    End If

    '==========================================================================
    ' 9 - ÝKÝNCÝ AYNI NORMAL RESMI TAHAKKUK
    '
    ' Ayný:
    '
    '   MemberID
    '   FiscalYear
    '   DueMonth
    '   ChargeType = RESMI
    '   AdjustmentType = NORMAL
    '
    ' kullanýlýyor.
    '
    ' Beklenen:
    '
    '   7203
    '==========================================================================

    On Error Resume Next

    Err.Clear

    SecondChargeID = _
        Service.AddOfficialCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            PeriodEndDate, _
            "TEST-081-2", _
            ChargeDate, _
            "TEST-081 - Ýkinci NORMAL RESMI tahakkuk")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorNumber = Err.Number
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 10 - ÝKÝNCÝ ÝÞLEM REDDEDÝLMELÝ
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 13113, _
                  "TEST_081", _
                  "Ayný dönem için ikinci NORMAL RESMI tahakkuk " & _
                  "Service tarafýndan reddedilmedi." & _
                  vbCrLf & _
                  "Ýkinci ChargeID = " & SecondChargeID

    End If

    '==========================================================================
    ' 11 - ÝKÝNCÝ CHARGEID OLUÞMAMALI
    '==========================================================================

    If SecondChargeID <> 0 Then

        Err.Raise vbObjectError + 13114, _
                  "TEST_081", _
                  "Mükerrer iþlem reddedildiði halde ikinci ChargeID oluþtu." & _
                  vbCrLf & _
                  "SecondChargeID = " & SecondChargeID

    End If

    '==========================================================================
    ' 12 - HATA NUMARASI KONTROLÜ
    '==========================================================================

    If ErrorNumber = 0 Then

        Err.Raise vbObjectError + 13115, _
                  "TEST_081", _
                  "Mükerrer iþlem hata verdi ancak Err.Number alýnamadý."

    End If

    If ErrorNumber <> ExpectedErrorNumber Then

        Err.Raise vbObjectError + 13116, _
                  "TEST_081", _
                  "Beklenen VBA hata numarasý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen Service kodu : 7203" & _
                  vbCrLf & _
                  "Beklenen Err.Number  : " & ExpectedErrorNumber & _
                  vbCrLf & _
                  "Alýnan Err.Number    : " & ErrorNumber & _
                  vbCrLf & vbCrLf & _
                  "Hata mesajý:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 13 - HATA MESAJI KONTROLÜ
    '==========================================================================

    If StrComp( _
            Trim$(ErrorDescription), _
            "Bu üye için ayný döneme ait resmi aidat zaten tahakkuk edilmiþ.", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13117, _
                  "TEST_081", _
                  "7203 hata mesajý beklenen metinle eþleþmiyor." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen:" & vbCrLf & _
                  "Bu üye için ayný döneme ait resmi aidat zaten tahakkuk edilmiþ." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan:" & vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 14 - ÝKÝNCÝ KAYDIN GERÇEKTEN OLUÞMADIÐINI REPOSITORY'DEN KONTROL
    '
    ' SecondChargeID = 0 olduðu için burada GetByID çaðrýsý yapýlmaz.
    ' Ýlk kayýt hâlâ mevcut olmalýdýr.
    '==========================================================================

    Set FirstCharge = _
        Repo.GetByID(FirstChargeID)

    If FirstCharge Is Nothing Then

        Err.Raise vbObjectError + 13118, _
                  "TEST_081", _
                  "Mükerrer iþlem sonrasýnda ilk NORMAL RESMI kayýt " & _
                  "beklenmedik þekilde kayboldu."

    End If

    '==========================================================================
    ' 15 - CLEANUP
    '==========================================================================

    DeleteTestCharge FirstChargeID

    '==========================================================================
    ' 16 - CLEANUP KONTROLÜ
    '==========================================================================

    Set FirstCharge = Nothing

    Set FirstCharge = _
        Repo.GetByID(FirstChargeID)

    If Not FirstCharge Is Nothing Then

        Err.Raise vbObjectError + 13119, _
                  "TEST_081", _
                  "TEST-081 geçici ilk kayýt cleanup sonrasýnda hâlâ mevcut." & _
                  vbCrLf & _
                  "ChargeID = " & FirstChargeID

    End If

    '==========================================================================
    ' 17 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-081 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "Mali yýl         : " & FiscalYear & vbCrLf & _
        "Dönem ayý        : " & DueMonth & vbCrLf & _
        "ChargeDate       : " & _
            Format$(ChargeDate, "dd.mm.yyyy") & vbCrLf & _
        "PeriodEndDate    : " & _
            Format$(PeriodEndDate, "dd.mm.yyyy") & vbCrLf & _
        "Amount           : " & Amount & " TL" & vbCrLf & vbCrLf & _
        "Ýlk ChargeID     : " & FirstChargeID & vbCrLf & _
        "Ýlk kayýt        : NORMAL / RESMI" & vbCrLf & _
        "Ýkinci kayýt     : REDDEDÝLDÝ" & vbCrLf & _
        "Service kodu     : 7203" & vbCrLf & _
        "VBA Err.Number   : " & ErrorNumber & vbCrLf & _
        "Hata mesajý      : " & ErrorDescription & vbCrLf & _
        "Mükerrer kayýt   : OLUÞMADI" & vbCrLf & _
        "Cleanup          : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-081"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    TestErrorNumber = Err.Number
    TestErrorDescription = Err.Description

    On Error Resume Next

    If FirstChargeID > 0 Then

        DeleteTestCharge FirstChargeID

    End If

    If SecondChargeID > 0 Then

        DeleteTestCharge SecondChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-081 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & TestErrorNumber & vbCrLf & _
        "Açýklama: " & TestErrorDescription & vbCrLf & vbCrLf & _
        "Ýlk ChargeID : " & FirstChargeID & vbCrLf & _
        "Ýkinci ChargeID: " & SecondChargeID & vbCrLf & vbCrLf & _
        "Cleanup uygulanmaya çalýþýldý.", _
        vbCritical, _
        "OAA - TEST-081"

End Sub



'==============================================================================
' TEST-082
'
' RESMI + TOPLANTI AYNI DÖNEM AYRIMI
'
' AMAÇ:
'
'   Ayný üye + mali yýl + dönem ayýnda NORMAL RESMI tahakkuk mevcutken,
'   ayrý bir NORMAL TOPLANTI tahakkukunun oluþturulabildiðini doðrulamak.
'
' TEST EDÝLEN ÝÞ KURALI:
'
'   RESMI mükerrer kontrolü:
'
'       ExistsNormalCharge(..., "RESMI")
'
'   TOPLANTI mükerrer kontrolü:
'
'       ExistsNormalCharge(..., "TOPLANTI")
'
'   Dolayýsýyla RESMI kaydýn mevcut olmasý TOPLANTI kaydýný engellememelidir.
'
' TEST AKIÞI:
'
'   1. Kullanýlmamýþ bir dönem bulunur.
'   2. Ayný üye/dönem için NORMAL RESMI oluþturulur.
'   3. Ayný üye/dönem için NORMAL TOPLANTI oluþturulur.
'   4. TOPLANTI kaydý Repository'den doðrulanýr.
'   5. RESMI ve TOPLANTI kayýtlarýnýn birbirinden ayrý olduðu doðrulanýr.
'   6. Test kayýtlarý temizlenir.
'
' BEKLENEN:
'
'   RESMI kayýt       : BAÞARILI
'   TOPLANTI kayýt    : BAÞARILI
'   TOPLANTI reddi    : OLMAMALI
'   ChargeType ayrýmý : RESMI / TOPLANTI
'   AdjustmentType    : NORMAL
'
' GERÇEK ÜYE VERÝSÝ:
'
'   Deðiþtirilmez.
'
' CLEANUP:
'
'   Oluþturulan iki geçici ChargeID temizlenir.
'==============================================================================

Public Sub TEST_082()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim OfficialCharge As clsMemberCharge
    Dim MeetingCharge As clsMemberCharge

    Dim TestMemberID As Long

    Dim OfficialChargeID As Long
    Dim MeetingChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim PeriodEndDate As Date

    Dim OfficialAmount As Currency
    Dim MeetingAmount As Currency

    Dim FoundMember As Boolean
    Dim FoundMonth As Boolean

    Dim MonthNo As Long

    Dim TestErrorNumber As Long
    Dim TestErrorDescription As String

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    TestMemberID = 0

    OfficialChargeID = 0
    MeetingChargeID = 0

    FoundMember = False
    FoundMonth = False

    '==========================================================================
    ' 2 - GEÇERLÝ AKTÝF ÜYE BUL
    '
    ' TOPLANTI aidatý yalnýzca aktif üyeye uygulanýr.
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 13201, _
                  "TEST_082", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 13202, _
                  "TEST_082", _
                  "Üye listesi boþ."

    End If

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID
                FoundMember = True

                Exit For

            End If

        End If

    Next Member

    If Not FoundMember Then

        Err.Raise vbObjectError + 13203, _
                  "TEST_082", _
                  "TEST-082 için AKTÝF üye bulunamadý."

    End If

    '==========================================================================
    ' 3 - KULLANILMAMIÞ DÖNEM BUL
    '
    ' Ayný üye için hem RESMI hem TOPLANTI NORMAL kayýtlarýnýn bulunmadýðý
    ' bir dönem seçilir.
    '==========================================================================

    FiscalYear = 2098

    For MonthNo = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                MonthNo, _
                "RESMI") _
           And _
           Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                MonthNo, _
                "TOPLANTI") Then

            DueMonth = MonthNo
            FoundMonth = True

            Exit For

        End If

    Next MonthNo

    If Not FoundMonth Then

        MsgBox _
            "TEST-082 UYGULANAMADI." & vbCrLf & vbCrLf & _
            "2098 yýlýnda hem RESMI hem TOPLANTI açýsýndan " & _
            "kullanýlmamýþ dönem bulunamadý." & vbCrLf & vbCrLf & _
            "Gerçek kullanýcý verileri deðiþtirilmedi." & vbCrLf & vbCrLf & _
            "Sonuç: TEST ÖN KOÞULU YOK", _
            vbExclamation, _
            "OAA - TEST-082"

        Exit Sub

    End If

    '==========================================================================
    ' 4 - TEST PARAMETRELERÝ
    '==========================================================================

    ChargeDate = _
        DateSerial(FiscalYear, DueMonth, 15)

    PeriodEndDate = _
        DateSerial(FiscalYear, 12, 31)

    OfficialAmount = 500@

    MeetingAmount = 150@

    '==========================================================================
    ' 5 - RESMI NORMAL TAHAKKUK OLUÞTUR
    '
    ' Önce ayný üye/dönem için RESMI kayýt oluþturulur.
    '==========================================================================

    OfficialChargeID = _
        Service.AddOfficialCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            OfficialAmount, _
            PeriodEndDate, _
            "TEST-082-R", _
            ChargeDate, _
            "TEST-082 - RESMI temel kayýt")

    If OfficialChargeID <= 0 Then

        Err.Raise vbObjectError + 13204, _
                  "TEST_082", _
                  "TEST-082 için RESMI NORMAL tahakkuk oluþturulamadý."

    End If

    '==========================================================================
    ' 6 - RESMI KAYDI DOÐRULA
    '==========================================================================

    Set OfficialCharge = _
        Repo.GetByID(OfficialChargeID)

    If OfficialCharge Is Nothing Then

        Err.Raise vbObjectError + 13205, _
                  "TEST_082", _
                  "Oluþturulan RESMI kayýt Repository'den okunamadý."

    End If

    If OfficialCharge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 13206, _
                  "TEST_082", _
                  "RESMI kaydýn MemberID deðeri hatalý."

    End If

    If StrComp( _
            Trim$(OfficialCharge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13207, _
                  "TEST_082", _
                  "RESMI kaydýn ChargeType deðeri RESMI deðil."

    End If

    If StrComp( _
            Trim$(OfficialCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13208, _
                  "TEST_082", _
                  "RESMI kaydýn AdjustmentType deðeri NORMAL deðil."

    End If

    '==========================================================================
    ' 7 - AYNI DÖNEME TOPLANTI AÝDATI OLUÞTUR
    '
    ' ANA TEST:
    '
    ' RESMI kayýt mevcut olmasýna raðmen TOPLANTI kaydý oluþturulabilmelidir.
    '==========================================================================

    MeetingChargeID = _
        Service.AddMeetingCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            MeetingAmount, _
            "TEST-082-T", _
            ChargeDate, _
            "TEST-082 - TOPLANTI ayný dönem testi")

    '==========================================================================
    ' 8 - TOPLANTI KAYDI OLUÞMUÞ OLMALI
    '==========================================================================

    If MeetingChargeID <= 0 Then

        Err.Raise vbObjectError + 13209, _
                  "TEST_082", _
                  "RESMI kayýt mevcutken TOPLANTI tahakkuku oluþturulamadý." & _
                  vbCrLf & vbCrLf & _
                  "Bu durum TEST-082'nin ana test amacýný baþarýsýz kýlar."

    End If

    '==========================================================================
    ' 9 - TOPLANTI KAYDINI REPOSITORY'DEN OKU
    '==========================================================================

    Set MeetingCharge = _
        Repo.GetByID(MeetingChargeID)

    If MeetingCharge Is Nothing Then

        Err.Raise vbObjectError + 13210, _
                  "TEST_082", _
                  "Oluþturulan TOPLANTI kayýt Repository'den okunamadý."

    End If

    '==========================================================================
    ' 10 - TOPLANTI MEMBERID
    '==========================================================================

    If MeetingCharge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 13211, _
                  "TEST_082", _
                  "TOPLANTI kaydýn MemberID deðeri hatalý."

    End If

    '==========================================================================
    ' 11 - TOPLANTI CHARGETYPE
    '==========================================================================

    If StrComp( _
            Trim$(MeetingCharge.ChargeType), _
            "TOPLANTI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13212, _
                  "TEST_082", _
                  "TOPLANTI kaydýn ChargeType deðeri TOPLANTI deðil."

    End If

    '==========================================================================
    ' 12 - TOPLANTI ADJUSTMENTTYPE
    '==========================================================================

    If StrComp( _
            Trim$(MeetingCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13213, _
                  "TEST_082", _
                  "TOPLANTI kaydýn AdjustmentType deðeri NORMAL deðil."

    End If

    '==========================================================================
    ' 13 - DÖNEM KONTROLÜ
    '==========================================================================

    If MeetingCharge.FiscalYear <> FiscalYear Then

        Err.Raise vbObjectError + 13214, _
                  "TEST_082", _
                  "TOPLANTI kaydýn FiscalYear deðeri hatalý."

    End If

    If MeetingCharge.DueMonth <> DueMonth Then

        Err.Raise vbObjectError + 13215, _
                  "TEST_082", _
                  "TOPLANTI kaydýn DueMonth deðeri hatalý."

    End If

    '==========================================================================
    ' 14 - TUTAR KONTROLÜ
    '==========================================================================

    If MeetingCharge.Amount <> MeetingAmount Then

        Err.Raise vbObjectError + 13216, _
                  "TEST_082", _
                  "TOPLANTI kaydýn Amount deðeri hatalý."

    End If

    '==========================================================================
    ' 15 - RESMI VE TOPLANTI AYRIMI
    '
    ' Ayný:
    '
    '   MemberID
    '   FiscalYear
    '   DueMonth
    '
    ' kullanýlmasýna raðmen ChargeType farklý olmalýdýr.
    '==========================================================================

    If StrComp( _
            Trim$(OfficialCharge.ChargeType), _
            Trim$(MeetingCharge.ChargeType), _
            vbTextCompare) = 0 Then

        Err.Raise vbObjectError + 13217, _
                  "TEST_082", _
                  "RESMI ve TOPLANTI kayýtlarýnýn ChargeType deðerleri " & _
                  "birbirinden ayrýlmýyor."

    End If

    '==========================================================================
    ' 16 - RESMI KAYDIN HALA MEVCUT OLDUÐUNU KONTROL
    '
    ' TOPLANTI oluþturulurken RESMI kayýt deðiþtirilmemiþ olmalýdýr.
    '==========================================================================

    Set OfficialCharge = _
        Repo.GetByID(OfficialChargeID)

    If OfficialCharge Is Nothing Then

        Err.Raise vbObjectError + 13218, _
                  "TEST_082", _
                  "TOPLANTI oluþturulduktan sonra RESMI kayýt kayboldu."

    End If

    If StrComp( _
            Trim$(OfficialCharge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13219, _
                  "TEST_082", _
                  "TOPLANTI oluþturulmasý RESMI kaydýn türünü deðiþtirdi."

    End If

    '==========================================================================
    ' 17 - RESMI VE TOPLANTI AYRI KAYIT OLMALI
    '==========================================================================

    If OfficialChargeID = MeetingChargeID Then

        Err.Raise vbObjectError + 13220, _
                  "TEST_082", _
                  "RESMI ve TOPLANTI ayný ChargeID ile oluþturuldu."

    End If

    '==========================================================================
    ' 18 - CLEANUP
    '==========================================================================

    If MeetingChargeID > 0 Then

        DeleteTestCharge MeetingChargeID

    End If

    If OfficialChargeID > 0 Then

        DeleteTestCharge OfficialChargeID

    End If

    '==========================================================================
    ' 19 - CLEANUP KONTROLÜ
    '==========================================================================

    Set MeetingCharge = Nothing
    Set OfficialCharge = Nothing

    If MeetingChargeID > 0 Then

        Set MeetingCharge = _
            Repo.GetByID(MeetingChargeID)

        If Not MeetingCharge Is Nothing Then

            Err.Raise vbObjectError + 13221, _
                      "TEST_082", _
                      "TOPLANTI test kaydý cleanup sonrasýnda hâlâ mevcut." & _
                      vbCrLf & _
                      "ChargeID = " & MeetingChargeID

        End If

    End If

    If OfficialChargeID > 0 Then

        Set OfficialCharge = _
            Repo.GetByID(OfficialChargeID)

        If Not OfficialCharge Is Nothing Then

            Err.Raise vbObjectError + 13222, _
                      "TEST_082", _
                      "RESMI test kaydý cleanup sonrasýnda hâlâ mevcut." & _
                      vbCrLf & _
                      "ChargeID = " & OfficialChargeID

        End If

    End If

    '==========================================================================
    ' 20 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-082 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "Mali yýl         : " & FiscalYear & vbCrLf & _
        "Dönem ayý        : " & DueMonth & vbCrLf & _
        "ChargeDate       : " & _
            Format$(ChargeDate, "dd.mm.yyyy") & vbCrLf & vbCrLf & _
        "RESMI ChargeID   : " & OfficialChargeID & vbCrLf & _
        "RESMI tutar      : " & OfficialAmount & " TL" & vbCrLf & _
        "TOPLANTI ChargeID: " & MeetingChargeID & vbCrLf & _
        "TOPLANTI tutar   : " & MeetingAmount & " TL" & vbCrLf & vbCrLf & _
        "RESMI kayýt      : OLUÞTU" & vbCrLf & _
        "TOPLANTI kayýt   : OLUÞTU" & vbCrLf & _
        "ChargeType ayrýmý: OK" & vbCrLf & _
        "Ayný dönem       : EVET" & vbCrLf & _
        "Mükerrer engeli  : SADECE AYNI TÜRDE" & vbCrLf & _
        "Cleanup          : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-082"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    TestErrorNumber = Err.Number
    TestErrorDescription = Err.Description

    On Error Resume Next

    If MeetingChargeID > 0 Then

        DeleteTestCharge MeetingChargeID

    End If

    If OfficialChargeID > 0 Then

        DeleteTestCharge OfficialChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-082 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & TestErrorNumber & vbCrLf & _
        "Açýklama: " & TestErrorDescription & vbCrLf & vbCrLf & _
        "RESMI ChargeID    : " & OfficialChargeID & vbCrLf & _
        "TOPLANTI ChargeID : " & MeetingChargeID & vbCrLf & vbCrLf & _
        "Cleanup uygulanmaya çalýþýldý.", _
        vbCritical, _
        "OAA - TEST-082"

End Sub


'==============================================================================
' TEST-083
'
' TOPLANTI AÝDATI - MÜKERRER NORMAL TAHAKKUK REDDÝ
'
' AMAÇ:
'
'   Ayný üye + mali yýl + ay + TOPLANTI + NORMAL kombinasyonunda
'   ikinci tahakkukun oluþturulamadýðýný doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   ExistsNormalCharge(MemberID, FiscalYear, DueMonth, "TOPLANTI")
'
'
'   True ise:
'
'       Err.Raise vbObjectError + 7213, _
'                 "clsMemberChargeService.AddMeetingCharge", _
'                 "Bu üye için ayný döneme ait toplantý aidatý zaten tahakkuk edilmiþ."
'
' BEKLENEN:
'
'   Ýlk TOPLANTI kaydý:
'       Baþarýlý
'
'   Ýkinci TOPLANTI kaydý:
'       Reddedilmeli
'
'   Service kodu:
'       7213
'
'   VBA Err.Number:
'       vbObjectError + 7213
'
'   Ýkinci ChargeID:
'       0
'
' GERÇEK ÜYE VERÝSÝ:
'
'   Deðiþtirilmez.
'
' CLEANUP:
'
'   Ýlk geçici TOPLANTI kaydý DeleteTestCharge ile temizlenir.
'==============================================================================

Public Sub TEST_083()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim FirstCharge As clsMemberCharge
    Dim CheckCharge As clsMemberCharge

    Dim TestMemberID As Long

    Dim FirstChargeID As Long
    Dim SecondChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date

    Dim Amount As Currency

    Dim FoundMember As Boolean
    Dim FoundMonth As Boolean

    Dim MonthNo As Long

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    Dim ExpectedErrorNumber As Long

    Dim TestErrorNumber As Long
    Dim TestErrorDescription As String

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    TestMemberID = 0

    FirstChargeID = 0
    SecondChargeID = 0

    FoundMember = False
    FoundMonth = False

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString

    '==========================================================================
    ' 2 - BEKLENEN GERÇEK VBA HATA NUMARASI
    '
    ' Service:
    '
    '   vbObjectError + 7213
    '==========================================================================

    ExpectedErrorNumber = _
        vbObjectError + 7213

    '==========================================================================
    ' 3 - GEÇERLÝ AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 13301, _
                  "TEST_083", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 13302, _
                  "TEST_083", _
                  "Üye listesi boþ."

    End If

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID
                FoundMember = True

                Exit For

            End If

        End If

    Next Member

    If Not FoundMember Then

        Err.Raise vbObjectError + 13303, _
                  "TEST_083", _
                  "TEST-083 için AKTÝF üye bulunamadý."

    End If

    '==========================================================================
    ' 4 - TOPLANTI KAYDI OLMAYAN TEST DÖNEMÝ BUL
    '
    ' Burada özellikle TOPLANTI kontrolü yapýlmaktadýr.
    '
    ' RESMI kaydýn bulunmasý bu test için engel deðildir.
    ' Çünkü RESMI ve TOPLANTI ayrý ChargeType deðerleridir.
    '==========================================================================

    FiscalYear = 2098

    For MonthNo = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                MonthNo, _
                "TOPLANTI") Then

            DueMonth = MonthNo
            FoundMonth = True

            Exit For

        End If

    Next MonthNo

    If Not FoundMonth Then

        MsgBox _
            "TEST-083 UYGULANAMADI." & vbCrLf & vbCrLf & _
            "2098 yýlýnda kullanýlmamýþ NORMAL TOPLANTI dönemi bulunamadý." & _
            vbCrLf & vbCrLf & _
            "Gerçek kullanýcý verileri deðiþtirilmedi." & vbCrLf & vbCrLf & _
            "Sonuç: TEST ÖN KOÞULU YOK", _
            vbExclamation, _
            "OAA - TEST-083"

        Exit Sub

    End If

    '==========================================================================
    ' 5 - TEST PARAMETRELERÝ
    '==========================================================================

    ChargeDate = _
        DateSerial(FiscalYear, DueMonth, 15)

    Amount = 150@

    '==========================================================================
    ' 6 - ÝLK NORMAL TOPLANTI TAHAKKUKU
    '
    ' Ýlk kayýt baþarýlý olmalýdýr.
    '==========================================================================

    FirstChargeID = _
        Service.AddMeetingCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            "TEST-083-1", _
            ChargeDate, _
            "TEST-083 - Ýlk NORMAL TOPLANTI tahakkuku")

    If FirstChargeID <= 0 Then

        Err.Raise vbObjectError + 13304, _
                  "TEST_083", _
                  "Ýlk NORMAL TOPLANTI tahakkuku oluþturulamadý."

    End If

    '==========================================================================
    ' 7 - ÝLK KAYDI REPOSITORY'DEN OKU
    '==========================================================================

    Set FirstCharge = _
        Repo.GetByID(FirstChargeID)

    If FirstCharge Is Nothing Then

        Err.Raise vbObjectError + 13305, _
                  "TEST_083", _
                  "Ýlk TOPLANTI kaydý Repository'den okunamadý."

    End If

    '==========================================================================
    ' 8 - ÝLK KAYIT MEMBERID
    '==========================================================================

    If FirstCharge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 13306, _
                  "TEST_083", _
                  "Ýlk TOPLANTI kaydýnýn MemberID deðeri hatalý."

    End If

    '==========================================================================
    ' 9 - ÝLK KAYIT CHARGETYPE
    '==========================================================================

    If StrComp( _
            Trim$(FirstCharge.ChargeType), _
            "TOPLANTI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13307, _
                  "TEST_083", _
                  "Ýlk TOPLANTI kaydýnýn ChargeType deðeri TOPLANTI deðil."

    End If

    '==========================================================================
    ' 10 - ÝLK KAYIT ADJUSTMENTTYPE
    '==========================================================================

    If StrComp( _
            Trim$(FirstCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13308, _
                  "TEST_083", _
                  "Ýlk TOPLANTI kaydýnýn AdjustmentType deðeri NORMAL deðil."

    End If

    '==========================================================================
    ' 11 - ÝLK KAYIT DÖNEM KONTROLLERÝ
    '==========================================================================

    If FirstCharge.FiscalYear <> FiscalYear Then

        Err.Raise vbObjectError + 13309, _
                  "TEST_083", _
                  "Ýlk TOPLANTI kaydýnýn FiscalYear deðeri hatalý."

    End If

    If FirstCharge.DueMonth <> DueMonth Then

        Err.Raise vbObjectError + 13310, _
                  "TEST_083", _
                  "Ýlk TOPLANTI kaydýnýn DueMonth deðeri hatalý."

    End If

    '==========================================================================
    ' 12 - ÝLK KAYIT TUTAR KONTROLÜ
    '==========================================================================

    If FirstCharge.Amount <> Amount Then

        Err.Raise vbObjectError + 13311, _
                  "TEST_083", _
                  "Ýlk TOPLANTI kaydýnýn Amount deðeri hatalý."

    End If

    '==========================================================================
    ' 13 - ÝLK KAYIT AKTÝF OLMALI
    '==========================================================================

    If StrComp( _
            Trim$(FirstCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13312, _
                  "TEST_083", _
                  "Ýlk TOPLANTI kaydýnýn Status deðeri AKTIF deðil."

    End If

    '==========================================================================
    ' 14 - AYNI TOPLANTI TAHAKKUKUNU ÝKÝNCÝ KEZ DENE
    '
    ' ANA TEST:
    '
    ' Ayný:
    '
    '   MemberID
    '   FiscalYear
    '   DueMonth
    '   ChargeType = TOPLANTI
    '   AdjustmentType = NORMAL
    '
    ' kullanýlýyor.
    '
    ' Beklenen:
    '
    '   7213
    '==========================================================================

    On Error Resume Next

    Err.Clear

    SecondChargeID = _
        Service.AddMeetingCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            "TEST-083-2", _
            ChargeDate, _
            "TEST-083 - Ýkinci NORMAL TOPLANTI tahakkuku")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorNumber = Err.Number
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 15 - ÝKÝNCÝ ÝÞLEM REDDEDÝLMELÝ
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 13313, _
                  "TEST_083", _
                  "Ayný dönem için ikinci NORMAL TOPLANTI tahakkuku " & _
                  "Service tarafýndan reddedilmedi." & _
                  vbCrLf & _
                  "SecondChargeID = " & SecondChargeID

    End If

    '==========================================================================
    ' 16 - ÝKÝNCÝ CHARGEID OLUÞMAMALI
    '==========================================================================

    If SecondChargeID <> 0 Then

        Err.Raise vbObjectError + 13314, _
                  "TEST_083", _
                  "Mükerrer TOPLANTI iþlemi reddedildiði halde " & _
                  "ikinci ChargeID oluþtu." & vbCrLf & _
                  "SecondChargeID = " & SecondChargeID

    End If

    '==========================================================================
    ' 17 - HATA NUMARASI KONTROLÜ
    '==========================================================================

    If ErrorNumber = 0 Then

        Err.Raise vbObjectError + 13315, _
                  "TEST_083", _
                  "Mükerrer TOPLANTI iþlemi hata verdi ancak " & _
                  "Err.Number alýnamadý."

    End If

    If ErrorNumber <> ExpectedErrorNumber Then

        Err.Raise vbObjectError + 13316, _
                  "TEST_083", _
                  "Beklenen VBA hata numarasý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen Service kodu : 7213" & _
                  vbCrLf & _
                  "Beklenen Err.Number  : " & ExpectedErrorNumber & _
                  vbCrLf & _
                  "Alýnan Err.Number    : " & ErrorNumber & _
                  vbCrLf & vbCrLf & _
                  "Hata mesajý:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 18 - HATA MESAJI KONTROLÜ
    '==========================================================================

    If StrComp( _
            Trim$(ErrorDescription), _
            "Bu üye için ayný döneme ait toplantý aidatý zaten tahakkuk edilmiþ.", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13317, _
                  "TEST_083", _
                  "7213 hata mesajý beklenen metinle eþleþmiyor." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen:" & vbCrLf & _
                  "Bu üye için ayný döneme ait toplantý aidatý zaten tahakkuk edilmiþ." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan:" & vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 19 - ÝLK KAYDIN HALA MEVCUT OLDUÐUNU KONTROL
    '
    ' Mükerrer deneme ilk kaydý deðiþtirmemelidir.
    '==========================================================================

    Set FirstCharge = Nothing

    Set FirstCharge = _
        Repo.GetByID(FirstChargeID)

    If FirstCharge Is Nothing Then

        Err.Raise vbObjectError + 13318, _
                  "TEST_083", _
                  "Mükerrer TOPLANTI denemesinden sonra ilk kayýt " & _
                  "beklenmedik þekilde kayboldu."

    End If

    If StrComp( _
            Trim$(FirstCharge.ChargeType), _
            "TOPLANTI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13319, _
                  "TEST_083", _
                  "Mükerrer deneme ilk kaydýn ChargeType deðerini deðiþtirdi."

    End If

    '==========================================================================
    ' 20 - CLEANUP
    '==========================================================================

    If FirstChargeID > 0 Then

        DeleteTestCharge FirstChargeID

    End If

    '==========================================================================
    ' 21 - CLEANUP KONTROLÜ
    '==========================================================================

    Set CheckCharge = Nothing

    Set CheckCharge = _
        Repo.GetByID(FirstChargeID)

    If Not CheckCharge Is Nothing Then

        Err.Raise vbObjectError + 13320, _
                  "TEST_083", _
                  "TEST-083 geçici TOPLANTI kaydý cleanup sonrasýnda " & _
                  "hâlâ mevcut." & vbCrLf & _
                  "ChargeID = " & FirstChargeID

    End If

    '==========================================================================
    ' 22 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-083 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi        : " & TestMemberID & vbCrLf & _
        "Mali yýl          : " & FiscalYear & vbCrLf & _
        "Dönem ayý         : " & DueMonth & vbCrLf & _
        "ChargeDate        : " & _
            Format$(ChargeDate, "dd.mm.yyyy") & vbCrLf & _
        "Amount            : " & Amount & " TL" & vbCrLf & vbCrLf & _
        "Ýlk ChargeID      : " & FirstChargeID & vbCrLf & _
        "Ýlk kayýt         : TOPLANTI / NORMAL" & vbCrLf & _
        "Ýkinci kayýt      : REDDEDÝLDÝ" & vbCrLf & _
        "Service kodu      : 7213" & vbCrLf & _
        "VBA Err.Number    : " & ErrorNumber & vbCrLf & _
        "Mükerrer kayýt    : OLUÞMADI" & vbCrLf & _
        "Ýlk kayýt korundu : EVET" & vbCrLf & _
        "Cleanup           : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-083"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    TestErrorNumber = Err.Number
    TestErrorDescription = Err.Description

    On Error Resume Next

    If SecondChargeID > 0 Then

        DeleteTestCharge SecondChargeID

    End If

    If FirstChargeID > 0 Then

        DeleteTestCharge FirstChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-083 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & TestErrorNumber & vbCrLf & _
        "Açýklama: " & TestErrorDescription & vbCrLf & vbCrLf & _
        "Ýlk ChargeID    : " & FirstChargeID & vbCrLf & _
        "Ýkinci ChargeID : " & SecondChargeID & vbCrLf & vbCrLf & _
        "Cleanup uygulanmaya çalýþýldý.", _
        vbCritical, _
        "OAA - TEST-083"

End Sub


'==============================================================================
' TEST-084
'
' TOPLANTI AÝDATI - ÝZÝNLÝ ÜYE REDDÝ
'
' AMAÇ:
'
'   AddMeetingCharge metodunun ÝZÝNLÝ üyeye TOPLANTI aidatý uygulanmasýný
'   reddettiðini doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   AKTÝF  -> uygulanýr
'   ÝZÝNLÝ -> reddedilir
'   ÝSTÝFA -> reddedilir
'
' GERÇEK HATA:
'
'   Service kodu : 7212
'
'   Mesaj:
'
'   "Ýzinli veya istifa durumundaki üyeye toplantý aidatý uygulanamaz."
'
' TEST PRENSÝBÝ:
'
'   Mevcut ÝZÝNLÝ üye kullanýlýr.
'   Üye kaydý deðiþtirilmez.
'
' BEKLENEN:
'
'   Service hata vermelidir.
'
'   Err.Number:
'
'       vbObjectError + 7212
'
'   ChargeID:
'
'       0
'
'   Yeni borç kaydý:
'
'       OLUÞMAMALI
'
' CLEANUP:
'
'   Validation öncesinde hata oluþtuðu için geçici kayýt oluþmaz.
'==============================================================================

Public Sub TEST_084()

    Dim Service As clsMemberChargeService
    Dim MemberRepo As clsMemberRepository
    Dim ChargeRepo As clsMemberChargeRepository

    Dim Members As Collection
    Dim Member As clsMember
    Dim Charge As clsMemberCharge

    Dim TestMemberID As Long
    Dim TestChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim Amount As Currency

    Dim FoundMember As Boolean

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    Dim ExpectedErrorNumber As Long

    Dim TestErrorNumber As Long
    Dim TestErrorDescription As String

    Dim MonthNo As Long
    Dim FoundMonth As Boolean

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set MemberRepo = New clsMemberRepository
    Set ChargeRepo = New clsMemberChargeRepository

    TestMemberID = 0
    TestChargeID = 0

    FoundMember = False
    FoundMonth = False

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString

    '==========================================================================
    ' 2 - BEKLENEN HATA NUMARASI
    '==========================================================================

    ExpectedErrorNumber = _
        vbObjectError + 7212

    '==========================================================================
    ' 3 - MEVCUT ÝZÝNLÝ ÜYE BUL
    '
    ' Üyenin mevcut kaydý kullanýlmaktadýr.
    ' Üyenin Status deðeri deðiþtirilmez.
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 13401, _
                  "TEST_084", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 13402, _
                  "TEST_084", _
                  "Üye listesi boþ."

    End If

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Ýzinli", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID
                FoundMember = True

                Exit For

            End If

        End If

    Next Member

    '==========================================================================
    ' 4 - ÝZÝNLÝ ÜYE YOKSA TEST UYGULANAMAZ
    '
    ' Üye oluþturmayacaðýz.
    ' Gerçek kullanýcý verisini deðiþtirmeyeceðiz.
    '==========================================================================

    If Not FoundMember Then

        MsgBox _
            "TEST-084 UYGULANAMADI." & vbCrLf & vbCrLf & _
            "Mevcut üyeler arasýnda ÝZÝNLÝ üye bulunamadý." & vbCrLf & vbCrLf & _
            "Test için yeni üye oluþturulmadý." & vbCrLf & _
            "Gerçek kullanýcý verileri deðiþtirilmedi." & vbCrLf & vbCrLf & _
            "Sonuç: TEST ÖN KOÞULU YOK", _
            vbExclamation, _
            "OAA - TEST-084"

        Exit Sub

    End If

    '==========================================================================
    ' 5 - TEST DÖNEMÝ
    '
    ' Üyelik durumu kontrolü mükerrerlikten önce yapýldýðý için,
    ' dönem seçiminin mevcut TOPLANTI kaydýyla çakýþmasý testin ana sonucunu
    ' deðiþtirmemelidir.
    '
    ' Yine de mümkünse kullanýlmamýþ dönem seçilir.
    '==========================================================================

    FiscalYear = 2098

    For MonthNo = 1 To 12

        If Not ChargeRepo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                MonthNo, _
                "TOPLANTI") Then

            DueMonth = MonthNo
            FoundMonth = True

            Exit For

        End If

    Next MonthNo

    If Not FoundMonth Then

        MsgBox _
            "TEST-084 UYGULANAMADI." & vbCrLf & vbCrLf & _
            "2098 yýlýnda kullanýlmamýþ TOPLANTI dönemi bulunamadý." & _
            vbCrLf & vbCrLf & _
            "Gerçek kullanýcý verileri deðiþtirilmedi.", _
            vbExclamation, _
            "OAA - TEST-084"

        Exit Sub

    End If

    '==========================================================================
    ' 6 - TEST PARAMETRELERÝ
    '==========================================================================

    ChargeDate = _
        DateSerial(FiscalYear, DueMonth, 15)

    Amount = 150@

    '==========================================================================
    ' 7 - TOPLANTI AÝDATI OLUÞTURMAYI DENE
    '
    ' Üye ÝZÝNLÝ olduðu için Service'in 7212 üretmesi beklenmektedir.
    '==========================================================================

    On Error Resume Next

    Err.Clear

    TestChargeID = _
        Service.AddMeetingCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            "TEST-084", _
            ChargeDate, _
            "TEST-084 - ÝZÝNLÝ üye reddi")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorNumber = Err.Number
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 8 - HATA OLUÞMALI
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 13403, _
                  "TEST_084", _
                  "ÝZÝNLÝ üyeye TOPLANTI aidatý uygulanmasý " & _
                  "Service tarafýndan reddedilmedi."

    End If

    '==========================================================================
    ' 9 - CHARGEID OLUÞMAMALI
    '==========================================================================

    If TestChargeID <> 0 Then

        Err.Raise vbObjectError + 13404, _
                  "TEST_084", _
                  "ÝZÝNLÝ üye reddedildiði halde ChargeID oluþtu." & _
                  vbCrLf & _
                  "ChargeID = " & TestChargeID

    End If

    '==========================================================================
    ' 10 - HATA NUMARASI
    '==========================================================================

    If ErrorNumber = 0 Then

        Err.Raise vbObjectError + 13405, _
                  "TEST_084", _
                  "Service hata verdi ancak Err.Number alýnamadý."

    End If

    If ErrorNumber <> ExpectedErrorNumber Then

        Err.Raise vbObjectError + 13406, _
                  "TEST_084", _
                  "Beklenen VBA hata numarasý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen Service kodu : 7212" & _
                  vbCrLf & _
                  "Beklenen Err.Number  : " & ExpectedErrorNumber & _
                  vbCrLf & _
                  "Alýnan Err.Number    : " & ErrorNumber & _
                  vbCrLf & vbCrLf & _
                  "Hata mesajý:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 11 - HATA MESAJI
    '==========================================================================

    If StrComp( _
            Trim$(ErrorDescription), _
            "Ýzinli veya istifa durumundaki üyeye toplantý aidatý uygulanamaz.", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13407, _
                  "TEST_084", _
                  "7212 hata mesajý beklenen metinle eþleþmiyor." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen:" & vbCrLf & _
                  "Ýzinli veya istifa durumundaki üyeye toplantý aidatý uygulanamaz." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan:" & vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 12 - ÜYENÝN STATUS DEÐERÝNÝN DEÐÝÞMEDÝÐÝNÝ KONTROL ET
    '
    ' Test hiçbir þekilde üye kaydýný deðiþtirmemelidir.
    '==========================================================================

    Set Member = _
    MemberRepo.GetByID(TestMemberID)

    If Member Is Nothing Then

        Err.Raise vbObjectError + 13408, _
                  "TEST_084", _
                  "Test edilen ÝZÝNLÝ üye test sonrasýnda bulunamadý."

    End If

    If StrComp( _
            Trim$(Member.Status), _
            "Ýzinli", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 13409, _
                  "TEST_084", _
                  "TEST-084 sonrasýnda üyenin Status deðeri deðiþti." & _
                  vbCrLf & _
                  "Beklenen: Ýzinli" & _
                  vbCrLf & _
                  "Alýnan: " & Member.Status

    End If

    '==========================================================================
    ' 13 - TEST CHARGEID YOKSA KAYIT KONTROLÜ GEREKMEZ
    '
    ' Service 7212'de Repository.Add çaðrýsýna ulaþmamalýdýr.
    '==========================================================================

    If TestChargeID > 0 Then

        Set Charge = _
            ChargeRepo.GetByID(TestChargeID)

        If Not Charge Is Nothing Then

            Err.Raise vbObjectError + 13410, _

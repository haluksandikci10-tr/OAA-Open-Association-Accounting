        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Test kayýtlarý için cleanup uygulandý.", _
        vbCritical, _
        "OAA - TEST-121"


    Set LoadedReceipt = Nothing
    Set Receipts = Nothing
    Set Receipt2 = Nothing
    Set Receipt1 = Nothing
    Set Service = Nothing


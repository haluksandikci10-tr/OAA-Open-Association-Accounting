'==============================================================================

Public Sub TEST_122_ReceiptChargeID()

    Dim Repo As clsReceiptRepository

    Dim Receipt As clsReceipt
    Dim LoadedReceipt As clsReceipt

    Dim TestReceiptID As Long

    Dim TestMemberID As Long
    Dim TestChargeID As Long

    On Error GoTo TestError

    '--------------------------------------------------------------------------
    ' TEST VERÝLERÝ
    '
    ' MemberID = 10 mevcut test üyemiz.
    '
    ' ChargeID için mevcut TBL_MEMBER_CHARGES kaydýndan bir ID kullanýlacak.
    ' Bu nedenle aþaðýdaki deðeri mevcut tablodaki gerçek bir ChargeID
    ' ile eþleþtirmemiz gerekiyor.
    '--------------------------------------------------------------------------

    TestMemberID = 10

    ' Buraya TBL_MEMBER_CHARGES tablosunda mevcut gerçek bir ChargeID yazýlmalý.
    TestChargeID = 1


    Debug.Print String(70, "=")
    Debug.Print "TEST-122 - Receipt ChargeID"
    Debug.Print String(70, "=")


    '--------------------------------------------------------------------------
    ' REPOSITORY
    '--------------------------------------------------------------------------

    Set Repo = New clsReceiptRepository


    '--------------------------------------------------------------------------
    ' TEST RECEIPT
    '--------------------------------------------------------------------------

    Set Receipt = New clsReceipt

    Receipt.Series = "A"
    Receipt.ReceiptNumber = 900012
    Receipt.ReceiptDate = Date
    Receipt.MemberID = TestMemberID
    Receipt.ChargeID = TestChargeID
    Receipt.Amount = CCur(250)
    Receipt.PaymentMethod = "Nakit"


    '--------------------------------------------------------------------------
    ' ADD
    '--------------------------------------------------------------------------

    TestReceiptID = Repo.Add(Receipt)

    If TestReceiptID <= 0 Then

        Err.Raise _
            vbObjectError + 12201, _
            "TEST-122", _
            "Receipt kaydý oluþturulamadý."


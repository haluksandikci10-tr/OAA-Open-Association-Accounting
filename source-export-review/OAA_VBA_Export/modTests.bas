' AMAÇ:
'
'   AddBulkOfficialCharges metodunun PeriodEndDate <= 0 deðerini
'   reddettiðini doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   PeriodEndDate <= 0
'       -> vbObjectError + 7355
'       -> "Dönem sonu tarihi girilmelidir."
'
' BEKLENEN:
'
'   Service iþlemi reddedilmelidir.
'
'   CreatedCount = 0
'   SkippedCount = 0
'   ErrorCount   = 1
'   Result       = 0
'
'   Üye döngüsüne girilmemeli ve hiçbir kayýt oluþmamalýdýr.
'
' CLEANUP:
'
'   Kayýt oluþmadýðý için cleanup gerekmez.
'==============================================================================

Public Sub TEST_053()

    Dim Service As clsMemberChargeService

    Dim CreatedCount As Long
    Dim SkippedCount As Long
    Dim ErrorCount As Long

    Dim Result As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim PeriodEndDate As Date

    Dim Amount As Currency

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    On Error GoTo TestError

    '==========================================================================
    ' 1 - SERVICE
    '==========================================================================

    Set Service = New clsMemberChargeService

    '==========================================================================
    ' 2 - TEST PARAMETRELERÝ
    '
    ' Sadece PeriodEndDate bilerek geçersizdir.
    ' Diðer parametreler geçerlidir.
    '
    ' Böylece doðrudan 7355 kontrolü test edilir.
    '==========================================================================

    FiscalYear = 2098

    DueMonth = 1

    ChargeDate = DateSerial(2098, 1, 1)

    Amount = 500@

    PeriodEndDate = 0

    CreatedCount = 0
    SkippedCount = 0
    ErrorCount = 0

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString

    '==========================================================================
    ' 3 - SERVICE ÇAÐRISI
    '==========================================================================

    On Error Resume Next

    Err.Clear

    Result = _
        Service.AddBulkOfficialCharges( _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            PeriodEndDate, _
            "TEST-053", _
            ChargeDate, _
            "TEST-053 - Geçersiz dönem sonu tarihi", _
            CreatedCount, _
            SkippedCount, _
            ErrorCount)

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorNumber = Err.Number
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 4 - SERVICE HATA VERMELÝ
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 10301, _
                  "TEST_053", _
                  "Geçersiz dönem sonu tarihi Service tarafýndan " & _
                  "reddedilmedi."

    End If

    '==========================================================================
    ' 5 - HATA NUMARASI
    '==========================================================================

    If ErrorNumber = 0 Then

        Err.Raise vbObjectError + 10302, _
                  "TEST_053", _
                  "Service hata verdiði halde Err.Number alýnamadý."

    End If

    '==========================================================================
    ' 6 - GERÇEK HATA MESAJI
    '==========================================================================

    If InStr( _
            1, _
            ErrorDescription, _
            "Dönem sonu tarihi girilmelidir.", _
            vbTextCompare) = 0 Then

        Err.Raise vbObjectError + 10303, _
                  "TEST_053", _
                  "Beklenen 7355 hata mesajý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen:" & _
                  vbCrLf & _
                  "Dönem sonu tarihi girilmelidir." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 7 - CREATED COUNT
    '==========================================================================

    If CreatedCount <> 0 Then

        Err.Raise vbObjectError + 10304, _
                  "TEST_053", _
                  "CreatedCount sýfýr deðil: " & CreatedCount

    End If

    '==========================================================================
    ' 8 - SKIPPED COUNT
    '
    ' Temel parametre kontrolünde hata oluþtuðu için üye döngüsüne
    ' girilmemelidir.
    '==========================================================================

    If SkippedCount <> 0 Then

        Err.Raise vbObjectError + 10305, _
                  "TEST_053", _
                  "SkippedCount sýfýr deðil: " & SkippedCount

    End If

    '==========================================================================
    ' 9 - ERROR COUNT
    '==========================================================================

    If ErrorCount <> 1 Then

        Err.Raise vbObjectError + 10306, _
                  "TEST_053", _
                  "Beklenen ErrorCount = 1." & _
                  vbCrLf & _
                  "Gerçek ErrorCount = " & ErrorCount

    End If

    '==========================================================================
    ' 10 - FONKSÝYON SONUCU
    '
    ' FatalError bölümünde:
    '
    '   AddBulkOfficialCharges = CreatedCount
    '
    ' CreatedCount = 0 olduðundan Result = 0 olmalýdýr.
    '==========================================================================

    If Result <> 0 Then

        Err.Raise vbObjectError + 10307, _
                  "TEST_053", _
                  "Fonksiyon sonucu 0 deðil: " & Result

    End If

    '==========================================================================
    ' 11 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-053 BAÞARILI." & vbCrLf & vbCrLf & _
        "FiscalYear       : " & FiscalYear & vbCrLf & _
        "DueMonth         : " & DueMonth & vbCrLf & _
        "ChargeDate       : " & _
            Format$(ChargeDate, "dd.mm.yyyy") & vbCrLf & _
        "Amount           : " & Amount & " TL" & vbCrLf & _
        "PeriodEndDate    : 0 (GEÇERSÝZ)" & vbCrLf & vbCrLf & _
        "Service reddi    : OK" & vbCrLf & _
        "Hata mesajý      : Dönem sonu tarihi girilmelidir." & vbCrLf & _
        "CreatedCount     : 0" & vbCrLf & _
        "SkippedCount     : 0" & vbCrLf & _
        "ErrorCount       : 1" & vbCrLf & _
        "Sonuç            : 0" & vbCrLf & _
        "Kayýt oluþumu    : YOK" & vbCrLf & _
        "Cleanup          : GEREKMEDÝ" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-053"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

TestError:

    MsgBox _
        "TEST-053 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Service Hatasý:" & vbCrLf & _
        ErrorDescription, _
        vbCritical, _
        "OAA - TEST-053"

End Sub

'==============================================================================
' TEST-054
'
' TOPLU RESMI AÝDAT - ÜYE LÝSTESÝ VE ÝÞLEME
'
' AMAÇ:
'
'   AddBulkOfficialCharges metodunun:
'
'       1. Üye listesini Repository'den alabildiðini,
'       2. Üye listesi Nothing olmadýðý için 7356 hatasýna düþmediðini,
'       3. Geçerli parametrelerle toplu iþlem döngüsüne girdiðini
'
'   doðrulamak.
'
' ÖNEMLÝ:
'
'   Gerçek MemberRepository deðiþtirilmez.
'   Gerçek kullanýcý üyeleri deðiþtirilmez.
'
'   2098 mali yýlý kullanýldýðý için mevcut kullanýcý verileriyle
'   çakýþma ihtimali minimum tutulur.
'
' CLEANUP:
'
'   TEST tarafýndan oluþturulan ChargeID kayýtlarý tek tek silinir.
'==============================================================================

Public Sub TEST_054()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember
    Dim Charge As clsMemberCharge

    Dim TestChargeIDs As Collection

    Dim CreatedCount As Long
    Dim SkippedCount As Long
    Dim ErrorCount As Long

    Dim Result As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim PeriodEndDate As Date

    Dim Amount As Currency

    Dim BeforeCount As Long
    Dim AfterCount As Long

    Dim TestChargeID As Long
    Dim ExistingCharge As clsMemberCharge

    Dim ErrorDescription As String

    Dim TestError As Boolean

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    Set TestChargeIDs = New Collection

    '==========================================================================
    ' 2 - GERÇEK ÜYE LÝSTESÝNÝ AL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 10401, _
                  "TEST_054", _
                  "Repository gerçek üye listesini döndürmedi."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 10402, _
                  "TEST_054", _
                  "Test için üye listesi boþ."

    End If

    '==========================================================================
    ' 3 - TEST PARAMETRELERÝ
    '==========================================================================

    FiscalYear = 2098
    DueMonth = 1

    ChargeDate = DateSerial(FiscalYear, DueMonth, 1)

    PeriodEndDate = DateSerial(FiscalYear, 12, 31)

    Amount = 125@

    CreatedCount = 0
    SkippedCount = 0
    ErrorCount = 0

    '==========================================================================
    ' 4 - SERVICE ÇAÐRISI
    '==========================================================================

    ErrorDescription = vbNullString
    TestError = False

    On Error Resume Next

    Err.Clear

    Result = _
        Service.AddBulkOfficialCharges( _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            PeriodEndDate, _
            "TEST-054", _
            ChargeDate, _
            "TEST-054 - Toplu RESMI aidat", _
            CreatedCount, _
            SkippedCount, _
            ErrorCount)

    If Err.Number <> 0 Then

        TestError = True
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 5 - BEKLENMEDÝK HATA KONTROLÜ
    '==========================================================================

    If TestError Then

        Err.Raise vbObjectError + 10403, _
                  "TEST_054", _
                  "Toplu RESMI aidat iþlemi beklenmedik hata verdi." & _
                  vbCrLf & vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 6 - SONUÇ KONTROLÜ
    '
    ' Üye listesi baþarýyla alýndýysa:
    '
    '   Result = CreatedCount
    '
    ' olmalýdýr.
    '==========================================================================

    If Result <> CreatedCount Then

        Err.Raise vbObjectError + 10404, _
                  "TEST_054", _
                  "Fonksiyon sonucu CreatedCount ile ayný deðil." & _
                  vbCrLf & _
                  "Result       : " & Result & _
                  vbCrLf & _
                  "CreatedCount : " & CreatedCount

    End If

    '==========================================================================
    ' 7 - ERRORCOUNT KONTROLÜ
    '
    ' Bu testte FatalError oluþmamalýdýr.
    '==========================================================================

    If ErrorCount <> 0 Then

        Err.Raise vbObjectError + 10405, _
                  "TEST_054", _
                  "Beklenmeyen ErrorCount oluþtu: " & ErrorCount

    End If

    '==========================================================================
    ' 8 - EN AZ BÝR ÜYE ÝÞLENMÝÞ OLMALI
    '
    ' Repository'de üye bulunduðu ve 2098 dönemi kullanýlmamýþ olduðu
    ' durumda CreatedCount veya SkippedCount üzerinden iþlem döngüsünün
    ' çalýþtýðý görülür.
    '
    ' Eðer mevcut üyelerin tamamýnda kayýt zaten varsa SkippedCount > 0
    ' olabilir.
    '==========================================================================

    If CreatedCount = 0 And SkippedCount = 0 Then

        Err.Raise vbObjectError + 10406, _
                  "TEST_054", _
                  "Toplu iþlem hiçbir üyeyi oluþturmadý veya atlamadý." & _
                  vbCrLf & _
                  "CreatedCount = 0" & _
                  vbCrLf & _
                  "SkippedCount = 0"

    End If

    '==========================================================================
    ' 9 - OLUÞTURULAN TEST KAYITLARINI BUL
    '
    ' 2098 / Ocak / RESMI / TEST-054 kayýtlarý bulunur.
    '
    ' Sadece Description deðeri TEST-054 olan kayýtlar cleanup edilir.
    '==========================================================================

    Set Members = MemberRepo.GetAll

    For Each Member In Members

        If Not Member Is Nothing Then

            Set ExistingCharge = Nothing

            On Error Resume Next

            Set ExistingCharge = _
                Repo.GetByMemberID(Member.MemberID)

            Err.Clear

            On Error GoTo ErrorHandler

            If Not ExistingCharge Is Nothing Then

                '----------------------------------------------------------------
                ' GetByMemberID ilk kayýt için dönebileceðinden aþaðýdaki
                ' kontrol yalnýzca TEST-054 açýklamasýný doðrulamak amacýyla
                ' kullanýlmaktadýr.
                '----------------------------------------------------------------

                If StrComp( _
                        Trim$(ExistingCharge.Description), _
                        "TEST-054 - Toplu RESMI aidat", _
                        vbTextCompare) = 0 Then

                    TestChargeIDs.Add ExistingCharge.ChargeID

                End If

            End If

        End If

    Next Member

    '==========================================================================
    ' 10 - CLEANUP
    '==========================================================================

    If TestChargeIDs.Count > 0 Then

        Dim Item As Variant

        For Each Item In TestChargeIDs

            TestChargeID = CLng(Item)

            DeleteTestCharge TestChargeID

        Next Item

    End If

    '==========================================================================
    ' 11 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-054 BAÞARILI." & vbCrLf & vbCrLf & _
        "FiscalYear       : " & FiscalYear & vbCrLf & _
        "DueMonth         : " & DueMonth & vbCrLf & _
        "ChargeDate       : " & _
            Format$(ChargeDate, "dd.mm.yyyy") & vbCrLf & _
        "Amount           : " & Amount & " TL" & vbCrLf & vbCrLf & _
        "Üye listesi      : OK" & vbCrLf & _
        "Üye sayýsý       : " & Members.Count & vbCrLf & _
        "CreatedCount     : " & CreatedCount & vbCrLf & _
        "SkippedCount     : " & SkippedCount & vbCrLf & _
        "ErrorCount       : " & ErrorCount & vbCrLf & _
        "Result           : " & Result & vbCrLf & _
        "7356 engeli      : AÞILDI" & vbCrLf & _
        "Cleanup          : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-054"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If TestChargeIDs Is Nothing Then

        ' Nothing

    Else

        Dim CleanupItem As Variant

        For Each CleanupItem In TestChargeIDs

            DeleteTestCharge CLng(CleanupItem)

        Next CleanupItem

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-054 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Service Hatasý:" & vbCrLf & _
        ErrorDescription, _
        vbCritical, _
        "OAA - TEST-054"

End Sub

'==============================================================================
' TEST-055
'
' TOPLU RESMI AÝDAT - MÜKERRER NORMAL TAHAKKUK ATLANMASI
'
' AMAÇ:
'
'   AddBulkOfficialCharges çalýþýrken ayný üye + mali yýl + ay + RESMI
'   için zaten NORMAL ve AKTIF tahakkuk varsa yeni NORMAL tahakkuk
'   oluþturulmadýðýný doðrulamak.
'
' GERÇEK KURAL:
'
'   ExistsNormalCharge(
'       MemberID,
'       FiscalYear,
'       DueMonth,
'       "RESMI"
'   )
'
'   = True
'
'   ise:
'
'       SkippedCount = SkippedCount + 1
'
'   ve AddOfficialCharge çaðrýlmaz.
'
' BEKLENEN:
'
'   Test üyesi için mevcut NORMAL kayýt korunur.
'   Ayný dönem için ikinci NORMAL kayýt oluþmaz.
'   Test üyesi SkippedCount içine girer.
'
' NOT:
'
'   Toplu iþlem diðer üyeleri de iþleyebilir.
'   Bu nedenle test yalnýzca TEST-055 açýklamasýyla oluþturulan
'   kayýtlarý cleanup eder.
'
' GERÇEK KULLANICI VERÝSÝ:
'
'   Mevcut üye kaydý deðiþtirilmez.
'
' CLEANUP:
'
'   Test tarafýndan oluþturulan tüm TEST-055 kayýtlarý ChargeID
'   üzerinden temizlenir.
'==============================================================================

Public Sub TEST_055()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Charges As Collection

    Dim Member As clsMember
    Dim Charge As clsMemberCharge
    Dim ExistingCharge As clsMemberCharge

    Dim TestChargeIDs As Collection

    Dim TestMemberID As Long
    Dim SourceChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim PeriodEndDate As Date

    Dim Amount As Currency

    Dim CreatedCount As Long
    Dim SkippedCount As Long
    Dim ErrorCount As Long

    Dim Result As Long

    Dim BeforeNormalCount As Long
    Dim AfterNormalCount As Long

    Dim TestNormalCount As Long

    Dim FoundTestMember As Boolean
    Dim TestMemberSkipped As Boolean

    Dim ErrorDescription As String
    Dim ErrorOccurred As Boolean

    Dim Item As Variant
    Dim ChargeItem As clsMemberCharge

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository
    Set TestChargeIDs = New Collection

    SourceChargeID = 0

    '==========================================================================
    ' 2 - TEST ÜYESÝ BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 10501, _
                  "TEST_055", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 10502, _
                  "TEST_055", _
                  "Test için üye bulunamadý."

    End If

    TestMemberID = 0
    FoundTestMember = False

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID
                FoundTestMember = True

                Exit For

            End If

        End If

    Next Member

    If Not FoundTestMember Then

        Err.Raise vbObjectError + 10503, _
                  "TEST_055", _
                  "Test için AKTÝF üye bulunamadý."

    End If

    '==========================================================================
    ' 3 - TEST DÖNEMÝ
    '
    ' 2098 yýlý kullanýlýr.
    ' Önce mevcut NORMAL RESMI kayýt kontrol edilir.
    ' Varsa baþka bir ay seçilir.
    '==========================================================================

    FiscalYear = 2098

    PeriodEndDate = DateSerial(FiscalYear, 12, 31)

    Amount = 375@

    DueMonth = 0

    For DueMonth = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                DueMonth, _
                "RESMI") Then

            Exit For

        End If

    Next DueMonth

    If DueMonth > 12 Then

        Err.Raise vbObjectError + 10504, _
                  "TEST_055", _
                  "TEST için kullanýlmamýþ RESMI dönem bulunamadý."

    End If

    ChargeDate = DateSerial(FiscalYear, DueMonth, 1)

    '==========================================================================
    ' 4 - TEST ÖNCESÝ NORMAL KAYIT SAYISINI AL
    '==========================================================================

    Set Charges = Repo.GetByMemberID(TestMemberID)

    BeforeNormalCount = 0

    If Not Charges Is Nothing Then

        For Each Charge In Charges

            If Not Charge Is Nothing Then

                If Charge.FiscalYear = FiscalYear _
                   And Charge.DueMonth = DueMonth _
                   And StrComp( _
                           Trim$(Charge.ChargeType), _
                           "RESMI", _
                           vbTextCompare) = 0 _
                   And StrComp( _
                           Trim$(Charge.AdjustmentType), _
                           "NORMAL", _
                           vbTextCompare) = 0 _
                   And StrComp( _
                           Trim$(Charge.Status), _
                           "AKTIF", _
                           vbTextCompare) = 0 Then

                    BeforeNormalCount = BeforeNormalCount + 1

                End If

            End If

        Next Charge

    End If

    If BeforeNormalCount <> 0 Then

        Err.Raise vbObjectError + 10505, _
                  "TEST_055", _
                  "Test dönemi baþlangýçta boþ deðil."

    End If

    '==========================================================================
    ' 5 - MEVCUT SERVICE API ÝLE ÝLK NORMAL KAYDI OLUÞTUR
    '
    ' Böylece mükerrer kontrolünü gerçek Service üzerinden hazýrlýyoruz.
    '==============================================================================

    ErrorDescription = vbNullString
    ErrorOccurred = False

    On Error Resume Next

    Err.Clear

    SourceChargeID = _
        Service.AddOfficialCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            PeriodEndDate, _
            "TEST-055-KAYNAK", _
            ChargeDate, _
            "TEST-055 - Mevcut NORMAL kaynak")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    If ErrorOccurred Then

        Err.Raise vbObjectError + 10506, _
                  "TEST_055", _
                  "Ýlk NORMAL RESMI tahakkuk oluþturulamadý." & _
                  vbCrLf & _
                  ErrorDescription

    End If

    If SourceChargeID <= 0 Then

        Err.Raise vbObjectError + 10507, _
                  "TEST_055", _
                  "Ýlk NORMAL tahakkuk ChargeID oluþturmadý."

    End If

    TestChargeIDs.Add SourceChargeID

    '==========================================================================
    ' 6 - KAYNAK KAYDI DOÐRULA
    '==========================================================================

    Set ExistingCharge = Repo.GetByID(SourceChargeID)

    If ExistingCharge Is Nothing Then

        Err.Raise vbObjectError + 10508, _
                  "TEST_055", _
                  "Oluþturulan NORMAL kaynak okunamadý."

    End If

    If ExistingCharge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 10509, _
                  "TEST_055", _
                  "Kaynak MemberID hatalý."

    End If

    If ExistingCharge.FiscalYear <> FiscalYear Then

        Err.Raise vbObjectError + 10510, _
                  "TEST_055", _
                  "Kaynak FiscalYear hatalý."

    End If

    If ExistingCharge.DueMonth <> DueMonth Then

        Err.Raise vbObjectError + 10511, _
                  "TEST_055", _
                  "Kaynak DueMonth hatalý."

    End If

    If StrComp( _
            Trim$(ExistingCharge.ChargeType), _
            "RESMI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 10512, _
                  "TEST_055", _
                  "Kaynak ChargeType RESMI deðil."

    End If

    If StrComp( _
            Trim$(ExistingCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 10513, _
                  "TEST_055", _
                  "Kaynak AdjustmentType NORMAL deðil."

    End If

    If StrComp( _
            Trim$(ExistingCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 10514, _
                  "TEST_055", _
                  "Kaynak Status AKTIF deðil."

    End If

    '==========================================================================
    ' 7 - EXISTSNORMALCHARGE TRUE OLMALI
    '==========================================================================

    If Not Repo.ExistsNormalCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            "RESMI") Then

        Err.Raise vbObjectError + 10515, _
                  "TEST_055", _
                  "Mevcut NORMAL RESMI tahakkuk Repository tarafýndan " & _
                  "mükerrer olarak algýlanmadý."

    End If

    '==========================================================================
    ' 8 - TOPLU RESMI AÝDAT ÇAÐRISI
    '==========================================================================

    CreatedCount = 0
    SkippedCount = 0
    ErrorCount = 0

    ErrorDescription = vbNullString
    ErrorOccurred = False

    On Error Resume Next

    Err.Clear

    Result = _
        Service.AddBulkOfficialCharges( _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            PeriodEndDate, _
            "TEST-055-BULK", _
            ChargeDate, _
            "TEST-055 - Toplu mükerrer kontrolü", _
            CreatedCount, _
            SkippedCount, _
            ErrorCount)

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 9 - TOPLU ÝÞLEM BEKLENMEDÝK FATAL HATA VERMEMELÝ
    '==========================================================================

    If ErrorOccurred Then

        Err.Raise vbObjectError + 10516, _
                  "TEST_055", _
                  "Toplu iþlem beklenmedik hata verdi." & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 10 - TEST ÜYESÝ SKIPPED OLMALI
    '
    ' Toplu iþlemde test üyesi için ExistsNormalCharge=True olduðundan
    ' SkippedCount en az 1 olmalýdýr.
    '==========================================================================

    If SkippedCount < 1 Then

        Err.Raise vbObjectError + 10517, _
                  "TEST_055", _
                  "Mevcut NORMAL tahakkuk bulunan üye atlanmadý." & _
                  vbCrLf & _
                  "SkippedCount = " & SkippedCount

    End If

    TestMemberSkipped = True

    '==========================================================================
    ' 11 - ERRORCOUNT SIFIR OLMALI
    '==========================================================================

    If ErrorCount <> 0 Then

        Err.Raise vbObjectError + 10518, _
                  "TEST_055", _
                  "Beklenmeyen ErrorCount oluþtu: " & ErrorCount

    End If

    '==========================================================================
    ' 12 - TEST ÜYESÝNÝN NORMAL RESMI KAYIT SAYISINI KONTROL ET
    '
    ' Ýþlemden önce 1 NORMAL kayýt vardý.
    ' Ýþlemden sonra hâlâ yalnýzca 1 olmalýdýr.
    '==========================================================================

    Set Charges = Repo.GetByMemberID(TestMemberID)

    AfterNormalCount = 0

    If Not Charges Is Nothing Then

        For Each Charge In Charges

            If Not Charge Is Nothing Then

                If Charge.FiscalYear = FiscalYear _
                   And Charge.DueMonth = DueMonth _
                   And StrComp( _
                           Trim$(Charge.ChargeType), _
                           "RESMI", _
                           vbTextCompare) = 0 _
                   And StrComp( _
                           Trim$(Charge.AdjustmentType), _
                           "NORMAL", _
                           vbTextCompare) = 0 _
                   And StrComp( _
                           Trim$(Charge.Status), _
                           "AKTIF", _
                           vbTextCompare) = 0 Then

                    AfterNormalCount = AfterNormalCount + 1

                End If

            End If

        Next Charge

    End If

    If AfterNormalCount <> BeforeNormalCount + 1 Then

        Err.Raise vbObjectError + 10519, _
                  "TEST_055", _
                  "Toplu iþlem test üyesi için ikinci NORMAL kayýt oluþturdu." & _
                  vbCrLf & _
                  "Baþlangýç NORMAL sayýsý: " & BeforeNormalCount & _
                  vbCrLf & _
                  "Beklenen NORMAL sayýsý : " & (BeforeNormalCount + 1) & _
                  vbCrLf & _
                  "Gerçek NORMAL sayýsý   : " & AfterNormalCount

    End If

    '==========================================================================
    ' 13 - KAYNAK KAYDIN HALA TEK VE DEÐÝÞMEMÝÞ OLDUÐUNU DOÐRULA
    '==========================================================================

    Set ExistingCharge = Repo.GetByID(SourceChargeID)

    If ExistingCharge Is Nothing Then

        Err.Raise vbObjectError + 10520, _
                  "TEST_055", _
                  "Mevcut NORMAL kaynak iþlem sonrasýnda bulunamadý."

    End If

    If ExistingCharge.Amount <> Amount Then

        Err.Raise vbObjectError + 10521, _
                  "TEST_055", _
                  "Mevcut NORMAL kaydýn tutarý deðiþti."

    End If

    If StrComp( _
            Trim$(ExistingCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 10522, _
                  "TEST_055", _
                  "Mevcut NORMAL kaydýn tipi deðiþti."

    End If

    '==========================================================================
    ' 14 - TOPLU ÝÞLEMÝN SONUCU CREATEDCOUNT ÝLE UYUMLU OLMALI
    '==========================================================================

    If Result <> CreatedCount Then

        Err.Raise vbObjectError + 10523, _
                  "TEST_055", _
                  "Result ve CreatedCount uyumsuz." & _
                  vbCrLf & _
                  "Result       : " & Result & _
                  vbCrLf & _
                  "CreatedCount : " & CreatedCount

    End If

    '==========================================================================
    ' 15 - TEST KAYITLARINI BUL VE CLEANUP
    '
    ' Toplu iþlem diðer üyeler için TEST-055 kayýtlarý oluþturmuþ olabilir.
    ' Bu kayýtlarý Description üzerinden tespit ediyoruz.
    '==============================================================================

    Set Members = MemberRepo.GetAll

    For Each Member In Members

        If Not Member Is Nothing Then

            Set Charges = Repo.GetByMemberID(Member.MemberID)

            If Not Charges Is Nothing Then

                For Each ChargeItem In Charges

                    If Not ChargeItem Is Nothing Then

                        If StrComp( _
                                Trim$(ChargeItem.Description), _
                                "TEST-055 - Mevcut NORMAL kaynak", _
                                vbTextCompare) = 0 Then

                            On Error Resume Next
                            TestChargeIDs.Add ChargeItem.ChargeID
                            Err.Clear
                            On Error GoTo ErrorHandler

                        ElseIf StrComp( _
                                Trim$(ChargeItem.Description), _
                                "TEST-055 - Toplu mükerrer kontrolü", _
                                vbTextCompare) = 0 Then

                            On Error Resume Next
                            TestChargeIDs.Add ChargeItem.ChargeID
                            Err.Clear
                            On Error GoTo ErrorHandler

                        End If

                    End If

                Next ChargeItem

            End If

        End If

    Next Member

    '==========================================================================
    ' 16 - DUPLICATE ID'LERÝ TEMÝZLE
    '
    ' Ayný kaynak kayýt zaten Collection'a eklenmiþ olabilir.
    ' DeleteTestCharge ikinci kez çaðrýlýrsa hata çýkabileceðinden
    ' yalnýzca ilk kaynak ve TEST açýklamalý kayýtlar üzerinden ilerlenir.
    '==============================================================================

    On Error Resume Next

    DeleteTestCharge SourceChargeID

    Err.Clear

    On Error GoTo ErrorHandler

    '--------------------------------------------------------------------------
    ' Diðer TEST-055 kayýtlarýný temizle
    '--------------------------------------------------------------------------

    Set Members = MemberRepo.GetAll

    For Each Member In Members

        If Not Member Is Nothing Then

            Set Charges = Repo.GetByMemberID(Member.MemberID)

            If Not Charges Is Nothing Then

                For Each ChargeItem In Charges

                    If Not ChargeItem Is Nothing Then

                        If StrComp( _
                                Trim$(ChargeItem.Description), _
                                "TEST-055 - Toplu mükerrer kontrolü", _
                                vbTextCompare) = 0 Then

                            On Error Resume Next
                            DeleteTestCharge ChargeItem.ChargeID
                            Err.Clear
                            On Error GoTo ErrorHandler

                        End If

                    End If

                Next ChargeItem

            End If

        End If

    Next Member

    '==========================================================================
    ' 17 - KAYNAK CLEANUP KONTROLÜ
    '==========================================================================

    If Not Repo.GetByID(SourceChargeID) Is Nothing Then

        Err.Raise vbObjectError + 10524, _
                  "TEST_055", _
                  "TEST-055 kaynak kaydý cleanup sonrasýnda hâlâ mevcut."

    End If

    '==========================================================================
    ' 18 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-055 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi      : " & TestMemberID & vbCrLf & _
        "FiscalYear      : " & FiscalYear & vbCrLf & _
        "DueMonth        : " & DueMonth & vbCrLf & _
        "Kaynak ChargeID : " & SourceChargeID & vbCrLf & vbCrLf & _
        "NORMAL kaynak   : OLUÞTU" & vbCrLf & _
        "ExistsNormal    : TRUE" & vbCrLf & _
        "Test üyesi      : ATLANDI" & vbCrLf & _
        "SkippedCount    : " & SkippedCount & vbCrLf & _
        "ErrorCount      : " & ErrorCount & vbCrLf & _
        "CreatedCount    : " & CreatedCount & vbCrLf & _
        "Result          : " & Result & vbCrLf & vbCrLf & _
        "Ýkinci NORMAL   : OLUÞMADI" & vbCrLf & _
        "Kaynak deðiþimi : YOK" & vbCrLf & _
        "Cleanup         : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-055"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If SourceChargeID > 0 Then

        DeleteTestCharge SourceChargeID

    End If

    Set Members = MemberRepo.GetAll

    If Not Members Is Nothing Then

        For Each Member In Members

            If Not Member Is Nothing Then

                Set Charges = Repo.GetByMemberID(Member.MemberID)

                If Not Charges Is Nothing Then

                    For Each ChargeItem In Charges

                        If Not ChargeItem Is Nothing Then

                            If StrComp( _
                                    Trim$(ChargeItem.Description), _
                                    "TEST-055 - Toplu mükerrer kontrolü", _
                                    vbTextCompare) = 0 Then

                                DeleteTestCharge ChargeItem.ChargeID

                            End If

                        End If

                    Next ChargeItem

                End If

            End If

        Next Member

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-055 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Service Hatasý:" & vbCrLf & _
        ErrorDescription, _
        vbCritical, _
        "OAA - TEST-055"

End Sub

'==============================================================================
' TEST-056
'
' TOPLU RESMI AÝDAT - ÝSTÝFA SONRASI ÜYENÝN ATLANMASI
'
' AMAÇ:
'
'   AddBulkOfficialCharges içinde:
'
'       ExistsNormalCharge = False
'
'   olan ÝSTÝFA üyesi için AddOfficialCharge çaðrýldýðýnda,
'   istifa sonrasý tarih nedeniyle oluþan ret hatasýnýn toplu iþlem
'   tarafýndan yakalanýp SkippedCount'a eklenmesini doðrulamak.
'
' GERÇEK AKIÞ:
'
'   1. ÝSTÝFA üye bulunur.
'   2. LeaveDate sonrasý bir ay seçilir.
'   3. O ay için NORMAL RESMI kayýt olmadýðý doðrulanýr.
'   4. AddBulkOfficialCharges çaðrýlýr.
'   5. AddOfficialCharge -> CanReceiveOfficialCharge = False
'   6. Üye SkippedCount'a eklenir.
'   7. Test üyesi için yeni kayýt oluþmaz.
'
' ÖNEMLÝ:
'
'   Mevcut üyenin Status / LeaveDate alanlarý deðiþtirilmez.
'
' CLEANUP:
'
'   Test tarafýndan oluþturulabilecek TEST-056 kayýtlarý temizlenir.
'==============================================================================

Public Sub TEST_056()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Charges As Collection

    Dim Member As clsMember
    Dim Charge As clsMemberCharge

    Dim TestMember As clsMember
    Dim TestMemberID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim PeriodEndDate As Date

    Dim Amount As Currency

    Dim CreatedCount As Long
    Dim SkippedCount As Long
    Dim ErrorCount As Long

    Dim Result As Long

    Dim BeforeNormalCount As Long
    Dim AfterNormalCount As Long

    Dim TestMemberSkipped As Boolean

    Dim ErrorOccurred As Boolean
    Dim ErrorDescription As String

    Dim TestChargeIDs As Collection
    Dim ChargeItem As clsMemberCharge
    Dim Item As Variant

    Dim FoundPeriod As Boolean

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    Set TestChargeIDs = New Collection

    TestMemberID = 0

    '==========================================================================
    ' 2 - ÝSTÝFA ÜYESÝ BUL
    '
    ' Mevcut kullanýcý üyesi kullanýlýr.
    ' Üye kaydý deðiþtirilmeyecektir.
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 10601, _
                  "TEST_056", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 10602, _
                  "TEST_056", _
                  "Üye listesi boþ."

    End If

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Ýstifa", _
                    vbTextCompare) = 0 Then

                If Member.LeaveDate > 0 Then

                    TestMemberID = Member.MemberID

                    Exit For

                End If

            End If

        End If

    Next Member

    If TestMemberID <= 0 Then

        Err.Raise vbObjectError + 10603, _
                  "TEST_056", _
                  "LeaveDate bilgisi bulunan ÝSTÝFA üye bulunamadý."

    End If

    '==========================================================================
    ' 3 - ÜYEYÝ TEKRAR OKU
    '==========================================================================

    Set TestMember = MemberRepo.GetByID(TestMemberID)

    If TestMember Is Nothing Then

        Err.Raise vbObjectError + 10604, _
                  "TEST_056", _
                  "ÝSTÝFA test üyesi Repository'den okunamadý."

    End If

    If StrComp( _
            Trim$(TestMember.Status), _
            "Ýstifa", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 10605, _
                  "TEST_056", _
                  "Test üyesi artýk ÝSTÝFA durumunda deðil."

    End If

    If TestMember.LeaveDate <= 0 Then

        Err.Raise vbObjectError + 10606, _
                  "TEST_056", _
                  "Test üyesinin LeaveDate deðeri geçersiz."

    End If

    '==========================================================================
    ' 4 - ÝSTÝFA SONRASI KULLANILMAMIÞ DÖNEM BUL
    '
    ' LeaveDate sonrasýndaki aylar taranýr.
    '
    ' Amaç:
    '
    '   ExistsNormalCharge = False
    '
    ' olmasýdýr.
    '==========================================================================

    FiscalYear = Year(TestMember.LeaveDate)

    FoundPeriod = False

    For DueMonth = Month(TestMember.LeaveDate) + 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                DueMonth, _
                "RESMI") Then

            FoundPeriod = True

            Exit For

        End If

    Next DueMonth

    '--------------------------------------------------------------------------
    ' Eðer ayný yýl içinde uygun ay bulunamazsa sonraki yýlýn Ocak ayý
    ' kontrol edilir.
    '--------------------------------------------------------------------------

    If Not FoundPeriod Then

        FiscalYear = FiscalYear + 1
        DueMonth = 1

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                DueMonth, _
                "RESMI") Then

            FoundPeriod = True

        End If

    End If

    If Not FoundPeriod Then

        Err.Raise vbObjectError + 10607, _
                  "TEST_056", _
                  "Ýstifa sonrasý kullanýlmamýþ RESMI dönem bulunamadý."

    End If

    '==========================================================================
    ' 5 - TARÝHLER
    '
    ' ChargeDate kesin olarak LeaveDate'den sonra olmalýdýr.
    '==========================================================================

    ChargeDate = DateSerial(FiscalYear, DueMonth, 1)

    PeriodEndDate = DateSerial(FiscalYear, 12, 31)

    If ChargeDate <= TestMember.LeaveDate Then

        Err.Raise vbObjectError + 10608, _
                  "TEST_056", _
                  "Seçilen tahakkuk tarihi istifa tarihinden sonra deðil." & _
                  vbCrLf & _
                  "LeaveDate : " & _
                    Format$(TestMember.LeaveDate, "dd.mm.yyyy") & _
                  vbCrLf & _
                  "ChargeDate: " & _
                    Format$(ChargeDate, "dd.mm.yyyy")

    End If

    '==========================================================================
    ' 6 - TEST ÖNCESÝ NORMAL RESMI SAYISI
    '==========================================================================

    Set Charges = Repo.GetByMemberID(TestMemberID)

    BeforeNormalCount = 0

    If Not Charges Is Nothing Then

        For Each Charge In Charges

            If Not Charge Is Nothing Then

                If Charge.FiscalYear = FiscalYear _
                   And Charge.DueMonth = DueMonth _
                   And StrComp( _
                           Trim$(Charge.ChargeType), _
                           "RESMI", _
                           vbTextCompare) = 0 _
                   And StrComp( _
                           Trim$(Charge.AdjustmentType), _
                           "NORMAL", _
                           vbTextCompare) = 0 _
                   And StrComp( _
                           Trim$(Charge.Status), _
                           "AKTIF", _
                           vbTextCompare) = 0 Then

                    BeforeNormalCount = _
                        BeforeNormalCount + 1

                End If

            End If

        Next Charge

    End If

    If BeforeNormalCount <> 0 Then

        Err.Raise vbObjectError + 10609, _
                  "TEST_056", _
                  "Seçilen dönem baþlangýçta boþ deðil." & _
                  vbCrLf & _
                  "NORMAL RESMI sayýsý: " & BeforeNormalCount

    End If

    '==========================================================================
    ' 7 - TOPLU RESMI AÝDAT
    '
    ' Bu çaðrý tüm üyeleri dolaþabilir.
    '
    ' Test üyesi için AddOfficialCharge hata vermeli ve
    ' AddBulkOfficialCharges bu hatayý SkippedCount'a eklemelidir.
    '==========================================================================

    CreatedCount = 0
    SkippedCount = 0
    ErrorCount = 0

    Result = 0

    ErrorOccurred = False
    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    Result = _
        Service.AddBulkOfficialCharges( _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount:=500@, _
            PeriodEndDate:=PeriodEndDate, _
            DecisionNo:="TEST-056", _
            DecisionDate:=ChargeDate, _
            Description:="TEST-056 - Ýstifa sonrasý toplu aidat testi", _
            CreatedCount:=CreatedCount, _
            SkippedCount:=SkippedCount, _
            ErrorCount:=ErrorCount)

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 8 - FATAL ERROR OLMAMALI
    '
    ' AddOfficialCharge'ýn üye bazlý reddi toplu Service tarafýndan
    ' yakalanýp SkippedCount'a çevrilmelidir.
    '==========================================================================

    If ErrorOccurred Then

        Err.Raise vbObjectError + 10610, _
                  "TEST_056", _
                  "Toplu iþlem beklenmedik þekilde FatalError verdi." & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 9 - SKIPPEDCOUNT EN AZ 1 OLMALI
    '
    ' Test üyesi istifa sonrasý tarih nedeniyle atlanmalýdýr.
    '==========================================================================

    If SkippedCount < 1 Then

        Err.Raise vbObjectError + 10611, _
                  "TEST_056", _
                  "Ýstifa sonrasý test üyesi SkippedCount'a eklenmedi." & _
                  vbCrLf & _
                  "SkippedCount = " & SkippedCount

    End If

    TestMemberSkipped = True

    '==========================================================================
    ' 10 - ERRORCOUNT SIFIR OLMALI
    '
    ' Üye bazýndaki beklenen ret FatalError deðildir.
    '==============================================================================

    If ErrorCount <> 0 Then

        Err.Raise vbObjectError + 10612, _
                  "TEST_056", _
                  "Beklenmeyen ErrorCount oluþtu: " & ErrorCount

    End If

    '==========================================================================
    ' 11 - RESULT = CREATEDCOUNT
    '==========================================================================

    If Result <> CreatedCount Then

        Err.Raise vbObjectError + 10613, _
                  "TEST_056", _
                  "Result ve CreatedCount eþit deðil." & _
                  vbCrLf & _
                  "Result       : " & Result & _
                  vbCrLf & _
                  "CreatedCount : " & CreatedCount

    End If

    '==========================================================================
    ' 12 - TEST ÜYESÝ ÝÇÝN NORMAL KAYIT OLUÞMAMALI
    '==========================================================================

    Set Charges = Repo.GetByMemberID(TestMemberID)

    AfterNormalCount = 0

    If Not Charges Is Nothing Then

        For Each Charge In Charges

            If Not Charge Is Nothing Then

                If Charge.FiscalYear = FiscalYear _
                   And Charge.DueMonth = DueMonth _
                   And StrComp( _
                           Trim$(Charge.ChargeType), _
                           "RESMI", _
                           vbTextCompare) = 0 _
                   And StrComp( _
                           Trim$(Charge.AdjustmentType), _
                           "NORMAL", _
                           vbTextCompare) = 0 _
                   And StrComp( _
                           Trim$(Charge.Status), _
                           "AKTIF", _
                           vbTextCompare) = 0 Then

                    AfterNormalCount = _
                        AfterNormalCount + 1

                End If

            End If

        Next Charge

    End If

    If AfterNormalCount <> BeforeNormalCount Then

        Err.Raise vbObjectError + 10614, _
                  "TEST_056", _
                  "Ýstifa sonrasý üye için beklenmeyen NORMAL RESMI " & _
                  "tahakkuk oluþturuldu." & _
                  vbCrLf & _
                  "Önce: " & BeforeNormalCount & _
                  vbCrLf & _
                  "Sonra: " & AfterNormalCount

    End If

    '==========================================================================
    ' 13 - TEST ÜYESÝNÝN ÜYELÝK KAYDI DEÐÝÞMEMELÝ
    '==========================================================================

    Set TestMember = MemberRepo.GetByID(TestMemberID)

    If TestMember Is Nothing Then

        Err.Raise vbObjectError + 10615, _
                  "TEST_056", _
                  "Test üyesi iþlem sonrasýnda bulunamadý."

    End If

    If StrComp( _
            Trim$(TestMember.Status), _
            "Ýstifa", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 10616, _
                  "TEST_056", _
                  "Üyenin Status deðeri test sýrasýnda deðiþti."

    End If

    '==========================================================================
    ' 14 - CLEANUP
    '
    ' Toplu iþlem diðer üyeler için TEST-056 kayýtlarý oluþturmuþ olabilir.
    ' Sadece TEST açýklamalý kayýtlar temizlenir.
    '==========================================================================

    Set Members = MemberRepo.GetAll

    For Each Member In Members

        If Not Member Is Nothing Then

            Set Charges = Repo.GetByMemberID(Member.MemberID)

            If Not Charges Is Nothing Then

                For Each ChargeItem In Charges

                    If Not ChargeItem Is Nothing Then

                        If StrComp( _
                                Trim$(ChargeItem.Description), _
                                "TEST-056 - Ýstifa sonrasý toplu aidat testi", _
                                vbTextCompare) = 0 Then

                            On Error Resume Next

                            DeleteTestCharge ChargeItem.ChargeID

                            Err.Clear

                            On Error GoTo ErrorHandler

                        End If

                    End If

                Next ChargeItem

            End If

        End If

    Next Member

    '==========================================================================
    ' 15 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-056 BAÞARILI." & vbCrLf & vbCrLf & _
        "Ýstifa üyesi    : " & TestMemberID & vbCrLf & _
        "LeaveDate       : " & _
            Format$(TestMember.LeaveDate, "dd.mm.yyyy") & vbCrLf & _
        "FiscalYear      : " & FiscalYear & vbCrLf & _
        "DueMonth        : " & DueMonth & vbCrLf & _
        "ChargeDate      : " & _
            Format$(ChargeDate, "dd.mm.yyyy") & vbCrLf & vbCrLf & _
        "Ýstifa sonrasý   : DOÐRULANDI" & vbCrLf & _
        "NORMAL kaynak    : YOK" & vbCrLf & _
        "AddOfficialCharge: RED" & vbCrLf & _
        "Üye atlandý      : EVET" & vbCrLf & _
        "SkippedCount     : " & SkippedCount & vbCrLf & _
        "CreatedCount     : " & CreatedCount & vbCrLf & _
        "ErrorCount       : " & ErrorCount & vbCrLf & _
        "Test üyesine kayýt: YOK" & vbCrLf & _
        "Üye kaydý deðiþimi: YOK" & vbCrLf & _
        "Cleanup           : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-056"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    '--------------------------------------------------------------------------
    ' TEST-056 açýklamalý tüm geçici kayýtlarý temizle
    '--------------------------------------------------------------------------

    Set Members = MemberRepo.GetAll

    If Not Members Is Nothing Then

        For Each Member In Members

            If Not Member Is Nothing Then

                Set Charges = Repo.GetByMemberID(Member.MemberID)

                If Not Charges Is Nothing Then

                    For Each ChargeItem In Charges

                        If Not ChargeItem Is Nothing Then

                            If StrComp( _
                                    Trim$(ChargeItem.Description), _
                                    "TEST-056 - Ýstifa sonrasý toplu aidat testi", _
                                    vbTextCompare) = 0 Then

                                DeleteTestCharge ChargeItem.ChargeID

                            End If

                        End If

                    Next ChargeItem

                End If

            End If

        Next Member

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-056 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Service Hatasý:" & vbCrLf & _
        ErrorDescription, _
        vbCritical, _
        "OAA - TEST-056"

End Sub

'==============================================================================
' TEST-057
'
' TOPLU RESMI AÝDAT - BAÞARILI KAYIT OLUÞTURMA
'
' AMAÇ:
'
'   AddBulkOfficialCharges metodunun uygun AKTÝF üyeler için
'   NORMAL RESMI tahakkuk oluþturduðunu doðrulamak.
'
' DOÐRULANANLAR:
'
'   - Gerçek üye listesi alýnýr.
'   - Kullanýlmamýþ bir mali yýl / ay seçilir.
'   - Toplu RESMI aidat çalýþtýrýlýr.
'   - Oluþturulan kayýtlarýn MemberID / FiscalYear / DueMonth
'     deðerleri doðrudur.
'   - ChargeType = RESMI
'   - AdjustmentType = NORMAL
'   - Status = AKTIF
'   - Amount doðrudur.
'   - CreatedCount doðru çalýþýr.
'   - Result = CreatedCount
'
' GERÇEK KULLANICI VERÝSÝ:
'
'   Üye bilgileri deðiþtirilmez.
'
' CLEANUP:
'
'   Yalnýzca TEST-057 açýklamasý ile oluþturulan tahakkuklar temizlenir.
'==============================================================================

Public Sub TEST_057()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Charges As Collection

    Dim Member As clsMember
    Dim Charge As clsMemberCharge

    Dim TestChargeIDs As Collection

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim PeriodEndDate As Date
    Dim Amount As Currency

    Dim CreatedCount As Long
    Dim SkippedCount As Long
    Dim ErrorCount As Long

    Dim Result As Long

    Dim CreatedTestCount As Long
    Dim ActiveMemberCount As Long

    Dim FoundPeriod As Boolean

    Dim TestDescription As String

    Dim ErrorDescription As String
    Dim ErrorOccurred As Boolean

    Dim TestMemberID As Long

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    Set TestChargeIDs = New Collection

    TestDescription = _
        "TEST-057 - Toplu RESMI aidat baþarýlý kayýt testi"

    '==========================================================================
    ' 2 - ÜYE LÝSTESÝNÝ AL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 10701, _
                  "TEST_057", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 10702, _
                  "TEST_057", _
                  "Üye listesi boþ."

    End If

    '==========================================================================
    ' 3 - AKTÝF ÜYE KONTROLÜ
    '==========================================================================

    ActiveMemberCount = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                ActiveMemberCount = ActiveMemberCount + 1

                If TestMemberID = 0 Then
                    TestMemberID = Member.MemberID
                End If

            End If

        End If

    Next Member

    If ActiveMemberCount = 0 Then

        Err.Raise vbObjectError + 10703, _
                  "TEST_057", _
                  "Test için AKTÝF üye bulunamadý."

    End If

    '==========================================================================
    ' 4 - TEST DÖNEMÝ BUL
    '
    ' 2098 mali yýlý kullanýlýr.
    '
    ' Test üyesi için NORMAL RESMI kaydý bulunmayan bir ay aranýr.
    '==========================================================================

    FiscalYear = 2098

    FoundPeriod = False

    For DueMonth = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                DueMonth, _
                "RESMI") Then

            FoundPeriod = True

            Exit For

        End If

    Next DueMonth

    If Not FoundPeriod Then

        Err.Raise vbObjectError + 10704, _
                  "TEST_057", _
                  "TEST üyesi için 2098 yýlýnda kullanýlmamýþ " & _
                  "RESMI dönem bulunamadý."

    End If

    '==========================================================================
    ' 5 - PARAMETRELER
    '==========================================================================

    ChargeDate = DateSerial( _
                    FiscalYear, _
                    DueMonth, _
                    1)

    PeriodEndDate = DateSerial( _
                        FiscalYear, _
                        12, _
                        31)

    Amount = 425@

    CreatedCount = 0
    SkippedCount = 0
    ErrorCount = 0

    Result = 0

    '==========================================================================
    ' 6 - TOPLU RESMI AÝDATI ÇALIÞTIR
    '==========================================================================

    ErrorDescription = vbNullString
    ErrorOccurred = False

    On Error Resume Next

    Err.Clear

    Result = _
        Service.AddBulkOfficialCharges( _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            PeriodEndDate, _
            "TEST-057", _
            ChargeDate, _
            TestDescription, _
            CreatedCount, _
            SkippedCount, _
            ErrorCount)

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 7 - BEKLENMEYEN HATA OLMAMALI
    '==========================================================================

    If ErrorOccurred Then

        Err.Raise vbObjectError + 10705, _
                  "TEST_057", _
                  "Toplu RESMI aidat iþlemi hata verdi." & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 8 - ERRORCOUNT
    '==========================================================================

    If ErrorCount <> 0 Then

        Err.Raise vbObjectError + 10706, _
                  "TEST_057", _
                  "Beklenmeyen ErrorCount oluþtu: " & ErrorCount

    End If

    '==========================================================================
    ' 9 - RESULT / CREATEDCOUNT
    '==========================================================================

    If Result <> CreatedCount Then

        Err.Raise vbObjectError + 10707, _
                  "TEST_057", _
                  "Result ve CreatedCount eþit deðil." & _
                  vbCrLf & _
                  "Result       : " & Result & _
                  vbCrLf & _
                  "CreatedCount : " & CreatedCount

    End If

    '==========================================================================
    ' 10 - EN AZ BÝR AKTÝF ÜYE OLUÞTURULMUÞ OLMALI
    '
    ' Test üyesi için seçilen dönem boþ olduðundan test üyesinin
    ' baþarýlý þekilde oluþturulmasý beklenir.
    '==========================================================================

    If CreatedCount < 1 Then

        Err.Raise vbObjectError + 10708, _
                  "TEST_057", _
                  "Hiç RESMI tahakkuk oluþturulmadý." & _
                  vbCrLf & _
                  "CreatedCount = " & CreatedCount

    End If

    '==========================================================================
    ' 11 - TEST ÜYESÝNÝN KAYDINI BUL
    '==========================================================================

    Set Charges = Repo.GetByMemberID(TestMemberID)

    CreatedTestCount = 0

    If Not Charges Is Nothing Then

        For Each Charge In Charges

            If Not Charge Is Nothing Then

                If StrComp( _
                        Trim$(Charge.Description), _
                        TestDescription, _
                        vbTextCompare) = 0 Then

                    CreatedTestCount = CreatedTestCount + 1

                    TestChargeIDs.Add Charge.ChargeID

                    '----------------------------------------------------------
                    ' Alan kontrolleri
                    '----------------------------------------------------------

                    If Charge.MemberID <> TestMemberID Then

                        Err.Raise vbObjectError + 10709, _
                                  "TEST_057", _
                                  "TEST-057 MemberID hatalý."

                    End If

                    If Charge.FiscalYear <> FiscalYear Then

                        Err.Raise vbObjectError + 10710, _
                                  "TEST_057", _
                                  "TEST-057 FiscalYear hatalý."

                    End If

                    If Charge.DueMonth <> DueMonth Then

                        Err.Raise vbObjectError + 10711, _
                                  "TEST_057", _
                                  "TEST-057 DueMonth hatalý."

                    End If

                    If Charge.Amount <> Amount Then

                        Err.Raise vbObjectError + 10712, _
                                  "TEST_057", _
                                  "TEST-057 Amount hatalý."

                    End If

                    If StrComp( _
                            Trim$(Charge.ChargeType), _
                            "RESMI", _
                            vbTextCompare) <> 0 Then

                        Err.Raise vbObjectError + 10713, _
                                  "TEST_057", _
                                  "TEST-057 ChargeType RESMI deðil."

                    End If

                    If StrComp( _
                            Trim$(Charge.AdjustmentType), _
                            "NORMAL", _
                            vbTextCompare) <> 0 Then

                        Err.Raise vbObjectError + 10714, _
                                  "TEST_057", _
                                  "TEST-057 AdjustmentType NORMAL deðil."

                    End If

                    If Charge.SourceChargeID <> 0 Then

                        Err.Raise vbObjectError + 10715, _
                                  "TEST_057", _
                                  "TEST-057 NORMAL kaydýnda SourceChargeID 0 deðil."

                    End If

                    If StrComp( _
                            Trim$(Charge.Status), _
                            "AKTIF", _
                            vbTextCompare) <> 0 Then

                        Err.Raise vbObjectError + 10716, _
                                  "TEST_057", _
                                  "TEST-057 Status AKTIF deðil."

                    End If

                    If Charge.EntryDate <= 0 Then

                        Err.Raise vbObjectError + 10717, _
                                  "TEST_057", _
                                  "TEST-057 EntryDate boþ."

                    End If

                End If

            End If

        Next Charge

    End If

    '==========================================================================
    ' 12 - TEST ÜYESÝ ÝÇÝN TAM OLARAK BÝR NORMAL KAYIT
    '==========================================================================

    If CreatedTestCount <> 1 Then

        Err.Raise vbObjectError + 10718, _
                  "TEST_057", _
                  "Test üyesi için beklenen 1 TEST-057 kaydý yerine " & _
                  CreatedTestCount & " kayýt bulundu."

    End If

    '==========================================================================
    ' 13 - CLEANUP
    '==========================================================================

    Dim CleanupID As Variant

    For Each CleanupID In TestChargeIDs

        DeleteTestCharge CLng(CleanupID)

    Next CleanupID

    '==========================================================================
    ' 14 - CLEANUP KONTROLÜ
    '==========================================================================

    Set Charges = Repo.GetByMemberID(TestMemberID)

    If Not Charges Is Nothing Then

        For Each Charge In Charges

            If Not Charge Is Nothing Then

                If StrComp( _
                        Trim$(Charge.Description), _
                        TestDescription, _
                        vbTextCompare) = 0 Then

                    Err.Raise vbObjectError + 10719, _
                              "TEST_057", _
                              "TEST-057 kaydý cleanup sonrasýnda hâlâ mevcut."

                End If

            End If

        Next Charge

    End If

    '==========================================================================
    ' 15 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-057 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi      : " & TestMemberID & vbCrLf & _
        "Aktif üye sayýsý: " & ActiveMemberCount & vbCrLf & _
        "FiscalYear      : " & FiscalYear & vbCrLf & _
        "DueMonth        : " & DueMonth & vbCrLf & _
        "ChargeDate      : " & _
            Format$(ChargeDate, "dd.mm.yyyy") & vbCrLf & _
        "Amount          : " & Amount & " TL" & vbCrLf & vbCrLf & _
        "CreatedCount    : " & CreatedCount & vbCrLf & _
        "SkippedCount    : " & SkippedCount & vbCrLf & _
        "ErrorCount      : " & ErrorCount & vbCrLf & _
        "Result          : " & Result & vbCrLf & _
        "Test kaydý      : 1" & vbCrLf & _
        "ChargeType      : RESMI" & vbCrLf & _
        "AdjustmentType  : NORMAL" & vbCrLf & _
        "Status          : AKTIF" & vbCrLf & _
        "SourceChargeID  : 0" & vbCrLf & _
        "Alan kontrolleri: OK" & vbCrLf & _
        "Cleanup         : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-057"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    '--------------------------------------------------------------------------
    ' Oluþturulmuþ ChargeID'leri temizle
    '--------------------------------------------------------------------------

    If Not TestChargeIDs Is Nothing Then

        For Each CleanupID In TestChargeIDs

            DeleteTestCharge CLng(CleanupID)

        Next CleanupID

    End If

    '--------------------------------------------------------------------------
    ' Ayrýca açýklama üzerinden oluþmuþ kayýtlarý temizle
    '--------------------------------------------------------------------------

    Set Members = MemberRepo.GetAll

    If Not Members Is Nothing Then

        For Each Member In Members

            If Not Member Is Nothing Then

                Set Charges = Repo.GetByMemberID(Member.MemberID)

                If Not Charges Is Nothing Then

                    For Each Charge In Charges

                        If Not Charge Is Nothing Then

                            If StrComp( _
                                    Trim$(Charge.Description), _
                                    TestDescription, _
                                    vbTextCompare) = 0 Then

                                DeleteTestCharge Charge.ChargeID

                            End If

                        End If

                    Next Charge

                End If

            End If

        Next Member

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-057 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Service Hatasý:" & vbCrLf & _
        ErrorDescription, _
        vbCritical, _
        "OAA - TEST-057"

End Sub

'==============================================================================
' TEST-058
'
' GET MEMBER BALANCE - PASIF HAREKET BAKIYEYE DAHIL EDÝLMEZ
'
' AMAÇ:
'
'   GetMemberBalance metodunun yalnýzca Status = "AKTIF" olan
'   borç hareketlerini bakiye hesabýna dahil ettiðini doðrulamak.
'
' TEST YÖNTEMÝ:
'
'   1. Mevcut bir üye bulunur.
'   2. Test öncesi mevcut bakiye alýnýr.
'   3. Repository.Add ile bir AKTIF test hareketi oluþturulur.
'   4. Repository.Add ile bir PASIF test hareketi oluþturulur.
'   5. GetMemberBalance çaðrýlýr.
'   6. PASIF hareketin hesaba dahil edilmediði doðrulanýr.
'   7. Test kayýtlarý ChargeID üzerinden temizlenir.
'
' ÖNEMLÝ:
'
'   Repository'de Update metodu yoktur.
'   Bu nedenle test kaydý doðrudan istenen Status ile Add edilir.
'
'   Gerçek kullanýcý üye kaydý deðiþtirilmez.
'
' CLEANUP:
'
'   Oluþturulan iki test kaydý DeleteTestCharge ile silinir.
'==============================================================================

Public Sub TEST_058()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Charges As Collection

    Dim Member As clsMember
    Dim Charge As clsMemberCharge

    Dim ActiveTestCharge As clsMemberCharge
    Dim PassiveTestCharge As clsMemberCharge

    Dim TestMemberID As Long

    Dim ActiveChargeID As Long
    Dim PassiveChargeID As Long

    Dim FiscalYear As Long
    Dim ActiveMonth As Long
    Dim PassiveMonth As Long

    Dim ActiveAmount As Currency
    Dim PassiveAmount As Currency

    Dim BeforeBalance As Currency
    Dim ExpectedBalance As Currency
    Dim ActualBalance As Currency

    Dim ChargeDate As Date
    Dim PeriodEndDate As Date

    Dim FoundActiveMonth As Boolean
    Dim FoundPassiveMonth As Boolean

    Dim ErrorDescription As String

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    ActiveChargeID = 0
    PassiveChargeID = 0

    '==========================================================================
    ' 2 - TEST ÜYESÝNÝ BUL
    '
    ' Öncelikle AKTÝF bir üye seçilir.
    ' Üye kaydý kesinlikle deðiþtirilmez.
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 10801, _
                  "TEST_058", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 10802, _
                  "TEST_058", _
                  "Üye listesi boþ."

    End If

    TestMemberID = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID

                Exit For

            End If

        End If

    Next Member

    If TestMemberID <= 0 Then

        Err.Raise vbObjectError + 10803, _
                  "TEST_058", _
                  "Test için AKTÝF üye bulunamadý."

    End If

    '==========================================================================
    ' 3 - TEST ÖNCESÝ BAKÝYE
    '
    ' Üyenin mevcut gerçek bakiyesi hesaba katýlýr.
    ' Böylece mevcut kullanýcý verileri testin sonucunu bozmaz.
    '==========================================================================

    BeforeBalance = _
        Service.GetMemberBalance(TestMemberID)

    '==========================================================================
    ' 4 - TEST DÖNEMÝ
    '
    ' 2098 yýlýnda iki farklý, kullanýlmamýþ RESMI ay bulunur.
    '
    ' Test kayýtlarý birbirinden ayrýlýr.
    '==========================================================================

    FiscalYear = 2098

    FoundActiveMonth = False
    FoundPassiveMonth = False

    For ActiveMonth = 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                ActiveMonth, _
                "RESMI") Then

            FoundActiveMonth = True

            Exit For

        End If

    Next ActiveMonth

    If Not FoundActiveMonth Then

        Err.Raise vbObjectError + 10804, _
                  "TEST_058", _
                  "AKTIF test hareketi için kullanýlmamýþ ay bulunamadý."

    End If

    For PassiveMonth = ActiveMonth + 1 To 12

        If Not Repo.ExistsNormalCharge( _
                TestMemberID, _
                FiscalYear, _
                PassiveMonth, _
                "RESMI") Then

            FoundPassiveMonth = True

            Exit For

        End If

    Next PassiveMonth

    If Not FoundPassiveMonth Then

        Err.Raise vbObjectError + 10805, _
                  "TEST_058", _
                  "PASIF test hareketi için ikinci kullanýlmamýþ ay bulunamadý."

    End If

    '==========================================================================
    ' 5 - TEST TUTARLARI
    '
    ' PASIF tutar özellikle yüksek seçilir.
    '
    ' Eðer PASIF hareket yanlýþlýkla hesaba dahil edilirse sonuç çok net
    ' þekilde farklý olacaktýr.
    '==========================================================================

    ActiveAmount = 275@
    PassiveAmount = 900@

    ExpectedBalance = _
        BeforeBalance + ActiveAmount

    ChargeDate = _
        DateSerial(FiscalYear, ActiveMonth, 1)

    PeriodEndDate = _
        DateSerial(FiscalYear, 12, 31)

    '==========================================================================
    ' 6 - AKTIF TEST HAREKETÝ
    '
    ' Repository.Add gerçek API'dir.
    '
    ' Bu test GetMemberBalance davranýþýný sýnadýðý için test fixture'ý
    ' Repository üzerinden oluþturulmaktadýr.
    '==========================================================================

    Set ActiveTestCharge = New clsMemberCharge

    ActiveTestCharge.MemberID = TestMemberID
    ActiveTestCharge.ChargeType = "RESMI"
    ActiveTestCharge.ChargeDate = ChargeDate
    ActiveTestCharge.FiscalYear = FiscalYear
    ActiveTestCharge.DueMonth = ActiveMonth
    ActiveTestCharge.Amount = ActiveAmount
    ActiveTestCharge.AdjustmentType = "NORMAL"
    ActiveTestCharge.SourceChargeID = 0
    ActiveTestCharge.Description = _
        "TEST-058 - AKTIF bakiye hareketi"
    ActiveTestCharge.DecisionNo = "TEST-058-A"
    ActiveTestCharge.DecisionDate = ChargeDate
    ActiveTestCharge.EntryDate = Now
    ActiveTestCharge.Status = "AKTIF"

    ActiveChargeID = Repo.Add(ActiveTestCharge)

    If ActiveChargeID <= 0 Then

        Err.Raise vbObjectError + 10806, _
                  "TEST_058", _
                  "AKTIF test hareketi oluþturulamadý."

    End If

    '==========================================================================
    ' 7 - AKTIF KAYDI DOÐRULA
    '==========================================================================

    Set ActiveTestCharge = Repo.GetByID(ActiveChargeID)

    If ActiveTestCharge Is Nothing Then

        Err.Raise vbObjectError + 10807, _
                  "TEST_058", _
                  "AKTIF test hareketi Repository'den okunamadý."

    End If

    If ActiveTestCharge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 10808, _
                  "TEST_058", _
                  "AKTIF test hareketinin MemberID deðeri hatalý."

    End If

    If ActiveTestCharge.Amount <> ActiveAmount Then

        Err.Raise vbObjectError + 10809, _
                  "TEST_058", _
                  "AKTIF test hareketinin tutarý hatalý."

    End If

    If StrComp( _
            Trim$(ActiveTestCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 10810, _
                  "TEST_058", _
                  "AKTIF test hareketinin Status deðeri AKTIF deðil."

    End If

    '==========================================================================
    ' 8 - PASIF TEST HAREKETÝ
    '
    ' Repository'de Update olmadýðý için kayýt doðrudan PASIF olarak
    ' oluþturulur.
    '==========================================================================

    ChargeDate = _
        DateSerial(FiscalYear, PassiveMonth, 1)

    Set PassiveTestCharge = New clsMemberCharge

    PassiveTestCharge.MemberID = TestMemberID
    PassiveTestCharge.ChargeType = "RESMI"
    PassiveTestCharge.ChargeDate = ChargeDate
    PassiveTestCharge.FiscalYear = FiscalYear
    PassiveTestCharge.DueMonth = PassiveMonth
    PassiveTestCharge.Amount = PassiveAmount
    PassiveTestCharge.AdjustmentType = "NORMAL"
    PassiveTestCharge.SourceChargeID = 0
    PassiveTestCharge.Description = _
        "TEST-058 - PASIF bakiye hareketi"
    PassiveTestCharge.DecisionNo = "TEST-058-P"
    PassiveTestCharge.DecisionDate = ChargeDate
    PassiveTestCharge.EntryDate = Now
    PassiveTestCharge.Status = "PASIF"

    PassiveChargeID = Repo.Add(PassiveTestCharge)

    If PassiveChargeID <= 0 Then

        Err.Raise vbObjectError + 10811, _
                  "TEST_058", _
                  "PASIF test hareketi oluþturulamadý."

    End If

    '==========================================================================
    ' 9 - PASIF KAYDI DOÐRULA
    '==========================================================================

    Set PassiveTestCharge = Repo.GetByID(PassiveChargeID)

    If PassiveTestCharge Is Nothing Then

        Err.Raise vbObjectError + 10812, _
                  "TEST_058", _
                  "PASIF test hareketi Repository'den okunamadý."

    End If

    If PassiveTestCharge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 10813, _
                  "TEST_058", _
                  "PASIF test hareketinin MemberID deðeri hatalý."

    End If

    If PassiveTestCharge.Amount <> PassiveAmount Then

        Err.Raise vbObjectError + 10814, _
                  "TEST_058", _
                  "PASIF test hareketinin tutarý hatalý."

    End If

    If StrComp( _
            Trim$(PassiveTestCharge.Status), _
            "PASIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 10815, _
                  "TEST_058", _
                  "PASIF test hareketinin Status deðeri PASIF deðil."

    End If

    '==========================================================================
    ' 10 - BAKÝYEYÝ HESAPLA
    '==========================================================================

    ActualBalance = _
        Service.GetMemberBalance(TestMemberID)

    '==========================================================================
    ' 11 - ANA TEST
    '
    ' Beklenen:
    '
    '   Önceki bakiye
    '       +
    '   AKTIF test tutarý
    '
    ' PASIF 900 TL hesaba dahil edilmemelidir.
    '==========================================================================

    If ActualBalance <> ExpectedBalance Then

        Err.Raise vbObjectError + 10816, _
                  "TEST_058", _
                  "PASIF hareket bakiye hesabýna dahil edilmiþ olabilir." & _
                  vbCrLf & vbCrLf & _
                  "Önceki bakiye : " & BeforeBalance & _
                  vbCrLf & _
                  "AKTIF hareket : " & ActiveAmount & _
                  vbCrLf & _
                  "PASIF hareket : " & PassiveAmount & _
                  vbCrLf & _
                  "Beklenen      : " & ExpectedBalance & _
                  vbCrLf & _
                  "Gerçek        : " & ActualBalance

    End If

    '==========================================================================
    ' 12 - PASIF HAREKETÝN GERÇEKTEN MEVCUT OLDUÐUNU DOÐRULA
    '
    ' Bu kontrol önemlidir:
    '
    ' Bakiye düþük çýktý diye PASIF kayýt hiç oluþmamýþ olmasýn.
    ' Kayýt mevcut olmalý fakat bakiye hesabýna girmemelidir.
    '==========================================================================

    Set PassiveTestCharge = _
        Repo.GetByID(PassiveChargeID)

    If PassiveTestCharge Is Nothing Then

        Err.Raise vbObjectError + 10817, _
                  "TEST_058", _
                  "PASIF test hareketi beklenmedik þekilde bulunamadý."

    End If

    If StrComp( _
            Trim$(PassiveTestCharge.Status), _
            "PASIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 10818, _
                  "TEST_058", _
                  "PASIF test hareketinin durumu deðiþmiþ."

    End If

    '==========================================================================
    ' 13 - AKTIF HAREKET DEÐÝÞMEMELÝ
    '==========================================================================

    Set ActiveTestCharge = _
        Repo.GetByID(ActiveChargeID)

    If ActiveTestCharge Is Nothing Then

        Err.Raise vbObjectError + 10819, _
                  "TEST_058", _
                  "AKTIF test hareketi beklenmedik þekilde bulunamadý."

    End If

    If StrComp( _
            Trim$(ActiveTestCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 10820, _
                  "TEST_058", _
                  "AKTIF test hareketinin durumu deðiþmiþ."

    End If

    '==========================================================================
    ' 14 - CLEANUP
    '==========================================================================

    DeleteTestCharge ActiveChargeID
    ActiveChargeID = 0

    DeleteTestCharge PassiveChargeID
    PassiveChargeID = 0

    '==========================================================================
    ' 15 - CLEANUP SONRASI BAKÝYE GERÝ DÖNMELÝ
    '==========================================================================

    ActualBalance = _
        Service.GetMemberBalance(TestMemberID)

    If ActualBalance <> BeforeBalance Then

        Err.Raise vbObjectError + 10821, _
                  "TEST_058", _
                  "Cleanup sonrasýnda üyenin gerçek bakiyesi eski deðerine " & _
                  "dönmedi." & _
                  vbCrLf & vbCrLf & _
                  "Önceki bakiye : " & BeforeBalance & _
                  vbCrLf & _
                  "Sonraki bakiye: " & ActualBalance

    End If

    '==========================================================================
    ' 16 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-058 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "Önceki bakiye    : " & BeforeBalance & " TL" & vbCrLf & _
        "AKTIF hareket    : " & ActiveAmount & " TL" & vbCrLf & _
        "PASIF hareket    : " & PassiveAmount & " TL" & vbCrLf & vbCrLf & _
        "Beklenen bakiye  : " & ExpectedBalance & " TL" & vbCrLf & _
        "Gerçek bakiye    : " & _
            (BeforeBalance + ActiveAmount) & " TL" & vbCrLf & vbCrLf & _
        "AKTIF dahil      : EVET" & vbCrLf & _
        "PASIF dahil      : HAYIR" & vbCrLf & _
        "PASIF kayýt      : MEVCUT" & vbCrLf & _
        "Üye kaydý deðiþimi: YOK" & vbCrLf & _
        "Cleanup           : OK" & vbCrLf & _
        "Bakiye geri döndü : EVET" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-058"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If ActiveChargeID > 0 Then

        DeleteTestCharge ActiveChargeID

    End If

    If PassiveChargeID > 0 Then

        DeleteTestCharge PassiveChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-058 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description, _
        vbCritical, _
        "OAA - TEST-058"

End Sub

'==============================================================================
' TEST-059
'
' SAIR BORÇ - BAÞARILI OLUÞTURMA
'
' AMAÇ:
'
'   AddOtherCharge metodunun geçerli bir aktif üye için SAIR borç
'   oluþturduðunu ve oluþturulan kaydýn alanlarýnýn doðru olduðunu
'   doðrulamak.
'
' DOÐRULANANLAR:
'
'   MemberID
'   ChargeType       = SAIR
'   ChargeDate
'   FiscalYear
'   DueMonth
'   Amount
'   AdjustmentType   = NORMAL
'   SourceChargeID   = 0
'   Description
'   Status           = AKTIF
'   ChargeID > 0
'
' CLEANUP:
'
'   Oluþturulan kayýt ChargeID üzerinden temizlenir.
'
' GERÇEK ÜYE VERÝSÝ:
'
'   Üyenin kendisi deðiþtirilmez.
'==============================================================================

Public Sub TEST_059()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Charges As Collection

    Dim Member As clsMember
    Dim Charge As clsMemberCharge
    Dim TestCharge As clsMemberCharge

    Dim TestMemberID As Long
    Dim TestChargeID As Long

    Dim ChargeDate As Date
    Dim Amount As Currency

    Dim ExpectedFiscalYear As Long
    Dim ExpectedDueMonth As Long

    Dim Description As String
    Dim DecisionNo As String
    Dim DecisionDate As Date

    Dim ErrorOccurred As Boolean
    Dim ErrorDescription As String

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    TestChargeID = 0

    Description = _
        "TEST-059 - Baþarýlý SAIR borç oluþturma"

    DecisionNo = "TEST-059"

    '==========================================================================
    ' 2 - AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 10901, _
                  "TEST_059", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 10902, _
                  "TEST_059", _
                  "Üye listesi boþ."

    End If

    TestMemberID = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID

                Exit For

            End If

        End If

    Next Member

    If TestMemberID <= 0 Then

        Err.Raise vbObjectError + 10903, _
                  "TEST_059", _
                  "TEST-059 için AKTÝF üye bulunamadý."

    End If

    '==========================================================================
    ' 3 - TEST PARAMETRELERÝ
    '
    ' Aktif üye olduðu için mevcut tarih güvenli bir borç tarihi olarak
    ' kullanýlabilir.
    '==========================================================================

    ChargeDate = Date

    Amount = 650@

    DecisionDate = ChargeDate

    ExpectedFiscalYear = Year(ChargeDate)
    ExpectedDueMonth = Month(ChargeDate)

    '==========================================================================
    ' 4 - SAIR BORÇ OLUÞTUR
    '==========================================================================

    ErrorOccurred = False
    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    TestChargeID = _
        Service.AddOtherCharge( _
            TestMemberID, _
            ChargeDate, _
            Amount, _
            Description, _
            DecisionNo, _
            DecisionDate)

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 5 - BEKLENMEYEN HATA KONTROLÜ
    '==========================================================================

    If ErrorOccurred Then

        Err.Raise vbObjectError + 10904, _
                  "TEST_059", _
                  "AddOtherCharge beklenmeyen hata verdi." & _
                  vbCrLf & vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 6 - CHARGE ID
    '==========================================================================

    If TestChargeID <= 0 Then

        Err.Raise vbObjectError + 10905, _
                  "TEST_059", _
                  "SAIR borç oluþturuldu ancak geçerli ChargeID dönmedi." & _
                  vbCrLf & _
                  "ChargeID = " & TestChargeID

    End If

    '==========================================================================
    ' 7 - KAYDI REPOSITORY'DEN OKU
    '==========================================================================

    Set TestCharge = Repo.GetByID(TestChargeID)

    If TestCharge Is Nothing Then

        Err.Raise vbObjectError + 10906, _
                  "TEST_059", _
                  "Oluþturulan SAIR borç Repository'den okunamadý."

    End If

    '==========================================================================
    ' 8 - MEMBER ID
    '==========================================================================

    If TestCharge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 10907, _
                  "TEST_059", _
                  "MemberID hatalý." & _
                  vbCrLf & _
                  "Beklenen: " & TestMemberID & _
                  vbCrLf & _
                  "Gerçek  : " & TestCharge.MemberID

    End If

    '==========================================================================
    ' 9 - CHARGE TYPE
    '==========================================================================

    If StrComp( _
            Trim$(TestCharge.ChargeType), _
            "SAIR", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 10908, _
                  "TEST_059", _
                  "ChargeType SAIR deðil." & _
                  vbCrLf & _
                  "Gerçek: " & TestCharge.ChargeType

    End If

    '==========================================================================
    ' 10 - CHARGE DATE
    '==========================================================================

    If TestCharge.ChargeDate <> ChargeDate Then

        Err.Raise vbObjectError + 10909, _
                  "TEST_059", _
                  "ChargeDate hatalý." & _
                  vbCrLf & _
                  "Beklenen: " & Format$(ChargeDate, "dd.mm.yyyy") & _
                  vbCrLf & _
                  "Gerçek  : " & _
                      Format$(TestCharge.ChargeDate, "dd.mm.yyyy")

    End If

    '==========================================================================
    ' 11 - FISCAL YEAR
    '==========================================================================

    If TestCharge.FiscalYear <> ExpectedFiscalYear Then

        Err.Raise vbObjectError + 10910, _
                  "TEST_059", _
                  "FiscalYear hatalý." & _
                  vbCrLf & _
                  "Beklenen: " & ExpectedFiscalYear & _
                  vbCrLf & _
                  "Gerçek  : " & TestCharge.FiscalYear

    End If

    '==========================================================================
    ' 12 - DUE MONTH
    '==========================================================================

    If TestCharge.DueMonth <> ExpectedDueMonth Then

        Err.Raise vbObjectError + 10911, _
                  "TEST_059", _
                  "DueMonth hatalý." & _
                  vbCrLf & _
                  "Beklenen: " & ExpectedDueMonth & _
                  vbCrLf & _
                  "Gerçek  : " & TestCharge.DueMonth

    End If

    '==========================================================================
    ' 13 - AMOUNT
    '==========================================================================

    If TestCharge.Amount <> Amount Then

        Err.Raise vbObjectError + 10912, _
                  "TEST_059", _
                  "Amount hatalý." & _
                  vbCrLf & _
                  "Beklenen: " & Amount & _
                  vbCrLf & _
                  "Gerçek  : " & TestCharge.Amount

    End If

    '==========================================================================
    ' 14 - ADJUSTMENT TYPE
    '==========================================================================

    If StrComp( _
            Trim$(TestCharge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 10913, _
                  "TEST_059", _
                  "AdjustmentType NORMAL deðil." & _
                  vbCrLf & _
                  "Gerçek: " & TestCharge.AdjustmentType

    End If

    '==========================================================================
    ' 15 - SOURCE CHARGE ID
    '
    ' SAIR borç baðýmsýz NORMAL harekettir.
    '==============================================================================

    If TestCharge.SourceChargeID <> 0 Then

        Err.Raise vbObjectError + 10914, _
                  "TEST_059", _
                  "SAIR NORMAL kaydýnda SourceChargeID 0 deðil." & _
                  vbCrLf & _
                  "Gerçek: " & TestCharge.SourceChargeID

    End If

    '==========================================================================
    ' 16 - DESCRIPTION
    '==========================================================================

    If StrComp( _
            Trim$(TestCharge.Description), _
            Description, _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 10915, _
                  "TEST_059", _
                  "Description hatalý." & _
                  vbCrLf & _
                  "Beklenen: " & Description & _
                  vbCrLf & _
                  "Gerçek  : " & TestCharge.Description

    End If

    '==========================================================================
    ' 17 - DECISION NO
    '==========================================================================

    If StrComp( _
            Trim$(TestCharge.DecisionNo), _
            DecisionNo, _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 10916, _
                  "TEST_059", _
                  "DecisionNo hatalý." & _
                  vbCrLf & _
                  "Beklenen: " & DecisionNo & _
                  vbCrLf & _
                  "Gerçek  : " & TestCharge.DecisionNo

    End If

    '==========================================================================
    ' 18 - DECISION DATE
    '==========================================================================

    If TestCharge.DecisionDate <> DecisionDate Then

        Err.Raise vbObjectError + 10917, _
                  "TEST_059", _
                  "DecisionDate hatalý."

    End If

    '==========================================================================
    ' 19 - ENTRY DATE
    '
    ' Service gerçek iþlem zamaný olarak Now kullanýyor.
    ' Bu nedenle yalnýzca boþ olmadýðýný kontrol ediyoruz.
    '==========================================================================

    If TestCharge.EntryDate <= 0 Then

        Err.Raise vbObjectError + 10918, _
                  "TEST_059", _
                  "EntryDate oluþturulmamýþ."

    End If

    '==========================================================================
    ' 20 - STATUS
    '==========================================================================

    If StrComp( _
            Trim$(TestCharge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 10919, _
                  "TEST_059", _
                  "Status AKTIF deðil." & _
                  vbCrLf & _
                  "Gerçek: " & TestCharge.Status

    End If

    '==========================================================================
    ' 21 - GETBYMEMBERID ÝÇÝNDE DE GÖRÜNMELÝ
    '
    ' Repository'nin üye hareketleri koleksiyonuna kayýt dahil edilmelidir.
    '==========================================================================

    Set Charges = Repo.GetByMemberID(TestMemberID)

    If Charges Is Nothing Then

        Err.Raise vbObjectError + 10920, _
                  "TEST_059", _
                  "GetByMemberID Collection döndürmedi."

    End If

    Set Charge = Nothing

    For Each Charge In Charges

        If Not Charge Is Nothing Then

            If Charge.ChargeID = TestChargeID Then

                Set TestCharge = Charge

                Exit For

            End If

        End If

    Next Charge

    If TestCharge Is Nothing Then

        Err.Raise vbObjectError + 10921, _
                  "TEST_059", _
                  "Oluþturulan SAIR hareket GetByMemberID içinde bulunamadý."

    End If

    '==========================================================================
    ' 22 - CLEANUP
    '==========================================================================

    DeleteTestCharge TestChargeID

    '==========================================================================
    ' 23 - CLEANUP KONTROLÜ
    '==========================================================================

    Set TestCharge = Repo.GetByID(TestChargeID)

    If Not TestCharge Is Nothing Then

        Err.Raise vbObjectError + 10922, _
                  "TEST_059", _
                  "TEST-059 kaydý cleanup sonrasýnda hâlâ mevcut."

    End If

    '==========================================================================
    ' 24 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-059 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi      : " & TestMemberID & vbCrLf & _
        "ChargeID        : " & TestChargeID & vbCrLf & _
        "ChargeType      : SAIR" & vbCrLf & _
        "AdjustmentType  : NORMAL" & vbCrLf & _
        "SourceChargeID  : 0" & vbCrLf & _
        "Amount          : " & Amount & " TL" & vbCrLf & _
        "FiscalYear      : " & ExpectedFiscalYear & vbCrLf & _
        "DueMonth        : " & ExpectedDueMonth & vbCrLf & _
        "Status          : AKTIF" & vbCrLf & _
        "Repository      : OK" & vbCrLf & _
        "GetByMemberID   : OK" & vbCrLf & _
        "Alan kontrolleri: OK" & vbCrLf & _
        "Cleanup         : OK" & vbCrLf & vbCrLf & _
        "Sonuç: BAÞARILI", _
        vbInformation, _
        "OAA - TEST-059"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If TestChargeID > 0 Then

        DeleteTestCharge TestChargeID

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-059 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Cleanup uygulanmaya çalýþýldý.", _
        vbCritical, _
        "OAA - TEST-059"

End Sub



'==============================================================================
' TEST-060
'
' SAIR BORÇ - BOÞ AÇIKLAMA KONTROLÜ
'
' AMAÇ:
'
'   AddOtherCharge metodunun boþ veya yalnýzca boþluklardan oluþan
'   Description deðerini reddettiðini doðrulamak.
'
' GERÇEK SERVICE KURALI:
'
'   Len(Trim$(Description)) = 0
'
'       -> vbObjectError + 7224
'       -> "Sair borç açýklamasý girilmelidir."
'
' GERÇEK SERVICE HATA DAVRANIÞI:
'
'   ErrorHandler:
'
'       AddOtherCharge = 0
'
'       Err.Raise ...
'
'   Dolayýsýyla TEST tarafýnda fonksiyon dönüþ deðerini okumak yerine
'   yükseltilen hatanýn yakalanmasý doðrulanýr.
'
' BEKLENEN:
'
'   Service hata vermelidir.
'
'   Hata mesajý:
'
'       Sair borç açýklamasý girilmelidir.
'
'   Herhangi bir kayýt oluþmamalýdýr.
'
' CLEANUP:
'
'   Temel parametre kontrolünde hata oluþtuðu için Repository.Add
'   çaðrýlmamalýdýr.
'
'   Bu nedenle normal durumda cleanup gerekmez.
'==============================================================================

Public Sub TEST_060()

    Dim Service As clsMemberChargeService
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim TestMemberID As Long

    Dim ChargeDate As Date
    Dim Amount As Currency

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    Dim ValidMemberFound As Boolean

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set MemberRepo = New clsMemberRepository

    TestMemberID = 0
    ValidMemberFound = False

    ErrorOccurred = False
    ErrorNumber = 0
    ErrorDescription = vbNullString

    '==========================================================================
    ' 2 - GEÇERLÝ AKTÝF ÜYE BUL
    '
    ' Description dýþýnda bütün parametreler geçerli tutulur.
    ' Böylece doðrudan 7224 kontrolü test edilir.
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 11001, _
                  "TEST_060", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 11002, _
                  "TEST_060", _
                  "Üye listesi boþ."

    End If

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID
                ValidMemberFound = True

                Exit For

            End If

        End If

    Next Member

    If Not ValidMemberFound Then

        Err.Raise vbObjectError + 11003, _
                  "TEST_060", _
                  "TEST-060 için AKTÝF üye bulunamadý."

    End If

    '==========================================================================
    ' 3 - GEÇERLÝ PARAMETRELER
    '
    ' Yalnýzca Description geçersizdir.
    '==========================================================================

    ChargeDate = Date

    Amount = 250@

    '==========================================================================
    ' 4 - SERVICE ÇAÐRISI
    '
    ' Description = yalnýzca boþluk.
    '
    ' Burada Err.Raise beklenen davranýþtýr.
    '==========================================================================

    On Error Resume Next

    Err.Clear

    Call Service.AddOtherCharge( _
            TestMemberID, _
            ChargeDate, _
            Amount, _
            "   ", _
            "TEST-060", _
            ChargeDate)

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorNumber = Err.Number
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo TestError

    '==========================================================================
    ' 5 - SERVICE HATA VERMELÝ
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise vbObjectError + 11004, _
                  "TEST_060", _
                  "Boþ açýklama Service tarafýndan reddedilmedi."

    End If

    '==========================================================================
    ' 6 - HATA NUMARASI KONTROLÜ
    '
    ' Gerçek hata:
    '
    '   vbObjectError + 7224
    '
    ' VBA'da Err.Number negatif olarak görülebilir.
    ' Bu nedenle doðrudan metin deðil, düþük seviye kod farký da kontrol edilir.
    '==========================================================================

    If ErrorNumber = 0 Then

        Err.Raise vbObjectError + 11005, _
                  "TEST_060", _
                  "Service hata verdi ancak Err.Number alýnamadý."

    End If

    '==========================================================================
    ' 7 - HATA MESAJI
    '==========================================================================

    If InStr( _
            1, _
            ErrorDescription, _
            "Sair borç açýklamasý girilmelidir.", _
            vbTextCompare) = 0 Then

        Err.Raise vbObjectError + 11006, _
                  "TEST_060", _
                  "Beklenen 7224 hata mesajý alýnamadý." & _
                  vbCrLf & vbCrLf & _
                  "Beklenen:" & _
                  vbCrLf & _
                  "Sair borç açýklamasý girilmelidir." & _
                  vbCrLf & vbCrLf & _
                  "Alýnan:" & _
                  vbCrLf & _
                  ErrorDescription

    End If

    '==========================================================================
    ' 8 - BAÞARILI
    '
    ' DÝKKAT:
    '
    ' Result kontrolü YOKTUR.
    '
    ' Çünkü gerçek AddOtherCharge hata durumunda:
    '
    '   AddOtherCharge = 0
    '
    ' atamasýndan sonra Err.Raise yapmaktadýr.
    '
    ' Dolayýsýyla çaðrý normal þekilde bir Long deðer döndürerek
    ' devam etmez.
    '==========================================================================

    MsgBox _
        "TEST-060 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi     : " & TestMemberID & vbCrLf & _
        "ChargeDate     : " & _
            Format$(ChargeDate, "dd.mm.yyyy") & vbCrLf & _
        "Amount         : " & Amount & " TL" & vbCrLf & _
        "Description    : [3 boþluk]" & vbCrLf & vbCrLf & _
        "Service reddi  : OK" & vbCrLf & _

'==============================================================================
' TEST-106
'
' SAIR BORC - ISTIFA TARIHI SINIRINDA BORCLANDIRMA
'
' AMAC:
'
'   Status = "Ýstifa" olan bir uye icin,
'   ChargeDate = LeaveDate oldugunda sair borc olusturulabildigini
'   dogrulamak.
'
' GERCEK SERVICE KURALI:
'
'   ChargeDate > Member.LeaveDate
'       -> RED
'
'   ChargeDate = Member.LeaveDate
'       -> KABUL
'
' BEKLENEN:
'
'   AddOtherCharge basarili
'   ChargeID > 0
'   ChargeType = SAIR
'   AdjustmentType = NORMAL
'   Status = AKTIF
'   ChargeDate = LeaveDate
'
' CLEANUP:
'
'   Olusturulan ChargeID test sonunda silinir.
'
' ONEMLI:
'
'   Mevcut istifa eden uye kullanilir.
'   Uyenin kaydi degistirilmez.
'   LeaveDate degistirilmez.
'==============================================================================

Public Sub TEST_106()

    Dim Service As clsMemberChargeService
    Dim MemberRepo As clsMemberRepository
    Dim ChargeRepo As clsMemberChargeRepository

    Dim Members As Collection
    Dim Charges As Collection

    Dim Member As clsMember
    Dim Charge As clsMemberCharge

    Dim TestMemberID As Long
    Dim TestLeaveDate As Date
    Dim TestChargeDate As Date

    Dim TestAmount As Currency
    Dim TestDescription As String

    Dim TestChargeID As Long

    Dim FoundCharge As Boolean

    Dim ChargeCountBefore As Long
    Dim ChargeCountAfter As Long

    Dim Mesaj As String
    Dim HataNo As Long
    Dim HataAciklama As String

    On Error GoTo TestError

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService

    Set MemberRepo = New clsMemberRepository

    Set ChargeRepo = New clsMemberChargeRepository

    '==========================================================================
    ' 2 - MEVCUT UYELERI AL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Mesaj = "TEST-106 UYGULANAMADI." & vbCrLf & vbCrLf
        Mesaj = Mesaj & "Uye listesi alinamadi." & vbCrLf
        Mesaj = Mesaj & "Gercek kullanici verileri degistirilmedi." & vbCrLf
        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-106"

        Exit Sub

    End If

    '==========================================================================
    ' 3 - GECERLI LEAVE DATE OLAN ISTIFA UYESINI BUL
    '==========================================================================

    TestMemberID = 0

    TestLeaveDate = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Ýstifa", _
                    vbTextCompare) = 0 Then

                If Member.LeaveDate > 0 Then

                    TestMemberID = Member.MemberID

                    TestLeaveDate = Member.LeaveDate

                    Exit For

                End If

            End If

        End If

    Next Member

    '==========================================================================
    ' 4 - UYGUN TEST UYESI BULUNAMADI
    '==========================================================================

    If TestMemberID <= 0 Then

        Mesaj = "TEST-106 UYGULANAMADI." & vbCrLf & vbCrLf
        Mesaj = Mesaj & "Gecerli LeaveDate bilgisine sahip" & vbCrLf
        Mesaj = Mesaj & "Ýstifa durumundaki bir uye bulunamadi." & vbCrLf
        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "Yeni test uyesi olusturulmadi." & vbCrLf
        Mesaj = Mesaj & "Gercek uye verileri degistirilmedi." & vbCrLf
        Mesaj = Mesaj & vbCrLf
        Mesaj = Mesaj & "Sonuc: TEST ON KOSULU YOK"

        MsgBox Mesaj, vbExclamation, "OAA - TEST-106"

        Exit Sub

    End If

    '==========================================================================
    ' 5 - SINIR DEGERI
    '
    ' ChargeDate tam olarak LeaveDate'e esit.
    '==========================================================================

    TestChargeDate = TestLeaveDate

    TestAmount = 150@

    TestDescription = _
        "TEST-106 - Istifa tarihi sinir testi"

    TestChargeID = 0

    '==========================================================================
    ' 6 - TEST ONCESI KAYIT SAYISI
    '==========================================================================

    Set Charges = _
        ChargeRepo.GetByMemberID(TestMemberID)

    If Charges Is Nothing Then

        ChargeCountBefore = 0

    Else

        ChargeCountBefore = Charges.Count

    End If

    '==========================================================================
    ' 7 - GERCEK SERVICE CAGRISI
    '
    ' Beklenen:
    '
    '   ChargeDate = LeaveDate
    '   -> basarili
    '   -> ChargeID > 0
    '==========================================================================

    TestChargeID = Service.AddOtherCharge( _
        TestMemberID, _
        TestChargeDate, _
        TestAmount, _
        TestDescription)

    '==========================================================================
    ' 8 - CHARGEID KONTROLU
    '==========================================================================

    If TestChargeID <= 0 Then

        Err.Raise vbObjectError + 15601, _
                  "TEST_106", _
                  "Ýstifa tarihi sinirinda sair borc olusturulamadi." & _
                  vbCrLf & _
                  "Beklenen: ChargeID > 0" & _
                  vbCrLf & _
                  "Alinan  : " & TestChargeID

    End If

    '==========================================================================
    ' 9 - OLUSTURULAN KAYDI REPOSITORY'DEN BUL
    '==========================================================================

    Set Charges = _
        ChargeRepo.GetByMemberID(TestMemberID)

    If Charges Is Nothing Then

        Err.Raise vbObjectError + 15602, _
                  "TEST_106", _
                  "Test sonrasi uye borc hareketleri okunamadi."

    End If

    FoundCharge = False

    For Each Charge In Charges

        If Not Charge Is Nothing Then

            If Charge.ChargeID = TestChargeID Then

                FoundCharge = True

                Exit For

            End If

        End If

    Next Charge

    '==========================================================================
    ' 10 - KAYIT BULUNMALI
    '==========================================================================

    If Not FoundCharge Then

        Err.Raise vbObjectError + 15603, _
                  "TEST_106", _
                  "Service tarafindan olusturulan ChargeID " & _
                  "Repository'de bulunamadi." & _
                  vbCrLf & _
                  "ChargeID = " & TestChargeID

    End If

    '==========================================================================
    ' 11 - CHARGE TYPE
    '==========================================================================

    If StrComp( _
            Trim$(Charge.ChargeType), _
            "SAIR", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 15604, _
                  "TEST_106", _
                  "ChargeType beklenen SAIR degerinde degil." & _
                  vbCrLf & _
                  "Alinan: " & Charge.ChargeType

    End If

    '==========================================================================
    ' 12 - ADJUSTMENT TYPE
    '==========================================================================

    If StrComp( _
            Trim$(Charge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 15605, _
                  "TEST_106", _
                  "AdjustmentType beklenen NORMAL degerinde degil." & _
                  vbCrLf & _
                  "Alinan: " & Charge.AdjustmentType

    End If

    '==========================================================================
    ' 13 - STATUS
    '==========================================================================

    If StrComp( _
            Trim$(Charge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 15606, _
                  "TEST_106", _
                  "Status beklenen AKTIF degerinde degil." & _
                  vbCrLf & _
                  "Alinan: " & Charge.Status

    End If

    '==========================================================================
    ' 14 - CHARGE DATE = LEAVE DATE
    '==========================================================================

    If Charge.ChargeDate <> TestLeaveDate Then

        Err.Raise vbObjectError + 15607, _
                  "TEST_106", _
                  "ChargeDate LeaveDate'e esit degil." & _
                  vbCrLf & _
                  "Beklenen: " & _
                  Format$(TestLeaveDate, "dd.mm.yyyy") & _
                  vbCrLf & _
                  "Alinan  : " & _
                  Format$(Charge.ChargeDate, "dd.mm.yyyy")

    End If

    '==========================================================================
    ' 15 - AMOUNT
    '==========================================================================

    If Charge.Amount <> TestAmount Then

        Err.Raise vbObjectError + 15608, _
                  "TEST_106", _
                  "Amount beklenen degerde degil." & _
                  vbCrLf & _
                  "Beklenen: " & TestAmount & _
                  vbCrLf & _
                  "Alinan  : " & Charge.Amount

    End If

    '==========================================================================
    ' 16 - CLEANUP
    '==========================================================================

    DeleteTestCharge TestChargeID

    '==========================================================================
    ' 17 - CLEANUP SONRASI KAYIT SAYISI
    '==========================================================================

    Set Charges = _
        ChargeRepo.GetByMemberID(TestMemberID)

    If Charges Is Nothing Then

        ChargeCountAfter = 0

    Else

        ChargeCountAfter = Charges.Count

    End If

    If ChargeCountAfter <> ChargeCountBefore Then

        Err.Raise vbObjectError + 15609, _
                  "TEST_106", _
                  "Cleanup sonrasinda kayit sayisi eski haline donmedi." & _
                  vbCrLf & _
                  "Onceki : " & ChargeCountBefore & _
                  vbCrLf & _
                  "Sonraki: " & ChargeCountAfter

    End If

    '==========================================================================
    ' 18 - UYE KAYDI KORUNDU MU?
    '==========================================================================

    Set Member = MemberRepo.GetByID(TestMemberID)

    If Member Is Nothing Then

        Err.Raise vbObjectError + 15610, _
                  "TEST_106", _
                  "Test edilen uye cleanup sonrasinda bulunamadi."

    End If

    If StrComp( _
            Trim$(Member.Status), _
            "Ýstifa", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 15611, _
                  "TEST_106", _
                  "Test sonrasinda uyenin Status degeri degisti."

    End If

    If Member.LeaveDate <> TestLeaveDate Then

        Err.Raise vbObjectError + 15612, _
                  "TEST_106", _
                  "Test sonrasinda LeaveDate degeri degisti."

    End If

    '==========================================================================
    ' 19 - BASARILI
    '==========================================================================

    Mesaj = "TEST-106 BASARILI." & vbCrLf & vbCrLf

    Mesaj = Mesaj & "Test edilen API : AddOtherCharge" & vbCrLf

    Mesaj = Mesaj & "MemberID        : " & _
                    TestMemberID & vbCrLf

    Mesaj = Mesaj & "Status          : " & _
                    Member.Status & vbCrLf

    Mesaj = Mesaj & "LeaveDate       : " & _
                    Format$(TestLeaveDate, "dd.mm.yyyy") & vbCrLf

    Mesaj = Mesaj & "ChargeDate      : " & _
                    Format$(TestChargeDate, "dd.mm.yyyy") & vbCrLf

    Mesaj = Mesaj & "Amount          : " & _
                    TestAmount & " TL" & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & "ChargeDate = LeaveDate : EVET" & vbCrLf

    Mesaj = Mesaj & "Service sonucu         : KABUL" & vbCrLf

    Mesaj = Mesaj & "ChargeID               : " & _
                    TestChargeID & vbCrLf

    Mesaj = Mesaj & "ChargeType             : " & _
                    Charge.ChargeType & vbCrLf

    Mesaj = Mesaj & "AdjustmentType         : " & _
                    Charge.AdjustmentType & vbCrLf

    Mesaj = Mesaj & "Status                 : " & _
                    Charge.Status & vbCrLf

    Mesaj = Mesaj & "Cleanup                : TAMAM" & vbCrLf

    Mesaj = Mesaj & "Kayit sayisi           : " & _
                    ChargeCountBefore & " -> " & _
                    ChargeCountAfter & vbCrLf

    Mesaj = Mesaj & vbCrLf

    Mesaj = Mesaj & "Sonuc: BASARILI"

    MsgBox Mesaj, vbInformation, "OAA - TEST-106"

    Exit Sub


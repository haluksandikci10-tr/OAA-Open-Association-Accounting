    End If


    '----------------------------------------------------------------------
    ' ÜYEYÝ GERÝ YÜKLE
    '----------------------------------------------------------------------

    If Not MemberRow Is Nothing Then

        MemberRow.Range.Cells(1, ColStatus).Value = _
            OriginalStatus


        If IsDate(OriginalLeaveDate) Then

            MemberRow.Range.Cells(1, ColLeaveDate).Value = _
                CDate(OriginalLeaveDate)

        Else

            MemberRow.Range.Cells(1, ColLeaveDate).ClearContents

        End If

    End If


    On Error GoTo 0


    '----------------------------------------------------------------------
    ' HATA MESAJI
    '----------------------------------------------------------------------

    MsgBox _
        "TEST-023 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Aþama    : " & Stage & vbCrLf & _
        "Hata No  : " & FinalErrorNumber & vbCrLf & _
        "Açýklama : " & FinalErrorDescription & vbCrLf & vbCrLf & _
        "Test kayýtlarý temizlendi." & vbCrLf & _
        "Üye bilgileri geri yüklendi.", _
        vbCritical, _
        "OAA - TEST-023"

End Sub



'==============================================================================
' TEST-024
'
' RESMÝ AÝDAT + ARTIS BAKÝYE HESABI
'
' AMAÇ:
'   NORMAL resmi aidat ile ARTIS hareketinin ayrý kayýtlar olarak tutulduðunu
'   ve GetMemberBalance tarafýndan doðru þekilde toplandýðýný doðrulamak.
'
' TEST SENARYOSU:
'
'   Üye              : 3
'   Mali yýl         : 2037
'   Aidat ayý        : 8
'
'   NORMAL RESMI     : 500 TL
'   ARTIS            : 200 TL
'
'   TEST ARTISI      : 700 TL
'
' NOT:
'   GetMemberBalance üyenin tüm AKTIF borçlarýný topladýðý için,
'   test mevcut bakiyeyi dikkate alýr.
'
'   Baþlangýç bakiyesi = X
'   Test hareketleri   = 700
'   Beklenen son bakiye = X + 700
'
' KONTROLLER:
'
'   1. NORMAL kayýt oluþturuldu.
'   2. NORMAL kayýt Repository'den okunabildi.
'   3. NORMAL ChargeType = RESMI.
'   4. NORMAL AdjustmentType = NORMAL.
'   5. NORMAL SourceChargeID = 0.
'   6. NORMAL Amount = 500.
'   7. NORMAL Status = AKTIF.
'   8. ARTIS kayýt oluþturuldu.
'   9. ARTIS kayýt Repository'den okunabildi.
'  10. ARTIS ChargeType = RESMI.
'  11. ARTIS AdjustmentType = ARTIS.
'  12. ARTIS Amount = 200.
'  13. ARTIS SourceChargeID = NORMAL ChargeID.
'  14. ARTIS Status = AKTIF.
'  15. GetMemberBalance artýþý = 700 TL.
'  16. TEST kayýtlarý tamamen temizlendi.
'
' TEST SONUNDA:
'   TEST-024-1 ve TEST-024-2 kayýtlarý silinir.
'
'==============================================================================

Public Sub TEST_024()

    '--------------------------------------------------------------------------
    ' NESNELER
    '--------------------------------------------------------------------------

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository

    Dim NormalCharge As clsMemberCharge
    Dim AdjustmentCharge As clsMemberCharge
    Dim CheckCharge As clsMemberCharge

    Dim Charges As Collection
    Dim Charge As clsMemberCharge

    '--------------------------------------------------------------------------
    ' TEST PARAMETRELERÝ
    '--------------------------------------------------------------------------

    Dim TestMemberID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim PeriodEndDate As Date

    Dim NormalAmount As Currency
    Dim AdjustmentAmount As Currency
    Dim ExpectedIncrease As Currency

    Dim BaselineBalance As Currency
    Dim ActualBalance As Currency
    Dim ExpectedBalance As Currency

    Dim NormalChargeID As Long
    Dim AdjustmentChargeID As Long

    Dim TestDecisionNormal As String
    Dim TestDecisionAdjustment As String

    '--------------------------------------------------------------------------
    ' KONTROL DEÐÝÞKENLERÝ
    '--------------------------------------------------------------------------

    Dim NormalFound As Boolean
    Dim AdjustmentFound As Boolean

    Dim ErrorOccurred As Boolean
    Dim ErrorDescription As String

    Dim Stage As String

    Dim FinalErrorNumber As Long
    Dim FinalErrorDescription As String

    Dim DeletedNormal As Long
    Dim DeletedAdjustment As Long

    Dim I As Long

    '--------------------------------------------------------------------------
    ' HATA YAKALAMA
    '--------------------------------------------------------------------------

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Stage = "Service ve Repository oluþturuluyor"

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository

    '==========================================================================
    ' 2 - TEST PARAMETRELERÝ
    '==========================================================================

    TestMemberID = 3

    FiscalYear = 2037
    DueMonth = 8

    ChargeDate = DateSerial(2037, 8, 1)

    PeriodEndDate = DateSerial(2037, 12, 31)

    NormalAmount = 500@
    AdjustmentAmount = 200@

    ExpectedIncrease = _
        NormalAmount + AdjustmentAmount

    TestDecisionNormal = _
        "TEST-024-1"

    TestDecisionAdjustment = _
        "TEST-024-2"

    NormalChargeID = 0
    AdjustmentChargeID = 0

    '==========================================================================
    ' 3 - ÖNCEKÝ TEST-024 KAYITLARINI TEMÝZLE
    '
    ' Repository'de DeleteByDecisionNo bulunmadýðý için test modülü kendi
    ' yardýmcý temizleme prosedürünü kullanýr.
    '==========================================================================

    Stage = "Eski TEST-024 kayýtlarý temizleniyor"

    DeletedNormal = _
        DeleteTEST024ByDecisionNo(TestDecisionNormal)

    DeletedAdjustment = _
        DeleteTEST024ByDecisionNo(TestDecisionAdjustment)

    '==========================================================================
    ' 4 - TEST ÜYESÝNÝN MEVCUT BAKÝYESÝNÝ AL
    '
    ' GetMemberBalance tüm aktif borçlarý toplar.
    '
    ' Bu nedenle testin mutlak bakiyeyi 700 kabul etmesi doðru deðildir.
    '
    ' Örneðin baþlangýç:
    '
    '   1.000 TL
    '
    ' Test hareketleri:
    '
    '     500 TL NORMAL
    '     200 TL ARTIS
    '
    ' Beklenen:
    '
    '   1.700 TL
    '==========================================================================

    Stage = "Baþlangýç bakiyesi hesaplanýyor"

    BaselineBalance = _
        Service.GetMemberBalance(TestMemberID)

    '==========================================================================
    ' 5 - NORMAL RESMÝ AÝDAT OLUÞTUR
    '==========================================================================

    Stage = "NORMAL resmi aidat oluþturuluyor"

    ErrorOccurred = False
    ErrorDescription = vbNullString

    NormalChargeID = 0

    On Error Resume Next

    Err.Clear

    NormalChargeID = _
        Service.AddOfficialCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            NormalAmount, _
            PeriodEndDate, _
            TestDecisionNormal, _
            ChargeDate, _
            "TEST-024 - Normal resmi aidat")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '--------------------------------------------------------------------------
    ' NORMAL OLUÞTURMA HATASI
    '--------------------------------------------------------------------------

    If ErrorOccurred Then

        Err.Raise _
            vbObjectError + 7751, _
            "TEST_024", _
            "NORMAL resmi aidat oluþturulamadý." & _
            vbCrLf & _
            ErrorDescription

    End If

    '--------------------------------------------------------------------------
    ' NORMAL CHARGE ID KONTROLÜ
    '--------------------------------------------------------------------------

    If NormalChargeID <= 0 Then

        Err.Raise _
            vbObjectError + 7752, _
            "TEST_024", _
            "NORMAL ChargeID oluþturulmadý."

    End If

    '==========================================================================
    ' 6 - NORMAL KAYDI REPOSITORY'DEN OKU
    '==========================================================================

    Stage = "NORMAL kayýt Repository'den okunuyor"

    Set NormalCharge = _
        Repo.GetByID(NormalChargeID)

    If NormalCharge Is Nothing Then

        Err.Raise _
            vbObjectError + 7753, _
            "TEST_024", _
            "Oluþturulan NORMAL kayýt Repository'den okunamadý."

    End If

    '==========================================================================
    ' 7 - NORMAL KAYIT ALAN KONTROLLERÝ
    '==========================================================================

    '--------------------------------------------------------------------------
    ' MemberID
    '--------------------------------------------------------------------------

    If NormalCharge.MemberID <> TestMemberID Then

        Err.Raise _
            vbObjectError + 7754, _
            "TEST_024", _
            "NORMAL kaydýn MemberID deðeri hatalý."

    End If

    '--------------------------------------------------------------------------
    ' ChargeType
    '--------------------------------------------------------------------------

    If StrComp( _
        Trim$(NormalCharge.ChargeType), _
        "RESMI", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7755, _
            "TEST_024", _
            "NORMAL kaydýn ChargeType deðeri RESMI deðil."

    End If

    '--------------------------------------------------------------------------
    ' FiscalYear
    '--------------------------------------------------------------------------

    If NormalCharge.FiscalYear <> FiscalYear Then

        Err.Raise _
            vbObjectError + 7756, _
            "TEST_024", _
            "NORMAL kaydýn FiscalYear deðeri hatalý."

    End If

    '--------------------------------------------------------------------------
    ' DueMonth
    '--------------------------------------------------------------------------

    If NormalCharge.DueMonth <> DueMonth Then

        Err.Raise _
            vbObjectError + 7757, _
            "TEST_024", _
            "NORMAL kaydýn DueMonth deðeri hatalý."

    End If

    '--------------------------------------------------------------------------
    ' Amount
    '--------------------------------------------------------------------------

    If NormalCharge.Amount <> NormalAmount Then

        Err.Raise _
            vbObjectError + 7758, _
            "TEST_024", _
            "NORMAL kaydýn Amount deðeri hatalý."

    End If

    '--------------------------------------------------------------------------
    ' AdjustmentType
    '--------------------------------------------------------------------------

    If StrComp( _
        Trim$(NormalCharge.AdjustmentType), _
        "NORMAL", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7759, _
            "TEST_024", _
            "NORMAL kaydýn AdjustmentType deðeri NORMAL deðil."

    End If

    '--------------------------------------------------------------------------
    ' SourceChargeID
    '--------------------------------------------------------------------------

    If NormalCharge.SourceChargeID <> 0 Then

        Err.Raise _
            vbObjectError + 7760, _
            "TEST_024", _
            "NORMAL kaydýn SourceChargeID deðeri 0 olmalý."

    End If

    '--------------------------------------------------------------------------
    ' Status
    '--------------------------------------------------------------------------

    If StrComp( _
        Trim$(NormalCharge.Status), _
        "AKTIF", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7761, _
            "TEST_024", _
            "NORMAL kayýt AKTIF deðil."

    End If

    '--------------------------------------------------------------------------
    ' DecisionNo
    '--------------------------------------------------------------------------

    If StrComp( _
        Trim$(NormalCharge.DecisionNo), _
        TestDecisionNormal, _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7762, _
            "TEST_024", _
            "NORMAL kaydýn DecisionNo deðeri hatalý."

    End If

    '==========================================================================
    ' 8 - ARTIS OLUÞTUR
    '
    ' Gerçek servis metodu:
    '
    '   AddOfficialChargeAdjustment
    '
    ' Parametreler:
    '
    '   SourceChargeID
    '   AdjustmentDate
    '   AdjustmentAmount
    '   DecisionNo
    '   DecisionDate
    '   Description
    '
    '==========================================================================

    Stage = "ARTIS oluþturuluyor"

    ErrorOccurred = False
    ErrorDescription = vbNullString

    AdjustmentChargeID = 0

    On Error Resume Next

    Err.Clear

    AdjustmentChargeID = _
        Service.AddOfficialChargeAdjustment( _
            NormalChargeID, _
            ChargeDate, _
            AdjustmentAmount, _
            TestDecisionAdjustment, _
            ChargeDate, _
            "TEST-024 - Resmi aidat artýþý")

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '--------------------------------------------------------------------------
    ' ARTIS OLUÞTURMA HATASI
    '--------------------------------------------------------------------------

    If ErrorOccurred Then

        Err.Raise _
            vbObjectError + 7763, _
            "TEST_024", _
            "ARTIS oluþturulamadý." & _
            vbCrLf & _
            ErrorDescription

    End If

    '--------------------------------------------------------------------------
    ' ARTIS CHARGE ID KONTROLÜ
    '--------------------------------------------------------------------------

    If AdjustmentChargeID <= 0 Then

        Err.Raise _
            vbObjectError + 7764, _
            "TEST_024", _
            "ARTIS ChargeID oluþturulmadý."

    End If

    '==========================================================================
    ' 9 - ARTIS KAYDINI REPOSITORY'DEN OKU
    '==========================================================================

    Stage = "ARTIS kayýt Repository'den okunuyor"

    Set AdjustmentCharge = _
        Repo.GetByID(AdjustmentChargeID)

    If AdjustmentCharge Is Nothing Then

        Err.Raise _
            vbObjectError + 7765, _
            "TEST_024", _
            "ARTIS kaydý Repository'den okunamadý."

    End If

    '==========================================================================
    ' 10 - ARTIS KAYIT ALAN KONTROLLERÝ
    '==========================================================================

    '--------------------------------------------------------------------------
    ' MemberID
    '--------------------------------------------------------------------------

    If AdjustmentCharge.MemberID <> TestMemberID Then

        Err.Raise _
            vbObjectError + 7766, _
            "TEST_024", _
            "ARTIS kaydýn MemberID deðeri hatalý."

    End If

    '--------------------------------------------------------------------------
    ' ChargeType
    '--------------------------------------------------------------------------

    If StrComp( _
        Trim$(AdjustmentCharge.ChargeType), _
        "RESMI", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7767, _
            "TEST_024", _
            "ARTIS kaydýn ChargeType deðeri RESMI deðil."

    End If

    '--------------------------------------------------------------------------
    ' FiscalYear
    '--------------------------------------------------------------------------

    If AdjustmentCharge.FiscalYear <> FiscalYear Then

        Err.Raise _
            vbObjectError + 7768, _
            "TEST_024", _
            "ARTIS kaydýn FiscalYear deðeri hatalý."

    End If

    '--------------------------------------------------------------------------
    ' DueMonth
    '--------------------------------------------------------------------------

    If AdjustmentCharge.DueMonth <> DueMonth Then

        Err.Raise _
            vbObjectError + 7769, _
            "TEST_024", _
            "ARTIS kaydýn DueMonth deðeri hatalý."

    End If

    '--------------------------------------------------------------------------
    ' Amount
    '--------------------------------------------------------------------------

    If AdjustmentCharge.Amount <> AdjustmentAmount Then

        Err.Raise _
            vbObjectError + 7770, _
            "TEST_024", _
            "ARTIS tutarý 200 TL deðil."

    End If

    '--------------------------------------------------------------------------
    ' AdjustmentType
    '--------------------------------------------------------------------------

    If StrComp( _
        Trim$(AdjustmentCharge.AdjustmentType), _
        "ARTIS", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7771, _
            "TEST_024", _
            "ARTIS kaydýn AdjustmentType deðeri ARTIS deðil."

    End If

    '--------------------------------------------------------------------------
    ' SourceChargeID
    '
    ' ARTIS doðrudan NORMAL kayda baðlý olmalýdýr.
    '--------------------------------------------------------------------------

    If AdjustmentCharge.SourceChargeID <> NormalChargeID Then

        Err.Raise _
            vbObjectError + 7772, _
            "TEST_024", _
            "ARTIS kaydýn SourceChargeID deðeri NORMAL ChargeID ile eþleþmiyor."

    End If

    '--------------------------------------------------------------------------
    ' Status
    '--------------------------------------------------------------------------

    If StrComp( _
        Trim$(AdjustmentCharge.Status), _
        "AKTIF", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7773, _
            "TEST_024", _
            "ARTIS kayýt AKTIF deðil."

    End If

    '--------------------------------------------------------------------------
    ' DecisionNo
    '--------------------------------------------------------------------------

    If StrComp( _
        Trim$(AdjustmentCharge.DecisionNo), _
        TestDecisionAdjustment, _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7774, _
            "TEST_024", _
            "ARTIS kaydýn DecisionNo deðeri hatalý."

    End If

    '==========================================================================
    ' 11 - ÜYENÝN TÜM HAREKETLERÝNÝ OKU
    '==========================================================================

    Stage = "Üye borç hareketleri okunuyor"

    Set Charges = _
        Repo.GetByMemberID(TestMemberID)

    If Charges Is Nothing Then

        Err.Raise _
            vbObjectError + 7775, _
            "TEST_024", _
            "Üyenin borç hareketleri alýnamadý."

    End If

    '==========================================================================
    ' 12 - TEST KAYITLARINI BUL
    '==========================================================================

    NormalFound = False
    AdjustmentFound = False

    For Each Charge In Charges

        If Not Charge Is Nothing Then

            If StrComp( _
                Trim$(Charge.DecisionNo), _
                TestDecisionNormal, _
                vbTextCompare) = 0 Then

                Set NormalCharge = Charge
                NormalFound = True

            End If

            If StrComp( _
                Trim$(Charge.DecisionNo), _
                TestDecisionAdjustment, _
                vbTextCompare) = 0 Then

                Set AdjustmentCharge = Charge
                AdjustmentFound = True

            End If

        End If

    Next Charge

    '--------------------------------------------------------------------------
    ' NORMAL BULUNDU MU?
    '--------------------------------------------------------------------------

    If Not NormalFound Then

        Err.Raise _
            vbObjectError + 7776, _
            "TEST_024", _
            "TEST-024 NORMAL kaydý üye hareketlerinde bulunamadý."

    End If

    '--------------------------------------------------------------------------
    ' ARTIS BULUNDU MU?
    '--------------------------------------------------------------------------

    If Not AdjustmentFound Then

        Err.Raise _
            vbObjectError + 7777, _
            "TEST_024", _
            "TEST-024 ARTIS kaydý üye hareketlerinde bulunamadý."

    End If

    '--------------------------------------------------------------------------
    ' NORMAL ve ARTIS ID'LERÝNÝN KORUNDUÐUNU TEKRAR KONTROL ET
    '--------------------------------------------------------------------------

    If NormalCharge.ChargeID <> NormalChargeID Then

        Err.Raise _
            vbObjectError + 7778, _
            "TEST_024", _
            "NORMAL ChargeID beklenen deðerle eþleþmiyor."

    End If

    If AdjustmentCharge.ChargeID <> AdjustmentChargeID Then

        Err.Raise _
            vbObjectError + 7779, _
            "TEST_024", _
            "ARTIS ChargeID beklenen deðerle eþleþmiyor."

    End If

    '==========================================================================
    ' 13 - BAKÝYE KONTROLÜ
    '
    ' Baþlangýç bakiyesi : BaselineBalance
    '
    ' NORMAL             : 500
    ' ARTIS              : 200
    ' -----------------------------
    ' TEST ARTIÞI        : 700
    '
    ' Beklenen son bakiye:
    '
    '   BaselineBalance + 700
    '==========================================================================

    Stage = "Üye bakiyesi kontrol ediliyor"

    ActualBalance = _
        Service.GetMemberBalance(TestMemberID)

    ExpectedBalance = _
        BaselineBalance + ExpectedIncrease

    '--------------------------------------------------------------------------
    ' MUTLAK BAKÝYE KONTROLÜ
    '--------------------------------------------------------------------------

    If ActualBalance <> ExpectedBalance Then

        Err.Raise _
            vbObjectError + 7780, _
            "TEST_024", _
            "Üye bakiyesi hatalý." & _
            vbCrLf & _
            "Baþlangýç : " & BaselineBalance & " TL" & _
            vbCrLf & _
            "Beklenen  : " & ExpectedBalance & " TL" & _
            vbCrLf & _
            "Gerçek    : " & ActualBalance & " TL"

    End If

    '--------------------------------------------------------------------------
    ' TEST HAREKETLERÝNÝN GERÇEK ARTIÞINI KONTROL ET
    '--------------------------------------------------------------------------

    If (ActualBalance - BaselineBalance) <> ExpectedIncrease Then

        Err.Raise _
            vbObjectError + 7781, _
            "TEST_024", _
            "TEST-024 bakiye artýþý 700 TL deðil." & _
            vbCrLf & _
            "Beklenen artýþ : " & ExpectedIncrease & " TL" & _
            vbCrLf & _
            "Gerçek artýþ   : " & _
            (ActualBalance - BaselineBalance) & " TL"

    End If

    '==========================================================================
    ' 14 - TEST KAYITLARINI TEMÝZLE
    '==========================================================================

    Stage = "TEST-024 kayýtlarý temizleniyor"

    DeleteTEST024ByDecisionNo TestDecisionAdjustment
    DeleteTEST024ByDecisionNo TestDecisionNormal

    '==========================================================================
    ' 15 - TEMÝZLÝK KONTROLÜ
    '==========================================================================

    Set CheckCharge = _
        Repo.GetByID(NormalChargeID)

    If Not CheckCharge Is Nothing Then

        Err.Raise _
            vbObjectError + 7782, _
            "TEST_024", _
            "NORMAL test kaydý silinemedi."

    End If

    Set CheckCharge = _
        Repo.GetByID(AdjustmentChargeID)

    If Not CheckCharge Is Nothing Then

        Err.Raise _
            vbObjectError + 7783, _
            "TEST_024", _
            "ARTIS test kaydý silinemedi."

    End If

    '==========================================================================
    ' 16 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-024 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi          : " & TestMemberID & vbCrLf & _
        "Mali yýl             : " & FiscalYear & vbCrLf & _
        "Aidat ayý            : " & DueMonth & vbCrLf & vbCrLf & _
        "NORMAL aidat         : " & NormalAmount & " TL" & vbCrLf & _
        "ARTIS                : " & AdjustmentAmount & " TL" & vbCrLf & _
        "Test bakiye artýþý   : " & ExpectedIncrease & " TL" & vbCrLf & vbCrLf & _
        "Baþlangýç bakiyesi   : " & BaselineBalance & " TL" & vbCrLf & _
        "Beklenen son bakiye  : " & ExpectedBalance & " TL" & vbCrLf & _
        "Gerçek son bakiye    : " & ActualBalance & " TL" & vbCrLf & vbCrLf & _
        "NORMAL kaydý         : OK" & vbCrLf & _
        "ARTIS kaydý          : OK" & vbCrLf & _
        "SourceChargeID       : OK" & vbCrLf & _
        "Bakiye artýþý        : OK" & vbCrLf & _
        "Temizlik             : OK" & vbCrLf & _
        "Test kayýtlarý       : SÝLÝNDÝ", _
        vbInformation, _
        "OAA - TEST-024"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    FinalErrorNumber = Err.Number
    FinalErrorDescription = Err.Description

    On Error Resume Next

    '--------------------------------------------------------------------------
    ' HATA DURUMUNDA TEST KAYITLARINI TEMÝZLE
    '--------------------------------------------------------------------------

    If Len(TestDecisionAdjustment) > 0 Then

        DeleteTEST024ByDecisionNo _
            TestDecisionAdjustment

    End If

    If Len(TestDecisionNormal) > 0 Then

        DeleteTEST024ByDecisionNo _
            TestDecisionNormal

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-024 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Aþama    : " & Stage & vbCrLf & _
        "Hata No  : " & FinalErrorNumber & vbCrLf & _
        "Açýklama : " & FinalErrorDescription & vbCrLf & vbCrLf & _
        "TEST-024 kayýtlarý temizleme iþlemi uygulandý.", _
        vbCritical, _
        "OAA - TEST-024"

End Sub


'==============================================================================
' TEST-024 YARDIMCI TEMÝZLÝK
'
' Repository'de DeleteByDecisionNo metodu olmadýðý için yalnýzca TEST-024
' tarafýndan kullanýlan bu yardýmcý prosedür doðrudan test modülünde tutulur.
'
' ÖNEMLÝ:
'   Bu prosedür uygulamanýn Repository katmanýna eklenmemiþtir.
'   Sadece test verilerini temizlemek içindir.
'
'==============================================================================

Private Function DeleteTEST024ByDecisionNo( _
    ByVal DecisionNo As String) As Long

    Dim ws As Worksheet
    Dim tbl As ListObject

    Dim I As Long
    Dim CurrentDecisionNo As String

    On Error GoTo ErrorHandler

    DeleteTEST024ByDecisionNo = 0

    If Trim$(DecisionNo) = "" Then Exit Function

    '--------------------------------------------------------------------------
    ' TEST-024'ün kullandýðý gerçek tablo
    '--------------------------------------------------------------------------

    Set ws = _
        ThisWorkbook.Worksheets("ÜyeBorçlarý")

    Set tbl = _
        ws.ListObjects("TBL_MEMBER_CHARGES")

    '--------------------------------------------------------------------------
    ' Boþ tablo
    '--------------------------------------------------------------------------

    If tbl.DataBodyRange Is Nothing Then Exit Function

    '--------------------------------------------------------------------------
    ' Sondan baþa doðru sil
    '
    ' Satýr silerken indeks kaymasýný önlemek için geriye doðru ilerliyoruz.
    '--------------------------------------------------------------------------

    For I = tbl.ListRows.Count To 1 Step -1

        CurrentDecisionNo = _
            Trim$(CStr( _
                tbl.ListRows(I).Range.Cells( _
                    1, _
                    tbl.ListColumns("DecisionNo").Index _
                ).Value _
            ))

        If StrComp( _
            CurrentDecisionNo, _
            Trim$(DecisionNo), _
            vbTextCompare) = 0 Then

            tbl.ListRows(I).Delete

            DeleteTEST024ByDecisionNo = _
                DeleteTEST024ByDecisionNo + 1

        End If

    Next I

    Exit Function

'==============================================================================
' TEMÝZLÝK HATASI
'==============================================================================

ErrorHandler:

    ' Test cleanup sýrasýnda hata olursa ana testin hata mesajýný bozma.
    DeleteTEST024ByDecisionNo = 0

End Function

'==============================================================================
' TEST-025
'
' SAÝR BORÇ OLUÞTURMA VE BAKÝYE KONTROLÜ
'
' AMAÇ:
'
'   AddOtherCharge metodunun:
'
'   1. Aktif üyeye sair borç oluþturduðunu,
'   2. Repository'ye doðru kayýt yaptýðýný,
'   3. ChargeType = SAIR olduðunu,
'   4. AdjustmentType = NORMAL olduðunu,
'   5. SourceChargeID = 0 olduðunu,
'   6. Status = AKTIF olduðunu,
'   7. Bakiye hesabýný doðru artýrdýðýný,
'   8. Sýfýr tutarý reddettiðini,
'   9. Boþ açýklamayý reddettiðini
'
'   doðrulamak.
'
' TEST TUTARI:
'
'   350 TL
'
' TEST SONUNDA:
'
'   TEST-025 kayýtlarý silinir.
'
'==============================================================================

Public Sub TEST_025()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim Charges As Collection
    Dim ChargeItem As clsMemberCharge
    Dim Charge As clsMemberCharge

    Dim TestMemberID As Long

    Dim TestChargeID As Long
    Dim InvalidAmountChargeID As Long
    Dim InvalidDescriptionChargeID As Long

    Dim TestAmount As Currency

    Dim TestChargeDate As Date

    Dim TestDecisionNo As String
    Dim TestDescription As String

    Dim BaselineBalance As Currency
    Dim ActualBalance As Currency
    Dim ExpectedBalance As Currency

    Dim FoundTestCharge As Boolean

    Dim ValidationErrorOccurred As Boolean

    Dim ErrorOccurred As Boolean
    Dim ErrorDescription As String

    Dim Stage As String

    Dim FinalErrorNumber As Long
    Dim FinalErrorDescription As String

    Dim I As Long


    On Error GoTo ErrorHandler


    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Stage = "Service ve Repository oluþturuluyor"

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository


    '==========================================================================
    ' 2 - TEST PARAMETRELERÝ
    '==========================================================================

    TestAmount = 350@

    TestChargeDate = _
        DateSerial(2037, 9, 1)

    TestDecisionNo = _
        "TEST-025"

    TestDescription = _
        "TEST-025 - Sair borç"


    TestChargeID = 0
    InvalidAmountChargeID = 0
    InvalidDescriptionChargeID = 0


    '==========================================================================
    ' 3 - AKTÝF ÜYE BUL
    '==========================================================================

    Stage = "Aktif test üyesi aranýyor"

    Set Members = _
        MemberRepo.GetAll


    If Members Is Nothing Then

        Err.Raise _
            vbObjectError + 7801, _
            "TEST_025", _
            "Üye listesi alýnamadý."

    End If


    If Members.Count = 0 Then

        Err.Raise _
            vbObjectError + 7802, _
            "TEST_025", _
            "Test için üye bulunamadý."

    End If


    TestMemberID = 0


    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                Trim$(Member.Status), _
                "Aktif", _
                vbTextCompare) = 0 Then

                TestMemberID = _
                    Member.MemberID

                Exit For

            End If

        End If

    Next Member


    If TestMemberID <= 0 Then

        Err.Raise _
            vbObjectError + 7803, _
            "TEST_025", _
            "Test için AKTÝF üye bulunamadý."

    End If


    '==========================================================================
    ' 4 - ESKÝ TEST-025 KAYITLARINI TEMÝZLE
    '
    ' Repository'de DeleteByDecisionNo kullanýlmýyor.
    ' Üyenin hareketleri okunuyor ve DecisionNo eþleþen kayýtlar
    ' DeleteTestCharge ile siliniyor.
    '==========================================================================

    Stage = "Eski TEST-025 kayýtlarý temizleniyor"

    Set Charges = _
        Repo.GetByMemberID(TestMemberID)


    If Not Charges Is Nothing Then

        For I = Charges.Count To 1 Step -1

            Set ChargeItem = _
                Charges(I)


            If Not ChargeItem Is Nothing Then

                If StrComp( _
                    Trim$(ChargeItem.DecisionNo), _
                    TestDecisionNo, _
                    vbTextCompare) = 0 Then

                    If ChargeItem.ChargeID > 0 Then

                        DeleteTestCharge _
                            ChargeItem.ChargeID

                    End If

                End If

            End If

        Next I

    End If


    '==========================================================================
    ' 5 - BAÞLANGIÇ BAKÝYESÝ
    '
    ' GetMemberBalance tüm AKTÝF hareketleri toplar.
    '
    ' Bu nedenle:
    '
    '   Beklenen son bakiye =
    '       Baþlangýç bakiyesi + 350 TL
    '==========================================================================

    Stage = "Baþlangýç bakiyesi hesaplanýyor"

    BaselineBalance = _
        Service.GetMemberBalance(TestMemberID)


    '==========================================================================
    ' 6 - SAÝR BORÇ OLUÞTUR
    '==========================================================================

    Stage = "Sair borç oluþturuluyor"

    ErrorOccurred = False
    ErrorDescription = vbNullString

    TestChargeID = 0


    On Error Resume Next

    Err.Clear


    TestChargeID = _
        Service.AddOtherCharge( _
            TestMemberID, _
            TestChargeDate, _
            TestAmount, _
            TestDescription, _
            TestDecisionNo, _
            TestChargeDate)


    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If


    Err.Clear

    On Error GoTo ErrorHandler


    If ErrorOccurred Then

        Err.Raise _
            vbObjectError + 7804, _
            "TEST_025", _
            "Sair borç oluþturulamadý." & _
            vbCrLf & _
            ErrorDescription

    End If


    If TestChargeID <= 0 Then

        Err.Raise _
            vbObjectError + 7805, _
            "TEST_025", _
            "Sair borç ChargeID oluþturulmadý."

    End If


    '==========================================================================
    ' 7 - REPOSITORY'DEN OKU
    '==========================================================================

    Stage = "Sair borç Repository'den okunuyor"

    Set Charge = _
        Repo.GetByID(TestChargeID)


    If Charge Is Nothing Then

        Err.Raise _
            vbObjectError + 7806, _
            "TEST_025", _
            "Oluþturulan sair borç Repository'den okunamadý."

    End If


    '==========================================================================
    ' 8 - MEMBERID
    '==========================================================================

    If Charge.MemberID <> TestMemberID Then

        Err.Raise _
            vbObjectError + 7807, _
            "TEST_025", _
            "MemberID hatalý."

    End If


    '==========================================================================
    ' 9 - CHARGETYPE
    '==========================================================================

    If StrComp( _
        Trim$(Charge.ChargeType), _
        "SAIR", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7808, _
            "TEST_025", _
            "ChargeType SAIR deðil."

    End If


    '==========================================================================
    ' 10 - CHARGEDATE
    '==========================================================================

    If Charge.ChargeDate <> TestChargeDate Then

        Err.Raise _
            vbObjectError + 7809, _
            "TEST_025", _
            "ChargeDate hatalý."

    End If


    '==========================================================================
    ' 11 - FISCALYEAR
    '==========================================================================

    If Charge.FiscalYear <> Year(TestChargeDate) Then

        Err.Raise _
            vbObjectError + 7810, _
            "TEST_025", _
            "FiscalYear hatalý."

    End If


    '==========================================================================
    ' 12 - DUEMONTH
    '==========================================================================

    If Charge.DueMonth <> Month(TestChargeDate) Then

        Err.Raise _
            vbObjectError + 7811, _
            "TEST_025", _
            "DueMonth hatalý."

    End If


    '==========================================================================
    ' 13 - AMOUNT
    '==========================================================================

    If Charge.Amount <> TestAmount Then

        Err.Raise _
            vbObjectError + 7812, _
            "TEST_025", _
            "Sair borç tutarý 350 TL deðil."

    End If


    '==========================================================================
    ' 14 - ADJUSTMENTTYPE
    '==========================================================================

    If StrComp( _
        Trim$(Charge.AdjustmentType), _
        "NORMAL", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7813, _
            "TEST_025", _
            "AdjustmentType NORMAL deðil."

    End If


    '==========================================================================
    ' 15 - SOURCECHARGEID
    '==========================================================================

    If Charge.SourceChargeID <> 0 Then

        Err.Raise _
            vbObjectError + 7814, _
            "TEST_025", _
            "Sair borç SourceChargeID deðeri 0 deðil."

    End If


    '==========================================================================
    ' 16 - DESCRIPTION
    '==========================================================================

    If StrComp( _
        Trim$(Charge.Description), _
        TestDescription, _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7815, _
            "TEST_025", _
            "Description hatalý."

    End If


    '==========================================================================
    ' 17 - DECISIONNO
    '==========================================================================

    If StrComp( _
        Trim$(Charge.DecisionNo), _
        TestDecisionNo, _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7816, _
            "TEST_025", _
            "DecisionNo hatalý."

    End If


    '==========================================================================
    ' 18 - STATUS
    '==========================================================================

    If StrComp( _
        Trim$(Charge.Status), _
        "AKTIF", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7817, _
            "TEST_025", _
            "Sair borç AKTIF deðil."

    End If


    '==========================================================================
    ' 19 - ÜYE HAREKETLERÝNDE TEST KAYDINI BUL
    '==========================================================================

    Stage = "Üye hareketlerinde test kaydý aranýyor"

    Set Charges = _
        Repo.GetByMemberID(TestMemberID)


    If Charges Is Nothing Then

        Err.Raise _
            vbObjectError + 7818, _
            "TEST_025", _
            "Üyenin borç hareketleri alýnamadý."

    End If


    FoundTestCharge = False


    For Each ChargeItem In Charges

        If Not ChargeItem Is Nothing Then

            If ChargeItem.ChargeID = TestChargeID Then

                FoundTestCharge = True

                Exit For

            End If

        End If

    Next ChargeItem


    If Not FoundTestCharge Then

        Err.Raise _
            vbObjectError + 7819, _
            "TEST_025", _
            "TEST-025 sair borç kaydý üye hareketlerinde bulunamadý."

    End If


    '==========================================================================
    ' 20 - BAKÝYE KONTROLÜ
    '==========================================================================

    Stage = "Sair borç sonrasý bakiye kontrol ediliyor"

    ActualBalance = _
        Service.GetMemberBalance(TestMemberID)


    ExpectedBalance = _
        BaselineBalance + TestAmount


    If ActualBalance <> ExpectedBalance Then

        Err.Raise _
            vbObjectError + 7820, _
            "TEST_025", _
            "Sair borç sonrasý bakiye hatalý." & _
            vbCrLf & _
            "Baþlangýç : " & BaselineBalance & " TL" & _
            vbCrLf & _
            "Beklenen  : " & ExpectedBalance & " TL" & _
            vbCrLf & _
            "Gerçek    : " & ActualBalance & " TL"

    End If


    '==========================================================================
    ' 21 - SIFIR TUTAR TESTÝ
    '
    ' Burada dönüþ deðerini kullanmýyoruz.
    ' Bu nedenle VBA'da doðru kullaným:
    '
    '   Call Service.AddOtherCharge(...)
    '
    '==========================================================================
    
    Stage = "Geçersiz tutar kontrolü"

    ValidationErrorOccurred = False
    InvalidAmountChargeID = 0


    On Error Resume Next

    Err.Clear


    Call Service.AddOtherCharge( _
        TestMemberID, _
        TestChargeDate, _
        0@, _
        "TEST-025 - Geçersiz tutar", _
        "TEST-025-INVALID-AMOUNT", _
        TestChargeDate)


    If Err.Number <> 0 Then

        ValidationErrorOccurred = True

    End If


    Err.Clear

    On Error GoTo ErrorHandler


    If Not ValidationErrorOccurred Then

        Err.Raise _
            vbObjectError + 7821, _
            "TEST_025", _
            "Sýfýr tutarlý sair borca izin verildi."

    End If


    '==========================================================================
    ' 22 - BOÞ AÇIKLAMA TESTÝ
    '==========================================================================

    Stage = "Boþ açýklama kontrolü"

    ValidationErrorOccurred = False
    InvalidDescriptionChargeID = 0


    On Error Resume Next

    Err.Clear


    Call Service.AddOtherCharge( _
        TestMemberID, _
        TestChargeDate, _
        100@, _
        vbNullString, _
        "TEST-025-INVALID-DESC", _
        TestChargeDate)


    If Err.Number <> 0 Then

        ValidationErrorOccurred = True

    End If


    Err.Clear

    On Error GoTo ErrorHandler


    If Not ValidationErrorOccurred Then

        Err.Raise _
            vbObjectError + 7822, _
            "TEST_025", _
            "Boþ açýklamalý sair borca izin verildi."

    End If


    '==========================================================================
    ' 23 - TEST KAYDINI TEMÝZLE
    '==========================================================================

    Stage = "TEST-025 kaydý temizleniyor"


    If TestChargeID > 0 Then

        DeleteTestCharge _
            TestChargeID

    End If


    '==========================================================================
    ' 24 - SÝLÝNDÝ KONTROLÜ
    '==========================================================================

    Set Charge = _
        Repo.GetByID(TestChargeID)


    If Not Charge Is Nothing Then

        Err.Raise _
            vbObjectError + 7823, _
            "TEST_025", _
            "TEST-025 sair borç kaydý silinemedi."

    End If


    '==========================================================================
    ' 25 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-025 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi          : " & TestMemberID & vbCrLf & _
        "Sair borç           : " & TestAmount & " TL" & vbCrLf & _
        "ChargeType          : SAIR - OK" & vbCrLf & _
        "AdjustmentType      : NORMAL - OK" & vbCrLf & _
        "SourceChargeID      : 0 - OK" & vbCrLf & _
        "Status              : AKTIF - OK" & vbCrLf & _
        "Repository          : OK" & vbCrLf & _
        "Bakiye artýþý       : 350 TL - OK" & vbCrLf & _
        "Sýfýr tutar          : REDDEDÝLDÝ - OK" & vbCrLf & _
        "Boþ açýklama        : REDDEDÝLDÝ - OK" & vbCrLf & _
        "Test kaydý          : SÝLÝNDÝ", _
        vbInformation, _
        "OAA - TEST-025"


    Exit Sub


'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    FinalErrorNumber = Err.Number
    FinalErrorDescription = Err.Description


    On Error Resume Next


    '--------------------------------------------------------------------------
    ' Ana test kaydýný temizle
    '--------------------------------------------------------------------------

    If TestChargeID > 0 Then

        DeleteTestCharge _
            TestChargeID

    End If


    '--------------------------------------------------------------------------
    ' Olasý geçersiz tutar kaydý oluþmuþsa temizle
    '--------------------------------------------------------------------------

    If InvalidAmountChargeID > 0 Then

        DeleteTestCharge _
            InvalidAmountChargeID

    End If


    '--------------------------------------------------------------------------
    ' Olasý geçersiz açýklama kaydý oluþmuþsa temizle
    '--------------------------------------------------------------------------

    If InvalidDescriptionChargeID > 0 Then

        DeleteTestCharge _
            InvalidDescriptionChargeID

    End If


    On Error GoTo 0


    MsgBox _
        "TEST-025 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Aþama    : " & Stage & vbCrLf & _
        "Hata No  : " & FinalErrorNumber & vbCrLf & _
        "Açýklama : " & FinalErrorDescription & vbCrLf & vbCrLf & _
        "Varsa TEST-025 kayýtlarý temizlendi.", _
        vbCritical, _
        "OAA - TEST-025"

End Sub
'==============================================================================
' TEST-026
'
' SAÝR BORÇ - ÝSTÝFA TARÝHÝ KONTROLÜ
'
' AMAÇ:
'
'   AddOtherCharge metodunun istifa eden üye için:
'
'       Ýstifa tarihinden ÖNCE     -> izin verdiðini
'       Ýstifa tarihinde            -> izin verdiðini
'       Ýstifa tarihinden SONRA    -> reddettiðini
'
'   doðrulamak.
'
' KURAL:
'
'       ChargeDate <= LeaveDate
'           -> SAÝR BORÇ OLUÞABÝLÝR
'
'       ChargeDate > LeaveDate
'           -> SAÝR BORÇ OLUÞAMAZ
'
' ÖNEMLÝ:
'
'   Test mevcut ÝSTÝFA üyesini kullanýr.
'   Üye bilgisi deðiþtirilmez.
'   Dolayýsýyla test sonunda üye geri yükleme gerekmez.
'
' TEST SONUNDA:
'
'   Baþarýlý olarak oluþturulan TEST-026 kayýtlarý DeleteTestCharge
'   kullanýlarak silinir.
'
'==============================================================================

Public Sub TEST_026()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim Charges As Collection
    Dim Charge As clsMemberCharge

    Dim TestMemberID As Long

    Dim LeaveDate As Date

    Dim BeforeDate As Date
    Dim EqualDate As Date
    Dim AfterDate As Date

    Dim TestAmount As Currency

    Dim ChargeIDBefore As Long
    Dim ChargeIDEqual As Long
    Dim ChargeIDAfter As Long

    Dim ErrorOccurred As Boolean
    Dim ErrorDescription As String

    Dim RejectedBefore As Boolean
    Dim RejectedEqual As Boolean
    Dim RejectedAfter As Boolean

    Dim Stage As String

    Dim I As Long

    Dim FinalErrorNumber As Long
    Dim FinalErrorDescription As String

    Dim CheckCharge As clsMemberCharge

    Dim TestDecisionBefore As String
    Dim TestDecisionEqual As String
    Dim TestDecisionAfter As String


    On Error GoTo ErrorHandler


    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Stage = "Service ve Repository oluþturuluyor"

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository


    '==========================================================================
    ' 2 - TEST PARAMETRELERÝ
    '==========================================================================

    TestAmount = 100@

    TestDecisionBefore = _
        "TEST-026-BEFORE"

    TestDecisionEqual = _
        "TEST-026-EQUAL"

    TestDecisionAfter = _
        "TEST-026-AFTER"

    ChargeIDBefore = 0
    ChargeIDEqual = 0
    ChargeIDAfter = 0


    '==========================================================================
    ' 3 - ÝSTÝFA ETMÝÞ ÜYE BUL
    '==========================================================================

    Stage = "Ýstifa etmiþ test üyesi aranýyor"

    Set Members = _
        MemberRepo.GetAll


    If Members Is Nothing Then

        Err.Raise _
            vbObjectError + 7831, _
            "TEST_026", _
            "Üye listesi alýnamadý."

    End If


    If Members.Count = 0 Then

        Err.Raise _
            vbObjectError + 7832, _
            "TEST_026", _
            "Üye listesi boþ."

    End If


    TestMemberID = 0


    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                Trim$(Member.Status), _
                "Ýstifa", _
                vbTextCompare) = 0 Then

                If Member.LeaveDate > 0 Then

                    TestMemberID = _
                        Member.MemberID

                    LeaveDate = _
                        Member.LeaveDate

                    Exit For

                End If

            End If

        End If

    Next Member


    '==========================================================================
    ' 4 - ÝSTÝFA ÜYESÝ YOKSA TEST UYGULANAMADI
    '
    ' Bu bir yazýlým hatasý deðildir.
    '
    ' Test senaryosunu çalýþtýrabilmek için mevcut üye listesinde en az bir
    ' Ýstifa üyesi bulunmasý gerekir.
    '==========================================================================

    If TestMemberID <= 0 Then

        MsgBox _
            "TEST-026 UYGULANAMADI." & vbCrLf & vbCrLf & _
            "Üye listesinde istifa durumunda üye bulunamadý." & vbCrLf & vbCrLf & _
            "Test için mevcut bir üyeyi Ýstifa durumuna getirip" & _
            "istifa tarihini girerek tekrar çalýþtýrýn.", _
            vbExclamation, _
            "OAA - TEST-026"

        Exit Sub

    End If


    '==========================================================================
    ' 5 - TEST TARÝHLERÝ
    '
    ' Örnek:
    '
    '   LeaveDate = 30.06.2037
    '
    '   BeforeDate = 29.06.2037
    '   EqualDate  = 30.06.2037
    '   AfterDate  = 01.07.2037
    '
    ' DateAdd kullanýyoruz.
    ' Böylece ay/yýl geçiþlerinde de güvenli çalýþýr.
    '==========================================================================

    BeforeDate = _
        DateAdd("d", -1, LeaveDate)

    EqualDate = _
        LeaveDate

    AfterDate = _
        DateAdd("d", 1, LeaveDate)


    '==========================================================================
    ' 6 - ÖNCEKÝ TEST-026 KAYITLARINI TEMÝZLE
    '==========================================================================

    Stage = "Eski TEST-026 kayýtlarý temizleniyor"

    Set Charges = _
        Repo.GetByMemberID(TestMemberID)


    If Not Charges Is Nothing Then

        For I = Charges.Count To 1 Step -1

            Set Charge = _
                Charges(I)


            If Not Charge Is Nothing Then

                If StrComp( _
                    Trim$(Charge.DecisionNo), _
                    TestDecisionBefore, _
                    vbTextCompare) = 0 Then

                    If Charge.ChargeID > 0 Then

                        DeleteTestCharge _
                            Charge.ChargeID

                    End If

                End If


                If StrComp( _
                    Trim$(Charge.DecisionNo), _
                    TestDecisionEqual, _
                    vbTextCompare) = 0 Then

                    If Charge.ChargeID > 0 Then

                        DeleteTestCharge _
                            Charge.ChargeID

                    End If

                End If


                If StrComp( _
                    Trim$(Charge.DecisionNo), _
                    TestDecisionAfter, _
                    vbTextCompare) = 0 Then

                    If Charge.ChargeID > 0 Then

                        DeleteTestCharge _
                            Charge.ChargeID

                    End If

                End If

            End If

        Next I

    End If


    '==========================================================================
    ' 7 - ÝSTÝFA TARÝHÝNDEN BÝR GÜN ÖNCE
    '
    ' BEKLENEN:
    '
    '   BORÇ OLUÞMALI
    '==========================================================================

    Stage = "Ýstifa öncesi sair borç kontrolü"

    ErrorOccurred = False
    ErrorDescription = vbNullString

    ChargeIDBefore = 0


    On Error Resume Next

    Err.Clear


    ChargeIDBefore = _
        Service.AddOtherCharge( _
            TestMemberID, _
            BeforeDate, _
            TestAmount, _
            "TEST-026 - Ýstifa öncesi", _
            TestDecisionBefore, _
            BeforeDate)


    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If


    Err.Clear

    On Error GoTo ErrorHandler


    If ErrorOccurred Then

        Err.Raise _
            vbObjectError + 7833, _
            "TEST_026", _
            "Ýstifa tarihinden önce sair borç oluþturulamadý." & _
            vbCrLf & _
            ErrorDescription

    End If


    If ChargeIDBefore <= 0 Then

        Err.Raise _
            vbObjectError + 7834, _
            "TEST_026", _
            "Ýstifa öncesi ChargeID oluþturulmadý."

    End If


    '==========================================================================
    ' 8 - ÝSTÝFA TARÝHÝ KENDÝSÝ
    '
    ' BEKLENEN:
    '
    '   BORÇ OLUÞMALI
    '
    ' Çünkü kural:
    '
    '   ChargeDate <= LeaveDate
    '==========================================================================

    Stage = "Ýstifa günü sair borç kontrolü"

    ErrorOccurred = False
    ErrorDescription = vbNullString

    ChargeIDEqual = 0


    On Error Resume Next

    Err.Clear


    ChargeIDEqual = _
        Service.AddOtherCharge( _
            TestMemberID, _
            EqualDate, _
            TestAmount, _
            "TEST-026 - Ýstifa günü", _
            TestDecisionEqual, _
            EqualDate)


    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If


    Err.Clear

    On Error GoTo ErrorHandler


    If ErrorOccurred Then

        Err.Raise _
            vbObjectError + 7835, _
            "TEST_026", _
            "Ýstifa tarihinde sair borç oluþturulamadý." & _
            vbCrLf & _
            ErrorDescription

    End If


    If ChargeIDEqual <= 0 Then

        Err.Raise _
            vbObjectError + 7836, _
            "TEST_026", _
            "Ýstifa günü ChargeID oluþturulmadý."

    End If


    '==========================================================================
    ' 9 - ÝSTÝFA TARÝHÝNDEN BÝR GÜN SONRA
    '
    ' BEKLENEN:
    '
    '   REDDEDÝLMELÝ
    '
    ' Çünkü:
    '
    '   ChargeDate > LeaveDate
    '==========================================================================

    Stage = "Ýstifa sonrasý sair borç kontrolü"

    RejectedAfter = False

    ChargeIDAfter = 0


    On Error Resume Next

    Err.Clear


    ChargeIDAfter = _
        Service.AddOtherCharge( _
            TestMemberID, _
            AfterDate, _
            TestAmount, _
            "TEST-026 - Ýstifa sonrasý", _
            TestDecisionAfter, _
            AfterDate)


    If Err.Number <> 0 Then

        RejectedAfter = True

    End If


    Err.Clear

    On Error GoTo ErrorHandler


    If Not RejectedAfter Then

        Err.Raise _
            vbObjectError + 7837, _
            "TEST_026", _
            "Ýstifa tarihinden sonra sair borç oluþturulmasýna izin verildi."

    End If


    '==========================================================================
    ' 10 - ÝSTÝFA SONRASI KAYIT OLUÞMADI KONTROLÜ
    '==========================================================================

    If ChargeIDAfter > 0 Then

        Err.Raise _
            vbObjectError + 7838, _
            "TEST_026", _
            "Ýstifa sonrasý reddedilmesi gereken iþlem kayýt oluþturdu."

    End If


    '==========================================================================
    ' 11 - ÖNCEKÝ KAYDI REPOSITORY'DEN KONTROL ET
    '==========================================================================

    Stage = "Ýstifa öncesi kayýt Repository kontrolü"


    Set CheckCharge = _
        Repo.GetByID(ChargeIDBefore)


    If CheckCharge Is Nothing Then

        Err.Raise _
            vbObjectError + 7839, _
            "TEST_026", _
            "Ýstifa öncesi oluþturulan kayýt Repository'den okunamadý."

    End If


    If CheckCharge.MemberID <> TestMemberID Then

        Err.Raise _
            vbObjectError + 7840, _
            "TEST_026", _
            "Ýstifa öncesi kaydýn MemberID deðeri hatalý."

    End If


    If StrComp( _
        Trim$(CheckCharge.ChargeType), _
        "SAIR", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7841, _
            "TEST_026", _
            "Ýstifa öncesi kayýt SAIR deðil."

    End If


    If CheckCharge.Amount <> TestAmount Then

        Err.Raise _
            vbObjectError + 7842, _
            "TEST_026", _
            "Ýstifa öncesi kayýt tutarý hatalý."

    End If


    If StrComp( _
        Trim$(CheckCharge.Status), _
        "AKTIF", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7843, _
            "TEST_026", _
            "Ýstifa öncesi kayýt AKTIF deðil."

    End If


    '==========================================================================
    ' 12 - ÝSTÝFA GÜNÜ KAYDI REPOSITORY KONTROLÜ
    '==========================================================================

    Stage = "Ýstifa günü kayýt Repository kontrolü"


    Set CheckCharge = _
        Repo.GetByID(ChargeIDEqual)


    If CheckCharge Is Nothing Then

        Err.Raise _
            vbObjectError + 7844, _
            "TEST_026", _
            "Ýstifa günü oluþturulan kayýt Repository'den okunamadý."

    End If


    If CheckCharge.MemberID <> TestMemberID Then

        Err.Raise _
            vbObjectError + 7845, _
            "TEST_026", _
            "Ýstifa günü kaydýn MemberID deðeri hatalý."

    End If


    If CheckCharge.ChargeDate <> EqualDate Then

        Err.Raise _
            vbObjectError + 7846, _
            "TEST_026", _
            "Ýstifa günü kaydýn ChargeDate deðeri hatalý."

    End If


    If StrComp( _
        Trim$(CheckCharge.ChargeType), _
        "SAIR", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7847, _
            "TEST_026", _
            "Ýstifa günü kayýt SAIR deðil."

    End If


    If CheckCharge.Amount <> TestAmount Then

        Err.Raise _
            vbObjectError + 7848, _
            "TEST_026", _
            "Ýstifa günü kayýt tutarý hatalý."

    End If


    If StrComp( _
        Trim$(CheckCharge.Status), _
        "AKTIF", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7849, _
            "TEST_026", _
            "Ýstifa günü kayýt AKTIF deðil."

    End If


    '==========================================================================
    ' 13 - ÜYE HAREKETLERÝNDE ÝSTÝFA SONRASI TEST KAYDI ARAMA
    '
    ' REDDEDÝLEN iþlem hiçbir þekilde oluþmamalýdýr.
    '==========================================================================

    Stage = "Ýstifa sonrasý kayýt kontrolü"


    Set Charges = _
        Repo.GetByMemberID(TestMemberID)


    If Not Charges Is Nothing Then

        For Each Charge In Charges

            If Not Charge Is Nothing Then

                If StrComp( _
                    Trim$(Charge.DecisionNo), _
                    TestDecisionAfter, _
                    vbTextCompare) = 0 Then

                    Err.Raise _
                        vbObjectError + 7850, _
                        "TEST_026", _
                        "Ýstifa sonrasý reddedilen kayýt Repository'de bulundu."

                End If

            End If

        Next Charge

    End If


    '==========================================================================
    ' 14 - TEST KAYITLARINI TEMÝZLE
    '==========================================================================

    Stage = "TEST-026 kayýtlarý temizleniyor"


    If ChargeIDBefore > 0 Then

        DeleteTestCharge _
            ChargeIDBefore

    End If


    If ChargeIDEqual > 0 Then

        DeleteTestCharge _
            ChargeIDEqual

    End If


    '==========================================================================
    ' 15 - TEMÝZLÝK KONTROLÜ
    '==========================================================================

    Set CheckCharge = _
        Repo.GetByID(ChargeIDBefore)


    If Not CheckCharge Is Nothing Then

        Err.Raise _
            vbObjectError + 7851, _
            "TEST_026", _
            "Ýstifa öncesi test kaydý silinemedi."

    End If


    Set CheckCharge = _
        Repo.GetByID(ChargeIDEqual)


    If Not CheckCharge Is Nothing Then

        Err.Raise _
            vbObjectError + 7852, _
            "TEST_026", _
            "Ýstifa günü test kaydý silinemedi."

    End If


    '==========================================================================
    ' 16 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-026 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi          : " & TestMemberID & vbCrLf & _
        "Ýstifa tarihi       : " & _
            Format$(LeaveDate, "dd.mm.yyyy") & vbCrLf & vbCrLf & _
        Format$(BeforeDate, "dd.mm.yyyy") & _
            " : SAÝR BORÇ OLUÞTU" & vbCrLf & _
        Format$(EqualDate, "dd.mm.yyyy") & _
            " : SAÝR BORÇ OLUÞTU" & vbCrLf & _
        Format$(AfterDate, "dd.mm.yyyy") & _
            " : REDDEDÝLDÝ" & vbCrLf & vbCrLf & _
        "Ýstifa öncesi       : OK" & vbCrLf & _
        "Ýstifa günü         : OK" & vbCrLf & _
        "Ýstifa sonrasý      : RED - OK" & vbCrLf & _
        "Repository kontrol  : OK" & vbCrLf & _
        "Test kayýtlarý      : SÝLÝNDÝ", _
        vbInformation, _
        "OAA - TEST-026"


    Exit Sub


'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    FinalErrorNumber = Err.Number
    FinalErrorDescription = Err.Description


    On Error Resume Next


    '--------------------------------------------------------------------------
    ' Oluþmuþ test kayýtlarýný temizle
    '--------------------------------------------------------------------------

    If ChargeIDBefore > 0 Then

        DeleteTestCharge _
            ChargeIDBefore

    End If


    If ChargeIDEqual > 0 Then

        DeleteTestCharge _
            ChargeIDEqual

    End If


    '--------------------------------------------------------------------------
    ' Ýstifa sonrasý iþlem yanlýþlýkla kayýt oluþturduysa onu da temizle
    '--------------------------------------------------------------------------

    If ChargeIDAfter > 0 Then

        DeleteTestCharge _
            ChargeIDAfter

    End If


    On Error GoTo 0


    MsgBox _
        "TEST-026 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Aþama    : " & Stage & vbCrLf & _
        "Hata No  : " & FinalErrorNumber & vbCrLf & _
        "Açýklama : " & FinalErrorDescription & vbCrLf & vbCrLf & _
        "Varsa TEST-026 kayýtlarý temizlendi.", _
        vbCritical, _
        "OAA - TEST-026"

End Sub
'==============================================================================
' TEST-027
'
' RESMÝ NORMAL + RESMÝ ARTIS + SAIR BORÇ
'
' AMAÇ:
'
'   Ayný üyenin bakiyesinde üç farklý borç hareketinin birlikte
'   doðru hesaplandýðýný doðrulamak.
'
' TEST HAREKETLERÝ:
'
'   RESMI NORMAL       = 500 TL
'   RESMI ARTIS        = 200 TL
'   SAIR BORÇ          = 300 TL
'   --------------------------------
'   TEST ARTIÞI       = 1000 TL
'
' BEKLENEN:
'
'   Baþlangýç bakiyesi + 1000 TL
'
' KONTROLLER:
'
'   1. Aktif üye bulundu.
'   2. Daha önce kullanýlmamýþ RESMI dönem bulundu.
'   3. NORMAL RESMI tahakkuk oluþturuldu.
'   4. ARTIS tahakkuku oluþturuldu.
'   5. SAIR borç oluþturuldu.
'   6. NORMAL kayýt alanlarý doðru.
'   7. ARTIS kayýt alanlarý doðru.
'   8. ARTIS SourceChargeID -> NORMAL ChargeID.
'   9. SAIR kayýt alanlarý doðru.
'  10. GetMemberBalance artýþý = 1000 TL.
'  11. Üç test kaydý silindi.
'
' TEST SONUNDA:
'
'   NORMAL
'   ARTIS
'   SAIR
'
'   test kayýtlarýnýn tamamý silinir.
'
'==============================================================================

Public Sub TEST_027()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim Charges As Collection
    Dim Charge As clsMemberCharge
    Dim CheckCharge As clsMemberCharge

    Dim TestMemberID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim PeriodEndDate As Date

    Dim NormalAmount As Currency
    Dim AdjustmentAmount As Currency
    Dim OtherAmount As Currency

    Dim ExpectedIncrease As Currency

    Dim BaselineBalance As Currency
    Dim ActualBalance As Currency
    Dim ExpectedBalance As Currency

    Dim NormalChargeID As Long
    Dim AdjustmentChargeID As Long
    Dim OtherChargeID As Long

    Dim TestDecisionNormal As String
    Dim TestDecisionAdjustment As String
    Dim TestDecisionOther As String

    Dim NormalCharge As clsMemberCharge
    Dim AdjustmentCharge As clsMemberCharge
    Dim OtherCharge As clsMemberCharge

    Dim NormalFound As Boolean
    Dim AdjustmentFound As Boolean
    Dim OtherFound As Boolean

    Dim ErrorOccurred As Boolean
    Dim ErrorDescription As String

    Dim Stage As String

    Dim I As Long
    Dim SearchYear As Long
    Dim SearchMonth As Long

    Dim PeriodFound As Boolean

    Dim FinalErrorNumber As Long
    Dim FinalErrorDescription As String


    On Error GoTo ErrorHandler


    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Stage = "Service ve Repository oluþturuluyor"

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository


    '==========================================================================
    ' 2 - TEST TUTARLARI
    '==========================================================================

    NormalAmount = 500@

    AdjustmentAmount = 200@

    OtherAmount = 300@

    ExpectedIncrease = _
        NormalAmount + _
        AdjustmentAmount + _
        OtherAmount


    '==========================================================================
    ' 3 - TEST KARAR NUMARALARI
    '==========================================================================

    TestDecisionNormal = _
        "TEST-027-NORMAL"

    TestDecisionAdjustment = _
        "TEST-027-ARTIS"

    TestDecisionOther = _
        "TEST-027-SAIR"


    '==========================================================================
    ' 4 - AKTÝF ÜYE BUL
    '==========================================================================

    Stage = "Aktif test üyesi aranýyor"

    Set Members = _
        MemberRepo.GetAll


    If Members Is Nothing Then

        Err.Raise _
            vbObjectError + 7861, _
            "TEST_027", _
            "Üye listesi alýnamadý."

    End If


    If Members.Count = 0 Then

        Err.Raise _
            vbObjectError + 7862, _
            "TEST_027", _
            "Test için üye bulunamadý."

    End If


    TestMemberID = 0


    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                Trim$(Member.Status), _
                "Aktif", _
                vbTextCompare) = 0 Then

                TestMemberID = _
                    Member.MemberID

                Exit For

            End If

        End If

    Next Member


    If TestMemberID <= 0 Then

        Err.Raise _
            vbObjectError + 7863, _
            "TEST_027", _
            "Test için AKTÝF üye bulunamadý."

    End If


    '==========================================================================
    ' 5 - ESKÝ TEST-027 KAYITLARINI TEMÝZLE
    '
    ' Repository'de olmayan DeleteByDecisionNo kullanýlmýyor.
    ' Üyenin hareketleri okunuyor ve ChargeID üzerinden siliniyor.
    '==========================================================================

    Stage = "Eski TEST-027 kayýtlarý temizleniyor"

    Set Charges = _
        Repo.GetByMemberID(TestMemberID)


    If Not Charges Is Nothing Then

        For I = Charges.Count To 1 Step -1

            Set Charge = _
                Charges(I)


            If Not Charge Is Nothing Then

                If StrComp( _
                    Trim$(Charge.DecisionNo), _
                    TestDecisionNormal, _
                    vbTextCompare) = 0 Then

                    If Charge.ChargeID > 0 Then

                        DeleteTestCharge _
                            Charge.ChargeID

                    End If

                End If


                If StrComp( _
                    Trim$(Charge.DecisionNo), _
                    TestDecisionAdjustment, _
                    vbTextCompare) = 0 Then

                    If Charge.ChargeID > 0 Then

                        DeleteTestCharge _
                            Charge.ChargeID

                    End If

                End If


                If StrComp( _
                    Trim$(Charge.DecisionNo), _
                    TestDecisionOther, _
                    vbTextCompare) = 0 Then

                    If Charge.ChargeID > 0 Then

                        DeleteTestCharge _
                            Charge.ChargeID

                    End If

                End If

            End If

        Next I

    End If


    '==========================================================================
    ' 6 - DAHA ÖNCE KULLANILMAMIÞ RESMI DÖNEM BUL
    '
    ' AddOfficialCharge ayný üye + mali yýl + ay + RESMI için ikinci
    ' NORMAL tahakkuka izin vermiyor.
    '
    ' Bu nedenle sabit bir tarih kullanmak yerine boþ bir dönem arýyoruz.
    '
    ' Aralýk: 2038 - 2047
    '==========================================================================

    Stage = "Boþ RESMI dönem aranýyor"

    PeriodFound = False

    FiscalYear = 0
    DueMonth = 0


    For SearchYear = 2038 To 2047

        If Not PeriodFound Then

            For SearchMonth = 1 To 12

                If Not Repo.ExistsNormalCharge( _
                        TestMemberID, _
                        SearchYear, _
                        SearchMonth, _
                        "RESMI") Then

                    FiscalYear = _
                        SearchYear

                    DueMonth = _
                        SearchMonth

                    PeriodFound = True

                    Exit For

                End If

            Next SearchMonth

        End If

    Next SearchYear


    If Not PeriodFound Then

        Err.Raise _
            vbObjectError + 7864, _
            "TEST_027", _
            "TEST-027 için kullanýlabilir RESMI dönem bulunamadý."

    End If


    '==========================================================================
    ' 7 - TARÝHLER
    '==========================================================================

    ChargeDate = _
        DateSerial( _
            FiscalYear, _
            DueMonth, _
            1)


    PeriodEndDate = _
        DateSerial( _
            FiscalYear, _
            12, _
            31)


    '==========================================================================
    ' 8 - BAÞLANGIÇ BAKÝYESÝ
    '
    ' GetMemberBalance aktif tüm borçlarý toplar.
    '
    ' Bu nedenle beklenen bakiye:
    '
    '   BaselineBalance + 1000 TL
    '==========================================================================

    Stage = "Baþlangýç bakiyesi hesaplanýyor"

    BaselineBalance = _
        Service.GetMemberBalance(TestMemberID)


    '==========================================================================
    ' 9 - NORMAL RESMI AÝDAT OLUÞTUR
    '==========================================================================

    Stage = "NORMAL RESMI aidat oluþturuluyor"

    ErrorOccurred = False
    ErrorDescription = vbNullString

    NormalChargeID = 0


    On Error Resume Next

    Err.Clear


    NormalChargeID = _
        Service.AddOfficialCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            NormalAmount, _
            PeriodEndDate, _
            TestDecisionNormal, _
            ChargeDate, _
            "TEST-027 - Normal resmi aidat")


    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If


    Err.Clear

    On Error GoTo ErrorHandler


    If ErrorOccurred Then

        Err.Raise _
            vbObjectError + 7865, _
            "TEST_027", _
            "NORMAL RESMI aidat oluþturulamadý." & _
            vbCrLf & _
            ErrorDescription

    End If


    If NormalChargeID <= 0 Then

        Err.Raise _
            vbObjectError + 7866, _
            "TEST_027", _
            "NORMAL RESMI ChargeID oluþturulmadý."

    End If


    '==========================================================================
    ' 10 - NORMAL KAYDI OKU
    '==========================================================================

    Stage = "NORMAL kayýt kontrolü"

    Set NormalCharge = _
        Repo.GetByID(NormalChargeID)


    If NormalCharge Is Nothing Then

        Err.Raise _
            vbObjectError + 7867, _
            "TEST_027", _
            "NORMAL kayýt Repository'den okunamadý."

    End If


    '==========================================================================
    ' 11 - NORMAL ALAN KONTROLLERÝ
    '==========================================================================

    If NormalCharge.MemberID <> TestMemberID Then

        Err.Raise _
            vbObjectError + 7868, _
            "TEST_027", _
            "NORMAL MemberID hatalý."

    End If


    If StrComp( _
        Trim$(NormalCharge.ChargeType), _
        "RESMI", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7869, _
            "TEST_027", _
            "NORMAL ChargeType RESMI deðil."

    End If


    If NormalCharge.FiscalYear <> FiscalYear Then

        Err.Raise _
            vbObjectError + 7870, _
            "TEST_027", _
            "NORMAL FiscalYear hatalý."

    End If


    If NormalCharge.DueMonth <> DueMonth Then

        Err.Raise _
            vbObjectError + 7871, _
            "TEST_027", _
            "NORMAL DueMonth hatalý."

    End If


    If NormalCharge.Amount <> NormalAmount Then

        Err.Raise _
            vbObjectError + 7872, _
            "TEST_027", _
            "NORMAL tutarý 500 TL deðil."

    End If


    If StrComp( _
        Trim$(NormalCharge.AdjustmentType), _
        "NORMAL", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7873, _
            "TEST_027", _
            "NORMAL AdjustmentType NORMAL deðil."

    End If


    If NormalCharge.SourceChargeID <> 0 Then

        Err.Raise _
            vbObjectError + 7874, _
            "TEST_027", _
            "NORMAL SourceChargeID 0 deðil."

    End If


    If StrComp( _
        Trim$(NormalCharge.Status), _
        "AKTIF", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7875, _
            "TEST_027", _
            "NORMAL kayýt AKTIF deðil."

    End If


    '==========================================================================
    ' 12 - RESMI ARTIS OLUÞTUR
    '==========================================================================

    Stage = "RESMI ARTIS oluþturuluyor"

    ErrorOccurred = False
    ErrorDescription = vbNullString

    AdjustmentChargeID = 0


    On Error Resume Next

    Err.Clear


    AdjustmentChargeID = _
        Service.AddOfficialChargeAdjustment( _
            NormalChargeID, _
            ChargeDate, _
            AdjustmentAmount, _
            TestDecisionAdjustment, _
            ChargeDate, _
            "TEST-027 - Resmi aidat artýþý")


    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If


    Err.Clear

    On Error GoTo ErrorHandler


    If ErrorOccurred Then

        Err.Raise _
            vbObjectError + 7876, _
            "TEST_027", _
            "RESMI ARTIS oluþturulamadý." & _
            vbCrLf & _
            ErrorDescription

    End If


    If AdjustmentChargeID <= 0 Then

        Err.Raise _
            vbObjectError + 7877, _
            "TEST_027", _
            "ARTIS ChargeID oluþturulmadý."

    End If


    '==========================================================================
    ' 13 - ARTIS KAYDINI OKU
    '==========================================================================

    Stage = "ARTIS kayýt kontrolü"

    Set AdjustmentCharge = _
        Repo.GetByID(AdjustmentChargeID)


    If AdjustmentCharge Is Nothing Then

        Err.Raise _
            vbObjectError + 7878, _
            "TEST_027", _
            "ARTIS kayýt Repository'den okunamadý."

    End If


    '==========================================================================
    ' 14 - ARTIS ALAN KONTROLLERÝ
    '==========================================================================

    If AdjustmentCharge.MemberID <> TestMemberID Then

        Err.Raise _
            vbObjectError + 7879, _
            "TEST_027", _
            "ARTIS MemberID hatalý."

    End If


    If StrComp( _
        Trim$(AdjustmentCharge.ChargeType), _
        "RESMI", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7880, _
            "TEST_027", _
            "ARTIS ChargeType RESMI deðil."

    End If


    If AdjustmentCharge.Amount <> AdjustmentAmount Then

        Err.Raise _
            vbObjectError + 7881, _
            "TEST_027", _
            "ARTIS tutarý 200 TL deðil."

    End If


    If StrComp( _
        Trim$(AdjustmentCharge.AdjustmentType), _
        "ARTIS", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7882, _
            "TEST_027", _
            "ARTIS AdjustmentType ARTIS deðil."

    End If


    If AdjustmentCharge.SourceChargeID <> NormalChargeID Then

        Err.Raise _
            vbObjectError + 7883, _
            "TEST_027", _
            "ARTIS SourceChargeID NORMAL kayda baðlý deðil."

    End If


    If StrComp( _
        Trim$(AdjustmentCharge.Status), _
        "AKTIF", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7884, _
            "TEST_027", _
            "ARTIS kayýt AKTIF deðil."

    End If


    '==========================================================================
    ' 15 - SAIR BORÇ OLUÞTUR
    '==========================================================================

    Stage = "SAIR borç oluþturuluyor"

    ErrorOccurred = False
    ErrorDescription = vbNullString

    OtherChargeID = 0


    On Error Resume Next

    Err.Clear


    OtherChargeID = _
        Service.AddOtherCharge( _
            TestMemberID, _
            ChargeDate, _
            OtherAmount, _
            "TEST-027 - Sair borç", _
            TestDecisionOther, _
            ChargeDate)


    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If


    Err.Clear

    On Error GoTo ErrorHandler


    If ErrorOccurred Then

        Err.Raise _
            vbObjectError + 7885, _
            "TEST_027", _
            "SAIR borç oluþturulamadý." & _
            vbCrLf & _
            ErrorDescription

    End If


    If OtherChargeID <= 0 Then

        Err.Raise _
            vbObjectError + 7886, _
            "TEST_027", _
            "SAIR ChargeID oluþturulmadý."

    End If


    '==========================================================================
    ' 16 - SAIR KAYDI OKU
    '==========================================================================

    Stage = "SAIR kayýt kontrolü"

    Set OtherCharge = _
        Repo.GetByID(OtherChargeID)


    If OtherCharge Is Nothing Then

        Err.Raise _
            vbObjectError + 7887, _
            "TEST_027", _
            "SAIR kayýt Repository'den okunamadý."

    End If


    '==========================================================================
    ' 17 - SAIR ALAN KONTROLLERÝ
    '==========================================================================

    If OtherCharge.MemberID <> TestMemberID Then

        Err.Raise _
            vbObjectError + 7888, _
            "TEST_027", _
            "SAIR MemberID hatalý."

    End If


    If StrComp( _
        Trim$(OtherCharge.ChargeType), _
        "SAIR", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7889, _
            "TEST_027", _
            "SAIR ChargeType SAIR deðil."

    End If


    If OtherCharge.Amount <> OtherAmount Then

        Err.Raise _
            vbObjectError + 7890, _
            "TEST_027", _
            "SAIR tutarý 300 TL deðil."

    End If


    If StrComp( _
        Trim$(OtherCharge.AdjustmentType), _
        "NORMAL", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7891, _
            "TEST_027", _
            "SAIR AdjustmentType NORMAL deðil."

    End If


    If OtherCharge.SourceChargeID <> 0 Then

        Err.Raise _
            vbObjectError + 7892, _
            "TEST_027", _
            "SAIR SourceChargeID 0 deðil."

    End If


    If StrComp( _
        Trim$(OtherCharge.Status), _
        "AKTIF", _
        vbTextCompare) <> 0 Then

        Err.Raise _
            vbObjectError + 7893, _
            "TEST_027", _
            "SAIR kayýt AKTIF deðil."

    End If


    '==========================================================================
    ' 18 - ÜYE HAREKETLERÝNDE ÜÇ TEST KAYDINI BUL
    '==========================================================================

    Stage = "Üç test hareketi Repository'den kontrol ediliyor"

    Set Charges = _
        Repo.GetByMemberID(TestMemberID)


    If Charges Is Nothing Then

        Err.Raise _
            vbObjectError + 7894, _
            "TEST_027", _
            "Üye borç hareketleri alýnamadý."

    End If


    NormalFound = False
    AdjustmentFound = False
    OtherFound = False


    For Each Charge In Charges

        If Not Charge Is Nothing Then

            '------------------------------------------------------------------
            ' NORMAL
            '------------------------------------------------------------------

            If Charge.ChargeID = NormalChargeID Then

                Set NormalCharge = Charge

                NormalFound = True

            End If


            '------------------------------------------------------------------
            ' ARTIS
            '------------------------------------------------------------------

            If Charge.ChargeID = AdjustmentChargeID Then

                Set AdjustmentCharge = Charge

                AdjustmentFound = True

            End If


            '------------------------------------------------------------------
            ' SAIR
            '------------------------------------------------------------------

            If Charge.ChargeID = OtherChargeID Then

                Set OtherCharge = Charge

                OtherFound = True

            End If

        End If

    Next Charge


    If Not NormalFound Then

        Err.Raise _
            vbObjectError + 7895, _
            "TEST_027", _
            "NORMAL test hareketi üye hareketlerinde bulunamadý."

    End If


    If Not AdjustmentFound Then

        Err.Raise _
            vbObjectError + 7896, _
            "TEST_027", _
            "ARTIS test hareketi üye hareketlerinde bulunamadý."

    End If


    If Not OtherFound Then

        Err.Raise _
            vbObjectError + 7897, _
            "TEST_027", _
            "SAIR test hareketi üye hareketlerinde bulunamadý."

    End If


    '==========================================================================
    ' 19 - TOPLAM BAKÝYE KONTROLÜ
    '
    ' NORMAL  = 500
    ' ARTIS   = 200
    ' SAIR    = 300
    ' ----------------
    ' TOPLAM  = 1000
    '
    ' GetMemberBalance aktif tüm hareketleri toplar.
    '==========================================================================

    Stage = "Üç hareketin toplam bakiyesi kontrol ediliyor"

    ActualBalance = _
        Service.GetMemberBalance(TestMemberID)


    ExpectedBalance = _
        BaselineBalance + ExpectedIncrease


    If ActualBalance <> ExpectedBalance Then

        Err.Raise _
            vbObjectError + 7898, _
            "TEST_027", _
            "Toplam bakiye hatalý." & _
            vbCrLf & _
            "Baþlangýç : " & BaselineBalance & " TL" & _
            vbCrLf & _
            "Beklenen  : " & ExpectedBalance & " TL" & _
            vbCrLf & _
            "Gerçek    : " & ActualBalance & " TL" & _
            vbCrLf & _
            "Test artýþý: " & _
            (ActualBalance - BaselineBalance) & " TL"

    End If


    '==========================================================================
    ' 20 - TEST KAYITLARINI TEMÝZLE
    '==========================================================================

    Stage = "TEST-027 kayýtlarý temizleniyor"


    If OtherChargeID > 0 Then

        DeleteTestCharge _
            OtherChargeID

    End If


    If AdjustmentChargeID > 0 Then

        DeleteTestCharge _
            AdjustmentChargeID

    End If


    If NormalChargeID > 0 Then

        DeleteTestCharge _
            NormalChargeID

    End If


    '==========================================================================
    ' 21 - TEMÝZLÝK KONTROLÜ
    '==========================================================================

    Set CheckCharge = _
        Repo.GetByID(NormalChargeID)


    If Not CheckCharge Is Nothing Then

        Err.Raise _
            vbObjectError + 7899, _
            "TEST_027", _
            "NORMAL test kaydý silinemedi."

    End If


    Set CheckCharge = _
        Repo.GetByID(AdjustmentChargeID)


    If Not CheckCharge Is Nothing Then

        Err.Raise _
            vbObjectError + 7900, _
            "TEST_027", _
            "ARTIS test kaydý silinemedi."

    End If


    Set CheckCharge = _
        Repo.GetByID(OtherChargeID)


    If Not CheckCharge Is Nothing Then

        Err.Raise _
            vbObjectError + 7901, _
            "TEST_027", _
            "SAIR test kaydý silinemedi."

    End If


    '==========================================================================
    ' 22 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-027 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi          : " & TestMemberID & vbCrLf & _
        "Mali yýl            : " & FiscalYear & vbCrLf & _
        "Aidat ayý           : " & DueMonth & vbCrLf & vbCrLf & _
        "NORMAL RESMI        : 500 TL - OK" & vbCrLf & _
        "RESMI ARTIS         : 200 TL - OK" & vbCrLf & _
        "SAIR BORÇ           : 300 TL - OK" & vbCrLf & _
        "-------------------------------" & vbCrLf & _
        "Test bakiye artýþý  : 1000 TL - OK" & vbCrLf & vbCrLf & _
        "Baþlangýç bakiyesi  : " & _
            BaselineBalance & " TL" & vbCrLf & _
        "Beklenen bakiye     : " & _
            ExpectedBalance & " TL" & vbCrLf & _
        "Gerçek bakiye       : " & _
            ActualBalance & " TL" & vbCrLf & vbCrLf & _
        "SourceChargeID      : OK" & vbCrLf & _
        "Bakiye hesabý       : OK" & vbCrLf & _
        "Temizlik            : OK" & vbCrLf & _
        "Test kayýtlarý      : SÝLÝNDÝ", _
        vbInformation, _
        "OAA - TEST-027"


    Exit Sub


'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    FinalErrorNumber = Err.Number
    FinalErrorDescription = Err.Description


    On Error Resume Next


    '--------------------------------------------------------------------------
    ' Oluþmuþ SAIR kaydýný temizle
    '--------------------------------------------------------------------------

    If OtherChargeID > 0 Then

        DeleteTestCharge _
            OtherChargeID

    End If


    '--------------------------------------------------------------------------
    ' Oluþmuþ ARTIS kaydýný temizle
    '--------------------------------------------------------------------------

    If AdjustmentChargeID > 0 Then

        DeleteTestCharge _
            AdjustmentChargeID

    End If


    '--------------------------------------------------------------------------
    ' Oluþmuþ NORMAL kaydý temizle
    '--------------------------------------------------------------------------

    If NormalChargeID > 0 Then

        DeleteTestCharge _
            NormalChargeID

    End If


    On Error GoTo 0


    MsgBox _
        "TEST-027 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Aþama    : " & Stage & vbCrLf & _
        "Hata No  : " & FinalErrorNumber & vbCrLf & _
        "Açýklama : " & FinalErrorDescription & vbCrLf & vbCrLf & _
        "Oluþturulan TEST-027 kayýtlarý temizlenmeye çalýþýldý.", _
        vbCritical, _
        "OAA - TEST-027"

End Sub
'==============================================================================
' TEST-028
'
' TOPLANTI AÝDATI - AKTÝF ÜYE + MÜKERRER KONTROLÜ
'
' AMAÇ:
'
'   1. Aktif üyeye TOPLANTI / NORMAL aidat oluþturulabildiðini
'      doðrulamak.
'
'   2. Oluþturulan kaydýn Repository üzerinden doðru alanlarla
'      okunabildiðini doðrulamak.
'
'   3. Ayný üye + mali yýl + ay + TOPLANTI için ikinci NORMAL
'      tahakkukun Service tarafýndan reddedildiðini doðrulamak.
'
'   4. Beklenmeyen ikinci kayýt oluþmadýðýný doðrulamak.
'
'   5. Oluþturulan test kayýtlarýnýn TEST sonunda temizlendiðini
'      doðrulamak.
'
' KURALLAR:
'
'   AKTÝF   -> TOPLANTI aidatý uygulanýr.
'   ÝZÝNLÝ  -> uygulanmaz.
'   ÝSTÝFA  -> uygulanmaz.
'
'   Ayný üye + dönem + TOPLANTI için ikinci NORMAL kayýt
'   oluþturulamaz.
'
' TEST MÝMARÝSÝ:
'
'   Test -> clsMemberChargeService
'        -> clsMemberChargeRepository
'        -> Excel tablosu
'
'   Test doðrudan worksheet'e veri yazmaz.
'
' TEST VERÝSÝ:
'
'   DecisionNo = TEST-028
'
'   Mali yýl / ay dinamik olarak boþ bir TOPLANTI dönemi seçilir.
'
' TEST SONUNDA:
'
'   Oluþturulan bütün TEST-028 kayýtlarý ChargeID üzerinden silinir.
'==============================================================================

Public Sub TEST_028()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Charges As Collection

    Dim Member As clsMember
    Dim Charge As clsMemberCharge

    Dim TestMemberID As Long
    Dim ChargeID As Long
    Dim DuplicateChargeID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim Amount As Currency

    Dim TestDecisionNo As String
    Dim TestDescription As String

    Dim TestChargeIDs As Collection

    Dim PeriodFound As Boolean
    Dim DuplicateRejected As Boolean
    Dim RepositoryOK As Boolean
    Dim CleanupOK As Boolean

    Dim ErrorOccurred As Boolean
    Dim ErrorDescription As String

    Dim I As Long
    Dim j As Long

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService
    Set Repo = New clsMemberChargeRepository
    Set MemberRepo = New clsMemberRepository

    Set TestChargeIDs = New Collection

    '==========================================================================
    ' 2 - TEST PARAMETRELERÝ
    '==========================================================================

    Amount = 250@

    TestDecisionNo = "TEST-028"

    TestDescription = _
        "TEST-028 - Aktif üye toplantý aidatý"

    '==========================================================================
    ' 3 - AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = MemberRepo.GetAll

    If Members Is Nothing Then

        Err.Raise vbObjectError + 7801, _
                  "TEST_028", _
                  "Üye listesi alýnamadý."

    End If

    If Members.Count = 0 Then

        Err.Raise vbObjectError + 7802, _
                  "TEST_028", _
                  "Test için üye bulunamadý."

    End If

    TestMemberID = 0

    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = Member.MemberID
                Exit For

            End If

        End If

    Next Member

    If TestMemberID <= 0 Then

        Err.Raise vbObjectError + 7803, _
                  "TEST_028", _
                  "Test için aktif üye bulunamadý."

    End If

    '==========================================================================
    ' 4 - KULLANILMAMIÞ TOPLANTI DÖNEMÝ BUL
    '
    ' Gerçek kullanýcý verileriyle çakýþmamasý için mevcut NORMAL TOPLANTI
    ' tahakkuku olmayan bir dönem aranýyor.
    '
    ' 2048-2099 aralýðý test amacýyla kullanýlmaktadýr.
    '==========================================================================

    PeriodFound = False

    For FiscalYear = 2048 To 2099

        For DueMonth = 1 To 12

            If Not Repo.ExistsNormalCharge( _
                    TestMemberID, _
                    FiscalYear, _
                    DueMonth, _
                    "TOPLANTI") Then

                PeriodFound = True
                Exit For

            End If

        Next DueMonth

        If PeriodFound Then Exit For

    Next FiscalYear

    If Not PeriodFound Then

        Err.Raise vbObjectError + 7804, _
                  "TEST_028", _
                  "Test için kullanýlmamýþ TOPLANTI dönemi bulunamadý."

    End If

    ChargeDate = DateSerial(FiscalYear, DueMonth, 1)

    '==========================================================================
    ' 5 - TEST BAÞLANGICI
    '==========================================================================

    '==========================================================================
    ' 6 - TOPLANTI AÝDATI OLUÞTUR
    '
    ' Beklenen:
    '
    '   Service baþarýlý þekilde ChargeID döndürmeli.
    '==========================================================================

    ChargeID = 0
    ErrorOccurred = False
    ErrorDescription = vbNullString

    On Error Resume Next

    Err.Clear

    ChargeID = _
        Service.AddMeetingCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            TestDecisionNo, _
            ChargeDate, _
            TestDescription)

    If Err.Number <> 0 Then

        ErrorOccurred = True
        ErrorDescription = Err.Description

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    If ErrorOccurred Then

        Err.Raise vbObjectError + 7805, _
                  "TEST_028", _
                  "TOPLANTI aidatý oluþturulamadý." & _
                  vbCrLf & ErrorDescription

    End If

    If ChargeID <= 0 Then

        Err.Raise vbObjectError + 7806, _
                  "TEST_028", _
                  "TOPLANTI aidatý için geçerli ChargeID oluþturulmadý."

    End If

    ' Oluþturulan kaydý cleanup listesine ekle.

    TestChargeIDs.Add ChargeID

    '==========================================================================
    ' 7 - REPOSITORY'DEN KAYDI GERÝ OKU
    '==========================================================================

    Set Charge = Repo.GetByID(ChargeID)

    If Charge Is Nothing Then

        Err.Raise vbObjectError + 7807, _
                  "TEST_028", _
                  "Oluþturulan TOPLANTI kaydý Repository'den okunamadý."

    End If

    '==========================================================================
    ' 8 - ALAN KONTROLLERÝ
    '==========================================================================

    If Charge.MemberID <> TestMemberID Then

        Err.Raise vbObjectError + 7808, _
                  "TEST_028", _
                  "TOPLANTI kaydýnýn MemberID deðeri hatalý."

    End If

    If StrComp( _
            Trim$(Charge.ChargeType), _
            "TOPLANTI", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 7809, _
                  "TEST_028", _
                  "TOPLANTI kaydýnýn ChargeType deðeri TOPLANTI deðil."

    End If

    If Charge.FiscalYear <> FiscalYear Then

        Err.Raise vbObjectError + 7810, _
                  "TEST_028", _
                  "TOPLANTI kaydýnýn FiscalYear deðeri hatalý."

    End If

    If Charge.DueMonth <> DueMonth Then

        Err.Raise vbObjectError + 7811, _
                  "TEST_028", _
                  "TOPLANTI kaydýnýn DueMonth deðeri hatalý."

    End If

    If Charge.Amount <> Amount Then

        Err.Raise vbObjectError + 7812, _
                  "TEST_028", _
                  "TOPLANTI kaydýnýn Amount deðeri hatalý."

    End If

    If StrComp( _
            Trim$(Charge.AdjustmentType), _
            "NORMAL", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 7813, _
                  "TEST_028", _
                  "TOPLANTI kaydýnýn AdjustmentType deðeri NORMAL deðil."

    End If

    If Charge.SourceChargeID <> 0 Then

        Err.Raise vbObjectError + 7814, _
                  "TEST_028", _
                  "TOPLANTI kaydýnýn SourceChargeID deðeri 0 olmalý."

    End If

    If StrComp( _
            Trim$(Charge.Status), _
            "AKTIF", _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 7815, _
                  "TEST_028", _
                  "TOPLANTI kaydý AKTIF deðil."

    End If

    If StrComp( _
            Trim$(Charge.DecisionNo), _
            TestDecisionNo, _
            vbTextCompare) <> 0 Then

        Err.Raise vbObjectError + 7816, _
                  "TEST_028", _
                  "TOPLANTI kaydýnýn DecisionNo deðeri TEST-028 deðil."

    End If

    RepositoryOK = True

    '==========================================================================
    ' 9 - ÜYE HAREKETLERÝNDE TEST KAYDINI KONTROL ET
    '==========================================================================

    Set Charges = Repo.GetByMemberID(TestMemberID)

    If Charges Is Nothing Then

        Err.Raise vbObjectError + 7817, _
                  "TEST_028", _
                  "Üye borç hareketleri Repository'den alýnamadý."

    End If

    Dim FoundTestCharge As Boolean

    FoundTestCharge = False

    For Each Charge In Charges

        If Not Charge Is Nothing Then

            If Charge.ChargeID = ChargeID Then

                FoundTestCharge = True
                Exit For

            End If

        End If

    Next Charge

    If Not FoundTestCharge Then

        Err.Raise vbObjectError + 7818, _
                  "TEST_028", _
                  "TEST-028 TOPLANTI hareketi üyenin hareketlerinde bulunamadý."

    End If

    '==========================================================================
    ' 10 - MÜKERRER TOPLANTI AÝDATI DENEMESÝ
    '
    ' Ayný:
    '   MemberID
    '   FiscalYear
    '   DueMonth
    '   TOPLANTI
    '
    ' için ikinci NORMAL kayýt oluþturulmamalýdýr.
    '==========================================================================

    DuplicateChargeID = 0
    DuplicateRejected = False

    On Error Resume Next

    Err.Clear

    DuplicateChargeID = _
        Service.AddMeetingCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            "TEST-028-DUP", _
            ChargeDate, _
            "TEST-028 - Mükerrer toplantý aidatý")

    If Err.Number <> 0 Then

        DuplicateRejected = True

    End If

    Err.Clear

    On Error GoTo ErrorHandler

    '==========================================================================
    ' 11 - MÜKERRER KONTROLÜ
    '==========================================================================

    If Not DuplicateRejected Then

        ' Service ikinci kaydý yanlýþlýkla oluþturduysa
        ' cleanup için ChargeID'yi listeye ekliyoruz.

        If DuplicateChargeID > 0 Then

            TestChargeIDs.Add DuplicateChargeID

        End If

        Err.Raise vbObjectError + 7819, _
                  "TEST_028", _
                  "Mükerrer TOPLANTI aidatý Service tarafýndan reddedilmedi."

    End If

    ' Beklenen durumda ikinci kayýt oluþmamýþ olmalý.

    If DuplicateChargeID > 0 Then

        TestChargeIDs.Add DuplicateChargeID

        Err.Raise vbObjectError + 7820, _
                  "TEST_028", _
                  "Mükerrer denemede ChargeID oluþtu: " & _
                  DuplicateChargeID

    End If

    '==========================================================================
    ' 12 - REPOSITORY'DEN MÜKERRER KAYIT KONTROLÜ
    '==========================================================================

    Set Charges = Repo.GetByMemberID(TestMemberID)

    If Charges Is Nothing Then

        Err.Raise vbObjectError + 7821, _
                  "TEST_028", _
                  "Mükerrer kontrolü için üye hareketleri okunamadý."

    End If

    Dim MeetingRecordCount As Long

    MeetingRecordCount = 0

    For Each Charge In Charges

        If Not Charge Is Nothing Then

            If Charge.FiscalYear = FiscalYear _
               And Charge.DueMonth = DueMonth _
               And StrComp( _
                    Trim$(Charge.ChargeType), _
                    "TOPLANTI", _
                    vbTextCompare) = 0 _
               And StrComp( _
                    Trim$(Charge.AdjustmentType), _
                    "NORMAL", _
                    vbTextCompare) = 0 _
               And StrComp( _
                    Trim$(Charge.DecisionNo), _
                    TestDecisionNo, _
                    vbTextCompare) = 0 Then

                MeetingRecordCount = MeetingRecordCount + 1

            End If

        End If

    Next Charge

    If MeetingRecordCount <> 1 Then

        Err.Raise vbObjectError + 7822, _
                  "TEST_028", _
                  "TEST-028 için beklenen 1 TOPLANTI kaydý yerine " & _
                  MeetingRecordCount & " kayýt bulundu."

    End If

    '==========================================================================
    ' 13 - TEST KAYITLARINI TEMÝZLE
    '==========================================================================

    CleanupOK = True

    On Error Resume Next

    For j = TestChargeIDs.Count To 1 Step -1

        ChargeID = CLng(TestChargeIDs(j))

        If ChargeID > 0 Then

            Err.Clear

            DeleteTestCharge ChargeID

            If Err.Number <> 0 Then

                CleanupOK = False
                Err.Clear

            End If

        End If

    Next j

    On Error GoTo ErrorHandler

    If Not CleanupOK Then

        Err.Raise vbObjectError + 7823, _
                  "TEST_028", _
                  "TEST-028 test kayýtlarýnýn tamamý temizlenemedi."

    End If

    '==========================================================================
    ' 14 - TEMÝZLÝK SONRASI KONTROL
    '==========================================================================

    Set Charges = Repo.GetByMemberID(TestMemberID)

    If Charges Is Nothing Then

        Err.Raise vbObjectError + 7824, _
                  "TEST_028", _
                  "Cleanup sonrasý üye hareketleri okunamadý."

    End If

    For Each Charge In Charges

        If Not Charge Is Nothing Then

            If StrComp( _
                    Trim$(Charge.DecisionNo), _
                    TestDecisionNo, _
                    vbTextCompare) = 0 Then

                Err.Raise vbObjectError + 7825, _
                          "TEST_028", _
                          "TEST-028 kaydý cleanup sonrasýnda hâlâ mevcut."

            End If

        End If

    Next Charge

    '==========================================================================
    ' 15 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-028 BAÞARILI." & vbCrLf & vbCrLf & _
        "Test üyesi       : " & TestMemberID & vbCrLf & _
        "Mali yýl         : " & FiscalYear & vbCrLf & _
        "Aidat ayý        : " & DueMonth & vbCrLf & _
        "Aidat tutarý     : " & Amount & " TL" & vbCrLf & vbCrLf & _
        "TOPLANTI kaydý   : OK" & vbCrLf & _
        "Alan kontrolleri : OK" & vbCrLf & _
        "Repository       : OK" & vbCrLf & _
        "Mükerrer kontrol : REDDEDÝLDÝ" & vbCrLf & _
        "Cleanup          : OK" & vbCrLf & _
        "Test kaydý       : SÝLÝNDÝ", _
        vbInformation, _
        "OAA - TEST-028"

    Exit Sub

'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    On Error Resume Next

    If Not TestChargeIDs Is Nothing Then

        For I = TestChargeIDs.Count To 1 Step -1

            ChargeID = CLng(TestChargeIDs(I))

            If ChargeID > 0 Then

                DeleteTestCharge ChargeID

            End If

        Next I

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-028 BAÞARISIZ." & vbCrLf & vbCrLf & _
        "Hata No : " & Err.Number & vbCrLf & _
        "Açýklama: " & Err.Description & vbCrLf & vbCrLf & _
        "Test kayýtlarý temizlenmeye çalýþýldý.", _
        vbCritical, _
        "OAA - TEST-028"

End Sub

'==============================================================================
' TEST-029
'
' TOPLANTI AÝDATI - SIFIR TUTAR REDDÝ
'
' AMAÇ:
'
'   AddMeetingCharge metodunun sýfýr tutarlý toplantý aidatýný
'   Service katmanýnda reddettiðini doðrulamak.
'
' TEST KURALI:
'
'   Amount <= 0
'       -> iþlem reddedilmelidir.
'
' BEKLENEN SONUÇ:
'
'   1. Service hata üretmelidir.
'   2. Beklenen hata kodu alýnmalýdýr.
'   3. AddMeetingCharge sonucu ChargeID = 0 olmalýdýr.
'   4. Yeni TOPLANTI kaydý oluþmamalýdýr.
'
' ÖNEMLÝ:
'
'   Test hata mesajýnýn Türkçe metnine baðlý deðildir.
'   Hata numarasý kontrol edilir.
'
'==============================================================================

Public Sub TEST_029()

    Dim Service As clsMemberChargeService
    Dim Repo As clsMemberChargeRepository
    Dim MemberRepo As clsMemberRepository

    Dim Members As Collection
    Dim Member As clsMember

    Dim Charge As clsMemberCharge
    Dim Charges As Collection

    Dim TestMemberID As Long

    Dim FiscalYear As Long
    Dim DueMonth As Long

    Dim ChargeDate As Date
    Dim Amount As Currency

    Dim ChargeID As Long

    Dim ErrorOccurred As Boolean
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    Dim MeetingChargeFound As Boolean

    Dim ExpectedErrorNumber As Long


    On Error GoTo ErrorHandler


    '==========================================================================
    ' 1 - NESNELER
    '==========================================================================

    Set Service = New clsMemberChargeService

    Set Repo = New clsMemberChargeRepository

    Set MemberRepo = New clsMemberRepository


    '==========================================================================
    ' 2 - TEST PARAMETRELERÝ
    '==========================================================================

    FiscalYear = 2098

    DueMonth = 11

    ChargeDate = _
        DateSerial(2098, 11, 1)

    '----------------------------------------------------------------------
    ' Geçersiz tutar
    '----------------------------------------------------------------------

    Amount = 0@


    '==========================================================================
    ' 3 - AKTÝF ÜYE BUL
    '==========================================================================

    Set Members = _
        MemberRepo.GetAll


    If Members Is Nothing Then

        Err.Raise _
            vbObjectError + 7901, _
            "TEST_029", _
            "Üye listesi alýnamadý."

    End If


    If Members.Count = 0 Then

        Err.Raise _
            vbObjectError + 7902, _
            "TEST_029", _
            "Test için üye bulunamadý."

    End If


    TestMemberID = 0


    For Each Member In Members

        If Not Member Is Nothing Then

            If StrComp( _
                    Trim$(Member.Status), _
                    "Aktif", _
                    vbTextCompare) = 0 Then

                TestMemberID = _
                    Member.MemberID

                Exit For

            End If

        End If

    Next Member


    If TestMemberID <= 0 Then

        Err.Raise _
            vbObjectError + 7903, _
            "TEST_029", _
            "Test için aktif üye bulunamadý."

    End If


    '==========================================================================
    ' 4 - TEST DÖNEMÝNDE ÖNCEDEN TOPLANTI AÝDATI OLMAMALI
    '==========================================================================

    If Repo.ExistsNormalCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            "TOPLANTI") Then

        Err.Raise _
            vbObjectError + 7904, _
            "TEST_029", _
            "Test dönemi zaten TOPLANTI aidatý içeriyor."

    End If


    '==========================================================================
    ' 5 - BEKLENEN HATA KODU
    '
    ' clsMemberChargeService.ValidateBasicChargeParameters:
    '
    '   Amount <= 0
    '       -> vbObjectError + 7235
    '==========================================================================

    ExpectedErrorNumber = _
        vbObjectError + 7235


    '==========================================================================
    ' 6 - GEÇERSÝZ TOPLANTI AÝDATI DENEMESÝ
    '==========================================================================

    ChargeID = 0

    ErrorOccurred = False

    ErrorNumber = 0

    ErrorDescription = vbNullString


    On Error Resume Next

    Err.Clear


    ChargeID = _
        Service.AddMeetingCharge( _
            TestMemberID, _
            FiscalYear, _
            DueMonth, _
            ChargeDate, _
            Amount, _
            "TEST-029", _
            ChargeDate, _
            "TEST-029 - Sýfýr tutarlý toplantý aidatý")


    If Err.Number <> 0 Then

        ErrorOccurred = True

        ErrorNumber = Err.Number

        ErrorDescription = Err.Description

    End If


    Err.Clear

    On Error GoTo ErrorHandler


    '==========================================================================
    ' 7 - HATA OLUÞMASI GEREKÝYOR
    '==========================================================================

    If Not ErrorOccurred Then

        Err.Raise _
            vbObjectError + 7905, _
            "TEST_029", _
            "Sýfýr tutarlý TOPLANTI aidatý Service tarafýndan reddedilmedi."

    End If


    '==========================================================================
    ' 8 - HATA NUMARASI KONTROLÜ
    '
    ' Türkçe hata mesajý yerine hata kodu kontrol edilir.
    '==========================================================================

    If ErrorNumber <> ExpectedErrorNumber Then

        Err.Raise _
            vbObjectError + 7906, _
            "TEST_029", _
            "Beklenen hata kodu alýnamadý." _
            & vbCrLf & vbCrLf _
            & "Beklenen : " _
            & ExpectedErrorNumber _
            & vbCrLf _
            & "Alýnan   : " _
            & ErrorNumber _
            & vbCrLf & vbCrLf _
            & "Hata mesajý:" _
            & vbCrLf _
            & ErrorDescription

    End If


    '==========================================================================
    ' 9 - CHARGEID OLUÞMAMALI
    '==========================================================================

    If ChargeID <> 0 Then

        Err.Raise _
            vbObjectError + 7907, _
            "TEST_029", _
            "Geçersiz iþlem sonucunda ChargeID oluþtu: " _
            & ChargeID

    End If


    '==========================================================================
    ' 10 - REPOSITORY'DE KAYIT OLUÞMADIÐINI KONTROL ET
    '==========================================================================

    Set Charges = _
        Repo.GetByMemberID(TestMemberID)


    If Charges Is Nothing Then

        Err.Raise _
            vbObjectError + 7908, _
            "TEST_029", _
            "Üye hareketleri Repository'den okunamadý."

    End If


    MeetingChargeFound = False


    For Each Charge In Charges

        If Not Charge Is Nothing Then

            If Charge.FiscalYear = FiscalYear _
               And Charge.DueMonth = DueMonth _
               And StrComp( _
                    Trim$(Charge.ChargeType), _
                    "TOPLANTI", _
                    vbTextCompare) = 0 _
               And StrComp( _
                    Trim$(Charge.AdjustmentType), _
                    "NORMAL", _
                    vbTextCompare) = 0 Then

                MeetingChargeFound = True

                Exit For

            End If

        End If

    Next Charge


    '==========================================================================
    ' 11 - KAYIT VARSA TEST BAÞARISIZ
    '==========================================================================

    If MeetingChargeFound Then

        Err.Raise _
            vbObjectError + 7909, _
            "TEST_029", _
            "Reddedilmesi gereken sýfýr tutarlý TOPLANTI kaydý " _
            & "Repository'de oluþmuþ."

    End If


    '==========================================================================
    ' 12 - BAÞARILI
    '==========================================================================

    MsgBox _
        "TEST-029 BAÞARILI." _
        & vbCrLf & vbCrLf _
        & "Test üyesi       : " & TestMemberID _
        & vbCrLf _
        & "Mali yýl         : " & FiscalYear _
        & vbCrLf _
        & "Aidat ayý        : " & DueMonth _
        & vbCrLf _
        & "Tutar            : 0 TL" _
        & vbCrLf & vbCrLf _
        & "Service reddi    : OK" _
        & vbCrLf _
        & "Hata kodu        : " & ErrorNumber & " OK" _
        & vbCrLf _
        & "ChargeID         : 0 OK" _
        & vbCrLf _
        & "Repository kayýt : YOK OK" _
        & vbCrLf & vbCrLf _
        & "Sonuç: BEKLENEN RET", _
        vbInformation, _
        "OAA - TEST-029"


    Exit Sub


'==============================================================================
' HATA YAKALAMA
'==============================================================================

ErrorHandler:

    MsgBox _
        "TEST-029 BAÞARISIZ." _
        & vbCrLf & vbCrLf _
        & "Hata No : " & Err.Number _
        & vbCrLf _
        & "Açýklama: " & Err.Description, _
        vbCritical, _
        "OAA - TEST-029"

End Sub



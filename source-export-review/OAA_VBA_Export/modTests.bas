    End If

    '==========================================================================
    ' EKLEME SONRASI KONTROL
    '==========================================================================

    BalanceAfterAdd = LedgerService.GetCurrentBalance

    If BalanceAfterAdd <> BalanceBefore + TestAmount Then

        Err.Raise _
            vbObjectError + 14305, _
            "TEST-143", _
            "Gelir ekleme sonrasi bakiye hatali."

    End If

    '==========================================================================
    ' GELIR VE DEFTER ILISKISINI KONTROL ET
    '==========================================================================

    Set LedgerRecords = LedgerService.GetAllEntries

    If LedgerRecords Is Nothing Then

        Err.Raise _
            vbObjectError + 14306, _
            "TEST-143", _
            "Defter kayitlari okunamadi."

    End If

    MatchCount = 0

    For I = 1 To LedgerRecords.Count

        Set CurrentEntry = LedgerRecords(I)

        If Not CurrentEntry Is Nothing Then

            If CurrentEntry.IncomeID = TestIncomeID Then

                MatchCount = MatchCount + 1

                Set Entry = CurrentEntry

            End If

        End If

    Next I

    If MatchCount <> 1 Then

        Err.Raise _
            vbObjectError + 14307, _
            "TEST-143", _
            "Gelire bagli tekil defter hareketi bulunamadi."

    End If

    '==========================================================================
    ' GELIR SILME
    '==========================================================================

    If Not IncomeService.DeleteIncome(TestIncomeID) Then

        Err.Raise _
            vbObjectError + 14308, _
            "TEST-143", _
            "DeleteIncome islemi basarisiz."

    End If

    '==========================================================================
    ' GELIR KAYDI SILINME KONTROLU
    '==========================================================================

    Set LoadedIncome = IncomeService.GetIncome(TestIncomeID)

    If Not LoadedIncome Is Nothing Then

        Err.Raise _
            vbObjectError + 14309, _
            "TEST-143", _
            "Gelir kaydi silinmemis."

    End If

    '==========================================================================
    ' DEFTER HAREKETI SILINME KONTROLU
    '==========================================================================

    Set LedgerRecords = LedgerService.GetAllEntries

    If LedgerRecords Is Nothing Then

        Err.Raise _
            vbObjectError + 14310, _
            "TEST-143", _
            "Silme sonrasi defter kayitlari okunamadi."

    End If

    LedgerFound = False

    For I = 1 To LedgerRecords.Count

        Set CurrentEntry = LedgerRecords(I)

        If Not CurrentEntry Is Nothing Then

            If CurrentEntry.IncomeID = TestIncomeID Then

                LedgerFound = True

                Exit For

            End If

        End If

    Next I

    If LedgerFound Then

        Err.Raise _
            vbObjectError + 14311, _
            "TEST-143", _
            "Gelire bagli defter hareketi silinmemis."

    End If

    '==========================================================================
    ' BAKIYE KONTROLU
    '==========================================================================

    BalanceAfterDelete = LedgerService.GetCurrentBalance

    If BalanceAfterDelete <> BalanceBefore Then

        Err.Raise _
            vbObjectError + 14312, _
            "TEST-143", _
            "Silme sonrasi bakiye baslangic degerine donmedi."

    End If

    '==========================================================================
    ' KAYIT SAYILARI KONTROLU
    '==========================================================================

    Set IncomeRecords = IncomeService.GetAllIncomes
    Set LedgerRecords = LedgerService.GetAllEntries

    If IncomeRecords Is Nothing Then

        Err.Raise _
            vbObjectError + 14313, _
            "TEST-143", _
            "Gelir kayitlari tekrar okunamadi."

    End If

    If LedgerRecords Is Nothing Then

        Err.Raise _
            vbObjectError + 14314, _
            "TEST-143", _
            "Defter kayitlari tekrar okunamadi."

    End If

    IncomeCountAfter = IncomeRecords.Count
    LedgerCountAfter = LedgerRecords.Count

    If IncomeCountAfter <> IncomeCountBefore Then

        Err.Raise _
            vbObjectError + 14315, _
            "TEST-143", _
            "Gelir kayit sayisi baslangic degerine donmedi."

    End If

    If LedgerCountAfter <> LedgerCountBefore Then

        Err.Raise _
            vbObjectError + 14316, _
            "TEST-143", _
            "Defter kayit sayisi baslangic degerine donmedi."

    End If

    '==========================================================================
    ' BASARILI
    '==========================================================================

    Debug.Print String(70, "=")
    Debug.Print "TEST-143 BASARILI"
    Debug.Print "Gelir kaydi silme       : BASARILI"
    Debug.Print "Defter hareketi silme   : BASARILI"
    Debug.Print "Gelir iliski kontrolu   : BASARILI"
    Debug.Print "Bakiye kontrolu         : BASARILI"
    Debug.Print "Kayit sayisi kontrolu   : BASARILI"
    Debug.Print String(70, "=")

    MsgBox _
        "TEST-143 BASARILI" & vbCrLf & vbCrLf & _
        "Gelir kaydi silme       : BASARILI" & vbCrLf & _
        "Defter hareketi silme   : BASARILI" & vbCrLf & _
        "Gelir iliski kontrolu   : BASARILI" & vbCrLf & _
        "Bakiye kontrolu         : BASARILI" & vbCrLf & _
        "Kayit sayisi kontrolu   : BASARILI", _
        vbInformation, _
        "OAA - TEST-143"

    TestIncomeID = 0

    GoTo CleanExit

'==============================================================================
' HATA YONETIMI
'==============================================================================

TestError:

    ErrorNumber = Err.Number
    ErrorDescription = Err.Description

    '--------------------------------------------------------------------------
    ' YALNIZCA TESTE AIT KAYDI TEMIZLEMEYI DENE
    '--------------------------------------------------------------------------

    On Error Resume Next

    If TestIncomeID > 0 Then

        Call IncomeService.DeleteIncome(TestIncomeID)

    End If

    On Error GoTo 0

    Debug.Print String(70, "=")
    Debug.Print "TEST-143 BASARISIZ"
    Debug.Print "Hata numarasi : " & ErrorNumber
    Debug.Print "Hata aciklamasi: " & ErrorDescription
    Debug.Print String(70, "=")

    MsgBox _
        "TEST-143 BASARISIZ" & vbCrLf & vbCrLf & _
        "Hata numarasi : " & ErrorNumber & vbCrLf & _
        "Hata aciklamasi: " & ErrorDescription & vbCrLf & vbCrLf & _
        "Test kaydi temizlenmeye calisildi.", _
        vbCritical, _
        "OAA - TEST-143"

'==============================================================================
' TEMIZ CIKIS
'==============================================================================

CleanExit:

    Set CurrentEntry = Nothing
    Set Entry = Nothing

    Set IncomeRecords = Nothing
    Set LedgerRecords = Nothing

    Set LoadedIncome = Nothing
    Set Income = Nothing

    Set LedgerService = Nothing
    Set IncomeService = Nothing

End Sub

'==============================================================================
' TEST-144
' Iliskili Defter Hareketi Bulunmayan Gelirin Silinmesinin Engellenmesi
'
' Amac:
'   Gelire ait defter hareketi bulunmadiginda DeleteIncome isleminin
'   silmeyi reddettigini ve gelir kaydini korudugunu dogrulamak.
'
' Test sonunda olusturulan gelir ve defter kayitlari temizlenir.
'==============================================================================

Public Sub TEST_144_IncomeDeleteWithoutLedger()

    Dim IncomeService As clsIncomeService
    Dim LedgerService As clsLedgerService

    Dim Income As clsIncome
    Dim LoadedIncome As clsIncome

    Dim Entries As Collection
    Dim Entry As clsLedgerEntry
    Dim CurrentEntry As clsLedgerEntry

    Dim TestIncomeID As Long
    Dim TestDocumentNo As String

    Dim BalanceBefore As Currency
    Dim BalanceAfterAdd As Currency
    Dim BalanceAfterLedgerDelete As Currency
    Dim BalanceAfterRejectedDelete As Currency
    Dim BalanceAfterCleanup As Currency

    Dim MatchCount As Long
    Dim I As Long

    Dim DeleteResult As Boolean
    Dim CleanupSucceeded As Boolean

    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    On Error GoTo TestError

    '==========================================================================
    ' TEST VERILERI
    '==========================================================================

    TestDocumentNo = _
        "TEST-144-" & Format$(Now, "yyyymmddhhnnss")

    '==========================================================================
    ' SERVICES
    '==========================================================================

    Set IncomeService = New clsIncomeService
    Set LedgerService = New clsLedgerService

    '==========================================================================
    ' BASLANGIC BAKIYESI
    '==========================================================================

    BalanceBefore = LedgerService.GetCurrentBalance

    '==========================================================================
    ' TEST GELIR KAYDI OLUSTUR
    '==========================================================================

    Set Income = New clsIncome

    With Income
        .IncomeID = 0
        .EntryDate = Date
        .DocumentNo = TestDocumentNo
        .IncomeType = "TEST-144"
        .Description = "TEST-144 Silme koruma testi"
        .IncomeAmount = CCur(0.01)
        .CashAmount = CCur(0.01)
        .BankAmount = CCur(0)
    End With

    If Not IncomeService.AddIncomeWithLedger(Income) Then

        Err.Raise _
            vbObjectError + 14401, _
            "TEST-144", _
            "Test gelir kaydi olusturulamadi."

    End If

    TestIncomeID = Income.IncomeID

    If TestIncomeID <= 0 Then

        Err.Raise _
            vbObjectError + 14402, _
            "TEST-144", _
            "Gecerli IncomeID olusturulmadi."

    End If

    '==========================================================================
    ' GELIR VE DEFTER BAGLANTISINI BUL
    '==========================================================================

    Set Entries = LedgerService.GetAllEntries

    If Entries Is Nothing Then

        Err.Raise _
            vbObjectError + 14403, _
            "TEST-144", _
            "Defter kayitlari okunamadi."

    End If

    MatchCount = 0

    For I = 1 To Entries.Count

        Set CurrentEntry = Entries(I)

        If Not CurrentEntry Is Nothing Then

            If CurrentEntry.IncomeID = TestIncomeID Then

                MatchCount = MatchCount + 1

                Set Entry = CurrentEntry

            End If

        End If

    Next I

    If MatchCount <> 1 Then

        Err.Raise _
            vbObjectError + 14404, _
            "TEST-144", _
            "Test gelirine ait tekil defter hareketi bulunamadi."

    End If

    BalanceAfterAdd = LedgerService.GetCurrentBalance

    If BalanceAfterAdd <> BalanceBefore + CCur(0.01) Then

        Err.Raise _
            vbObjectError + 14405, _
            "TEST-144", _
            "Gelir ekleme sonrasi bakiye hatali."

    End If

    '==========================================================================
    ' ILISKILI DEFTER HAREKETINI SIL
    '==========================================================================

    If Not LedgerService.DeleteEntry(Entry.LedgerID) Then

        Err.Raise _
            vbObjectError + 14406, _
            "TEST-144", _
            "Test icin defter hareketi silinemedi."

    End If

    If Not LedgerService.RecalculateBalances Then

        Err.Raise _
            vbObjectError + 14407, _
            "TEST-144", _
            "Defter bakiyesi yeniden hesaplanamadi."

    End If

    BalanceAfterLedgerDelete = LedgerService.GetCurrentBalance

    If BalanceAfterLedgerDelete <> BalanceBefore Then

        Err.Raise _
            vbObjectError + 14408, _
            "TEST-144", _
            "Defter hareketi silindikten sonra bakiye hatali."

    End If

    '==========================================================================
    ' DEFTER HAREKETI OLMAYAN GELIRI SILMEYI DENE
    '==========================================================================

    DeleteResult = IncomeService.DeleteIncome(TestIncomeID)

    If DeleteResult Then

        Err.Raise _
            vbObjectError + 14409, _
            "TEST-144", _
            "Iliskili defter hareketi olmayan gelir silindi."

    End If

    '==========================================================================
    ' GELIR KAYDININ KORUNDUGUNU KONTROL ET
    '==========================================================================

    Set LoadedIncome = IncomeService.GetIncome(TestIncomeID)

    If LoadedIncome Is Nothing Then

        Err.Raise _
            vbObjectError + 14410, _
            "TEST-144", _
            "Silme reddedilmesine ragmen gelir kaydi bulunamadi."

    End If

    If LoadedIncome.IncomeID <> TestIncomeID Then

        Err.Raise _
            vbObjectError + 14411, _
            "TEST-144", _
            "Korunan gelir kaydinin IncomeID degeri hatali."

    End If

    '==========================================================================
    ' REDDEDILEN SILME ISLEMININ BAKIYEYI DEGISTIRMEDIGINI KONTROL ET
    '==========================================================================

    BalanceAfterRejectedDelete = LedgerService.GetCurrentBalance

    If BalanceAfterRejectedDelete <> BalanceAfterLedgerDelete Then

        Err.Raise _
            vbObjectError + 14412, _
            "TEST-144", _
            "Reddedilen silme islemi bakiyeyi degistirdi."

    End If

    '==========================================================================
    ' TEMIZLIK ICIN ESKI DEFTER HAREKETINI AYNI ID ILE GERI EKLE
    '==========================================================================

    If Not LedgerService.AddEntry(Entry) Then

        Err.Raise _
            vbObjectError + 14413, _
            "TEST-144", _
            "Test temizligi icin defter hareketi geri eklenemedi."

    End If

    If Not LedgerService.RecalculateBalances Then

        Err.Raise _
            vbObjectError + 14414, _
            "TEST-144", _
            "Defter bakiyesi geri yukleme sonrasi hesaplanamadi."

    End If

    '==========================================================================
    ' TEST GELIRINI NORMAL SERVIS ILE TEMIZLE
    '==========================================================================

    If Not IncomeService.DeleteIncome(TestIncomeID) Then

        Err.Raise _
            vbObjectError + 14415, _
            "TEST-144", _
            "Test gelir kaydi temizlenemedi."

    End If

    TestIncomeID = 0

    '==========================================================================
    ' TEMIZLIK SONRASI BAKIYE
    '==========================================================================

    BalanceAfterCleanup = LedgerService.GetCurrentBalance

    If BalanceAfterCleanup <> BalanceBefore Then

        Err.Raise _
            vbObjectError + 14416, _
            "TEST-144", _
            "Test temizligi sonrasi bakiye baslangic degerine donmedi."

    End If

    '==========================================================================
    ' BASARILI
    '==========================================================================

    Debug.Print String(70, "=")
    Debug.Print "TEST-144 BASARILI"
    Debug.Print "Eksik defter iliskisi kontrolu : BASARILI"
    Debug.Print "Gelir silme isleminin reddi    : BASARILI"
    Debug.Print "Gelir kaydinin korunmasi       : BASARILI"
    Debug.Print "Bakiye tutarliligi             : BASARILI"
    Debug.Print "Test kayitlarinin temizligi    : BASARILI"
    Debug.Print String(70, "=")

    MsgBox _
        "TEST-144 BASARILI" & vbCrLf & vbCrLf & _
        "Eksik defter iliskisi kontrolu : BASARILI" & vbCrLf & _
        "Gelir silme isleminin reddi    : BASARILI" & vbCrLf & _
        "Gelir kaydinin korunmasi       : BASARILI" & vbCrLf & _
        "Bakiye tutarliligi             : BASARILI" & vbCrLf & _
        "Test kayitlarinin temizligi    : BASARILI", _
        vbInformation, _
        "OAA - TEST-144"

    GoTo CleanExit

'==============================================================================
' HATA YONETIMI
'==============================================================================

TestError:

    ErrorNumber = Err.Number
    ErrorDescription = Err.Description

    '--------------------------------------------------------------------------
    ' YALNIZCA TESTE AIT KAYITLARI TEMIZLE
    '--------------------------------------------------------------------------

    On Error Resume Next

    If TestIncomeID > 0 Then

        ' Defter hareketi eksikse once eski hareketi geri yukle.
        If Not Entry Is Nothing Then

            If Entry.LedgerID > 0 Then

                Set CurrentEntry = _
                    LedgerService.GetEntry(Entry.LedgerID)

                If CurrentEntry Is Nothing Then

                    Call LedgerService.AddEntry(Entry)

                End If

            End If

        End If

        Call LedgerService.RecalculateBalances

        ' Gelir kaydini ve iliskili hareketini servis uzerinden temizle.
        Call IncomeService.DeleteIncome(TestIncomeID)

    End If

    On Error GoTo 0

    Debug.Print String(70, "=")
    Debug.Print "TEST-144 BASARISIZ"
    Debug.Print "Hata numarasi : " & ErrorNumber
    Debug.Print "Hata aciklamasi: " & ErrorDescription
    Debug.Print String(70, "=")

    MsgBox _
        "TEST-144 BASARISIZ" & vbCrLf & vbCrLf & _
        "Hata numarasi : " & ErrorNumber & vbCrLf & _
        "Hata aciklamasi: " & ErrorDescription & vbCrLf & vbCrLf & _
        "Test kayitlari temizlenmeye calisildi.", _
        vbCritical, _
        "OAA - TEST-144"

'==============================================================================
' TEMIZ CIKIS
'==============================================================================

CleanExit:

    Set CurrentEntry = Nothing
    Set Entry = Nothing

    Set Entries = Nothing

    Set LoadedIncome = Nothing
    Set Income = Nothing

    Set LedgerService = Nothing
    Set IncomeService = Nothing

End Sub


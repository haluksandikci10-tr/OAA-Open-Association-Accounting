' TEST-117
' Receipt Service - Baþarýlý Kayýt
'==============================================================================

Public Sub TEST_117_ReceiptServiceAdd()

    Dim Service As clsReceiptService
    Dim Receipt As clsReceipt
    Dim LoadedReceipt As clsReceipt

    Dim TestReceiptID As Long
    Dim TestMemberID As Long

    On Error GoTo TestError

    TestMemberID = 10

    Debug.Print String(70, "=")
    Debug.Print "TEST-117 - Receipt Service Add"
    Debug.Print String(70, "=")


    '--------------------------------------------------------------------------
    ' SERVICE
    '--------------------------------------------------------------------------

    Set Service = New clsReceiptService


    '--------------------------------------------------------------------------
    ' ENTITY
    '--------------------------------------------------------------------------

    Set Receipt = New clsReceipt


    If TestReceiptID <= 0 Then

        Err.Raise _
            vbObjectError + 11701, _
            "TEST-117", _
            "ReceiptService.AddReceipt kayýt oluþturmadý."

    End If


    '--------------------------------------------------------------------------
    ' ENTITY ID
    '--------------------------------------------------------------------------

    If Receipt.ReceiptID <> TestReceiptID Then

        Err.Raise _
            vbObjectError + 11702, _
            "TEST-117", _
            "Service sonrasý Entity ReceiptID hatalý."


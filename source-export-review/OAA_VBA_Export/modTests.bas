    Expense.CashAmount = OriginalCashAmount
    Expense.BankAmount = OriginalBankAmount

    If Not ExpenseService.AddExpenseWithLedger(Expense) Then

        Err.Raise _
            vbObjectError + 13601, _
            "TEST-136", _
            "Test gideri ve Ledger hareketi olusturulamadi."

    End If

    TestExpenseID = Expense.ExpenseID

    If TestExpenseID <= 0 Then

        Err.Raise _
            vbObjectError + 13602, _
            "TEST-136", _
            "Gecerli ExpenseID olusturulamadi."

    End If

    '--------------------------------------------------------------------------
    ' ILISKILI LEDGER HAREKETINI BUL
    '--------------------------------------------------------------------------

    Set Entries = LedgerService.GetAllEntries

    If Entries Is Nothing Then

        Err.Raise _
            vbObjectError + 13603, _
            "TEST-136", _
            "Ledger hareketleri okunamadi."

    End If

    TestLedgerID = 0

    For I = 1 To Entries.Count

        Set Entry = Entries(I)

        If Not Entry Is Nothing Then

            If Entry.ExpenseID = TestExpenseID Then

                TestLedgerID = Entry.LedgerID

                Exit For

            End If

        End If

    Next I

    If TestLedgerID <= 0 Then

        Err.Raise _
            vbObjectError + 13604, _
            "TEST-136", _
            "Test giderine bagli Ledger hareketi bulunamadi."

    End If

    '--------------------------------------------------------------------------
    ' TEST 1 - SIFIR TUTARLI GUNCELLEME REDDEDILMELI
    '--------------------------------------------------------------------------

    Expense.ExpenseAmount = CCur(0)
    Expense.CashAmount = CCur(0)
    Expense.BankAmount = CCur(0)
    Expense.Description = "TEST-136 - Sifir tutar denemesi"

    ZeroUpdateRejected = _
        Not ExpenseService.UpdateExpense(Expense)

    If Not ZeroUpdateRejected Then

        Err.Raise _
            vbObjectError + 13605, _
            "TEST-136", _
            "Sifir tutarli gider guncellemesi reddedilmedi."

    End If

    '--------------------------------------------------------------------------
    ' TEST 2 - NEGATIF TUTARLI GUNCELLEME REDDEDILMELI
    '--------------------------------------------------------------------------

    Expense.ExpenseAmount = CCur(-5)
    Expense.CashAmount = CCur(-5)
    Expense.BankAmount = CCur(0)
    Expense.Description = "TEST-136 - Negatif tutar denemesi"

    NegativeUpdateRejected = _
        Not ExpenseService.UpdateExpense(Expense)

    If Not NegativeUpdateRejected Then

        Err.Raise _
            vbObjectError + 13606, _
            "TEST-136", _
            "Negatif tutarli gider guncellemesi reddedilmedi."

    End If

    '--------------------------------------------------------------------------
    ' TEST 3 - GIDER KAYDI DEGISMEMIS OLMALI
    '--------------------------------------------------------------------------

    Set LoadedExpense = _
        ExpenseService.GetExpense(TestExpenseID)

    If LoadedExpense Is Nothing Then

        Err.Raise _
            vbObjectError + 13607, _
            "TEST-136", _
            "Test gideri guncelleme denemelerinden sonra bulunamadi."

    End If

    If LoadedExpense.ExpenseID <> TestExpenseID Then

        Err.Raise _
            vbObjectError + 13608, _
            "TEST-136", _
            "ExpenseID degisti."

    End If

    If LoadedExpense.ExpenseAmount <> OriginalAmount Then

        Err.Raise _
            vbObjectError + 13609, _
            "TEST-136", _
            "Gecersiz guncelleme gider tutarini degistirdi."

    End If

    If LoadedExpense.CashAmount <> OriginalCashAmount Then

        Err.Raise _
            vbObjectError + 13610, _
            "TEST-136", _
            "Gecersiz guncelleme kasa tutarini degistirdi."

    End If

    If LoadedExpense.BankAmount <> OriginalBankAmount Then

        Err.Raise _
            vbObjectError + 13611, _
            "TEST-136", _
            "Gecersiz guncelleme banka tutarini degistirdi."

    End If

    If LoadedExpense.Description <> OriginalDescription Then

        Err.Raise _
            vbObjectError + 13612, _
            "TEST-136", _
            "Gecersiz guncelleme gider aciklamasini degistirdi."

    End If

    '--------------------------------------------------------------------------
    ' TEST 4 - LEDGER KAYDI DEGISMEMIS OLMALI
    '--------------------------------------------------------------------------

    Set LoadedEntry = _
        LedgerService.GetEntry(TestLedgerID)

    If LoadedEntry Is Nothing Then

        Err.Raise _
            vbObjectError + 13613, _
            "TEST-136", _
            "Iliskili Ledger hareketi bulunamadi."

    End If

    If LoadedEntry.LedgerID <> TestLedgerID Then

        Err.Raise _
            vbObjectError + 13614, _
            "TEST-136", _
            "LedgerID degisti."

    End If

    If LoadedEntry.ExpenseID <> TestExpenseID Then

        Err.Raise _
            vbObjectError + 13615, _
            "TEST-136", _
            "Ledger ExpenseID degeri degisti."

    End If

    If LoadedEntry.ExpenseAmount <> OriginalAmount Then

        Err.Raise _
            vbObjectError + 13616, _
            "TEST-136", _
            "Gecersiz guncelleme Ledger gider tutarini degistirdi."

    End If

    If LoadedEntry.CashAmount <> OriginalCashAmount Then

        Err.Raise _
            vbObjectError + 13617, _
            "TEST-136", _
            "Gecersiz guncelleme Ledger kasa tutarini degistirdi."

    End If

    If LoadedEntry.BankAmount <> OriginalBankAmount Then

        Err.Raise _
            vbObjectError + 13618, _
            "TEST-136", _
            "Gecersiz guncelleme Ledger banka tutarini degistirdi."

    End If

    If LoadedEntry.Description <> OriginalDescription Then

        Err.Raise _
            vbObjectError + 13619, _
            "TEST-136", _
            "Gecersiz guncelleme Ledger aciklamasini degistirdi."

    End If

    '--------------------------------------------------------------------------
    ' TEST KAYDINI TEMIZLE
    '--------------------------------------------------------------------------

    If Not ExpenseService.DeleteExpense(TestExpenseID) Then

        Err.Raise _
            vbObjectError + 13620, _
            "TEST-136", _
            "Test gideri ve Ledger hareketi temizlenemedi."

    End If

    TestExpenseID = 0

    '--------------------------------------------------------------------------
    ' BASARILI
    '--------------------------------------------------------------------------

    Debug.Print String(70, "=")
    Debug.Print "TEST-136 BASARILI"
    Debug.Print "Sifir tutar kontrolu       : BASARILI"
    Debug.Print "Negatif tutar kontrolu     : BASARILI"
    Debug.Print "Gider kaydi korunmasi      : BASARILI"
    Debug.Print "Ledger kaydi korunmasi     : BASARILI"
    Debug.Print "Test kayitlarinin temizligi: BASARILI"
    Debug.Print String(70, "=")

    MsgBox _
        "TEST-136 BASARILI" & vbCrLf & vbCrLf & _
        "Sifir tutarli guncelleme reddedildi." & vbCrLf & _
        "Negatif tutarli guncelleme reddedildi." & vbCrLf & _
        "Gider kaydi korundu." & vbCrLf & _
        "Ledger kaydi korundu." & vbCrLf & _
        "Test kayitlari temizlendi.", _
        vbInformation, _
        "OAA - TEST-136"

    Set LoadedEntry = Nothing
    Set Entry = Nothing
    Set Entries = Nothing
    Set LoadedExpense = Nothing
    Set Expense = Nothing
    Set LedgerService = Nothing
    Set ExpenseService = Nothing

    Exit Sub

TestError:

    ErrorNumber = Err.Number
    ErrorDescription = Err.Description

    '--------------------------------------------------------------------------
    ' HATA DURUMUNDA TEMIZLEMEYI DENE
    '--------------------------------------------------------------------------

    On Error Resume Next

    If TestExpenseID > 0 Then

        Call ExpenseService.DeleteExpense(TestExpenseID)

    End If

    On Error GoTo 0

    Debug.Print String(70, "=")
    Debug.Print "TEST-136 BASARISIZ"
    Debug.Print "Hata No : " & ErrorNumber
    Debug.Print "Aciklama: " & ErrorDescription
    Debug.Print "Temizleme denendi."
    Debug.Print String(70, "=")

    MsgBox _
        "TEST-136 BASARISIZ" & vbCrLf & vbCrLf & _
        "Hata No: " & ErrorNumber & vbCrLf & _
        "Aciklama: " & ErrorDescription & vbCrLf & vbCrLf & _
        "Test kaydinin temizlenmesi denendi.", _
        vbCritical, _
        "OAA - TEST-136"

    Set LoadedEntry = Nothing
    Set Entry = Nothing
    Set Entries = Nothing
    Set LoadedExpense = Nothing
    Set Expense = Nothing
    Set LedgerService = Nothing
    Set ExpenseService = Nothing

End Sub

'==============================================================================
' TEST-136
'
' ExpenseService - DeleteExpense
' ExpenseRepository - DeleteByID
' LedgerService - DeleteEntry
'
' PURPOSE:
'   Verify that deleting an expense also removes its linked ledger entry.
'
' CHECKS:
'   1. Create a temporary expense and ledger entry.
'   2. Find the linked ledger entry by ExpenseID.
'   3. Delete the expense through ExpenseService.
'   4. Verify that the expense no longer exists.
'   5. Verify that the linked ledger entry no longer exists.
'   6. Verify that no ledger entry remains with the test ExpenseID.
'   7. Clean up temporary test records if necessary.
'
' IMPORTANT:
'   This test must not delete real user records.
'==============================================================================

Public Sub TEST_136_ExpenseDeleteConsistency()

    Dim ExpenseService As clsExpenseService
    Dim ExpenseRepository As clsExpenseRepository
    Dim LedgerService As clsLedgerService

    Dim Expense As clsExpense
    Dim LoadedExpense As clsExpense

    Dim Entry As clsLedgerEntry
    Dim LoadedEntry As clsLedgerEntry

    Dim Entries As Collection

    Dim TestExpenseID As Long
    Dim TestLedgerID As Long

    Dim FoundLedgerEntry As Boolean
    Dim FoundRemainingEntry As Boolean

    Dim I As Long

    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    On Error GoTo TestError

    '--------------------------------------------------------------------------
    ' INITIALIZE
    '--------------------------------------------------------------------------

    TestExpenseID = 0
    TestLedgerID = 0

    FoundLedgerEntry = False
    FoundRemainingEntry = False

    Set ExpenseService = New clsExpenseService
    Set ExpenseRepository = New clsExpenseRepository
    Set LedgerService = New clsLedgerService

    '--------------------------------------------------------------------------
    ' CREATE TEST EXPENSE
    '--------------------------------------------------------------------------

    Set Expense = New clsExpense

    Expense.ExpenseID = 0
    Expense.EntryDate = Date
    Expense.DocumentNo = "TEST-136"
    Expense.ExpenseType = "TEST-136"
    Expense.Description = "TEST-136 - Expense delete test"

    Expense.ExpenseAmount = CCur(10)
    Expense.CashAmount = CCur(10)
    Expense.BankAmount = CCur(0)

    '--------------------------------------------------------------------------
    ' CREATE EXPENSE AND LEDGER ENTRY
    '--------------------------------------------------------------------------

    If Not ExpenseService.AddExpenseWithLedger(Expense) Then

        Err.Raise _
            vbObjectError + 13601, _
            "TEST-136", _
            "AddExpenseWithLedger failed."

    End If

    TestExpenseID = Expense.ExpenseID

    If TestExpenseID <= 0 Then

        Err.Raise _
            vbObjectError + 13602, _
            "TEST-136", _
            "A valid ExpenseID was not created."

    End If

    '--------------------------------------------------------------------------
    ' FIND LINKED LEDGER ENTRY
    '--------------------------------------------------------------------------

    Set Entries = LedgerService.GetAllEntries

    If Entries Is Nothing Then

        Err.Raise _
            vbObjectError + 13603, _
            "TEST-136", _
            "Ledger entries could not be read."

    End If

    For I = 1 To Entries.Count

        Set Entry = Entries(I)

        If Not Entry Is Nothing Then

            If Entry.ExpenseID = TestExpenseID Then

                TestLedgerID = Entry.LedgerID
                FoundLedgerEntry = True

                Exit For

            End If

        End If

    Next I

    If Not FoundLedgerEntry Or TestLedgerID <= 0 Then

        Err.Raise _
            vbObjectError + 13604, _
            "TEST-136", _
            "The ledger entry linked to the test expense was not found."

    End If

    '--------------------------------------------------------------------------
    ' VERIFY EXPENSE BEFORE DELETION
    '--------------------------------------------------------------------------

    Set LoadedExpense = ExpenseService.GetExpense(TestExpenseID)

    If LoadedExpense Is Nothing Then

        Err.Raise _
            vbObjectError + 13605, _
            "TEST-136", _
            "The test expense could not be read before deletion."

    End If

    If LoadedExpense.ExpenseID <> TestExpenseID Then

        Err.Raise _
            vbObjectError + 13606, _
            "TEST-136", _
            "The expense ID does not match."

    End If

    '--------------------------------------------------------------------------
    ' DELETE EXPENSE
    '--------------------------------------------------------------------------

    If Not ExpenseService.DeleteExpense(TestExpenseID) Then

        Err.Raise _
            vbObjectError + 13607, _
            "TEST-136", _
            "DeleteExpense returned False."

    End If

    '--------------------------------------------------------------------------
    ' VERIFY THAT EXPENSE WAS DELETED
    '--------------------------------------------------------------------------

    Set LoadedExpense = ExpenseService.GetExpense(TestExpenseID)

    If Not LoadedExpense Is Nothing Then

        Err.Raise _
            vbObjectError + 13608, _
            "TEST-136", _
            "The expense still exists after deletion."

    End If

    '--------------------------------------------------------------------------
    ' VERIFY THAT LINKED LEDGER ENTRY WAS DELETED
    '--------------------------------------------------------------------------

    Set LoadedEntry = LedgerService.GetEntry(TestLedgerID)

    If Not LoadedEntry Is Nothing Then

        Err.Raise _
            vbObjectError + 13609, _
            "TEST-136", _
            "The linked ledger entry still exists after deletion."

    End If

    '--------------------------------------------------------------------------
    ' VERIFY THAT NO LEDGER ENTRY REFERENCES THE TEST EXPENSE
    '--------------------------------------------------------------------------

    Set Entries = LedgerService.GetAllEntries

    If Entries Is Nothing Then

        Err.Raise _
            vbObjectError + 13610, _
            "TEST-136", _
            "Ledger entries could not be read after deletion."

    End If

    FoundRemainingEntry = False

    For I = 1 To Entries.Count

        Set Entry = Entries(I)

        If Not Entry Is Nothing Then

            If Entry.ExpenseID = TestExpenseID Then

                FoundRemainingEntry = True

                Exit For

            End If

        End If

    Next I

    If FoundRemainingEntry Then

        Err.Raise _
            vbObjectError + 13611, _
            "TEST-136", _
            "An orphan ledger entry remains for the deleted expense."

    End If

    '--------------------------------------------------------------------------
    ' SUCCESS
    '--------------------------------------------------------------------------

    Debug.Print String(70, "=")
    Debug.Print "TEST-136 SUCCESS"
    Debug.Print "Expense deletion       : SUCCESS"
    Debug.Print "Ledger deletion        : SUCCESS"
    Debug.Print "ExpenseID relationship : SUCCESS"
    Debug.Print "Temporary records      : VERIFIED"
    Debug.Print String(70, "=")

    MsgBox _
        "TEST-136 SUCCESS" & vbCrLf & vbCrLf & _
        "Expense deletion: SUCCESS" & vbCrLf & _
        "Ledger deletion: SUCCESS" & vbCrLf & _
        "ExpenseID relationship: SUCCESS" & vbCrLf & _
        "Temporary records: VERIFIED", _
        vbInformation, _
        "OAA - TEST-136"

    GoTo CleanExit

'--------------------------------------------------------------------------
' ERROR HANDLER
'--------------------------------------------------------------------------

TestError:

    ErrorNumber = Err.Number
    ErrorDescription = Err.Description

    Debug.Print "TEST-136 FAILED"
    Debug.Print "Error Number: " & ErrorNumber
    Debug.Print "Description: " & ErrorDescription

    '--------------------------------------------------------------------------
    ' CLEAN UP ONLY THE TEMPORARY TEST RECORDS
    '--------------------------------------------------------------------------

    On Error Resume Next

    If TestExpenseID > 0 Then

        ' Try the service-level deletion first.
        Call ExpenseService.DeleteExpense(TestExpenseID)

        ' Remove any remaining ledger entry linked to this test expense.
        Set Entries = LedgerService.GetAllEntries

        If Not Entries Is Nothing Then

            For I = Entries.Count To 1 Step -1

                Set Entry = Entries(I)

                If Not Entry Is Nothing Then

                    If Entry.ExpenseID = TestExpenseID Then

                        Call LedgerService.DeleteEntry(Entry.LedgerID)

                    End If

                End If

            Next I

        End If

        ' Remove the expense record if it still exists.
        Set LoadedExpense = ExpenseRepository.GetByID(TestExpenseID)

        If Not LoadedExpense Is Nothing Then

            Call ExpenseRepository.DeleteByID(TestExpenseID)

        End If

    End If

    On Error GoTo 0

    MsgBox _
        "TEST-136 FAILED" & vbCrLf & vbCrLf & _
        "Error Number: " & ErrorNumber & vbCrLf & _
        "Description: " & ErrorDescription & vbCrLf & vbCrLf & _
        "Cleanup was attempted for temporary test records.", _
        vbCritical, _
        "OAA - TEST-136"

CleanExit:

    Set LoadedEntry = Nothing
    Set Entry = Nothing
    Set Entries = Nothing

    Set LoadedExpense = Nothing
    Set Expense = Nothing

    Set LedgerService = Nothing
    Set ExpenseRepository = Nothing
    Set ExpenseService = Nothing

End Sub

'==============================================================================
' TEST-137
'
' ExpenseService - Failed Delete Consistency
'
' PURPOSE:
'   Verify that a rejected expense deletion does not affect
'   an existing expense or its linked ledger entry.
'
' CHECKS:
'   1. Create a temporary expense and linked ledger entry.
'   2. Attempt deletion with an invalid ExpenseID.
'   3. Verify that the deletion is rejected.
'   4. Verify that the original expense still exists.
'   5. Verify that the original ledger entry still exists.
'   6. Verify that ExpenseID and LedgerID remain unchanged.
'   7. Clean up temporary test records.
'==============================================================================

Public Sub TEST_137_ExpenseDeleteFailureConsistency()

    Dim ExpenseService As clsExpenseService
    Dim LedgerService As clsLedgerService

    Dim Expense As clsExpense
    Dim LoadedExpense As clsExpense

    Dim Entry As clsLedgerEntry
    Dim LoadedEntry As clsLedgerEntry

    Dim Entries As Collection

    Dim TestExpenseID As Long
    Dim TestLedgerID As Long

    Dim DeleteResult As Boolean
    Dim FoundLedgerEntry As Boolean

    Dim I As Long

    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    On Error GoTo TestError

    TestExpenseID = 0
    TestLedgerID = 0
    DeleteResult = False
    FoundLedgerEntry = False

    '--------------------------------------------------------------------------
    ' CREATE SERVICES
    '--------------------------------------------------------------------------

    Set ExpenseService = New clsExpenseService
    Set LedgerService = New clsLedgerService

    '--------------------------------------------------------------------------
    ' CREATE TEST EXPENSE
    '--------------------------------------------------------------------------

    Set Expense = New clsExpense

    Expense.ExpenseID = 0
    Expense.EntryDate = Date
    Expense.DocumentNo = "TEST-137"
    Expense.ExpenseType = "TEST-137"
    Expense.Description = "TEST-137 - Delete failure test"
    Expense.ExpenseAmount = CCur(10)
    Expense.CashAmount = CCur(10)
    Expense.BankAmount = CCur(0)

    '--------------------------------------------------------------------------
    ' CREATE EXPENSE AND LEDGER ENTRY
    '--------------------------------------------------------------------------

    If Not ExpenseService.AddExpenseWithLedger(Expense) Then

        Err.Raise _
            vbObjectError + 13701, _
            "TEST-137", _
            "AddExpenseWithLedger failed."

    End If

    TestExpenseID = Expense.ExpenseID

    If TestExpenseID <= 0 Then

        Err.Raise _
            vbObjectError + 13702, _
            "TEST-137", _
            "A valid ExpenseID was not created."

    End If

    '--------------------------------------------------------------------------
    ' FIND THE LINKED LEDGER ENTRY
    '--------------------------------------------------------------------------

    Set Entries = LedgerService.GetAllEntries

    If Entries Is Nothing Then

        Err.Raise _
            vbObjectError + 13703, _
            "TEST-137", _
            "Ledger entries could not be read."

    End If

    For I = 1 To Entries.Count

        Set Entry = Entries(I)

        If Not Entry Is Nothing Then

            If Entry.ExpenseID = TestExpenseID Then

                TestLedgerID = Entry.LedgerID
                FoundLedgerEntry = True

                Exit For

            End If

        End If

    Next I

    If Not FoundLedgerEntry Or TestLedgerID <= 0 Then

        Err.Raise _
            vbObjectError + 13704, _
            "TEST-137", _
            "The linked ledger entry was not found."

    End If

    '--------------------------------------------------------------------------
    ' ATTEMPT DELETION USING AN INVALID ID
    '--------------------------------------------------------------------------

    DeleteResult = ExpenseService.DeleteExpense(-1)

    If DeleteResult Then

        Err.Raise _
            vbObjectError + 13705, _
            "TEST-137", _
            "Deletion with an invalid ExpenseID was unexpectedly accepted."

    End If

    '--------------------------------------------------------------------------
    ' VERIFY THAT THE ORIGINAL EXPENSE STILL EXISTS
    '--------------------------------------------------------------------------

    Set LoadedExpense = ExpenseService.GetExpense(TestExpenseID)

    If LoadedExpense Is Nothing Then

        Err.Raise _
            vbObjectError + 13706, _
            "TEST-137", _
            "The original expense was unexpectedly deleted."

    End If

    If LoadedExpense.ExpenseID <> TestExpenseID Then

        Err.Raise _
            vbObjectError + 13707, _
            "TEST-137", _
            "The original ExpenseID changed."

    End If

    '--------------------------------------------------------------------------
    ' VERIFY THAT THE ORIGINAL LEDGER ENTRY STILL EXISTS
    '--------------------------------------------------------------------------

    Set LoadedEntry = LedgerService.GetEntry(TestLedgerID)

    If LoadedEntry Is Nothing Then

        Err.Raise _
            vbObjectError + 13708, _
            "TEST-137", _
            "The original ledger entry was unexpectedly deleted."

    End If

    If LoadedEntry.LedgerID <> TestLedgerID Then

        Err.Raise _
            vbObjectError + 13709, _
            "TEST-137", _
            "The original LedgerID changed."

    End If

    If LoadedEntry.ExpenseID <> TestExpenseID Then

        Err.Raise _
            vbObjectError + 13710, _
            "TEST-137", _
            "The ledger entry ExpenseID relationship changed."

    End If

    '--------------------------------------------------------------------------
    ' SUCCESS
    '--------------------------------------------------------------------------

    Debug.Print String(70, "=")
    Debug.Print "TEST-137 SUCCESS"
    Debug.Print "Invalid deletion rejected : SUCCESS"
    Debug.Print "Expense preserved         : SUCCESS"
    Debug.Print "Ledger entry preserved    : SUCCESS"
    Debug.Print "ExpenseID preserved       : SUCCESS"
    Debug.Print "LedgerID preserved        : SUCCESS"
    Debug.Print String(70, "=")

    GoTo CleanUp

'--------------------------------------------------------------------------
' ERROR HANDLER
'--------------------------------------------------------------------------

TestError:

    ErrorNumber = Err.Number
    ErrorDescription = Err.Description

    Debug.Print "TEST-137 FAILED"
    Debug.Print "Error Number: " & ErrorNumber
    Debug.Print "Description: " & ErrorDescription

    Resume CleanUp

'--------------------------------------------------------------------------
' CLEANUP
'--------------------------------------------------------------------------

CleanUp:

    On Error Resume Next

    ' Delete only the temporary test expense.
    If TestExpenseID > 0 Then
        Call ExpenseService.DeleteExpense(TestExpenseID)
    End If

    Set LoadedEntry = Nothing
    Set LoadedExpense = Nothing
    Set Entry = Nothing
    Set Entries = Nothing
    Set Expense = Nothing

    Set LedgerService = Nothing
    Set ExpenseService = Nothing

    On Error GoTo 0

    If ErrorNumber <> 0 Then

        MsgBox _
            "TEST-137 BASARISIZ" & vbCrLf & vbCrLf & _
            "Hata numarasi: " & ErrorNumber & vbCrLf & _
            "Aciklama: " & ErrorDescription & vbCrLf & vbCrLf & _
            "Gecici test kayitlarinin temizligi denendi.", _
            vbCritical, _
            "OAA - TEST-137"

    Else

        MsgBox _
            "TEST-137 BASARILI" & vbCrLf & vbCrLf & _
            "Gecersiz silme istegi reddedildi." & vbCrLf & _
            "Gider kaydi korundu." & vbCrLf & _
            "Isletme defteri hareketi korundu." & vbCrLf & _
            "ExpenseID ve LedgerID kimlikleri korundu." & vbCrLf & _
            "Gecici test kaydinin temizligi denendi.", _
            vbInformation, _
            "OAA - TEST-137"

    End If

End Sub

'==============================================================================
' TEST-138
'
' Expense update/delete and ledger balance consistency.
'
' Checks:
'   1. Create a temporary expense with a linked ledger entry.
'   2. Create a later ledger entry.
'   3. Update the expense and verify the later balance.
'   4. Delete the expense and verify the later balance again.
'   5. Clean up temporary records.
'==============================================================================

Public Sub TEST_138_ExpenseBalanceConsistency()

    Dim ExpenseService As clsExpenseService
    Dim LedgerService As clsLedgerService

    Dim Expense As clsExpense
    Dim LoadedExpense As clsExpense

    Dim Entry As clsLedgerEntry
    Dim LoadedEntry As clsLedgerEntry
    Dim CurrentEntry As clsLedgerEntry

    Dim Entries As Collection

    Dim TestExpenseID As Long
    Dim TestLedgerID As Long
    Dim LaterLedgerID As Long

    Dim FoundExpenseLedger As Boolean
    Dim FoundLaterLedger As Boolean

    Dim ExpectedBalance As Currency
    Dim RunningBalance As Currency

    Dim I As Long
    Dim ErrorNumber As Long
    Dim ErrorDescription As String

    On Error GoTo TestError

    TestExpenseID = 0
    TestLedgerID = 0
    LaterLedgerID = 0

    FoundExpenseLedger = False
    FoundLaterLedger = False

    Set ExpenseService = New clsExpenseService
    Set LedgerService = New clsLedgerService

    '--------------------------------------------------------------------------
    ' CREATE TEMPORARY EXPENSE
    '--------------------------------------------------------------------------

    Set Expense = New clsExpense

    Expense.ExpenseID = 0
    Expense.EntryDate = Date
    Expense.DocumentNo = "TEST-138"
    Expense.ExpenseType = "TEST-138"
    Expense.Description = "TEST-138 - Balance consistency"
    Expense.ExpenseAmount = CCur(10)
    Expense.CashAmount = CCur(10)
    Expense.BankAmount = CCur(0)

    If Not ExpenseService.AddExpenseWithLedger(Expense) Then

        Err.Raise _
            vbObjectError + 13801, _
            "TEST-138", _
            "Temporary expense could not be created."

    End If

    TestExpenseID = Expense.ExpenseID

    If TestExpenseID <= 0 Then

        Err.Raise _
            vbObjectError + 13802, _
            "TEST-138", _
            "Invalid ExpenseID."

    End If

    '--------------------------------------------------------------------------
    ' FIND THE EXPENSE LEDGER ENTRY
    '--------------------------------------------------------------------------

    Set Entries = LedgerService.GetAllEntries

    If Entries Is Nothing Then

        Err.Raise _
            vbObjectError + 13803, _
            "TEST-138", _
            "Ledger entries could not be read."

    End If

    For I = 1 To Entries.Count

        Set Entry = Entries(I)

        If Not Entry Is Nothing Then

            If Entry.ExpenseID = TestExpenseID Then

                TestLedgerID = Entry.LedgerID
                FoundExpenseLedger = True

                Exit For

            End If

        End If

    Next I

    If Not FoundExpenseLedger Or TestLedgerID <= 0 Then

        Err.Raise _
            vbObjectError + 13804, _
            "TEST-138", _
            "Expense ledger entry was not found."

    End If

    '--------------------------------------------------------------------------
    ' CREATE A LATER LEDGER ENTRY
    '--------------------------------------------------------------------------

    Set Entry = New clsLedgerEntry

    Entry.EntryDate = Date
    Entry.DocumentNo = "TEST-138-LATER"
    Entry.ReceiptInvoice = "TEST-138-LATER"
    Entry.Description = "TEST-138 - Later ledger entry"
    Entry.IncomeType = "TEST-138"
    Entry.ExpenseType = vbNullString
    Entry.IncomeAmount = CCur(100)
    Entry.ExpenseAmount = CCur(0)
    Entry.CashAmount = CCur(100)
    Entry.BankAmount = CCur(0)
    Entry.ExpenseID = 0

    If Not LedgerService.AddEntry(Entry) Then

        Err.Raise _
            vbObjectError + 13805, _
            "TEST-138", _
            "Later ledger entry could not be created."

    End If

    LaterLedgerID = Entry.LedgerID

    If LaterLedgerID <= 0 Then

        Err.Raise _
            vbObjectError + 13806, _
            "TEST-138", _
            "Invalid later LedgerID."

    End If

    '--------------------------------------------------------------------------
    ' UPDATE EXPENSE
    '--------------------------------------------------------------------------

    Set LoadedExpense = ExpenseService.GetExpense(TestExpenseID)

    If LoadedExpense Is Nothing Then

        Err.Raise _
            vbObjectError + 13807, _
            "TEST-138", _
            "Expense could not be loaded before update."

    End If

    LoadedExpense.ExpenseAmount = CCur(20)
    LoadedExpense.CashAmount = CCur(20)
    LoadedExpense.BankAmount = CCur(0)
    LoadedExpense.Description = "TEST-138 - Updated expense"

    If Not ExpenseService.UpdateExpense(LoadedExpense) Then

        Err.Raise _
            vbObjectError + 13808, _
            "TEST-138", _
            "Expense update failed."

    End If

    '--------------------------------------------------------------------------
    ' VERIFY LATER BALANCE AFTER UPDATE
    '--------------------------------------------------------------------------

    Set Entries = LedgerService.GetAllEntries

    If Entries Is Nothing Then

        Err.Raise _
            vbObjectError + 13809, _
            "TEST-138", _
            "Ledger entries could not be read after update."

    End If

    RunningBalance = CCur(0)
    FoundLaterLedger = False

    For I = 1 To Entries.Count

        Set CurrentEntry = Entries(I)

        If Not CurrentEntry Is Nothing Then

            RunningBalance = RunningBalance _
                + CurrentEntry.IncomeAmount _
                - CurrentEntry.ExpenseAmount

            If CurrentEntry.LedgerID = LaterLedgerID Then

                ExpectedBalance = RunningBalance
                FoundLaterLedger = True

                If CurrentEntry.BalanceAmount <> ExpectedBalance Then

                    Err.Raise _
                        vbObjectError + 13810, _
                        "TEST-138", _
                        "Later ledger balance is incorrect after expense update."

                End If

                Exit For

            End If

        End If

    Next I

    If Not FoundLaterLedger Then

        Err.Raise _
            vbObjectError + 13811, _
            "TEST-138", _
            "Later ledger entry was not found after update."

    End If

    '--------------------------------------------------------------------------
    ' DELETE EXPENSE
    '--------------------------------------------------------------------------

    If Not ExpenseService.DeleteExpense(TestExpenseID) Then

        Err.Raise _
            vbObjectError + 13812, _
            "TEST-138", _
            "Expense deletion failed."

    End If

    '--------------------------------------------------------------------------
    ' VERIFY EXPENSE WAS DELETED
    '--------------------------------------------------------------------------

    Set LoadedExpense = ExpenseService.GetExpense(TestExpenseID)

    If Not LoadedExpense Is Nothing Then

        Err.Raise _
            vbObjectError + 13813, _
            "TEST-138", _
            "Expense still exists after deletion."

    End If

    '--------------------------------------------------------------------------
    ' VERIFY LINKED LEDGER ENTRY WAS DELETED
    '--------------------------------------------------------------------------

    Set LoadedEntry = LedgerService.GetEntry(TestLedgerID)

    If Not LoadedEntry Is Nothing Then

        Err.Raise _
            vbObjectError + 13814, _
            "TEST-138", _
            "Expense ledger entry still exists after deletion."

    End If

    '--------------------------------------------------------------------------
    ' VERIFY LATER BALANCE AFTER DELETION
    '--------------------------------------------------------------------------

    Set Entries = LedgerService.GetAllEntries

    If Entries Is Nothing Then

        Err.Raise _
            vbObjectError + 13815, _
            "TEST-138", _
            "Ledger entries could not be read after deletion."

    End If

    RunningBalance = CCur(0)
    FoundLaterLedger = False

    For I = 1 To Entries.Count

        Set CurrentEntry = Entries(I)

        If Not CurrentEntry Is Nothing Then

            RunningBalance = RunningBalance _
                + CurrentEntry.IncomeAmount _
                - CurrentEntry.ExpenseAmount

            If CurrentEntry.LedgerID = LaterLedgerID Then

                ExpectedBalance = RunningBalance
                FoundLaterLedger = True

                If CurrentEntry.BalanceAmount <> ExpectedBalance Then

                    Err.Raise _
                        vbObjectError + 13816, _
                        "TEST-138", _
                        "Later ledger balance is incorrect after expense deletion."

                End If

                Exit For

            End If

        End If

    Next I

    If Not FoundLaterLedger Then

        Err.Raise _
            vbObjectError + 13817, _
            "TEST-138", _
            "Later ledger entry was not found after deletion."

    End If

    '--------------------------------------------------------------------------
    ' SUCCESS
    '--------------------------------------------------------------------------

    Debug.Print "TEST-138 SUCCESS"
    Debug.Print "Expense update balance: SUCCESS"
    Debug.Print "Expense deletion balance: SUCCESS"

    GoTo CleanUp

TestError:

    ErrorNumber = Err.Number
    ErrorDescription = Err.Description

    Debug.Print "TEST-138 FAILED"
    Debug.Print "Error Number: " & ErrorNumber
    Debug.Print "Description: " & ErrorDescription

    Resume CleanUp

CleanUp:

    '--------------------------------------------------------------------------
    ' CLEAN UP ONLY THE TEMPORARY TEST RECORDS
    '--------------------------------------------------------------------------

    On Error Resume Next

    If TestExpenseID > 0 Then
        Call ExpenseService.DeleteExpense(TestExpenseID)
    End If

    If LaterLedgerID > 0 Then
        Call LedgerService.DeleteEntry(LaterLedgerID)
    End If

    ' Recalculate remaining balances after removing test records.
    Call LedgerService.RecalculateBalances

    On Error GoTo 0

    Set LoadedEntry = Nothing
    Set CurrentEntry = Nothing
    Set Entries = Nothing
    Set LoadedExpense = Nothing
    Set Entry = Nothing
    Set Expense = Nothing

    Set LedgerService = Nothing
    Set ExpenseService = Nothing

    If ErrorNumber <> 0 Then

        MsgBox _
            "TEST-138 BASARISIZ" & vbCrLf & vbCrLf & _
            "Hata numarasi: " & ErrorNumber & vbCrLf & _
            "Aciklama: " & ErrorDescription & vbCrLf & vbCrLf & _
            "Gecici test kayitlarinin temizligi denendi.", _
            vbCritical, _
            "OAA - TEST-138"

    Else

        MsgBox _
            "TEST-138 BASARILI" & vbCrLf & vbCrLf & _
            "Gider guncelleme bakiyesi dogrulandi." & vbCrLf & _
            "Gider silme bakiyesi dogrulandi." & vbCrLf & _
            "Gecici test kayitlarinin temizligi denendi.", _
            vbInformation, _
            "OAA - TEST-138"

    End If

End Sub

'==============================================================================
' TEST-139
' Expense - Ledger Relationship Integrity
'
' Test edilen:
'   1. AddExpenseWithLedger
'   2. ExpenseID relationship
'   3. Duplicate relationship control
'   4. Expense / Ledger field consistency
'   5. Cleanup
'
' Test sonunda olusturulan gider ve ledger kaydi temizlenir.
'==============================================================================

Public Sub TEST_139_ExpenseLedgerRelationship()

    Dim ExpenseService As clsExpenseService
    Dim LedgerService As clsLedgerService

    Dim Expense As clsExpense
    Dim LoadedExpense As clsExpense

    Dim EntriesBefore As Collection
    Dim EntriesAfter As Collection

    Dim Entry As clsLedgerEntry
    Dim CurrentEntry As clsLedgerEntry

    Dim TestExpenseID As Long

    Dim TestEntryDate As Date
    Dim TestDocumentNo As String
    Dim TestExpenseType As String
    Dim TestDescription As String

    Dim TestAmount As Currency
    Dim TestCashAmount As Currency
    Dim TestBankAmount As Currency

    Dim FoundCount As Long
    Dim LedgerCountBefore As Long
    Dim LedgerCountAfter As Long

    Dim RelationshipFound As Boolean
    Dim ExpenseDeleted As Boolean
    Dim LedgerDeleted As Boolean

    Dim I As Long

    Dim ErrorNumber As Long
    Dim ErrorDescription As String


    On Error GoTo TestError


    '==========================================================================
    ' TEST DATA
    '==========================================================================

    TestEntryDate = Date

    TestDocumentNo = _
        "TEST-139-" & Format$(Now, "yyyymmddhhnnss") & _
        "-" & CStr(CLng(Timer * 100))

    TestExpenseType = "TEST-139"

    TestDescription = _
        "TEST-139 - Expense Ledger Relationship Test"

    TestAmount = CCur(100)

    TestCashAmount = CCur(60)

    TestBankAmount = CCur(40)


    '==========================================================================
    ' SERVICES
    '==========================================================================

    Set ExpenseService = New clsExpenseService

    Set LedgerService = New clsLedgerService


    '==========================================================================
    ' LEDGER COUNT BEFORE TEST
    '==========================================================================

    Set EntriesBefore = LedgerService.GetAllEntries

    If EntriesBefore Is Nothing Then

        Err.Raise _
            vbObjectError + 13901, _
            "TEST-139", _
            "LedgerService.GetAllEntries returned Nothing."

    End If

    LedgerCountBefore = EntriesBefore.Count


    '==========================================================================
    ' CREATE EXPENSE ENTITY
    '==========================================================================

    Set Expense = New clsExpense

    Expense.ExpenseID = 0

    Expense.EntryDate = TestEntryDate

    Expense.DocumentNo = TestDocumentNo

    Expense.ExpenseType = TestExpenseType

    Expense.Description = TestDescription

    Expense.ExpenseAmount = TestAmount

    Expense.CashAmount = TestCashAmount

    Expense.BankAmount = TestBankAmount


    '==========================================================================
    ' ADD EXPENSE WITH LEDGER
    '==========================================================================

    If Not ExpenseService.AddExpenseWithLedger(Expense) Then

        Err.Raise _
            vbObjectError + 13902, _
            "TEST-139", _
            "AddExpenseWithLedger returned False."

    End If


    TestExpenseID = Expense.ExpenseID

    If TestExpenseID <= 0 Then

        Err.Raise _
            vbObjectError + 13903, _
            "TEST-139", _
            "ExpenseID was not generated."

    End If


    '==========================================================================
    ' VERIFY EXPENSE RECORD
    '==========================================================================

    Set LoadedExpense = _
        ExpenseService.GetExpense(TestExpenseID)

    If LoadedExpense Is Nothing Then

        Err.Raise _
            vbObjectError + 13904, _
            "TEST-139", _
            "Created expense record could not be loaded."

    End If


    If LoadedExpense.ExpenseID <> TestExpenseID Then GoTo DataError

    If LoadedExpense.EntryDate <> TestEntryDate Then GoTo DataError

    If LoadedExpense.DocumentNo <> TestDocumentNo Then GoTo DataError

    If LoadedExpense.ExpenseType <> TestExpenseType Then GoTo DataError

    If LoadedExpense.Description <> TestDescription Then GoTo DataError

    If LoadedExpense.ExpenseAmount <> TestAmount Then GoTo DataError

    If LoadedExpense.CashAmount <> TestCashAmount Then GoTo DataError

    If LoadedExpense.BankAmount <> TestBankAmount Then GoTo DataError


    '==========================================================================
    ' VERIFY LEDGER RECORD
    '==========================================================================

    Set EntriesAfter = LedgerService.GetAllEntries

    If EntriesAfter Is Nothing Then

        Err.Raise _
            vbObjectError + 13905, _
            "TEST-139", _
            "LedgerService.GetAllEntries returned Nothing after insert."

    End If

    LedgerCountAfter = EntriesAfter.Count

    If LedgerCountAfter <> LedgerCountBefore + 1 Then

        Err.Raise _
            vbObjectError + 13906, _
            "TEST-139", _
            "Ledger record count did not increase by one."

    End If


    '==========================================================================
    ' FIND RELATED LEDGER ENTRY
    '==========================================================================

    FoundCount = 0

    RelationshipFound = False

    For I = 1 To EntriesAfter.Count

        Set CurrentEntry = EntriesAfter(I)

        If Not CurrentEntry Is Nothing Then

            If CurrentEntry.ExpenseID = TestExpenseID Then

                FoundCount = FoundCount + 1

                Set Entry = CurrentEntry

                RelationshipFound = True

            End If

        End If

    Next I


    If Not RelationshipFound Then

        Err.Raise _
            vbObjectError + 13907, _
            "TEST-139", _
            "Related ledger entry was not found."

    End If


    If FoundCount <> 1 Then

        Err.Raise _
            vbObjectError + 13908, _
            "TEST-139", _
            "More than one ledger entry references the same ExpenseID."

    End If


    '==========================================================================
    ' VERIFY LEDGER FIELDS
    '==========================================================================

    If Entry.ExpenseID <> TestExpenseID Then GoTo LedgerDataError

    If Entry.EntryDate <> TestEntryDate Then GoTo LedgerDataError

    If Entry.DocumentNo <> TestDocumentNo Then GoTo LedgerDataError

    If Entry.Description <> TestDescription Then GoTo LedgerDataError

    If Entry.ExpenseType <> TestExpenseType Then GoTo LedgerDataError

    If Entry.IncomeAmount <> CCur(0) Then GoTo LedgerDataError

    If Entry.ExpenseAmount <> TestAmount Then GoTo LedgerDataError

    If Entry.CashAmount <> TestCashAmount Then GoTo LedgerDataError

    If Entry.BankAmount <> TestBankAmount Then GoTo LedgerDataError


    '==========================================================================
    ' CLEANUP
    '==========================================================================

    If Not ExpenseService.DeleteExpense(TestExpenseID) Then

        Err.Raise _
            vbObjectError + 13909, _
            "TEST-139", _
            "Test expense and ledger records could not be deleted."

    End If


    '==========================================================================
    ' VERIFY CLEANUP
    '==========================================================================

    Set LoadedExpense = _
        ExpenseService.GetExpense(TestExpenseID)

    If Not LoadedExpense Is Nothing Then

        Err.Raise _
            vbObjectError + 13910, _
            "TEST-139", _
            "Expense record still exists after cleanup."

    End If


    Set EntriesAfter = LedgerService.GetAllEntries

    If EntriesAfter Is Nothing Then

        Err.Raise _
            vbObjectError + 13911, _
            "TEST-139", _
            "Ledger records could not be read after cleanup."

    End If


    LedgerDeleted = True

    For I = 1 To EntriesAfter.Count

        Set CurrentEntry = EntriesAfter(I)

        If Not CurrentEntry Is Nothing Then

            If CurrentEntry.ExpenseID = TestExpenseID Then

                LedgerDeleted = False

                Exit For

            End If

        End If

    Next I


    If Not LedgerDeleted Then

        Err.Raise _
            vbObjectError + 13912, _
            "TEST-139", _
            "Related ledger entry still exists after cleanup."

    End If


    TestExpenseID = 0


    '==========================================================================
    ' SUCCESS
    '==========================================================================

    Debug.Print String(70, "=")
    Debug.Print "TEST-139 SUCCESSFUL"
    Debug.Print "AddExpenseWithLedger : SUCCESS"
    Debug.Print "ExpenseID            : SUCCESS"
    Debug.Print "Ledger relationship  : SUCCESS"
    Debug.Print "Duplicate control    : SUCCESS"
    Debug.Print "Field consistency    : SUCCESS"
    Debug.Print "Cleanup              : SUCCESS"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-139 SUCCESSFUL" & vbCrLf & vbCrLf & _
        "AddExpenseWithLedger : SUCCESS" & vbCrLf & _
        "ExpenseID            : SUCCESS" & vbCrLf & _
        "Ledger relationship  : SUCCESS" & vbCrLf & _
        "Duplicate control    : SUCCESS" & vbCrLf & _
        "Field consistency    : SUCCESS" & vbCrLf & _
        "Cleanup              : SUCCESS", _
        vbInformation, _
        "OAA - TEST-139"


    GoTo CleanExit


'==============================================================================
' EXPENSE DATA ERROR
'==============================================================================

DataError:

    Err.Raise _
        vbObjectError + 13913, _
        "TEST-139", _
        "Expense fields do not match expected values."


'==============================================================================
' LEDGER DATA ERROR
'==============================================================================

LedgerDataError:

    Err.Raise _
        vbObjectError + 13914, _
        "TEST-139", _
        "Ledger fields do not match expected expense values."


'==============================================================================
' TEST ERROR
'==============================================================================

TestError:

    ErrorNumber = Err.Number

    ErrorDescription = Err.Description


    '--------------------------------------------------------------------------
    ' CLEANUP ON ERROR
    '--------------------------------------------------------------------------

    On Error Resume Next

    If TestExpenseID > 0 Then

        ExpenseService.DeleteExpense TestExpenseID

    End If

    On Error GoTo 0


    Debug.Print String(70, "=")
    Debug.Print "TEST-139 FAILED"
    Debug.Print "Error Number : " & ErrorNumber
    Debug.Print "Description  : " & ErrorDescription
    Debug.Print "Cleanup      : Attempted"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-139 FAILED" & vbCrLf & vbCrLf & _
        "Error Number : " & ErrorNumber & vbCrLf & _
        "Description  : " & ErrorDescription & vbCrLf & vbCrLf & _
        "Cleanup was attempted.", _
        vbCritical, _
        "OAA - TEST-139"


'==============================================================================
' CLEAN EXIT
'==============================================================================

CleanExit:

    Set CurrentEntry = Nothing

    Set Entry = Nothing

    Set EntriesAfter = Nothing

    Set EntriesBefore = Nothing

    Set LoadedExpense = Nothing

    Set Expense = Nothing

    Set LedgerService = Nothing

    Set ExpenseService = Nothing

End Sub

'==============================================================================
' TEST-140
' Gider Kasa / Banka Dagilimi Tutarlilik Kontrolu
'
' Beklenen:
' Gider tutari <> Kasa tutari + Banka tutari ise
' AddExpenseWithLedger islemi reddedilmelidir.
'==============================================================================

Public Sub TEST_140_ExpensePaymentDistributionValidation()

    Dim ExpenseService As clsExpenseService
    Dim LedgerService As clsLedgerService

    Dim Expense As clsExpense
    Dim CurrentExpense As clsExpense

    Dim EntriesBefore As Collection
    Dim EntriesAfter As Collection

    Dim ExpensesBefore As Collection
    Dim ExpensesAfter As Collection

    Dim Entry As clsLedgerEntry

    Dim TestDocumentNo As String
    Dim TestDescription As String

    Dim TestExpenseID As Long

    Dim TestAmount As Currency
    Dim TestCashAmount As Currency
    Dim TestBankAmount As Currency

    Dim ExpenseCountBefore As Long
    Dim ExpenseCountAfter As Long

    Dim LedgerCountBefore As Long
    Dim LedgerCountAfter As Long

    Dim FoundExpense As Boolean
    Dim FoundLedger As Boolean

    Dim AddResult As Boolean

    Dim I As Long

    Dim ErrorNumber As Long
    Dim ErrorDescription As String


    On Error GoTo TestError


    '==========================================================================
    ' TEST VERILERI
    '==========================================================================

    TestDocumentNo = _
        "TEST-140-" & Format$(Now, "yyyymmddhhnnss")

    TestDescription = _
        "TEST-140 - Gecersiz kasa banka dagilimi"

    TestAmount = CCur(100)

    TestCashAmount = CCur(60)

    TestBankAmount = CCur(30)


    '==========================================================================
    ' SERVICES
    '==========================================================================

    Set ExpenseService = New clsExpenseService

    Set LedgerService = New clsLedgerService


    '==========================================================================
    ' MEVCUT KAYIT SAYILARI
    '==========================================================================

    Set ExpensesBefore = ExpenseService.GetAllExpenses

    Set EntriesBefore = LedgerService.GetAllEntries

    If ExpensesBefore Is Nothing Then

        Err.Raise _
            vbObjectError + 14001, _
            "TEST-140", _
            "Gider kayitlari okunamadi."

    End If

    If EntriesBefore Is Nothing Then

        Err.Raise _
            vbObjectError + 14002, _
            "TEST-140", _
            "Defter kayitlari okunamadi."

    End If

    ExpenseCountBefore = ExpensesBefore.Count

    LedgerCountBefore = EntriesBefore.Count


    '==========================================================================
    ' GECERSIZ GIDER ENTITY
    '==========================================================================

    Set Expense = New clsExpense

    Expense.ExpenseID = 0

    Expense.EntryDate = Date

    Expense.DocumentNo = TestDocumentNo

    Expense.ExpenseType = "TEST-140"

    Expense.Description = TestDescription

    Expense.ExpenseAmount = TestAmount

    Expense.CashAmount = TestCashAmount

    Expense.BankAmount = TestBankAmount


    '==========================================================================
    ' ADD EXPENSE WITH LEDGER
    '==========================================================================

    AddResult = ExpenseService.AddExpenseWithLedger(Expense)


    If AddResult Then

        Err.Raise _
            vbObjectError + 14003, _
            "TEST-140", _
            "Gecersiz kasa banka dagilimi kabul edildi."

    End If


    '==========================================================================
    ' ENTITY ID KONTROLU
    '==========================================================================

    If Expense.ExpenseID <> 0 Then

        Err.Raise _
            vbObjectError + 14004, _
            "TEST-140", _
            "Reddedilen gider icin ExpenseID olusturuldu."

    End If


    '==========================================================================
    ' GIDER KAYIT SAYISI KONTROLU
    '==========================================================================

    Set ExpensesAfter = ExpenseService.GetAllExpenses

    If ExpensesAfter Is Nothing Then

        Err.Raise _
            vbObjectError + 14005, _
            "TEST-140", _
            "Gider kayitlari tekrar okunamadi."

    End If

    ExpenseCountAfter = ExpensesAfter.Count

    If ExpenseCountAfter <> ExpenseCountBefore Then

        Err.Raise _
            vbObjectError + 14006, _
            "TEST-140", _
            "Gecersiz islem sonrasinda gider kayit sayisi degisti."

    End If


    '==========================================================================
    ' TEST BELGE NUMARASI ILE GIDER KAYDI ARAMA
    '==========================================================================

    FoundExpense = False

    For I = 1 To ExpensesAfter.Count

        Set CurrentExpense = ExpensesAfter(I)

        If Not CurrentExpense Is Nothing Then

            If CurrentExpense.DocumentNo = TestDocumentNo Then

                FoundExpense = True

                Exit For

            End If

        End If

    Next I


    If FoundExpense Then

        Err.Raise _
            vbObjectError + 14007, _
            "TEST-140", _
            "Reddedilen gider veritabanina kaydedildi."

    End If


    '==========================================================================
    ' DEFTER KAYIT SAYISI KONTROLU
    '==========================================================================

    Set EntriesAfter = LedgerService.GetAllEntries

    If EntriesAfter Is Nothing Then

        Err.Raise _
            vbObjectError + 14008, _
            "TEST-140", _
            "Defter kayitlari tekrar okunamadi."

    End If

    LedgerCountAfter = EntriesAfter.Count

    If LedgerCountAfter <> LedgerCountBefore Then

        Err.Raise _
            vbObjectError + 14009, _
            "TEST-140", _
            "Gecersiz islem sonrasinda defter kayit sayisi degisti."

    End If


    '==========================================================================
    ' TEST BELGE NUMARASI ILE DEFTER HAREKETI ARAMA
    '==========================================================================

    FoundLedger = False

    For I = 1 To EntriesAfter.Count

        Set Entry = EntriesAfter(I)

        If Not Entry Is Nothing Then

            If Entry.DocumentNo = TestDocumentNo Then

                FoundLedger = True

                Exit For

            End If

        End If

    Next I


    If FoundLedger Then

        Err.Raise _
            vbObjectError + 14010, _
            "TEST-140", _
            "Reddedilen gider icin defter hareketi olusturuldu."

    End If


    '==========================================================================
    ' BASARILI
    '==========================================================================

    Debug.Print String(70, "=")
    Debug.Print "TEST-140 BASARILI"
    Debug.Print "Gecersiz dagilim reddi       : BASARILI"
    Debug.Print "ExpenseID kontrolu           : BASARILI"
    Debug.Print "Gider kayit sayisi kontrolu  : BASARILI"
    Debug.Print "Defter kayit sayisi kontrolu : BASARILI"
    Debug.Print "Defter hareketi kontrolu     : BASARILI"
    Debug.Print String(70, "=")


    MsgBox _
        "TEST-140 BASARILI" & vbCrLf & vbCrLf & _
        "Gecersiz dagilim reddi       : BASARILI" & vbCrLf & _
        "ExpenseID kontrolu           : BASARILI" & vbCrLf & _
        "Gider kayit sayisi kontrolu  : BASARILI" & vbCrLf & _
        "Defter kayit sayisi kontrolu : BASARILI" & vbCrLf & _
        "Defter hareketi kontrolu     : BASARILI", _
        vbInformation, _
        "OAA - TEST-140"


    GoTo CleanExit


'==============================================================================
' TEST HATASI
'==============================================================================

TestError:

    ErrorNumber = Err.Number

    ErrorDescription = Err.Description


    '--------------------------------------------------------------------------
    ' HATA DURUMUNDA TEST KAYITLARINI TEMIZLE
    '--------------------------------------------------------------------------

    On Error Resume Next

    Set ExpensesAfter = ExpenseService.GetAllExpenses

    If Not ExpensesAfter Is Nothing Then

        For I = 1 To ExpensesAfter.Count

            Set CurrentExpense = ExpensesAfter(I)

            If Not CurrentExpense Is Nothing Then

                If CurrentExpense.DocumentNo = TestDocumentNo Then

                    TestExpenseID = CurrentExpense.ExpenseID

                    If TestExpenseID > 0 Then

                        ExpenseService.DeleteExpense TestExpenseID

                    End If

                End If

            End If

        Next I

    End If


    '--------------------------------------------------------------------------
    ' BAGIMSIZ DEFTER HAREKETI KONTROLU
    '--------------------------------------------------------------------------

    Set EntriesAfter = LedgerService.GetAllEntries

    If Not EntriesAfter Is Nothing Then

        For I = EntriesAfter.Count To 1 Step -1

            Set Entry = EntriesAfter(I)

            If Not Entry Is Nothing Then

                If Entry.DocumentNo = TestDocumentNo Then

                    If Entry.LedgerID > 0 Then

                        LedgerService.DeleteEntry Entry.LedgerID

                    End If

                End If

            End If

        Next I

    End If

    On Error GoTo 0


    Debug.Print String(70, "=")
    Debug.Print "TEST-140 BASARISIZ"
    Debug.Print "Hata numarasi : " & ErrorNumber
    Debug.Print "Hata aciklamasi: " & ErrorDescription

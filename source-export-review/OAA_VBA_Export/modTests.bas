        MsgBox "TBL_DUE_RATES kolon sayýsý hatalý." & vbCrLf & _
               "Beklenen: 9" & vbCrLf & _
               "Bulunan: " & tblRates.ListColumns.Count, _
               vbCritical, "OAA - TEST-007"
        Exit Sub
    End If

    '----------------------------------------------------------------------
    ' TBL_MEMBER_CHARGES kolon adlarý
    '----------------------------------------------------------------------

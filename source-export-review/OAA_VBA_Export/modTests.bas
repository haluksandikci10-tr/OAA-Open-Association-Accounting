    If tblCharges.ListColumns(2).Name <> "MemberID" Then GoTo ChargeColumnError
    If tblCharges.ListColumns(3).Name <> "ChargeType" Then GoTo ChargeColumnError
    If tblCharges.ListColumns(4).Name <> "ChargeDate" Then GoTo ChargeColumnError
    If tblCharges.ListColumns(5).Name <> "FiscalYear" Then GoTo ChargeColumnError
    If tblCharges.ListColumns(6).Name <> "DueMonth" Then GoTo ChargeColumnError
